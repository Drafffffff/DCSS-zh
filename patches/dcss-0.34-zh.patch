diff --git a/crawl-ref/source/dat/database/zh/decorlines.txt b/crawl-ref/source/dat/database/zh/decorlines.txt
new file mode 100644
index 0000000..8481445
--- /dev/null
+++ b/crawl-ref/source/dat/database/zh/decorlines.txt
@@ -0,0 +1,914 @@
+
+%%%%
+default peaceful fountain_blue
+
+{{
+  -- 鬼火能饮用药水，因此这里不需要另外的消息。
+  if you.transform() == "death" or you.race() == "Mummy" then -- 处于死亡形态或木乃伊
+    if crawl.one_chance_in(3) then return "你对着饮水喷泉呆望片刻，叹了口气。"
+    else return "__NONE" end -- 不显示任何消息
+  elseif you.transform() == "storm" then return "喷泉在你身下噼啪作响。"
+  else return "你小饮了一口喷泉的水。清爽。"; end
+}}
+
+{{
+  if you.transform() == "storm" then return "细微的电击在喷泉中涌动。"
+  elseif you.transform() == "wisp" then return "你水中的倒影诡异地明灭不定。"
+  elseif crawl.coinflip() or you.god() == "Okawaru" then return "你停下来洗了洗@your_hands@。"
+  else return "你停下来擦拭@your_weapon@。" end
+}}
+
+w:1
+你看见喷泉上有@any_graffiti@。
+%%%%
+%%%%
+default fountain_blue
+
+喷泉因你的靠近而泛起短暂的涟漪。
+
+w:1
+你看见喷泉上有@any_graffiti@。
+%%%%
+%%%%
+default peaceful fountain_sparkling
+
+{{
+  if you.transform() == "death" or you.race() == "Mummy" then -- 处于死亡形态或木乃伊
+    if crawl.one_chance_in(3) then return "你对着泛光的喷泉呆望片刻，叹了口气。"
+    else return "__NONE" end -- 不显示任何消息
+  elseif you.transform() == "storm" then return "喷泉在你身下诡异地噼啪作响。"
+  elseif crawl.coinflip() or you.god == "Zin" or you.god == "Cheibriados" then return "喷泉脉动着奇异的@any_colour_pattern@，你决定不喝它的水。"
+  else return "你小饮了一口喷泉的水。@sparkling_message@" end
+}}
+
+w:1
+你看见喷泉上有@any_graffiti@。
+%%%%
+%%%%
+sparkling_message
+
+# 为陈年泛光喷泉可能含有的药水效果增添些风味是合理的，
+# 但请保持非常简短，且不易被误认为任何真正有意义的效果。（另外，不要提及血。）
+你感到自己瞬间轻盈了一些。
+
+你感到一阵短暂的勇气冲动。
+
+你感到一阵恶心。
+
+你的情绪不适地扭绞着。
+%%%%
+%%%%
+default fountain_sparkling
+
+泛光的喷泉闪烁着微弱的@any_colour@。
