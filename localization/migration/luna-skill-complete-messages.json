    },
    {
      "id": "skill.menu.switch_help.focus",
      "context": "专注训练模式操作说明。",
      "source": "SkillMenuSwitch::get_help",
      "params": {},
      "en": "Press the letter of a skill to cycle between <darkgrey>disabled</darkgrey> (<darkgrey>-</darkgrey>), enabled (+) and <white>focused</white> (<white>*</white>). Focused skills train twice as fast relative to others.",
      "zh": "按下技能对应的字母，可在<darkgrey>停用</darkgrey>（<darkgrey>-</darkgrey>）、启用（+）和<white>专注</white>（<white>*</white>）之间切换。专注技能相较其他技能以双倍速度训练。"
    },
    {
      "id": "skill.menu.switch_help.manual",
      "context": "手动技能训练模式说明。",
      "source": "SkillMenuSwitch::get_help",
      "params": {},
      "en": "In manual mode, experience is spread evenly across all activated skills.",
      "zh": "手动模式下，经验会平均分配给所有已启用的技能。"
    },
    {
      "id": "skill.menu.switch_help.practice",
