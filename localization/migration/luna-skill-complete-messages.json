    {
      "id": "skill.menu.default.experience",
      "context": "使用经验药剂后的技能分配帮助。",
      "source": "SkillMenu::set_default_help",
      "params": {},
      "en": "Select the skills you want to be trained. The chosen skills will be raised to the level shown in <cyan>cyan</cyan>.",
      "zh": "选择要训练的技能。所选技能将提升至<cyan>青色</cyan>显示的等级。"
    },
    {
      "id": "skill.menu.default.manual",
      "context": "技能手册加成说明。",
      "source": "SkillMenu::set_default_help",
      "params": {},
      "en": "Bonus from skill manuals is in <lightred>red</lightred>. ",
      "zh": "技能手册带来的加成以<lightred>红色</lightred>显示。"
    },
    {
      "id": "skill.menu.default.normal",
      "context": "技能面板的常规帮助组合。",
      "source": "SkillMenu::set_default_help",
