    {
      "id": "skill.menu.default.experience",
      "args": {},
      "canonical": "Select the skills you want to be trained. The chosen skills will be raised to the level shown in <cyan>cyan</cyan>.",
      "zh": "选择要训练的技能。所选技能将提升至<cyan>青色</cyan>显示的等级。"
    },
    {
      "id": "skill.menu.error.no_training",
      "args": {},
      "canonical": "<lightred>You need to enable at least one skill.</lightred>",
      "zh": "<lightred>你至少需要启用一项技能。</lightred>"
    },
    {
      "id": "skill.menu.switch",
      "args": {
        "hotkey": {
          "type": "key",
          "canonical": "/",
          "localized": "/"
        },
        "options": {
          "type": "text",
          "canonical": "<white>manual</white>|<darkgrey>auto</darkgrey>",
          "localized": "<white>手动</white>|<darkgrey>自动</darkgrey>"
        },
        "label": {
          "type": "text",
          "canonical": " mode  ",
          "localized": " 模式  "
        }
      },
      "canonical": " [<yellow>/</yellow>] <white>manual</white>|<darkgrey>auto</darkgrey> mode  ",
      "zh": " [<yellow>/</yellow>] <white>手动</white>|<darkgrey>自动</darkgrey> 模式   "
    },
    {
      "id": "skill.menu.switch_help.focus",
      "args": {},
      "canonical": "Press the letter of a skill to cycle between <darkgrey>disabled</darkgrey> (<darkgrey>-</darkgrey>), enabled (+) and <white>focused</white> (<white>*</white>). Focused skills train twice as fast relative to others.",
      "zh": "按下技能对应的字母，可在<darkgrey>停用</darkgrey>（<darkgrey>-</darkgrey>）、启用（+）和<white>专注</white>（<white>*</white>）之间切换。专注技能相较其他技能以双倍速度训练。"
    },
    {
      "id": "skill.menu.help.overview",
      "args": {},
      "canonical": "This screen shows the skill set of your character. The number next to the skill is your current level, the higher the better. <w>Training</w> displays training percentages. <w>Costs</w> displays relative training costs. <w>Targets</w> displays skill training targets. You can toggle which skills to train by pressing their slot letters. A <darkgrey>grey</darkgrey> skill will not be trained and ease the training of others.",
      "zh": "此界面显示角色的技能。技能旁的数字是当前等级，数值越高越好。<w>训练比例</w>显示训练百分比，<w>消耗</w>显示相对训练消耗，<w>目标</w>显示技能训练目标。按下技能对应的栏位字母即可切换是否训练。<darkgrey>灰色</darkgrey>技能不会受训，并会让其他技能更容易提升。"
    }
  ]
