      "en": "{prefix} {skill}",
      "zh": "{prefix} {skill}"
    },
    {
      "id": "skill.menu.error.no_training",
      "context": "未启用任何训练技能时的提示。",
      "source": "SkillMenu::do_skill_enabled_check",
      "params": {},
      "en": "<lightred>You need to enable at least one skill.</lightred>",
      "zh": "<lightred>你至少需要启用一项技能。</lightred>"
    },
    {
      "id": "skill.menu.error.target_limit",
      "context": "训练目标超过上限时的提示。",
      "source": "SkillMenu::read_skill_target",
      "params": {},
      "en": "<lightred>Your training target must be 27 or below!</lightred>",
      "zh": "<lightred>训练目标必须不高于27！</lightred>"
    },
    {
      "id": "skill.menu.help.experience",
      "context": "经验分配界面标题。",
      "source": "SkillMenu::set_title",
      "params": {},
      "en": "You have gained great experience. Select the skills to train.",
      "zh": "你获得了大量经验。请选择要训练的技能。"
    },
    {
      "id": "skill.menu.help.general",
      "context": "技能说明模式下的总体帮助。",
      "source": "SkillMenu::help",
      "params": {},
      "en": "Press the letter of a skill to read its description.\nPress <w>? for a general explanation of skilling and the various toggles.",
      "zh": "按下技能对应的字母可阅读其说明。\\n按<w>?查看技能训练及各项切换选项的总体说明。"
    },
    {
      "id": "skill.menu.help.overview",
      "context": "简单模式技能面板帮助。",
      "source": "hints_skills_info wording in SkillMenu::set_default_help",
      "params": {},
      "en": "This screen shows the skill set of your character. The number next to the skill is your current level, the higher the better. <w>Training</w> displays training percentages. <w>Costs</w> displays relative training costs. <w>Targets</w> displays skill training targets. You can toggle which skills to train by pressing their slot letters. A <darkgrey>grey</darkgrey> skill will not be trained and ease the training of others.",
      "zh": "此界面显示角色的技能。技能旁的数字是当前等级，数值越高越好。<w>训练比例</w>显示训练百分比，<w>消耗</w>显示相对训练消耗，<w>目标</w>显示技能训练目标。按下技能对应的栏位字母即可切换是否训练。<darkgrey>灰色</darkgrey>技能不会受训，并会让其他技能更容易提升。"
    },
    {
      "id": "skill.menu.help.simple_cost",
      "context": "简单模式训练消耗帮助。",
      "source": "hints_skill_costs_info wording in SkillMenuSwitch::get_help",
      "params": {},
      "en": "The training cost (in <cyan>cyan</cyan>) shows the experience cost to raise the given skill one level, relative to the cost of raising an aptitude zero skill from level zero to level one.",
      "zh": "训练消耗（以<cyan>青色</cyan>显示）表示该技能提升一级所需的经验，相对于将适性为零的技能从0级提升到1级的消耗。"
    },
    {
      "id": "skill.menu.help.simple_descriptions",
      "context": "简单模式技能描述帮助。",
      "source": "hints_skills_description_info wording in SkillMenu::help",
      "params": {},
      "en": "This screen shows the skill set of your character. Press the letter of a skill to read its description, or press <w>?</w> again to return to the skill selection.",
      "zh": "此界面显示角色的技能。按下技能对应的字母可阅读其说明；再次按<w>?</w>返回技能选择。"
    },
    {
      "id": "skill.menu.help.simple_targets",
      "context": "简单模式训练目标帮助。",
      "source": "hints_skill_targets_info wording in SkillMenuSwitch::get_help",
      "params": {},
      "en": "Press the letter of a skill to set a training target. When the target is reached a message will appear and the training of the skill will be disabled.",
      "zh": "按下技能对应的字母可设定训练目标。达到目标时会出现提示，并停用该技能的训练。"
    },
    {
      "id": "skill.menu.help.simple_training",
      "context": "简单模式训练比例帮助。",
      "source": "hints_skill_training_info wording in SkillMenuSwitch::get_help",
      "params": {},
      "en": "The training percentage (in <brown>brown</brown>) shows the relative amount of the experience gained which will be used to train each skill. It is automatically set depending on which skills you have used recently. Disabling a skill sets the training rate to 0.",
      "zh": "训练百分比（以<brown>棕色</brown>显示）表示获得的经验中用于训练各技能的相对比例。系统会根据你最近使用的技能自动分配比例。停用某项技能会将其训练比例设为0。"
    },
