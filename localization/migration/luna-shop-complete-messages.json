{
  "model": "gpt-6-luna",
  "messages": [
    {
      "id": "shopping_list.title",
      "context": "购物清单菜单标题完整句",
      "en": "Shopping list: {count} {item}{plural}, total cost {cost} gold pieces",
      "zh": "购物清单：{count}{item}{plural}，总价{cost}枚金币",
      "params": {
        "count": "integer",
        "item": "text",
        "plural": "text",
        "cost": "integer"
      },
      "source": {
        "file": "native/crawl-ref/source/shopping.cc",
        "anchor": "ShoppingListMenu::calc_title; title quantity/text and SHOPPING_LIST_COST_KEY"
      }
    },
    {
      "id": "shopping_list.entry",
      "context": "购物清单条目；place 包含位置对齐空格，item 未鉴定时保留遮蔽",
      "en": "{place}{cost} gold  {item}",
      "zh": "{place}{cost}枚金币  {item}",
      "params": {
        "place": "key",
        "cost": "integer",
        "item": "name"
      },
      "source": {
        "file": "native/crawl-ref/source/shopping.cc",
        "anchor": "ShoppingList::fill_out_menu; describe_thing_pos, thing_cost, name_thing"
      }
    },
    {
      "id": "shop.purchase.insufficient",
      "context": "购买余额不足提示",
      "en": "You don't have enough money.",
      "zh": "你的钱不够。",
      "params": {},
      "source": {
        "file": "native/crawl-ref/source/shopping.cc",
        "anchor": "ShopMenu::purchase_selected; cost exceeds gold and voucher cannot cover"
      }
    },
    {
      "id": "shop.purchase.confirm",
      "context": "购买确认完整句；confirm 是根据 easy_confirm 生成的 Y/y",
      "en": "Purchase items{list_suffix} for {cost} gold? {voucher_notice} ({confirm}/N)",
      "zh": "要花{cost}枚金币购买{list_suffix}吗？{voucher_notice}（{confirm}/N）",
      "params": {
        "list_suffix": "text",
        "cost": "integer",
        "voucher_notice": "text",
        "confirm": "key"
      },
      "source": {
        "file": "native/crawl-ref/source/shopping.cc",
        "anchor": "ShopMenu::purchase_selected; buying_from_list, cost, too_expensive, easy_confirm key"
      }
    },
    {
      "id": "shopping_list.error.already",
      "context": "重复加入购物清单提示",
      "en": "{item} is already on the shopping list.",
      "zh": "{item}已在购物清单中。",
      "params": {
        "item": "name"
      },
      "source": {
        "file": "native/crawl-ref/source/shopping.cc",
        "anchor": "ShoppingList::add_thing; item.name(DESC_THE)"
