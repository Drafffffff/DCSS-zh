    {
      "id": "item.origin.god_gift",
      "context": "物品详情：神祇赠礼来源",
      "en": "\n{god} gifted it to you {place}.",
      "zh": "\n{god}在{place}赐予了你这件物品。",
      "params": {
        "god": "name",
        "place": "text"
      },
      "source": {
        "file": "items.cc",
        "anchor": "origin_desc; negative orig_monnum interpreted as god id and within GOD_NO_GOD..NUM_GODS"
      }
