      "zh": "\n你在{place}从{monster}身上取下了它。",
      "params": {
        "monster": "name",
        "place": "text"
      },
      "source": {
        "file": "items.cc",
        "anchor": "origin_desc; positive orig_monnum other than MONS_DANCING_WEAPON, _origin_monster_name(item)"
