    {
      "id": "item.origin.found_place",
      "context": "物品详情：普通来源地点（非标准地下城条目）",
      "en": "\nYou found it {place}.",
      "zh": "\n你在{place}发现了它。",
      "params": {
        "place": "text"
      },
      "source": {
        "file": "items.cc",
        "anchor": "origin_desc; orig_monnum == 0, followed by _origin_place_desc(item)"
      }
    },
    {
