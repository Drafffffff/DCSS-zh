{
  "model": "gpt-6-luna",
  "purpose": "Complete reviewed messages generated by detailed skill descriptions and their raw description tabs.",
  "messages": [
    {
      "id": "detail.tabs.description",
      "context": "详情弹窗的说明视图标签；保留原ASCII快捷键和<w>样式标记。",
      "source": "describe.cc::show_description",
      "params": {},
      "en": "[<w>!</w>]: <w>Description</w>|Quote",
      "zh": "[<w>!</w>]: <w>说明</w>|引言"
    },
    {
      "id": "detail.tabs.quote",
      "context": "详情弹窗的引言视图标签；保留原ASCII快捷键和<w>样式标记。",
      "source": "describe.cc::show_description",
      "params": {},
      "en": "[<w>!</w>]: Description|<w>Quote</w>",
      "zh": "[<w>!</w>]: 说明|<w>引言</w>"
    },
    {
      "id": "detail.skill.defence.armour",
      "context": "护甲技能详情展示提升1级后的防御变化。",
      "source": "describe.cc::_get_skill_defense_change, SK_ARMOUR",
      "params": {
        "action": "text",
        "ac": "number",
        "ev": "number"
      },
      "en": "With your current stats and equipment, {action} this skill would increase your AC by {ac} and your EV by {ev}.",
      "zh": "根据你当前的属性与装备，{action}会使护甲等级提高{ac}，闪避提高{ev}。"
    },
    {
      "id": "detail.skill.defence.dodging",
      "context": "闪避技能详情展示提升1级后的闪避变化。",
      "source": "describe.cc::_get_skill_defense_change, SK_DODGING",
      "params": {
        "action": "text",
        "ev": "number"
      },
      "en": "With your current stats and equipment, {action} this skill would increase your EV by {ev}.",
      "zh": "根据你当前的属性与装备，{action}会使闪避提高{ev}。"
    },
    {
      "id": "detail.skill.defence.shields",
      "context": "盾牌技能详情展示提升1级后的格挡变化。",
      "source": "describe.cc::_get_skill_defense_change, SK_SHIELDS",
      "params": {
        "action": "text",
        "sh": "number"
      },
      "en": "With your current stats and equipment, {action} this skill would increase your SH by {sh}.",
      "zh": "根据你当前的属性与装备，{action}会使格挡提高{sh}。"
    },
    {
      "id": "detail.skill.invocations.forlorn",
      "context": "孤苦变异下祈祷技能说明的专属提示。",
      "source": "describe.cc::get_skill_description, MUT_FORLORN",
      "params": {},
      "en": "How on earth did you manage to pick this up?",
      "zh": "你到底是怎么学会这个技能的？"
    },
    {
      "id": "detail.skill.invocations.unaffected",
      "context": "祈祷技能不适用于当前神祇时的详情提示；神名为专名。",
      "source": "describe.cc::get_skill_description, invo_skill mismatch",
      "params": {
        "god": "name"
      },
      "en": "{god} powers are not affected by the Invocations skill.",
      "zh": "{god}的神力不受祈祷技能影响。"
    },
    {
      "id": "detail.skill.invocations.based_on",
      "context": "当前神祇能力改由另一技能驱动时的详情提示。",
      "source": "describe.cc::get_skill_description, invo_skill match",
      "params": {
        "god": "name",
        "skill": "name"
      },
      "en": "{god} powers are based on {skill} instead of Invocations skill.",
      "zh": "{god}的神力基于{skill}，而非祈祷技能。"
    },
    {
      "id": "detail.skill.god.dislikes_training",
      "context": "神祇厌恶训练该技能时的详情提示。",
      "source": "describe.cc::get_skill_description, is_harmful_skill",
      "params": {
        "god": "name"
      },
      "en": "{god} strongly dislikes when you train this skill.",
      "zh": "{god}很厌恶你训练这项技能。"
    },
    {
      "id": "skill.tile.tag",
      "context": "技能面板当前选中技能的等级与种族适性。",
      "source": "SkillRegion::draw_tag",
      "params": {
        "skill": "name",
        "level": "number",
        "apt_sign": "text",
        "apt": "integer"
      },
      "en": "{skill} Skill {level} Aptitude {apt_sign}{apt}",
      "zh": "{skill}　技能等级 {level}　适性 {apt_sign}{apt}"
    },
    {
      "id": "skill.tile.error.cannot_train",
      "context": "尝试训练当前不可训练技能时的提示。",
      "source": "SkillRegion::handle_mouse",
      "params": {},
      "en": "You cannot train this skill.",
      "zh": "目前无法训练这项技能。"
    },
    {
      "id": "skill.tile.error.distributed",
      "context": "分布式训练变异禁止调整分配时的提示。",
      "source": "SkillRegion::handle_mouse",
      "params": {},
      "en": "You can't change your training allocations!",
      "zh": "你无法更改技能训练分配！"
    },
    {
      "id": "skill.tile.error.maxed",
      "context": "尝试切换已达到最高等级技能时的提示。",
      "source": "SkillRegion::handle_mouse",
      "params": {},
      "en": "There's no point to toggling this skill anymore.",
      "zh": "继续切换这项技能已没有意义。"
    },
    {
