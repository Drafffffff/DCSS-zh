    {"monster.special.royal_jelly.damage", "It will release varied jellies when damaged or killed, with the number of jellies proportional to the amount of damage.\n", "它受伤或死亡时会释放各种果冻怪，释放的数量与所受伤害成正比。\n", ""},
    {"monster.special.royal_jelly.polymorph", "It will release all of its jellies when polymorphed.\n", "它被变形时会释放所有果冻怪。\n", ""},
    {"monster.special.see_invisible", "{subject} can see invisible.\n", "{subject}能看见隐形生物。\n", "subject:name"},
    {"monster.special.shadowghast.plural", "{subject} cover ground more quickly when invisible.\n", "{subject}隐形时移动得更快。\n", "subject:name"},
    {"monster.special.shadowghast.singular", "{subject} covers ground more quickly when invisible.\n", "{subject}隐形时移动得更快。\n", "subject:name"},
