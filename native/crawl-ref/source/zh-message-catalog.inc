    {"speech.monspeak.8a55507d282fddd2", "{the_monster_1} {shouts_1} {at_foe_1}, \"Die, {orc_heathen_1}!\"", "{the_monster_1}{shouts_1} {at_foe_1}：“死吧，{orc_heathen_1}！”", "the_monster_1:name;shouts_1:text;at_foe_1:text;orc_heathen_1:text"},
    {"speech.monspeak.8a907f357f3dead8", "{the_monster_1} says, \"If I give you my weapon, will you leave me alone\?\"", "{the_monster_1}说：“我把武器给你，你就不烦我了吗？”", "the_monster_1:name"},
    {"speech.monspeak.8a947fa5a3b7f04e", "{the_monster_1} sighs, \"Dead already\? I want a refund.\"", "{the_monster_1}叹息道：“这就死了？我要退款。”", "the_monster_1:name"},
    {"speech.monspeak.8aa66504a7095502", "{the_monster_1} laughs in a distinctly smug fashion.", "{the_monster_1}得意洋洋地大笑起来。", "the_monster_1:name"},
    {"speech.monspeak.8aaea63ffd109455", "{the_monster_1} says, \"I hate it when jellies take over a level.\"", "{the_monster_1}说：“我讨厌胶冻占满一整层。”", "the_monster_1:name"},
    {"speech.monspeak.8ac60b01ed3e0f73", "{channel_1}{the_monster_1} splatters into many small globs of multi-coloured light, then recombines.", "{channel_1}{the_monster_1}炸裂成许多多彩的小光团，随后又聚合起来。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.8acd0376b32e29da", "{the_monster_1} laughs insanely.", "{the_monster_1}疯狂地大笑。", "the_monster_1:name"},
