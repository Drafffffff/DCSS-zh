    {"speech.monspeak.145b24913db5f093", "{boris_timeout_1}", "{boris_timeout_1}", "boris_timeout_1:text"},
    {"speech.monspeak.1473b8e95338867c", "{the_monster_1} says, \"Her death will not be in vain!\"", "{the_monster_1}说：“她的死不会白费！”", "the_monster_1:name"},
    {"speech.monspeak.1480fb2f0795238a", "{channel_1}{the_monster_1} fiddles with {possessive_1} portable altar.", "{channel_1}{the_monster_1}摆弄着{possessive_1}便携祭坛。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.1490acc7e7f35848", "{the_monster_1} says, \"I bet the Orb isn't even all that great.\"", "{the_monster_1}说：“我打赌宝珠根本没多厉害。”", "the_monster_1:name"},
