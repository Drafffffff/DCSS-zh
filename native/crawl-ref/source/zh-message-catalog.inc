    {"speech.monspeak.916ad1c4ac311105", "{the_monster_1} lets loose a series of foul curses in Beogh's name.", "{the_monster_1}以比欧弗之名一连串地骂起了粗话。", "the_monster_1:name"},
    {"speech.monspeak.916dd7ef8b0cee5f", "{channel_1}{the_monster_1} shines with the incandescence of long-dead nights.", "{channel_1}{the_monster_1}闪耀着早已死去的夜晚的光辉。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.917f3431988df0aa", "{the_monster_1} says {to_foe_1}, \"Everything is water in the end.\"", "{the_monster_1}说 {to_foe_1}：“一切最终都是水。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.9180ec451b522da1", "{the_monster_1} says, \"Feeling sleepy\?\"", "{the_monster_1}说：“困了吗？”", "the_monster_1:name"},
    {"speech.monspeak.918a1beee929f086", "{channel_1}{the_monster_1} twirls {possessive_1} moustache.", "{channel_1}{the_monster_1}捻着{possessive_1}小胡子。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.91a9de25ba90a346", "{the_monster_1} ponders what role {player_genus_plural_1} play in the local ecosystem.", "{the_monster_1}思索着{player_genus_plural_1}在本地生态系统中扮演什么角色。", "the_monster_1:name;player_genus_plural_1:name"},
    {"speech.monspeak.91b9237141433225", "{the_monster_1} says, \"Hit me lik' ye mean it, ye dafty glaikit!\"", "{the_monster_1}说：“用点力气打俺，你这蠢货！”", "the_monster_1:name"},
    {"speech.monspeak.91c2d6120bbdd047", "{crazy_yiuf_wordlist1_1}! {crazy_yiuf_wordlist1_2} {crazy_yiuf_wordlist2_1} {crazy_yiuf_wordlist2_2}.", "{crazy_yiuf_wordlist1_1}！{crazy_yiuf_wordlist1_2} {crazy_yiuf_wordlist2_1} {crazy_yiuf_wordlist2_2}。", "crazy_yiuf_wordlist1_1:text;crazy_yiuf_wordlist1_2:text;crazy_yiuf_wordlist2_1:text;crazy_yiuf_wordlist2_2:text"},
    {"speech.monspeak.91cb0ef7305719a6", "{channel_1}{the_monster_1} glances furtively about.", "{channel_1}{the_monster_1}鬼鬼祟祟地四下张望。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.91d9791050fef1a9", "{the_monster_1} laughs.", "{the_monster_1}大笑。", "the_monster_1:name"},
    {"speech.monspeak.91e23a3473c9a196", "{channel_1}{the_monster_1} cries in horror.", "{channel_1}{the_monster_1}惊恐地哭喊。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.9216ec8307128fac", "{high_priest_1}", "{high_priest_1}", "high_priest_1:text"},
    {"speech.monspeak.92567d0e8429caec", "{the_monster_1} draws the Illusion. \"I have a twin now!\"", "{the_monster_1}抽到了幻象。“我现在有个双胞胎了！”", "the_monster_1:name"},
    {"speech.monspeak.9273f7e44d2eef22", "{channel_1}{the_monster_1} crackles and sizzles.", "{channel_1}{the_monster_1}噼啪作响，发出嘶嘶声。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.9282ec06feff0a6c", "{the_monster_1} says {to_foe_1}, \"Let's make it quick, okay\? I've got mouths to feed.\"", "{the_monster_1}说 {to_foe_1}：“咱们速战速决，行吗？我还有几张嘴要喂。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.928a4dfb97e1175a", "{the_monster_1} says, \"I hate this place.\"", "{the_monster_1}说：“我讨厌这个地方。”", "the_monster_1:name"},
    {"speech.monspeak.9299df84dfb8bc98", "{the_monster_1} says, \"I think I'm starting to get a cough. I hate that.\"", "{the_monster_1}说：“我觉得我开始咳嗽了。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.92a02f0d20dd633f", "{the_monster_1} mumbles about the follies of mortal constellations.", "{the_monster_1}嘟囔着凡俗星座的种种荒唐。", "the_monster_1:name"},
    {"speech.monspeak.92a5719728085c2f", "screams", "尖叫道", ""},
    {"speech.monspeak.92ead39641591840", "Spike", "大钉", ""},
    {"speech.monspeak.92f66b9ec127eebe", "{the_monster_1} says, \"I enjoy death. I like the smell. I like the greasy feel of cooling blood.\"", "{the_monster_1}说：“我享受死亡。我喜欢那气味。我喜欢冷却的血那油腻的触感。”", "the_monster_1:name"},
    {"speech.monspeak.930d12f54088bb9f", "{wizard_1}", "{wizard_1}", "wizard_1:text"},
    {"speech.monspeak.93168952186112b1", "{the_monster_1} says, \"Careful; you might trip over your own shadow.\"", "{the_monster_1}说：“小心点；你可能会被自己的影子绊倒。”", "the_monster_1:name"},
    {"speech.monspeak.93199a3dd3292f82", "{the_monster_1} says, \"Spare some coin\?\"", "{the_monster_1}说：“给点钱吧？”", "the_monster_1:name"},
    {"speech.monspeak.932137b4006dcb6f", "{the_monster_1} says {to_foe_1}, \"I don't need an army to kill you!\"", "{the_monster_1}说 {to_foe_1}：“我不需要军队也能杀了你！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.93280ebece7d4d97", "{channel_1}The earth trembles for a moment.", "{channel_1}大地颤动了一阵。", "channel_1:key"},
    {"speech.monspeak.9336c754763cd041", "the grave", "坟墓", ""},
    {"speech.monspeak.933f74d68c8c682a", "nice plot of land", "一块上好的土地", ""},
    {"speech.monspeak.93755e0b0842aa03", "{the_monster_1} scoffs, \"How can you challenge a perfect, immortal machine\?\"", "{the_monster_1}嗤笑道：“你凭什么挑战一台完美而不朽的机器？”", "the_monster_1:name"},
    {"speech.monspeak.939a026dbabcce78", "{the_monster_1} says, \"At least this place doesn't smell as bad as the Swamp.\"", "{the_monster_1}说：“至少这里没有沼泽那么难闻。”", "the_monster_1:name"},
    {"speech.monspeak.93aa99b886ca422a", "{channel_1}{the_monster_1} picks up a beetle and eats it.", "{channel_1}{the_monster_1}捡起一只甲虫吃了下去。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.93af46425ff6e898", "{the_monster_1} shouts {at_foe_1}, \"You are a ghastly nuisance!\"", "{the_monster_1}喊道 {at_foe_1}：“你真是讨厌至极！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.93b3dacbeaa94209", "{the_monster_1} says {to_foe_1}, \"It's nothing personal.\"", "{the_monster_1}说 {to_foe_1}：“这不是私人恩怨。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.93ce75a5ef2cd021", "sizzlefizz", "嘶嘶嘶", ""},
    {"speech.monspeak.93d64bb6019512d2", "{the_monster_1} says, \"I wanna be an adventurer, not a preacher!\"", "{the_monster_1}说：“我想当冒险者，不想当传教士！”", "the_monster_1:name"},
    {"speech.monspeak.93f4b45f40cd71b6", "{the_monster_1} {norris_verb_1} {to_foe_1}, \"Catch the small wave before chasing the big one.\"", "{the_monster_1}{norris_verb_1} {to_foe_1}：“在追大浪之前，先接住小浪。”", "the_monster_1:name;norris_verb_1:text;to_foe_1:text"},
    {"speech.monspeak.94081747a6f3405f", "{the_monster_1} {says_or_shouts_1}, \"Our fallen brethren won't be forgotten.\"", "{the_monster_1}{says_or_shouts_1}：“我们倒下的同胞不会被遗忘。”", "the_monster_1:name;says_or_shouts_1:text"},
    {"speech.monspeak.940a3cae046406f2", "the sacred Law of Zin.", "辛的神圣法则", ""},
    {"speech.monspeak.943d173197510c81", "{the_monster_1} says {to_foe_1}, \"Come closer, little fly.\"", "{the_monster_1}说 {to_foe_1}：“再靠近些，小苍蝇。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.94650db4fec986a0", "{the_monster_1} mutters, \"Who needs spells, anyway\?\"", "{the_monster_1}咕哝道：“谁需要法术啊？”", "the_monster_1:name"},
    {"speech.monspeak.94817dae7d464e04", "{the_monster_1} says, \"I saw a dragon earlier, but I didn't get too close - it seemed pretty mercurial.\"", "{the_monster_1}说：“我刚才看到一条龙，但我没敢靠太近——它看起来挺反复无常的。”", "the_monster_1:name"},
    {"speech.monspeak.94c9d04153a9c594", "Junior", "小仔", ""},
    {"speech.monspeak.94d8131846f16326", "{the_monster_1} says, \"I'd like to see a scythe do that!\"", "{the_monster_1}说：“我倒想看看镰刀能不能做到这个！”", "the_monster_1:name"},
    {"speech.monspeak.94da892fcc056ab0", "the Curse", "诅咒", ""},
    {"speech.monspeak.94e71d8fb40225d0", "tired", "疲惫", ""},
    {"speech.monspeak.94f206ede80a4702", "{the_monster_1} {grum_verb_1} {at_foe_1}, \"I don't need to eat anymore, but I'll make an exception for you.\"", "{the_monster_1} {grum_verb_1} {at_foe_1}：“我不用再吃东西了，但我会为你破个例。”", "the_monster_1:name;grum_verb_1:text;at_foe_1:text"},
    {"speech.monspeak.950a499cf59cb9e6", "{the_monster_1} roars {at_foe_1}, \"I HATE BEING BOTHERED!\"", "{the_monster_1}咆哮道 {at_foe_1}：“我最讨厌被打扰！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.95224c0b09a6d5cb", "{the_monster_1} screams, \"The pain, the pain!\"", "{the_monster_1}尖叫道：“好疼，好疼！”", "the_monster_1:name"},
    {"speech.monspeak.95493b25776647d8", "{the_monster_1} shouts, \"{player_genus_plural_1} are the best!\"", "{the_monster_1}喊道：“{player_genus_plural_1}是最棒的！”", "the_monster_1:name;player_genus_plural_1:name"},
    {"speech.monspeak.955563ed6e49d0b7", "{nellie_common_1}", "{nellie_common_1}", "nellie_common_1:text"},
    {"speech.monspeak.955875507f13b153", "{the_monster_1} asks, \"Why won't you be my friend\?\"", "{the_monster_1}问：“你为什么不肯做我的朋友？”", "the_monster_1:name"},
    {"speech.monspeak.95688a3e56ec893c", "{the_monster_1} says, \"You can only wear one cloak at a time, you know\?\"", "{the_monster_1}说：“你知道斗篷一次只能披一件吧？”", "the_monster_1:name"},
    {"speech.monspeak.9580833f2abe7fe2", "{eustachio_rare_1}", "{eustachio_rare_1}", "eustachio_rare_1:text"},
    {"speech.monspeak.958871f907a6f8ce", "{the_monster_1} starts to cry.", "{the_monster_1}开始哭泣。", "the_monster_1:name"},
    {"speech.monspeak.959be2a571864b3a", "{the_monster_1} says, \"What kind of name is 'Xom', anyway\?\"", "{the_monster_1}说：“‘佐姆’这算哪门子名字？”", "the_monster_1:name"},
    {"speech.monspeak.95e4aaa090c17ba3", "{channel_1}{the_monster_1} looks around nervously.", "{channel_1}{the_monster_1}紧张地四下张望。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.95f937dc8ebc3875", "{the_monster_1} shouts {at_foe_1}, \"Surrender and die!\"", "{the_monster_1}喊道 {at_foe_1}：“投降吧，受死吧！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.95fd07de080229cf", "{channel_1}{the_monster_1} spins like a top.", "{channel_1}{the_monster_1}像陀螺一样旋转。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.961669d580406968", "Suddenly {the_monster_possessive_1} spirit rises from {possessive_1} lifeless body.", "突然，{the_monster_possessive_1}灵魂从{possessive_1}毫无生气的躯体中升起。", "the_monster_possessive_1:name;possessive_1:text"},
    {"speech.monspeak.96225d85148fb8b1", "{the_monster_1} says, \"I keep my friends close, but my enemies closer.\"", "{the_monster_1}说：“我让朋友留在身边，让敌人贴得更近。”", "the_monster_1:name"},
    {"speech.monspeak.96325a1f5704103d", "{channel_1}{the_monster_1} smiles happily.", "{channel_1}{the_monster_1}开心地微笑着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.9639026d5143dda5", "{the_monster_1} screams {at_foe_1}, \"I put up a 'Do Not Disturb' sign! Can't you read\?!\"", "{the_monster_1}尖叫道 {at_foe_1}：“我挂了‘请勿打扰’的牌子！你不识字吗？！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.9655dfa6c9f17c26", "{channel_1}{the_monster_1} yawns in an exaggerated manner.", "{channel_1}{the_monster_1}夸张地打了个哈欠。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.96857b449d8cdd13", "{the_monster_1} says {to_foe_1}, \"I shall smite you and smash you.\"", "{the_monster_1}说 {to_foe_1}：“我要将你击倒，把你碾碎。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.968f1fcd52775b7c", "{the_monster_1} asks {foe_1}, \"Where did this trident come from\? Is it yours\?\"", "{the_monster_1}问{foe_1}：“这把三叉戟是从哪儿来的？是你的吗？”", "the_monster_1:name;foe_1:text"},
    {"speech.monspeak.96923d9de3e1a721", "{the_monster_1} sneers {at_foe_1}, \"Where's your god now\?\"", "{the_monster_1}冷笑道 {at_foe_1}：“你的神现在在哪儿呢？”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.9692c511cf7c3e5b", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.96a925badbae00d9", "You hear a distant scream of rage.", "你听到远方传来愤怒的尖叫。", ""},
    {"speech.monspeak.96c2efe7e8876eb2", "voivode", "总督", ""},
    {"speech.monspeak.96d22d29ea36fc7b", "{the_monster_1} says, \"I just want to get paid!\"", "{the_monster_1}说：“我只想拿到工钱！”", "the_monster_1:name"},
    {"speech.monspeak.96d38c554aab429c", "{amaemon_rare_1}", "{amaemon_rare_1}", "amaemon_rare_1:text"},
    {"speech.monspeak.970c0121da2621e6", "{channel_1}{the_monster_1} pokes out {possessive_1} tongue.", "{channel_1}{the_monster_1}吐出{possessive_1}舌头。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.970f32a01010ce88", "{the_monster_1} screams {at_foe_1}, \"Look beyond the surface! Nothing is what it seems!\"", "{the_monster_1}尖叫 {at_foe_1}：“看穿表象！没有什么是看上去那样的！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.971b5e6f1b175405", "{the_monster_1} says, \"What do naga need barding for\?\"", "{the_monster_1}说：“纳迦要马甲做什么用？”", "the_monster_1:name"},
    {"speech.monspeak.9729dd6834d88784", "{the_monster_1} screams {at_foe_1}, \"I'm goin' to kill you! Now!\"", "{the_monster_1}尖叫道 {at_foe_1}：“我要宰了你！就现在！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.973d2e2c694aa483", "{generic_orc_speech_1}", "{generic_orc_speech_1}", "generic_orc_speech_1:text"},
    {"speech.monspeak.97466d2b368ddb59", "{channel_1}{the_monster_1} stares at {foe_1} while slowly dragging a finger across {possessive_1} throat.", "{channel_1}{the_monster_1}一边盯着{foe_1}，一边用手指慢慢划过{possessive_1}喉咙。", "channel_1:key;the_monster_1:name;foe_1:text;possessive_1:text"},
    {"speech.monspeak.974b7617cec3524d", "{channel_1}{the_monster_1} looks {choice_1}.", "{channel_1}{the_monster_1}看起来{choice_1}。", "channel_1:key;the_monster_1:name;choice_1:text"},
    {"speech.monspeak.974b7617cec3524d.choice_1.alt_0", "rattled", "很不安", ""},
    {"speech.monspeak.974b7617cec3524d.choice_1.alt_1", "scared stiff", "吓呆了", ""},
    {"speech.monspeak.974b7617cec3524d.choice_1.alt_2", "petrified", "吓僵了", ""},
    {"speech.monspeak.974e0ac99501784d", "{erica_rare_1}", "{erica_rare_1}", "erica_rare_1:text"},
    {"speech.monspeak.975f125599ac1798", "{saint_roka_generic_1}", "{saint_roka_generic_1}", "saint_roka_generic_1:text"},
    {"speech.monspeak.97866a2f22356441", "{the_monster_1} {yells_1}, \"I'm getting too old for this!\"", "{the_monster_1}{yells_1}：“我这把年纪可受不了这个了！”", "the_monster_1:name;yells_1:text"},
    {"speech.monspeak.9795984cb9a476c5", "{the_monster_1} stares {at_foe_1} intently and {grum_verb_1}.", "{the_monster_1}紧盯着 {at_foe_1}，{grum_verb_1}。", "the_monster_1:name;at_foe_1:text;grum_verb_1:text"},
    {"speech.monspeak.9796dd14b8aad27e", "{the_monster_1} says, \"One of the priests looked like she was going to ask me to join... I guess she changed her mind.\"", "{the_monster_1}说：“有个女祭司看起来像要拉我入教……我猜她改主意了。”", "the_monster_1:name"},
    {"speech.monspeak.97d073361f7bc4bf", "{the_monster_1} says {to_foe_1}, \"Now you've reached the end of your journey.\"", "{the_monster_1}说 {to_foe_1}：“你已经走到旅程的尽头了。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.97dffef9c4f4b454", "{the_monster_1} shouts {at_foe_1}, \"Taste the thunder!\"", "{the_monster_1}喊道 {at_foe_1}：“尝尝雷霆的滋味！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.97f8ee040442cc28", "a winter without end", "一个没有尽头的冬天", ""},
    {"speech.monspeak.981ea51d6f633e7e", "{the_monster_1} says, \"A flail is better than a scythe, any day of the week!\"", "{the_monster_1}说：“连枷比镰刀强，一周里随便哪天都是！”", "the_monster_1:name"},
    {"speech.monspeak.9837ad698f4af3f6", "{channel_1}{the_monster_1} frowns.", "{channel_1}{the_monster_1}皱起眉头。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.9843686ad8690c91", "{harold_rare_1}", "{harold_rare_1}", "harold_rare_1:text"},
    {"speech.monspeak.986dec40da58d931", "{the_monster_1} says {to_foe_1}, \"My weaknesses are his strengths!\"", "{the_monster_1}说 {to_foe_1}：“我的弱点正是他的强项！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.9874b8c67d76dd45", "{the_monster_1} says, \"This place is the Pits.\"", "{the_monster_1}说：“这地方就是个大坑。”", "the_monster_1:name"},
    {"speech.monspeak.987506c81db9c077", "{the_monster_1} breathes a few words.\n{channel_1}{the_monster_possessive_1} hands start flickering wildly.", "{the_monster_1}低声说了几个词。\n{channel_1}{the_monster_possessive_1}双手开始剧烈地忽隐忽现。", "the_monster_1:name;channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.987fb8126e42d610", "{maurice_rare_1}", "{maurice_rare_1}", "maurice_rare_1:text"},
    {"speech.monspeak.988cf2ad0970a400", "{channel_1}{the_monster_1} rolls in a circle.", "{channel_1}{the_monster_1}转了个圈。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.98c24099409f5c5a", "{the_monster_1} screams {at_foe_1}, \"What are you like inside\? I'll break you open and find out!\"", "{the_monster_1}尖叫 {at_foe_1}：“你里面是什么样子？我要把你剖开来看看！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.98db19a610f07e07", "{the_monster_1} says, \"Uh-oh! Wait. OK.\"", "{the_monster_1}说：“哎呀！等等。好吧。”", "the_monster_1:name"},
    {"speech.monspeak.98f18298ae877e68", "{the_monster_1} says {to_foe_1}, \"I'm happy to see you. And I'll be happy to kill you.\"", "{the_monster_1}说 {to_foe_1}：“见到你我很高兴。而且我会很乐意杀了你。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.9912ebeae60d4738", "{the_monster_1} says, \"Even the Abyss couldn't kill me! What makes you think you can\?\"", "{the_monster_1}说：“连深渊都杀不死我！你凭什么以为你能？”", "the_monster_1:name"},
    {"speech.monspeak.991a2b63a30cfcbe", "{the_monster_1} says, \"No facts are to me sacred; none are profane; I simply experiment, an endless seeker, with no past at my back.\"", "{the_monster_1}说：“对我来说没有神圣的事实，也没有亵渎的事实；我只是不断实验，一个无止境的求索者，身后不留过去。”", "the_monster_1:name"},
    {"speech.monspeak.991aba9a8bd1f844", "down", "向下", ""},
    {"speech.monspeak.991ce1dbf81d8e2f", "chair", "椅子", ""},
    {"speech.monspeak.992fb1b43a866b00", "{the_monster_1} says, \"Why would you have your front door in a mine\? Stupid.\"", "{the_monster_1}说：“为什么把前门开在矿井里？真蠢。”", "the_monster_1:name"},
    {"speech.monspeak.9933eeb4e2a1b6e3", "{channel_1}{the_monster_1} clenches {possessive_1} teeth.", "{channel_1}{the_monster_1}咬紧{possessive_1}牙。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.9956a9e2f70563ae", "{the_monster_1} whispers, \"Once I find the ORB, I'll be cured. I'll be normal again!\"", "{the_monster_1}低声说：“等我找到宝珠，我就能痊愈了。我就能变回正常了！”", "the_monster_1:name"},
    {"speech.monspeak.99593298cddda3e5", "{the_monster_1} says, \"My army is invincible!\"", "{the_monster_1}说：“我的军队不可战胜！”", "the_monster_1:name"},
    {"speech.monspeak.995b8b444c3c2898", "Trifle", "琐事", ""},
    {"speech.monspeak.9981674c440f660f", "{the_monster_1} says {to_foe_1}, \"All warfare is based on deception.\"", "{the_monster_1}说 {to_foe_1}：“一切战争都以诡诈为本。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.999334d13edf1869", "{the_monster_1} says, \"I follow the Polar star.\"", "{the_monster_1}说：“我追随北极星。”", "the_monster_1:name"},
    {"speech.monspeak.9998a0b76d29e231", "{the_monster_1} says, \"I burned twice as bright, and look where it got me...\"", "{the_monster_1}说：“我燃烧得比谁都要亮，看看这把我带到了何处……”", "the_monster_1:name"},
    {"speech.monspeak.99a81b2aad8a77de", "{the_monster_1} grumbles, \"Damn that jealous turtle monk.\"", "{the_monster_1}嘟囔道：“那只爱嫉妒的龟和尚，真该死。”", "the_monster_1:name"},
    {"speech.monspeak.99afa9fcd6dc1d81", "{the_monster_1} sighs, \"Your brethren were only holding you back, {player_genus_1}.\"", "{the_monster_1}叹息道：“你的同族只是在拖你的后腿，{player_genus_1}。”", "the_monster_1:name;player_genus_1:name"},
    {"speech.monspeak.99b0d7743f021009", "{the_monster_1} says, \"Show me proof of your conquests, and I will call you a great adventurer.\" {player_only_1}", "{the_monster_1}说：“拿出你征服的战利品给我看，我就称你为伟大的冒险者。”{player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.99be337418fb7b79", "{channel_1}{the_monster_possessive_1} eyes start glowing with a red light.", "{channel_1}{the_monster_possessive_1}眼睛开始发出红光。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.99fe82040d70828b", "{channel_1}{the_monster_1} twirls gently on the spot.", "{channel_1}{the_monster_1}原地轻轻地转着圈。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.9a0d78a67201c449", "{channel_1}{the_monster_1} smiles kindly.", "{channel_1}{the_monster_1}亲切地微笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.9a1399072b8f3ad2", "{channel_1}{the_monster_1} seems to say something.", "{channel_1}{the_monster_1}似乎说了些什么。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.9a17b6bdcf582ade", "{channel_1}{the_monster_1} furiously gestures all around.", "{channel_1}{the_monster_1}狂怒地朝四面八方打着手势。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.9a1e63d5a8e6b9e9", "{the_monster_1} mumbles the words to a spell, but in the wrong order.", "{the_monster_1}喃喃念着一段咒语，但词序错了。", "the_monster_1:name"},
    {"speech.monspeak.9a295ccd52990047", "{the_monster_1} says, \"I'd like to make these snakes into gloves, but I hate gloves.\"", "{the_monster_1}说：“我倒是想把这些蛇做成手套，可我讨厌手套。”", "the_monster_1:name"},
    {"speech.monspeak.9a3114ef10b781a7", "{the_monster_1} praises {possessive_god_1}.", "{the_monster_1}赞美{possessive_god_1}。", "the_monster_1:name;possessive_god_1:name"},
    {"speech.monspeak.9a41e5597f4446ce", "{the_monster_1} mutters, \"Such pretty colours everywhere...\"", "{the_monster_1}咕哝道：“到处都是这么漂亮的颜色……”", "the_monster_1:name"},
    {"speech.monspeak.9a451bda0196b130", "{the_monster_1} says, \"What's all in the cards\? Your future\?\"", "{the_monster_1}说：“牌里都写着什么？你的未来？”", "the_monster_1:name"},
    {"speech.monspeak.9a49a205ad17ab86", "{the_monster_1} screams {at_foe_1}, \"Wand still stronger! You very nasty!\"", "{the_monster_1}尖叫 {at_foe_1}：“魔杖还是更厉害！你太坏了！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.9a4f0ba873e9b1a4", "{the_monster_1} chants, \"I shall fear no evil, for {player_name_1} is my saviour.\"", "{the_monster_1}吟唱道：“我必不惧怕邪恶，因为{player_name_1}是我的救主。”", "the_monster_1:name;player_name_1:name"},
    {"speech.monspeak.9a57cfac498e9482", "{the_monster_1} says, \"The earth shall destroy you!\"", "{the_monster_1}说：“大地将毁灭你！”", "the_monster_1:name"},
    {"speech.monspeak.9a6f5188f589983c", "the Shining One", "光明神", ""},
    {"speech.monspeak.9a7cf648fee1b7f1", "{the_monster_1} shouts {at_foe_1}, \"It's the end of the party!\"", "{the_monster_1}喊道 {at_foe_1}：“派对到此结束了！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.9a93ef5eac65f6f6", "{channel_1}{the_monster_1} grins, showing sharp teeth.", "{channel_1}{the_monster_1}咧嘴一笑，露出锋利的牙齿。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.9a9f1ab1fdd2033f", "{channel_1}Suppurating sores blossom under {the_monster_possessive_1} eyelids.", "{channel_1}{the_monster_possessive_1}眼睑下绽出流脓的疮口。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.9ac81aff301f432f", "mumbles", "嘟囔道", ""},
    {"speech.monspeak.9b3097c79b75e7b3", "{the_monster_1} cries, \"Don't forget your friends!\"", "{the_monster_1}哭喊道：“别忘记你的朋友！”", "the_monster_1:name"},
    {"speech.monspeak.9b3f153235369440", "{the_monster_1} whispers {to_foe_1}, \"Not even holy moly will save you.\"", "{the_monster_1}低声说 {to_foe_1}：“就算是神圣的魔草也救不了你。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.9b4e86b22dc6d4d1", "{channel_1}{the_monster_1} lashes his vines and gnashes his teeth.", "{channel_1}{the_monster_1}甩动藤蔓，磨着牙齿。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.9b5a7b23ba674c7e", "{the_monster_1} says, \"Mostly I couldn't keep them alive.\"", "{the_monster_1}说：“大多数我都养不活。”", "the_monster_1:name"},
    {"speech.monspeak.9ba76e0f2a42b4db", "{the_monster_1} mumbles, \"Took all my skin, all gone, all gone...\"", "{the_monster_1}喃喃道：“把我的皮全拿走了，都没了，都没了……”", "the_monster_1:name"},
    {"speech.monspeak.9ba8cc8bcae8c811", "{the_monster_1} screams {at_foe_1}, \"No nasty magic on me!\"", "{the_monster_1}尖叫 {at_foe_1}：“别对俺使那种邪门魔法！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.9bb56a60cd16a7a6", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.9bb7f9d0eb92a990", "{the_monster_1} howls, \"Why can't I wake up\?\"", "{the_monster_1}嚎叫道：“我为什么醒不过来？”", "the_monster_1:name"},
    {"speech.monspeak.9bd31380c1828410", "{the_monster_1} surrenders.", "{the_monster_1}投降了。", "the_monster_1:name"},
    {"speech.monspeak.9be945005b60c475", "{the_monster_1} says, \"I've come back once... I'll do it again!\"", "{the_monster_1}说：“我已经回来过一次了……我还会再回来的！”", "the_monster_1:name"},
    {"speech.monspeak.9c0fab5483500644", "{the_monster_1} \"Baaaas\" balefully.", "{the_monster_1}凶巴巴地“咩咩”叫着。", "the_monster_1:name"},
    {"speech.monspeak.9c1e8900add32019", "{wizard_common_spell_1}\n{fake_spell_effect_1}", "{wizard_common_spell_1}\n{fake_spell_effect_1}", "wizard_common_spell_1:text;fake_spell_effect_1:text"},
    {"speech.monspeak.9c29b706928fa3b6", "{the_monster_1} says, \"Messiah\? I hate messiahs.\"", "{the_monster_1}说：“弥赛亚？我讨厌弥赛亚。”", "the_monster_1:name"},
    {"speech.monspeak.9c35b85b2e3df100", "{the_monster_1} says {to_foe_1}, \"Fear not. I will immortalise you in the tale of my first kill.\"", "{the_monster_1}说 {to_foe_1}：“别怕。我会让你在我的第一次杀戮故事里永垂不朽。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.9c41271f0fe04d77", "{the_monster_1} says, \"Time to retire.\"", "{the_monster_1}说：“该退休了。”", "the_monster_1:name"},
    {"speech.monspeak.9c4d67d7c171cff3", "{channel_1}{the_monster_1} runs a finger over {possessive_1} scar.", "{channel_1}{the_monster_1}用手指抚过{possessive_1}伤疤。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.9c5552ac6d879fd2", "{the_monster_1} {grum_verb_1} {at_foe_1}, \"I'll hound you night and day!\"", "{the_monster_1} {grum_verb_1} {at_foe_1}：“我会日夜追猎你！”", "the_monster_1:name;grum_verb_1:text;at_foe_1:text"},
    {"speech.monspeak.9c6132bf3d2bef31", "{the_monster_1} {says_1} {to_foe_1}, \"{demon_taunt_1}\"", "{the_monster_1} {says_1} {to_foe_1}：“{demon_taunt_1}”", "the_monster_1:name;says_1:text;to_foe_1:text;demon_taunt_1:text"},
    {"speech.monspeak.9c6af69e2031b08b", "{channel_1}{the_monster_1} wobbles in {possessive_1} flight.", "{channel_1}{the_monster_1}在{possessive_1}飞行中摇摇晃晃。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.9c7d5d5530fbe561", "{the_monster_1} says, \"There's a spark of magic in your eyes.\"", "{the_monster_1}说：“你眼中有魔法的火花。”", "the_monster_1:name"},
    {"speech.monspeak.9c7ff1aeb1a04fe5", "rivers of blight", "枯萎之河", ""},
    {"speech.monspeak.9c811a40e9cbeba9", "{the_monster_1} says, \"A turtle bit me. I hate turtles.\"", "{the_monster_1}说：“一只海龟咬了我。我讨厌海龟。”", "the_monster_1:name"},
    {"speech.monspeak.9c99880d61b3dfe4", "{the_monster_1} cracks {possessive_1} whip.", "{the_monster_1}甩响{possessive_1}鞭子。", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.9cba4bb3c52fd859", "the weight of a mountain atop us", "压在我们身上的山岳之重", ""},
    {"speech.monspeak.9d006bdc42f945b4", "{the_monster_1} says, \"What was that\? Sorry, I couldn't hear you over all this noise.\"", "{the_monster_1}说：“你说什么？抱歉，这动静太大，我听不见。”", "the_monster_1:name"},
    {"speech.monspeak.9d0c364c18cd3f23", "{channel_1}{the_monster_1} runs around in a circle.", "{channel_1}{the_monster_1}绕圈奔跑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.9d25b66743a9495e", "{agnes_common_1}", "{agnes_common_1}", "agnes_common_1:text"},
    {"speech.monspeak.9d3dad20165babb0", "{the_monster_1} shouts {at_foe_1}, \"Give me your head, so I can impale it on a pike!\"", "{the_monster_1}喊道 {at_foe_1}：“把你的头给我，我好把它插在长矛上！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.9d5c580e4e28dbab", "{channel_1}{the_monster_1} gestures wildly.", "{channel_1}{the_monster_1}疯狂地打着手势。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.9d664d18ace3bef1", "{the_monster_1} says, \"I hate atheists.\"", "{the_monster_1}说：“我讨厌无神论者。”", "the_monster_1:name"},
    {"speech.monspeak.9d75a08c86b383a5", "{the_monster_1} exclaims, \"Oh yes! We are going to have fun!\"", "{the_monster_1}大声说道：“哦，太好了！我们会玩得很开心的！”", "the_monster_1:name"},
    {"speech.monspeak.9d77663a83c39d3f", "{the_monster_1} says {to_foe_1}, \"You can never win.\"", "{the_monster_1}说 {to_foe_1}：“你永远也赢不了。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.9d7c59ad92e0c657", "{the_monster_1} says, \"I need scissors! I think I chipped a nail somewhere...\"", "{the_monster_1}说：“我需要剪刀！我好像在哪里崩坏了一片指甲……”", "the_monster_1:name"},
    {"speech.monspeak.9d939ec6dc27010b", "{the_monster_1} says, \"You'll freeze in Cocytus!\" {player_only_1}", "{the_monster_1}说：“你会在悲叹河里冻成冰！” {player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.9d9682b196523d5a", "{asterion_rare_1}", "{asterion_rare_1}", "asterion_rare_1:text"},
    {"speech.monspeak.9db959a1d5463e70", "{the_monster_1} says, \"It's like an all you can read... something.\"", "{the_monster_1}说：“就像随便读……随便什么的。”", "the_monster_1:name"},
    {"speech.monspeak.9dd27697c8f0a092", "{the_monster_1} says, \"I think I died... I think I'm dead...\"", "{the_monster_1}说：“我想我死了……我想我已经死了……”", "the_monster_1:name"},
    {"speech.monspeak.9dde330523ca13b8", "{the_monster_1} whispers, \"Everlasting silence awaits you...\"", "{the_monster_1}低声说：“永恒的寂静在等着你……”", "the_monster_1:name"},
    {"speech.monspeak.9e1d22ef12619c15", "{channel_1}{the_monster_1} pulsates ominously.", "{channel_1}{the_monster_1}不祥地脉动着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.9e2c97f065c72db2", "{the_monster_1} says, \"So, what is this Orb thing, anyway\?\"", "{the_monster_1}说：“话说回来，这个叫宝珠的东西到底是什么？”", "the_monster_1:name"},
    {"speech.monspeak.9e3a7239441f603d", "{the_monster_1} {norris_verb_1} {to_foe_1}, \"Rejoin the cosmic current!\"", "{the_monster_1}{norris_verb_1} {to_foe_1}：“重新汇入宇宙的洪流吧！”", "the_monster_1:name;norris_verb_1:text;to_foe_1:text"},
    {"speech.monspeak.9e420f3684def2ae", "{the_monster_1} {orc_says_to_foe_1}, \"Beogh doesn't tell me what to do!\"", "{the_monster_1}{orc_says_to_foe_1}：“比欧弗管不着我！”", "the_monster_1:name;orc_says_to_foe_1:text"},
    {"speech.monspeak.9e4a742ada1118ef", "{the_monster_1} says, \"Don't you get tired of all these old geezers telling you what to do\?\"", "{the_monster_1}说：“那些老家伙成天教你怎么做事，你不烦吗？”", "the_monster_1:name"},
    {"speech.monspeak.9e52d7875d568d80", "{the_monster_1} beats {possessive_1} weapon against {possessive_2} chest and roars.", "{the_monster_1}用{possessive_1}武器猛击{possessive_2}胸膛，发出怒吼。", "the_monster_1:name;possessive_1:text;possessive_2:text"},
    {"speech.monspeak.9e5a82f968563042", "{channel_1}{the_monster_1} {choice_1}, {choice_2}, and {choice_3}.", "{channel_1}{the_monster_1}{choice_1}，{choice_2}着，{choice_3}。", "channel_1:key;the_monster_1:name;choice_1:text;choice_2:text;choice_3:text"},
    {"speech.monspeak.9e5a82f968563042.choice_1.alt_0", "glitters", "闪着微光", ""},
    {"speech.monspeak.9e5a82f968563042.choice_1.alt_1", "crackles", "噼啪作响", ""},
    {"speech.monspeak.9e5a82f968563042.choice_2.alt_0", "sighs", "叹息", ""},
    {"speech.monspeak.9e5a82f968563042.choice_2.alt_1", "grumbles", "抱怨", ""},
    {"speech.monspeak.9e5a82f968563042.choice_3.alt_0", "beckons", "招手", ""},
    {"speech.monspeak.9e5a82f968563042.choice_3.alt_1", "stomps", "跺脚", ""},
    {"speech.monspeak.9e767fa033e64199", "{the_monster_1} breathes in.", "{the_monster_1}吸了一口气。", "the_monster_1:name"},
    {"speech.monspeak.9e7efb8cdc329a4d", "{says_imp_taunt_1}", "{says_imp_taunt_1}", "says_imp_taunt_1:text"},
    {"speech.monspeak.9e7f3a402901b00c", "Fluff", "绒毛", ""},
    {"speech.monspeak.9e846be37433e009", "{the_monster_1} says {to_foe_1}, \"The world, the flesh, and the devil.\"", "{the_monster_1}说 {to_foe_1}：“尘世、肉身，与魔鬼。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.9e87900ed7acb493", "{fleeing_silenced_rare_1}", "{fleeing_silenced_rare_1}", "fleeing_silenced_rare_1:text"},
    {"speech.monspeak.9e8ef61eb263f842", "says", "说", ""},
    {"speech.monspeak.9ee833a5cfb88f36", "Lady", "淑女", ""},
    {"speech.monspeak.9ef79703c5e2e076", "{channel_1}{the_monster_1} is surrounded by a shower of sparks.", "{channel_1}{the_monster_1}被一阵火花之雨环绕着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.9f15d4f8f5aee0e0", "{channel_1}{the_monster_1} gazes at {possessive_1} orb, transfixed.", "{channel_1}{the_monster_1}出神地凝视着{possessive_1}宝珠。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.9f2e231d05031ab0", "{grinder_common_1}", "{grinder_common_1}", "grinder_common_1:text"},
    {"speech.monspeak.9f305413353fd803", "{the_monster_1} says, \"You would ask such trivialities of one who has solved death itself\?\"", "{the_monster_1}说：“你竟要向一个连死亡都解开了的人问这种琐事？”", "the_monster_1:name"},
    {"speech.monspeak.9f344ac0ca7e83f8", "{the_monster_1} says {to_foe_1}, \"I'll make a rug of your skin.\"", "{the_monster_1}说 {to_foe_1}：“我要用你的皮做一张地毯。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.9f3a86843fe1b7d0", "{the_monster_1} throws up {possessive_1} hands and says, \"Alright, I admit it, I'm lost!\"", "{the_monster_1}举起{possessive_1}双手说：“好吧，我承认，我迷路了！”", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.9f3cb68ba6ed61bd", "{the_monster_1} cowers, then darts away.", "{the_monster_1}缩成一团，随即飞奔而去。", "the_monster_1:name"},
    {"speech.monspeak.9f42ae6ad2b167fb", "{the_monster_1} says, \"I considered Trog, but the aftereffects of berserk scare me.\"", "{the_monster_1}说：“我考虑过信特洛戈，但狂暴的后遗症太吓人了。”", "the_monster_1:name"},
    {"speech.monspeak.9f5d18a84e9776bb", "{channel_1}{the_monster_1} looks at {possessive_1} weapon with confusion.", "{channel_1}{the_monster_1}困惑地看着{possessive_1}武器。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.9f6f320210312aae", "{duvessa_dowan_dies_bytwin_1}", "{duvessa_dowan_dies_bytwin_1}", "duvessa_dowan_dies_bytwin_1:text"},
    {"speech.monspeak.9fb32bc9b2440009", "{the_monster_1} says, \"You know that slithering noise\? I hate that.\"", "{the_monster_1}说：“你听到那种滑行声了吗？我讨厌那个。”", "the_monster_1:name"},
    {"speech.monspeak.9fd11d27e8559ad8", "{the_monster_1} recites {axioms_of_law_1}", "{the_monster_1}背诵{axioms_of_law_1}", "the_monster_1:name;axioms_of_law_1:text"},
    {"speech.monspeak.9febe37b6cf4716e", "{the_monster_1} intones a terrible prayer.", "{the_monster_1}吟诵着一段可怕的祷文。", "the_monster_1:name"},
    {"speech.monspeak.9fece4feebdcb150", "in the woods", "林间", ""},
    {"speech.monspeak.9ff0b62576b5417c", "smoke... everywhere", "烟雾……到处都是", ""},
    {"speech.monspeak.a005e65c3ebffc59", "{the_monster_1} shouts {at_foe_1}, \"You think you're better than me\?\"", "{the_monster_1}喊道 {at_foe_1}：“你以为你比我强？”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.a013b482469ad73e", "{the_monster_1} presages, \"An acid flood will etch off all the scum!\"", "{the_monster_1}预言道：“一场酸潮将蚀去所有的渣滓！”", "the_monster_1:name"},
    {"speech.monspeak.a016ad2b5ced07db", "{jory_common_1}", "{jory_common_1}", "jory_common_1:text"},
    {"speech.monspeak.a01d8cb5aae94c66", "{the_monster_1} says, \"There's not enough treasure in here.\"", "{the_monster_1}说：“这里的财宝太少了。”", "the_monster_1:name"},
    {"speech.monspeak.a037a8d13f516499", "{the_monster_1} yells, \"I thought of it first! Give it back!\"", "{the_monster_1}大叫道：“是我先想到的！把它还回来！”", "the_monster_1:name"},
    {"speech.monspeak.a03983175edfbb69", "{the_monster_1} says, \"Become one with my sorrow!\"", "{the_monster_1}说：“与我的悲伤合而为一吧！”", "the_monster_1:name"},
    {"speech.monspeak.a040f1e2e6f624bd", "{the_monster_1} says, \"Betcha didn't see that coming, eh\?\"", "{the_monster_1}说：“我打赌你没料到这一手吧，嗯？”", "the_monster_1:name"},
    {"speech.monspeak.a04882ed53f2aa32", "{the_monster_1} says, \"My uncle had bigger webs in his attic. I hated that.\"", "{the_monster_1}说：“我叔叔的阁楼里有比这更大的蛛网。我讨厌那样。”", "the_monster_1:name"},
    {"speech.monspeak.a064b8697bc81f64", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.a08b0c2ff565ec27", "{the_monster_1} smears {possessive_1} weapon with vermillion and lifts it high.", "{the_monster_1}用朱红的鲜血涂抹{possessive_1}武器，将它高高举起。", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.a09b4ee0a4f4f2dc", "{the_monster_1} says, \"Your jellies ate my lunch. I hate that.\"", "{the_monster_1}说：“你的胶冻吃了我的午饭。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.a0c9d1aa99c8090d", "{the_monster_1} says, \"Ah. You're responsible for all those zombies.\"", "{the_monster_1}说：“啊。那些僵尸都是你搞出来的。”", "the_monster_1:name"},
    {"speech.monspeak.a0cd0ae560fc07fd", "{channel_1}{the_monster_1} grins evilly.", "{channel_1}{the_monster_1}邪恶地咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.a111c2ee32c4779c", "{the_monster_1} begs for mercy.", "{the_monster_1}乞求怜悯。", "the_monster_1:name"},
    {"speech.monspeak.a11717e983961c28", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.a13d4809f43dd296", "{the_monster_1} shakes {possessive_1} head, saying, \"No, no, no!\"", "{the_monster_1}摇着{possessive_1}头说：“不，不，不！”", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.a15999ed582ef72b", "{generic_orc_speech_1}", "{generic_orc_speech_1}", "generic_orc_speech_1:text"},
    {"speech.monspeak.a15c297d1600eeb1", "{the_monster_1} screams {at_foe_1}, \"I'll use your head as a decoration in Hell!\"", "{the_monster_1}尖叫 {at_foe_1}：“我要用你的头去装饰地狱！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.a1621b14d93957f3", "{the_monster_1} says, \"Join with me for eternity!\"", "{the_monster_1}说：“与我融为一体，共度永恒吧！”", "the_monster_1:name"},
    {"speech.monspeak.a172f8739e1d4330", "{the_monster_1} says {to_foe_1}, \"You dishonour your ancestors.\"", "{the_monster_1}说 {to_foe_1}：“你辱没了你的祖先。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.a17c24c5d9294a2e", "{channel_1}{the_monster_1} swishes {possessive_1} cloak stereotypically.", "{channel_1}{the_monster_1}故作老派地甩动{possessive_1}斗篷。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.a1ae6eab9c277709", "{the_monster_1} says, \"Oh, hey! I could use a new shield. Have you got any spares\?\"", "{the_monster_1}说：“哦，嘿！我正缺一面新盾牌。你有多余的吗？”", "the_monster_1:name"},
    {"speech.monspeak.a1c7d8dc87d53104", "{the_monster_1} says, \"Wow, you can rise to a higher floor... isn't that called 'climbing stairs'\?\"", "{the_monster_1}说：“哇，你能升到上层去……那不就是叫‘爬楼梯’吗？”", "the_monster_1:name"},
    {"speech.monspeak.a1d4114a8a1a30b2", "{the_monster_1} points {possessive_1} finger {at_foe_1} and shouts, \"{grum_dog_name_1}! Sic 'em!\"", "{the_monster_1}用{possessive_1}手指指着{at_foe_1}并大喊：“{grum_dog_name_1}！咬他！”", "the_monster_1:name;possessive_1:text;at_foe_1:text;grum_dog_name_1:name"},
    {"speech.monspeak.a1e3b8c7218b22b1", "{the_monster_1} says, \"I hate despair.\"", "{the_monster_1}说：“我讨厌绝望。”", "the_monster_1:name"},
    {"speech.monspeak.a1ecc918a1ef7a32", "illustrious", "显赫的", ""},
    {"speech.monspeak.a1f15494337fb563", "{the_monster_1} boasts, \"After taking care of you, I will research a spell that consumes the world.\"", "{the_monster_1}夸口道：“收拾完你，我就去研究一个吞噬世界的法术。”", "the_monster_1:name"},
    {"speech.monspeak.a201dcee743fb98f", "{the_monster_1} says, \"I hate wretches.\"", "{the_monster_1}说：“我讨厌可怜虫。”", "the_monster_1:name"},
    {"speech.monspeak.a20fb44d700a9087", "{the_monster_1} says, \"Life goes in cycles. In a little while, you'll be reborn as a tapeworm.\"", "{the_monster_1}说：“生命循环不息。过不了多久，你就会转生为一条绦虫。”", "the_monster_1:name"},
    {"speech.monspeak.a213561cfbcb5f89", "{the_monster_1} takes aim {at_foe_1}.", "{the_monster_1}瞄准了 {at_foe_1}。", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.a2300a4d66bf1b47", "{the_monster_1} says, \"The agents of utter destruction are not stopped by death.\"", "{the_monster_1}说：“彻底毁灭的代理人们不会因死亡而停下。”", "the_monster_1:name"},
    {"speech.monspeak.a23a3e285e139035", "{channel_1}{the_monster_1} grinds {possessive_1} teeth.", "{channel_1}{the_monster_1}咬得{possessive_1}牙齿咯咯作响。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.a23b0fac1ee51220", "{the_monster_1} says, \"Everyone always remembers my brother. 'Who's Edmund\?' they ask!\"", "{the_monster_1}说：“大家永远只记得我哥哥。‘埃德蒙是谁？’他们这么问！”", "the_monster_1:name"},
    {"speech.monspeak.a2403b117a68842a", "{the_monster_1} says, \"I hate spells.\"", "{the_monster_1}说：“我讨厌法术。”", "the_monster_1:name"},
    {"speech.monspeak.a2480f27b359527f", "{channel_1}{the_monster_possessive_1} form {choice_1}{choice_2} with deep exhaustion.", "{channel_1}{the_monster_possessive_1}身形因极度疲惫而{choice_1}{choice_2}。", "channel_1:key;the_monster_possessive_1:name;choice_1:text;choice_2:text"},
    {"speech.monspeak.a2480f27b359527f.choice_1.alt_0", "briefly ", "短暂地", ""},
    {"speech.monspeak.a2480f27b359527f.choice_1.alt_1", "", "", ""},
    {"speech.monspeak.a2480f27b359527f.choice_2.alt_0", "ripples", "泛起涟漪", ""},
    {"speech.monspeak.a2480f27b359527f.choice_2.alt_1", "wavers", "摇摇欲坠", ""},
    {"speech.monspeak.a24c6d24f2648d72", "{the_monster_1} rumbles, \"TIME FOR A NIBBLE.\"", "{the_monster_1}隆隆地说：“该啃一口了。”", "the_monster_1:name"},
    {"speech.monspeak.a24fed1180795ffd", "{the_monster_1} says {to_foe_1}, \"There's only one solution for all of you. To die.\"", "{the_monster_1}说 {to_foe_1}：“对你们所有人来说只有一个解决办法。那就是死。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.a253a8a64ea4354e", "{the_monster_1} says, \"Oh, what beautiful sparkles and rainbows everywhere!\"", "{the_monster_1}说：“哦，到处都是多么美丽的闪光和彩虹啊！”", "the_monster_1:name"},
    {"speech.monspeak.a2597d9cde33ca33", "{channel_1}{the_monster_1} inspects you suspiciously.", "{channel_1}{the_monster_1}怀疑地打量着你。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.a26b934aa3bc117c", "{the_monster_1} sputters.", "{the_monster_1}结结巴巴地说着。", "the_monster_1:name"},
    {"speech.monspeak.a272f3120f874474", "{channel_1}{the_monster_1} grins with merry abandon.", "{channel_1}{the_monster_1}纵情快活地咧嘴大笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.a280fe72781db85f", "{the_monster_1} yells, \"I will have my revenge on the monster who did this!\"", "{the_monster_1}喊道：“我一定要向做出这一切的怪物报仇！”", "the_monster_1:name"},
    {"speech.monspeak.a289b333c56fa098", "{the_monster_1} says, \"The Vaults look kind of boring.\"", "{the_monster_1}说：“宝库看起来有点无聊。”", "the_monster_1:name"},
    {"speech.monspeak.a28e5344d702bfe9", "{the_monster_1} says {to_foe_1}, \"When I snap my fingers, you will think you are a chicken.\"", "{the_monster_1}说 {to_foe_1}：“等我打个响指，你就会以为自己是一只鸡。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.a29ad196fdefc11a", "{the_monster_1} says, \"I bet you're feeling stupid now, huh\?\"", "{the_monster_1}说：“我打赌你现在觉得自己很蠢，对吧？”", "the_monster_1:name"},
    {"speech.monspeak.a2aa99eac509bb35", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.a2b4337ee7899d4c", "{the_monster_1} says, \"I saw some tasty-looking maize earlier, but it tried to eat me. I hate that.\"", "{the_monster_1}说：“我刚才看到一些看起来很美味的玉米，可它想吃我。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.a2b6ec42f1c32044", "{channel_1}{the_monster_1} momentarily stares at you in horror, before exploding into a cloud of blood!", "{channel_1}{the_monster_1}惊恐地盯着你看了片刻，随即炸成了一团血雾！", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.a2ba6e98b8a68182", "{the_monster_1} shouts, \"I believe in me!\"", "{the_monster_1}喊道：“我相信我自己！”", "the_monster_1:name"},
    {"speech.monspeak.a2cf7ae2b214e236", "{the_monster_1} says, \"One may say the eternal mystery of the world is its comprehensibility.\"", "{the_monster_1}说：“可以说，世界永恒的神秘之处就在于它能够被理解。”", "the_monster_1:name"},
    {"speech.monspeak.a2ebd2ca7276b259", "Snower", "雪人", ""},
    {"speech.monspeak.a338013ac4e5c2ba", "{the_monster_1} {begs_1} {to_foe_1}, \"Why can't we all just get along\?\"", "{the_monster_1} {begs_1} {to_foe_1}：“我们就不能好好相处吗？”", "the_monster_1:name;begs_1:text;to_foe_1:text"},
    {"speech.monspeak.a33861195bf5bcbe", "laughs", "笑着", ""},
    {"speech.monspeak.a37447e518bdbf60", "{the_monster_1} says, \"I hate haloes.\"", "{the_monster_1}说：“我讨厌光环。”", "the_monster_1:name"},
    {"speech.monspeak.a391b3883f7d5fd6", "{crazy_yiuf_wordlist1_1}!", "{crazy_yiuf_wordlist1_1}！", "crazy_yiuf_wordlist1_1:text"},
    {"speech.monspeak.a399cde50ddce950", "{the_monster_1} says, \"Damn it, I left my flaming sword at home.\"", "{the_monster_1}说：“该死，我把燃烧的剑忘在家里了。”", "the_monster_1:name"},
    {"speech.monspeak.a3d4cd875976fc11", "{the_monster_1} says, \"I'll bring them back. Then they'll show me... everything...\"", "{the_monster_1}说：“我会把他们带回来。然后他们就会让我看到……一切……”", "the_monster_1:name"},
    {"speech.monspeak.a3ec3dcae5b256a7", "{the_monster_1} says {to_foe_1}, \"Look into my eyes.\"", "{the_monster_1}说 {to_foe_1}：“看着我的眼睛。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.a444a1954fd27eae", "{the_monster_1} says, \"My goal is simple. It is a complete understanding of the universe, why it is as it is and why it exists at all.\"", "{the_monster_1}说：“我的目标很简单。那就是彻底理解这个宇宙：它为何如此，它又为何存在。”", "the_monster_1:name"},
    {"speech.monspeak.a485f701602a05e0", "{the_monster_1} says, \"His death shall not be in vain!\"", "{the_monster_1}说：“他的死不会白费！”", "the_monster_1:name"},
    {"speech.monspeak.a49bb7760448f6b7", "{the_monster_1} says, \"What's the Crucible of Flesh\? Some kind of fancy barbecue place\?\"", "{the_monster_1}说：“血肉熔炉是什么？某家高级烤肉店吗？”", "the_monster_1:name"},
    {"speech.monspeak.a4a0edadc53eb8d0", "{the_monster_1} {norris_verb_1}, \"I think I should really try dying once.\"", "{the_monster_1}{norris_verb_1}：“我想我真该试着死上一次。”", "the_monster_1:name;norris_verb_1:text"},
    {"speech.monspeak.a4a73af00eafe72b", "a poem about", "一首关于", ""},
    {"speech.monspeak.a4b1936570337379", "bag", "袋子", ""},
    {"speech.monspeak.a52cf9f059d07fa2", "{hostile_imp_1}", "{hostile_imp_1}", "hostile_imp_1:text"},
    {"speech.monspeak.a53aa72a6a21c291", "{the_monster_1} says, \"What are you going to do with that Orb\?\"", "{the_monster_1}说：“你打算拿那枚宝珠做什么？”", "the_monster_1:name"},
    {"speech.monspeak.a55b30363a58a350", "{the_monster_1} says, \"Surely there's a limit to the number of books you can carry. Right\?\"", "{the_monster_1}说：“你能带的书肯定是有上限的吧。对吧？”", "the_monster_1:name"},
    {"speech.monspeak.a587e7fa7c0e0856", "{the_monster_1} tries to tell {foe_1} a complicated story about hydras, {possessive_1} blood, and marriage.", "{the_monster_1}试图给{foe_1}讲一个复杂的故事，关于九头蛇、{possessive_1}的血，以及婚姻。", "the_monster_1:name;foe_1:text;possessive_1:text"},
    {"speech.monspeak.a58c5a4fc2e8fb71", "{the_monster_1} says, \"Need a shortcut to the ORB\? Here, let me help!\"", "{the_monster_1}说：“想要一条通往宝珠的捷径？来，我帮你！”", "the_monster_1:name"},
    {"speech.monspeak.a592dfab0ebf8777", "{the_monster_1} screams in joy, \"As in life, so in death: Kill! Kill!! Kill!!!\"", "{the_monster_1}狂喜地尖叫道：“生也如此，死也如此：杀！杀！！杀！！！”", "the_monster_1:name"},
    {"speech.monspeak.a5ed474adc10c57e", "{subjective_1} asks, \"Are you our saviour\?\"", "{subjective_1}问道：“你是我们的救世主吗？”", "subjective_1:text"},
    {"speech.monspeak.a62f7f0607188291", "{wizard_medium_1}", "{wizard_medium_1}", "wizard_medium_1:text"},
    {"speech.monspeak.a63534949194e59f", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.a639b5dab93946eb", "{the_monster_1} clumsily fails to latch onto your valuables.", "{the_monster_1}笨手笨脚地没能抓住你的财物。", "the_monster_1:name"},
    {"speech.monspeak.a6665792405e58f3", "{channel_1}{the_monster_1} is wreathed in a cloud of translocational energy.", "{channel_1}{the_monster_1}被一团移位能量环绕着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.a66c911a831fe27b", "{the_monster_1} bellows, \"You've tricked me!\"", "{the_monster_1}吼叫道：“你骗了我！”", "the_monster_1:name"},
    {"speech.monspeak.a6b8de4bc6de64c3", "{the_monster_1} says, \"So much for spreading the word; you get punched in the face instead.\"", "{the_monster_1}说：“说到传播福音，结果就是脸上挨一拳。”", "the_monster_1:name"},
    {"speech.monspeak.a6df17bafaed1574", "{the_monster_1} says {to_foe_1}, \"You can't imagine my power.\"", "{the_monster_1}说 {to_foe_1}：“你无法想象我的力量。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.a6e7fa359381b43d", "{the_monster_1} sighs.", "{the_monster_1}叹了口气。", "the_monster_1:name"},
    {"speech.monspeak.a6ff960bf411b29e", "{dowan_duvessa_dies_bytwin_1}", "{dowan_duvessa_dies_bytwin_1}", "dowan_duvessa_dies_bytwin_1:text"},
    {"speech.monspeak.a720402a4a147673", "{the_monster_1} says, \"Maybe you should start praying.\"", "{the_monster_1}说：“也许你该开始祈祷了。”", "the_monster_1:name"},
    {"speech.monspeak.a720ee9a03770f65", "a terrible drought", "一场可怕的干旱", ""},
    {"speech.monspeak.a7306c4a0a0c09d2", "Aardvark", "土豚", ""},
    {"speech.monspeak.a752bc7ba014dd37", "shrieks", "悲鸣道", ""},
    {"speech.monspeak.a771ffa1d536ac75", "{the_monster_1} says, \"Why do the walls change colour every floor\? Did they keep running out of paint\?\"", "{the_monster_1}说：“为什么每层墙的颜色都不一样？他们的油漆老是不够用吗？”", "the_monster_1:name"},
    {"speech.monspeak.a7748cda3d56eb6f", "{generic_ranged_1}", "{generic_ranged_1}", "generic_ranged_1:text"},
    {"speech.monspeak.a791e04f99fe53d7", "{the_monster_1} growls, \"COMING HERE WAS YOUR LAST MISTAKE.\"", "{the_monster_1}低吼道：“来这里是你犯的最后一个错误。”", "the_monster_1:name"},
    {"speech.monspeak.a7a7145ecd7bffc3", "{the_monster_1} says, \"Zombies are pretty boring.\"", "{the_monster_1}说：“丧尸都挺无聊的。”", "the_monster_1:name"},
    {"speech.monspeak.a7a8dbaeefc062cb", "{chuck_generic_1}", "{chuck_generic_1}", "chuck_generic_1:text"},
    {"speech.monspeak.a7ac2d003c1b3b33", "a terrible numbness", "可怕的麻木", ""},
    {"speech.monspeak.a7ca9c3c2e08ae76", "As they crumble to ash, {the_monster_1} whispers, \"You will also be forgotten....\"", "{the_monster_1}化为灰烬时，低声说：“你也会被遗忘……”", "the_monster_1:name"},
    {"speech.monspeak.a7e9fe4899cd66c1", "{the_monster_1} says, \"What's the point of a Hall of Blades anyway\?\"", "{the_monster_1}说：“一座刀剑大厅到底有什么用？”", "the_monster_1:name"},
    {"speech.monspeak.a7ec46e87a105de3", "{the_monster_1} tells you, \"None of this matters. None of this is real!\"", "{the_monster_1}告诉你：“这一切都毫无意义。这一切都不是真的！”", "the_monster_1:name"},
    {"speech.monspeak.a802a3b9c731e850", "{the_monster_1} weeps quietly.", "{the_monster_1}无声地抽泣着。", "the_monster_1:name"},
    {"speech.monspeak.a81d59030b9f6b05", "Mountain", "山", ""},
    {"speech.monspeak.a840e700185a1b74", "{the_monster_1} gibbers softly, \"It was just one butterfly....\"", "{the_monster_1}轻声胡言乱语道：“那只不过是一只蝴蝶……”", "the_monster_1:name"},
    {"speech.monspeak.a848f9096cd7c978", "{subjective_1} shouts, \"Spare me, and you'll never see me again!\"", "{subjective_1}喊道：“饶了我，你再也见不到我！”", "subjective_1:text"},
    {"speech.monspeak.a84a4cf8b3fa260e", "proper burial practice.", "正确的丧葬礼仪。", ""},
    {"speech.monspeak.a850c66337bc5fe5", "{vashnia_naga_1}", "{vashnia_naga_1}", "vashnia_naga_1:text"},
    {"speech.monspeak.a8567727092a42f1", "{the_monster_1} says {to_foe_1}, \"My constructs will outlast you.\"", "{the_monster_1}说 {to_foe_1}：“我的造物会比你活得长久。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.a86c896c4dc0fd58", "{the_monster_1} sighs, \"Join the corpses you idolise, mortal.\"", "{the_monster_1}叹息道：“去和你所崇拜的尸体为伍吧，凡人。”", "the_monster_1:name"},
    {"speech.monspeak.a876916cea114d47", "{channel_1}For a moment, you lose track of {the_monster_1}.", "{channel_1}有那么一瞬间，你跟丢了{the_monster_1}。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.a8793fd6809d4f0e", "{channel_1}{the_monster_1} looks at you.", "{channel_1}{the_monster_1}看着你。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.a879f9e44dc932e1", "{channel_1}{the_monster_1} lashes {possessive_1} tail.", "{channel_1}{the_monster_1}甩动{possessive_1}尾巴。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.a8957a7e9dd9a105", "{the_monster_1} says, \"Everybody has to sleep sometimes.\"", "{the_monster_1}说：“谁都有要睡觉的时候。”", "the_monster_1:name"},
    {"speech.monspeak.a8a0dc9f6e584bfc", "{channel_1}{the_monster_1} begins to take a bow, but slips on a banana peel.", "{channel_1}{the_monster_1}正要鞠躬，却踩到香蕉皮滑了一跤。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.a8aa848f9938aee6", "{the_monster_1} shouts {at_foe_1}, \"Intruder!\"", "{the_monster_1}喊道 {at_foe_1}：“有入侵者！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.a8b49deec23ca6e3", "{the_monster_1} muses, \"Oh, to shine as brightly as a sun moth...\"", "{the_monster_1}沉思道：“啊，要是能像太阳蛾一样闪耀……”", "the_monster_1:name"},
    {"speech.monspeak.a8be3c34ef785f0f", "{the_monster_1} {orc_shouts_1} {loudly_or_repeatedly_1}{orc_modifier_1}", "{the_monster_1}{orc_shouts_1}{loudly_or_repeatedly_1}{orc_modifier_1}", "the_monster_1:name;orc_shouts_1:text;loudly_or_repeatedly_1:text;orc_modifier_1:text"},
    {"speech.monspeak.a8bef8e43b0c890a", "{channel_1}{the_monster_1} grins evilly.", "{channel_1}{the_monster_1}邪恶地咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.a8c9a61ba4a94a24", "arm", "手臂", ""},
    {"speech.monspeak.a8de429d4379e4ae", "{the_monster_1} says, \"Bet you can't {choice_1} your way out of this one.\"", "{the_monster_1}说：“这次你{choice_1}不出一条出路了吧。”", "the_monster_1:name;choice_1:text"},
    {"speech.monspeak.a8de429d4379e4ae.choice_1.alt_0", "analyse", "分析", ""},
    {"speech.monspeak.a8de429d4379e4ae.choice_1.alt_1", "invent", "发明", ""},
    {"speech.monspeak.a8e9514bbd3845d9", "{the_monster_1} screams {at_foe_1}, \"I no like you!\"", "{the_monster_1}尖叫 {at_foe_1}：“俺不喜欢你！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.a8ee82584515df4d", "{the_monster_1} says, \"You either stomp with the beat or get stomped.\"", "{the_monster_1}说：“你要么踩着节拍踏地，要么就被踏扁。”", "the_monster_1:name"},
    {"speech.monspeak.a908a886668e36aa", "{the_monster_1} says, \"They must've been making zombies for centuries to fill this place.\"", "{the_monster_1}说：“他们肯定做了好几百年丧尸才填满这个地方。”", "the_monster_1:name"},
    {"speech.monspeak.a91fc5a2f33d567f", "{ilsuiw_common_1}", "{ilsuiw_common_1}", "ilsuiw_common_1:text"},
    {"speech.monspeak.a92ea192363970df", "{channel_1}{the_monster_1} looks at you.", "{channel_1}{the_monster_1}看着你。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.a942c57199b0dae7", "{the_monster_1} says, \"Once, I gave up eating meat for a week. I hated that.\"", "{the_monster_1}说：“有一次我戒肉戒了一星期。我讨厌那样。”", "the_monster_1:name"},
    {"speech.monspeak.a95c793ae03a95e0", "Citrus", "柑橘", ""},
    {"speech.monspeak.a98046e2e7ed4e03", "{the_monster_1} yells, \"Please, just kill me!\"", "{the_monster_1}喊道：“求你了，杀了我吧！”", "the_monster_1:name"},
    {"speech.monspeak.a9da9846bfa4f229", "butterfly", "蝴蝶", ""},
    {"speech.monspeak.a9e8feeda6ace551", "{channel_1}{the_monster_1} pulls a quokka out of {possessive_1} cap.", "{channel_1}{the_monster_1}从{possessive_1}帽子里掏出一只短尾矮袋鼠。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.a9f7153e53b54db4", "{the_monster_1} shouts, \"Fear not, {player_name_1}! Beogh smiles on those who fall in battle!\"", "{the_monster_1}喊道：“别怕，{player_name_1}！比欧弗对战斗中倒下的人微笑！”", "the_monster_1:name;player_name_1:name"},
    {"speech.monspeak.aa08747ba3d333dd", "{the_monster_1} asks {foe_1} \"Just a little smooch\?\"", "{the_monster_1}问道 {foe_1}“就亲一小口？”", "the_monster_1:name;foe_1:text"},
    {"speech.monspeak.aa221819a2ab60de", "{the_monster_1} yells, \"Danger! Danger! High voltage!\"", "{the_monster_1}喊道：“危险！危险！高压电！”", "the_monster_1:name"},
    {"speech.monspeak.aa2370b727cc8d33", "{channel_1}{the_monster_1} gestures wildly at you. {player_only_1}", "{channel_1}{the_monster_1}冲你疯狂地比划着。{player_only_1}", "channel_1:key;the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.aa3726c140480793", "{natasha_common_1}", "{natasha_common_1}", "natasha_common_1:text"},
    {"speech.monspeak.aa42ddf9cbebc81c", "{the_monster_1} draws {misplaced_card_1}. \"Wait, where'd this come from\?\"", "{the_monster_1}抽到了{misplaced_card_1}。“等等，这张是从哪儿来的？”", "the_monster_1:name;misplaced_card_1:text"},
    {"speech.monspeak.aa58355f8ce014ee", "{channel_1}{the_monster_possessive_1} eyes momentarily flash bright red.", "{channel_1}{the_monster_possessive_1}双眼短暂地闪过鲜红光芒。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.aa5cce6b2c6e73a6", "{the_monster_1} says, \"Thou art lean, ill-favoured, death is in thy neighbourhood!\"", "{the_monster_1}说：“你瘦弱不堪、形容可憎，死神就在你左右！”", "the_monster_1:name"},
    {"speech.monspeak.aa74b18f67593c28", "{the_monster_1} says {to_foe_1}, \"I'm here to kill trespassers. I like my job.\"", "{the_monster_1}说 {to_foe_1}：“我在这里杀掉擅闯者。我喜欢我的工作。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.aa82724e738f35e3", "{the_monster_1} says {to_foe_1}, \"Don't move, or the poison will kill you faster.\"", "{the_monster_1}说 {to_foe_1}：“别动，否则毒会更快要了你的命。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.aa90c41001685d32", "{the_monster_1} says, \"{player_name_1}, you are my only friend.\"", "{the_monster_1}说：“{player_name_1}，你是我唯一的朋友。”", "the_monster_1:name;player_name_1:name"},
    {"speech.monspeak.aa94bf9f91657149", "{the_monster_1} says, \"I guess you can't buy your way into a good afterlife.\"", "{the_monster_1}说：“看来花钱也买不来一个美好的来世。”", "the_monster_1:name"},
    {"speech.monspeak.aa9e1ee4fabc8e1d", "{the_monster_1} says {to_foe_1}, \"This battle is not even a challenge!\"", "{the_monster_1}说 {to_foe_1}：“这场战斗根本算不上挑战！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.aab0376a70dc385b", "{the_monster_1} says, \"I like turtle soup. I hate turtles.\"", "{the_monster_1}说：“我喜欢海龟汤。我讨厌海龟。”", "the_monster_1:name"},
    {"speech.monspeak.aabb91fa2add238c", "{the_monster_1} screams, \"THIEF!\"", "{the_monster_1}尖叫道：“小偷！”", "the_monster_1:name"},
    {"speech.monspeak.aac5683693be17f1", "{channel_1}{the_monster_1} winks {at_foe_1} and puckers {possessive_1} lips.", "{channel_1}{the_monster_1}眨了眨眼 {at_foe_1}，撅起了{possessive_1}嘴唇。", "channel_1:key;the_monster_1:name;at_foe_1:text;possessive_1:text"},
    {"speech.monspeak.aacba564deff26a5", "{spectator_speech_1}", "{spectator_speech_1}", "spectator_speech_1:text"},
    {"speech.monspeak.aacf2a8c5866fed7", "{default_friendly_humanoid_1}", "{default_friendly_humanoid_1}", "default_friendly_humanoid_1:text"},
    {"speech.monspeak.aad6aed130ed35c1", "{the_monster_1} says {to_foe_1}, \"In the orcish mines, orcs kill the likes of YOU!\"", "{the_monster_1}说 {to_foe_1}：“在兽人矿坑里，兽人杀的就是你这样的家伙！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.aae96ebbf380addb", "{the_monster_1} says, \"Bound art thou by all the snares!\"", "{the_monster_1}说：“你被一切罗网所缚！”", "the_monster_1:name"},
    {"speech.monspeak.aaecd4f2462345fd", "{the_monster_1} screams {at_foe_1}, \"Time for continue experiment!\"", "{the_monster_1}尖叫 {at_foe_1}：“该继续做实验了！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.ab0733eb89eb3efe", "{the_monster_1} screams {at_foe_1}, \"Let me show you how many colours things can be!\"", "{the_monster_1}尖叫 {at_foe_1}：“让我给你看看东西能有多少种颜色！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.ab3adf0ba824f725", "{the_monster_1} says, \"Why a 'Demon-God'\? Wouldn't a 'Zombie-God' be more appropriate\?\"", "{the_monster_1}说：“为什么叫‘魔神’？叫‘丧尸神’不是更合适？”", "the_monster_1:name"},
    {"speech.monspeak.ab3d476ef60d841f", "{the_monster_1} mumbles some strange words.", "{the_monster_1}咕哝着一些奇怪的词句。", "the_monster_1:name"},
    {"speech.monspeak.ab47abffd374d3db", "{the_monster_1} says, \"Warriors are made for war and combat. Do you call yourself a warrior\?\"", "{the_monster_1}说：“战士就该为战争和战斗而生。你自称是战士吗？”", "the_monster_1:name"},
    {"speech.monspeak.ab50c99d6849cb76", "{the_monster_1} says, \"I don't understand half of what these people say. It's all Greek to me.\"", "{the_monster_1}说：“这些人说的话我有一半听不懂。对我来说完全是天书。”", "the_monster_1:name"},
    {"speech.monspeak.ab5fea971f188025", "noodlescoop", "面条勺", ""},
    {"speech.monspeak.ab77c9778b0cb69d", "{the_monster_1} roars horribly.", "{the_monster_1}发出可怕的咆哮。", "the_monster_1:name"},
    {"speech.monspeak.abad476bf0e9ee89", "{the_monster_1} says, \"Now do you deem me a worthy opponent\?\"", "{the_monster_1}说：“现在，你觉得我是个够格的对手了吗？”", "the_monster_1:name"},
    {"speech.monspeak.abd7a9ac0dd13b03", "{the_monster_1} says, \"I hear the Orcs make a nippy scran these days.\"", "{the_monster_1}说：“听说如今兽人做的吃食挺够味。”", "the_monster_1:name"},
    {"speech.monspeak.ac003153ae9ae01b", "{the_monster_1} says {to_foe_1}, \"Don't worry, I won't let your corpse go to waste.\"", "{the_monster_1}说 {to_foe_1}：“别担心，我不会让你的尸体白白浪费掉。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.ac03c1a2110942d3", "Island", "岛屿", ""},
    {"speech.monspeak.ac0ff4a9783bd4aa", "{the_monster_1} says, \"This place is the Pits.\"", "{the_monster_1}说：“这地方就是个大坑。”", "the_monster_1:name"},
    {"speech.monspeak.ac2d2bf64f7a40f5", "{urug_common_1}", "{urug_common_1}", "urug_common_1:text"},
    {"speech.monspeak.ac2f92b71704f5b2", "{the_monster_1} weeps.", "{the_monster_1}哭泣。", "the_monster_1:name"},
    {"speech.monspeak.ac3e33ce6928aed5", "obedience to the Law.", "对法则的顺从。", ""},
    {"speech.monspeak.ac483157776a638e", "{the_monster_1} says, \"The only thing more annoying than a worshipper is a proselytiser.\"", "{the_monster_1}说：“唯一比信徒更烦人的，就是劝人入教的人。”", "the_monster_1:name"},
    {"speech.monspeak.ac4bd91fc813b543", "{the_monster_1} says, \"This place has the same junk as everywhere else. I hate that.\"", "{the_monster_1}说：“这里的破烂跟别处的一模一样。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.ac503dc0e428d292", "{the_monster_1} says {to_foe_1}, \"An ice sculpture of you would look very nice here.\"", "{the_monster_1}说 {to_foe_1}：“在这里摆一座你的冰雕一定很好看。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.ac674f0f87befbbc", "{wizard_1}", "{wizard_1}", "wizard_1:text"},
    {"speech.monspeak.ac71bcb07e7d7816", "{channel_1}{the_monster_1} glances around for something to throw.", "{channel_1}{the_monster_1}四下张望，想找点东西扔出去。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.ac72dce3dea7f83f", "{the_monster_1} says {to_foe_1}, \"Don't worry, I'll kill you fast.\"", "{the_monster_1}说 {to_foe_1}：“别担心，我会很快杀了你。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.ac77544a62bf32bb", "{channel_1}{the_monster_1} buzzes around in tight circles.", "{channel_1}{the_monster_1}嗡嗡地绕着紧小的圈子飞。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.ac84631b47578250", "{the_monster_1} says {to_foe_1}, \"I know a thousand and one ways to kill you.\"", "{the_monster_1}说 {to_foe_1}：“我有一千零一种杀死你的办法。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.ac900d3d48614d1c", "{the_monster_1} says, \"Huh, so Ignis will die when you do... how's that make you feel\?\"", "{the_monster_1}说：“哦，所以伊格尼斯会在你死的时候一起熄灭……这让你什么感觉？”", "the_monster_1:name"},
    {"speech.monspeak.ac99dcb3d29bae46", "{the_monster_1} whispers, \"Soon you will have time, lots of time...\"", "{the_monster_1}低声说：“很快你就会拥有时间，大把大把的时间……”", "the_monster_1:name"},
    {"speech.monspeak.ac9c24decc33cfc4", "{the_monster_1} whispers {to_foe_1}, \"You'd look cute with a curly little tail.\"", "{the_monster_1}低声说 {to_foe_1}：“你要是有条卷卷的小尾巴，一定很可爱。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.aca74a5cd127333b", "{the_monster_1} says, \"Do you find it easier to cast spells, now\?\"", "{the_monster_1}说：“你现在施法是不是更容易了？”", "the_monster_1:name"},
    {"speech.monspeak.acbcb51bf1340235", "{the_monster_1} shakes {possessive_1} head sadly, \"Willingly donning a god's shackles... pitiful.\"", "{the_monster_1}悲伤地摇着{possessive_1}头，说道：“心甘情愿戴上神明的枷锁……真可悲。”", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.acc2140f9cdaaab6", "{the_monster_1} says, \"How can a god be banished to the Abyss\?\"", "{the_monster_1}说：“一个神怎么会被放逐到深渊？”", "the_monster_1:name"},
    {"speech.monspeak.acd4f24a94eaeb32", "{the_monster_1} lets out a mournful wail.", "{the_monster_1}发出一声哀伤的悲号。", "the_monster_1:name"},
    {"speech.monspeak.acdf9a9693dafc3f", "Spot", "点点", ""},
    {"speech.monspeak.acfbc2572d26aa5f", "{misc_colour_1}", "{misc_colour_1}", "misc_colour_1:text"},
    {"speech.monspeak.ad0ec32b82533e38", "{the_monster_1} screams in fury as {subjective_1} dies!", "{the_monster_1}在{subjective_1}死去时愤怒地尖叫！", "the_monster_1:name;subjective_1:text"},
    {"speech.monspeak.ad16318dd155bb55", "{the_monster_1} says {to_foe_1}, \"I don't want to hurt you. Just - go! Run!\"", "{the_monster_1}说 {to_foe_1}：“我不想伤害你。只要——走！快跑！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.ad23a44a15b59a0a", "{the_monster_1} says, \"I hate inventors.\"", "{the_monster_1}说：“我讨厌发明家。”", "the_monster_1:name"},
    {"speech.monspeak.ad5462bb101bc0f2", "{the_monster_1} says, \"The Crypt, the Tomb, what's next\? The Coffin\?\"", "{the_monster_1}说：“墓室、远古坟冢，接下来是什么？棺材？”", "the_monster_1:name"},
    {"speech.monspeak.ad69d1cfbaeb64a2", "{related_beogh_orc_1}", "{related_beogh_orc_1}", "related_beogh_orc_1:text"},
    {"speech.monspeak.ad8bd806e9ed88e1", "{the_monster_1} {choice_1}, \"{choice_2}!\"", "{the_monster_1}{choice_1}道：“{choice_2}！”", "the_monster_1:name;choice_1:text;choice_2:text"},
    {"speech.monspeak.ad8bd806e9ed88e1.choice_1.alt_0", "blubbers", "哭诉", ""},
    {"speech.monspeak.ad8bd806e9ed88e1.choice_1.alt_1", "cries", "哭喊", ""},
    {"speech.monspeak.ad8bd806e9ed88e1.choice_2.alt_0", "Mummeee", "妈妈呀", ""},
    {"speech.monspeak.ad8bd806e9ed88e1.choice_2.alt_1", "Daddeee", "爸爸呀", ""},
    {"speech.monspeak.ad8bd806e9ed88e1.choice_2.alt_2", "Meeeeep", "咩咩咩", ""},
    {"speech.monspeak.ad8bd806e9ed88e1.choice_2.alt_3", "Help meeeeeeee", "救救我呀呀呀", ""},
    {"speech.monspeak.ad8bd806e9ed88e1.choice_2.alt_4", "Eeeeekkkk", "咿咿咿呀", ""},
    {"speech.monspeak.ad8bd806e9ed88e1.choice_2.alt_5", "Oh nooooooo", "噢不不不不", ""},
    {"speech.monspeak.ad8bd806e9ed88e1.choice_2.alt_6", "Waaaaaa", "哇啊啊啊", ""},
    {"speech.monspeak.ad8fd15a3e4ac766", "{the_monster_1} says, \"Well, at least you're never short of company.\"", "{the_monster_1}说：“好吧，至少你从不缺伴儿。”", "the_monster_1:name"},
    {"speech.monspeak.ad96e5b043763f20", "{the_monster_1} points {at_foe_1}. \"Kill!\"", "{the_monster_1}指着 {at_foe_1}。“杀！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.adb6fea1f9930d6a", "{the_monster_1} speaks in an indecipherable language.", "{the_monster_1}用一种无法解读的语言说话。", "the_monster_1:name"},
    {"speech.monspeak.adbbe7bae3448ca1", "red", "红色", ""},
    {"speech.monspeak.adbd4dd7fd00e9f7", "{subjective_1} shouts, \"I'll follow you! Let me live!\"", "{subjective_1}喊道：“我会追随你！让我活着！”", "subjective_1:text"},
    {"speech.monspeak.add84c0b2ead3e00", "{the_monster_1} shouts, \"Orcs kill for Beogh, Orcs die for Beogh!\"", "{the_monster_1}喊道：“兽人为比欧弗而杀，兽人为比欧弗而死！”", "the_monster_1:name"},
    {"speech.monspeak.adf490023c40c3e3", "{the_monster_1} says, \"If your ancestor was so tough and powerful, how come they're dead\?\"", "{the_monster_1}说：“要是你的祖先真有那么强悍，他们怎么会死？”", "the_monster_1:name"},
    {"speech.monspeak.ae28c2814cd37c84", "{the_monster_1} {orc_says_to_foe_1}, \"How could Beogh possibly choose you\?\"", "{the_monster_1}{orc_says_to_foe_1}：“比欧弗怎么可能选中你？”", "the_monster_1:name;orc_says_to_foe_1:text"},
    {"speech.monspeak.ae2b8697bb4673ea", "{the_monster_1} says, \"Things are no longer grey! Not since my great insight!\"", "{the_monster_1}说：“自从我获得大彻大悟，东西就不再是灰的了！”", "the_monster_1:name"},
    {"speech.monspeak.ae556df3ff0fb5f7", "{the_monster_1} says, \"They say chivalry is dead. Well, so am I.\"", "{the_monster_1}说：“人们说骑士精神已死。嗯，我也死了。”", "the_monster_1:name"},
    {"speech.monspeak.ae5c404778b1e227", "You feel {the_monster_possessive_1} spirit has finally been put to rest.", "你感到{the_monster_possessive_1}灵魂终于得以安息。", "the_monster_possessive_1:name"},
    {"speech.monspeak.ae5e2575959de0af", "{the_monster_1} says, \"I havnae been down this way for yonks. They've redecorated.\"", "{the_monster_1}说：“俺好久没走这条路了。他们重新装修过了。”", "the_monster_1:name"},
    {"speech.monspeak.ae5fa0cfb4773368", "{the_monster_1} says, \"All of the earth is under my command.\"", "{the_monster_1}说：“整片大地都在我的掌控之中。”", "the_monster_1:name"},
    {"speech.monspeak.ae632e4315bc7415", "{the_monster_1} says, \"Dispater doesn't talk much, but I know they dig me.\"", "{the_monster_1}说：“迪斯帕特话不多，但我知道他们很欣赏我。”", "the_monster_1:name"},
    {"speech.monspeak.ae771dbf54630667", "{channel_1}{the_monster_1} makes some cryptic hand gestures, then points {at_foe_1}.", "{channel_1}{the_monster_1}做了几个神秘的手势，然后指向 {at_foe_1}。", "channel_1:key;the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.ae8accf488f76d4d", "{the_monster_1} says, \"I hate starless nights.\"", "{the_monster_1}说：“我讨厌没有星星的夜晚。”", "the_monster_1:name"},
    {"speech.monspeak.aea1d93efe81c51e", "{the_monster_1} says, \"Selling your soul isn't that bad. What the hell, right\?\"", "{the_monster_1}说：“出卖灵魂也没那么糟。管他呢，对吧？”", "the_monster_1:name"},
    {"speech.monspeak.aea2e19e07cdb19e", "{the_monster_1} {wails_1}, \"You will never get the ORB!\" {player_only_1}", "{the_monster_1} {wails_1}：“你永远也别想拿到宝珠！”{player_only_1}", "the_monster_1:name;wails_1:text;player_only_1:text"},
    {"speech.monspeak.aebf6ab0c9e63be3", "{channel_1}{the_monster_1} flits into the dungeon's darkness for a moment.", "{channel_1}{the_monster_1}倏地飞进地牢的黑暗之中，停留了片刻。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.aebff226a6d0a951", "{the_monster_1} falls down, and clutches {possessive_1} wounds. \"But I was going to get a {harold_retirement_plan_1}...\"", "{the_monster_1}倒在地上，捂着{possessive_1}伤口。“可我本来就要得到{harold_retirement_plan_1}了啊……”", "the_monster_1:name;possessive_1:text;harold_retirement_plan_1:text"},
    {"speech.monspeak.aecde2fc6b1265e7", "{channel_1}{the_monster_possessive_1} armour gleams in the torchlight.", "{channel_1}{the_monster_possessive_1}盔甲在火把光下闪闪发亮。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.af1998a6c926e0c6", "{the_monster_1} says, \"I can't get this icky slime off my feet.\"", "{the_monster_1}说：“我脚上这黏糊糊的黏液怎么也弄不掉。”", "the_monster_1:name"},
    {"speech.monspeak.af1aa075b5e03fd4", "{generic_orc_speech_1}", "{generic_orc_speech_1}", "generic_orc_speech_1:text"},
    {"speech.monspeak.af2f98003d579ec9", "{the_monster_1} muses, \"Oh, to be as impervious as an emperor scorpion...\"", "{the_monster_1}沉思道：“啊，要是能像帝王蝎一样刀枪不入……”", "the_monster_1:name"},
    {"speech.monspeak.af3c3341e97bbff6", "{the_monster_1} snarls {at_foe_1}, \"My dungeon! Leave!\"", "{the_monster_1}咆哮道 {at_foe_1}：“我的地牢！出去！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.af3ec309da34acb7", "{channel_1}{the_monster_1} looks at {possessive_1} axe, then at {foe_1}, then at {possessive_2} axe, then at {foe_2}...", "{channel_1}{the_monster_1}看看{possessive_1}斧头，再看看{foe_1}，又看看{possessive_2}斧头，再看看{foe_2}……", "channel_1:key;the_monster_1:name;possessive_1:text;foe_1:text;possessive_2:text;foe_2:text"},
    {"speech.monspeak.af4bfb4d1acb9c92", "{zenata_common_1}", "{zenata_common_1}", "zenata_common_1:text"},
    {"speech.monspeak.af53ae3609abab60", "tea", "茶", ""},
    {"speech.monspeak.af67579f1c8ddf9b", "{the_monster_1} says {to_foe_1}, \"Life is a curse, you will soon understand.\"", "{the_monster_1}说 {to_foe_1}：“生命是一场诅咒，你很快就会明白。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.af6f39e762b3a81b", "{the_monster_1} {norris_verb_1} {to_foe_1}, \"We're all made of gods.\"", "{the_monster_1}{norris_verb_1} {to_foe_1}：“我们都是由神构成的。”", "the_monster_1:name;norris_verb_1:text;to_foe_1:text"},
    {"speech.monspeak.af793d05249b81d2", "{the_monster_1} {yells_1}, \"Help!\"", "{the_monster_1} {yells_1}：“救命！”", "the_monster_1:name;yells_1:text"},
    {"speech.monspeak.af79cb8f92a500fb", "{channel_1}{the_monster_1} tries to sneak away.", "{channel_1}{the_monster_1}试图悄悄溜走。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.af8a8230964912ce", "{the_monster_1} snarls, \"I will not be driven out again.\"", "{the_monster_1}咆哮道：“我不会再被赶走。”", "the_monster_1:name"},
    {"speech.monspeak.af8b2766c657cac9", "{the_monster_1} says, \"I was beautiful once. Now look at me.\"", "{the_monster_1}说：“我也曾美丽过。你看看我现在。”", "the_monster_1:name"},
    {"speech.monspeak.afb333ace7df2df5", "{the_monster_1} says, \"A rolling stone gathers plenty of {foe_name_1}.\"", "{the_monster_1}说：“滚石不生苔，却能碾过不少{foe_name_1}。”", "the_monster_1:name;foe_name_1:name"},
    {"speech.monspeak.afbd39d153813c1e", "{the_monster_1} says, \"Path\? I don't see a path anywhere.\"", "{the_monster_1}说：“道？我哪儿都没看见什么道。”", "the_monster_1:name"},
    {"speech.monspeak.afc1576bdb76af76", "{the_monster_1} says {to_foe_1}, \"You're just another fly to me.\"", "{the_monster_1}说 {to_foe_1}：“你对我来说不过是另一只苍蝇。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.afcfcbd35fec3477", "{the_monster_1} muses, \"Killing is much more fun than I thought it would be.\"", "{the_monster_1}若有所思道：“杀戮比我原以为的有趣多了。”", "the_monster_1:name"},
    {"speech.monspeak.afd2f4766a05144e", "{the_monster_1} says, \"You will make such fine fertiliser.\"", "{the_monster_1}说：“你会成为上好的肥料。”", "the_monster_1:name"},
    {"speech.monspeak.afdeaff0260c108e", "{the_monster_1} says, \"I hate mosquitoes. Almost as much as I hate swamp water.\"", "{the_monster_1}说：“我讨厌蚊子。几乎跟我讨厌沼泽水一样多。”", "the_monster_1:name"},
    {"speech.monspeak.aff53390bd0284ff", "Mugger", "抢劫犯", ""},
    {"speech.monspeak.b020717a6805cc73", "{the_monster_1} whispers {to_foe_1}, \"You'll know eternity soon.\"", "{the_monster_1}低语道 {to_foe_1}：“你很快就会体会到永恒。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.b0248ce26fa9ac91", "{the_monster_1} says {to_foe_1}, \"When magic and the sword combine, nothing stands against them.\"", "{the_monster_1}说 {to_foe_1}：“当魔法与剑合为一体，任何东西都抵挡不住。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.b038deb1b52c5c31", "{default_confused_winged_insect_1}", "{default_confused_winged_insect_1}", "default_confused_winged_insect_1:text"},
    {"speech.monspeak.b0543bace3ebd9fe", "{the_monster_1} breathes, \"And she was my only...\"", "{the_monster_1}低声道：“而她是我唯一的……”", "the_monster_1:name"},
    {"speech.monspeak.b05bed8ce7d4921d", "{the_monster_1} says {to_foe_1}, \"There's a certain beauty in death, don't you think\?\"", "{the_monster_1}说 {to_foe_1}：“死亡中有一种别样的美，你不觉得吗？”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.b068dfe667ec9e38", "{channel_1}{the_monster_1} flexes.", "{channel_1}{the_monster_1}炫耀着肌肉。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.b07b4f4071aa4c49", "Race", "赛跑", ""},
    {"speech.monspeak.b0adb0c6e8efc5c7", "{the_monster_1} says, \"At least there aren't any ducks around. I hate ducks.\"", "{the_monster_1}说：“至少这附近没有鸭子。我讨厌鸭子。”", "the_monster_1:name"},
    {"speech.monspeak.b0ba77ed3d7bb864", "{the_monster_1} says, \"I love the smell of burning flesh.\"", "{the_monster_1}说：“我爱极了人肉烧焦的味儿。”", "the_monster_1:name"},
    {"speech.monspeak.b0de1447937a8dd2", "{the_monster_1} whispers, \"Once you die, everything will be fine. It promises.\"", "{the_monster_1}低声说：“等你一死，一切都会好起来的。它保证过。”", "the_monster_1:name"},
    {"speech.monspeak.b0e8480d32eabbde", "{the_monster_1} begins to sob.", "{the_monster_1}开始抽泣。", "the_monster_1:name"},
    {"speech.monspeak.b0f97e3d667592d5", "{the_monster_1} says, \"I'm an Orc, you're an Orc, it's OK.\"", "{the_monster_1}说：“我是兽人，你是兽人，一切都好。”", "the_monster_1:name"},
    {"speech.monspeak.b191bcca580f210d", "{channel_1}{the_monster_1} scratches at a flea.", "{channel_1}{the_monster_1}挠着一只跳蚤。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.b196932805f9d4d6", "{channel_1}{the_monster_1} seems to be listening.", "{channel_1}{the_monster_1}像是在倾听着什么。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.b1a548341b991fea", "{the_monster_1} laughs uncontrollably.", "{the_monster_1}无法自制地大笑。", "the_monster_1:name"},
    {"speech.monspeak.b1b025cc05372f4e", "{the_monster_1} says, \"I think I remember you...\"", "{the_monster_1}说：“我好像记得你……”", "the_monster_1:name"},
    {"speech.monspeak.b1edd7e6b840f0a3", "disdain", "蔑视", ""},
    {"speech.monspeak.b1fc7f5da25683af", "{the_monster_1} rumbles {at_foe_1}, \"YOU LOOK DELICIOUS.\"", "{the_monster_1}低沉地吼道 {at_foe_1}：“你看起来很好吃。”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.b2025bc1e12e4b77", "{channel_1}{the_monster_1} contemplates whether Beogh's temples would look better painted {blorkula_colour_1}.", "{channel_1}{the_monster_1}琢磨着比欧弗的神殿要是刷成{blorkula_colour_1}会不会更好看。", "channel_1:key;the_monster_1:name;blorkula_colour_1:text"},
    {"speech.monspeak.b2028733b3fe72dd", "{channel_1}{the_monster_1} furiously scribbles notes with a free limb.", "{channel_1}{the_monster_1}用一条空着的肢体飞快地记着笔记。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.b20f5169cf846018", "{the_monster_1} says, \"I'll never leave you.\"", "{the_monster_1}说：“我永远不会离开你。”", "the_monster_1:name"},
    {"speech.monspeak.b22a6bb5b473ab06", "{the_monster_1} says, \"I hate the gods.\"", "{the_monster_1}说：“我讨厌众神。”", "the_monster_1:name"},
    {"speech.monspeak.b22d12d860cddcb8", "Xom", "佐姆", ""},
    {"speech.monspeak.b230994f2b57e2a6", "{the_monster_1} says, \"Some mausoleum.\"", "{the_monster_1}说：“这也叫陵墓。”", "the_monster_1:name"},
    {"speech.monspeak.b23e056d83ed7011", "cries", "哭喊道", ""},
    {"speech.monspeak.b24b3e686b2e16c2", "{channel_1}{the_monster_1} stares vacantly at {possessive_1} hideously deformed hands.", "{channel_1}{the_monster_1}茫然地盯着{possessive_1}畸形得可怕的手。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.b25981f8a989f176", "{channel_1}{the_monster_1} shakes with grief.", "{channel_1}{the_monster_1}悲痛地颤抖着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.b27ab38e6bff2458", "{player_ghost_rare_1}", "{player_ghost_rare_1}", "player_ghost_rare_1:text"},
    {"speech.monspeak.b27e6796cfb03fb3", "{the_monster_1} lectures the ground at length about {important_subject_1}", "{the_monster_1}对着地面长篇大论地讲{important_subject_1}", "the_monster_1:name;important_subject_1:text"},
    {"speech.monspeak.b2889cc7f77cffde", "{the_monster_1} smirks. \"I am one who seeks the Path and the Right.\"", "{the_monster_1}得意一笑。“我就是那求索大道与正法之人。”", "the_monster_1:name"},
    {"speech.monspeak.b2951401a2495323", "{the_monster_1} says, \"Don't worry about being fed to the lions. Worry about being fed to me.\"", "{the_monster_1}说：“别担心被喂给狮子。该担心的是被喂给我。”", "the_monster_1:name"},
    {"speech.monspeak.b29f59cec08efef0", "{the_monster_1} says, \"This beard itches something crazy!\"", "{the_monster_1}说：“这把胡子痒得真要命！”", "the_monster_1:name"},
    {"speech.monspeak.b2aa2e244a012c30", "{the_monster_1} whispers, \"You will understand me better in a moment.\"", "{the_monster_1}低声说：“再过一会儿，你就会更理解我了。”", "the_monster_1:name"},
    {"speech.monspeak.b2c2e8585425dc13", "{channel_1}{the_monster_1} {choice_1} stumbles in trying to escape.", "{channel_1}{the_monster_1}在试图逃跑时{choice_1}被绊倒。", "channel_1:key;the_monster_1:name;choice_1:text"},
    {"speech.monspeak.b2c2e8585425dc13.choice_1.alt_0", "almost", "几乎", ""},
    {"speech.monspeak.b2c2e8585425dc13.choice_1.alt_1", "nearly", "差点", ""},
    {"speech.monspeak.b2d2e4e4d1a62469", "{the_monster_1} says, \"Can you turn the glow down a bit\? I can't see you to hit you.\"", "{the_monster_1}说：“你能把光调暗点吗？我亮得看不见你，都打不着你了。”", "the_monster_1:name"},
    {"speech.monspeak.b2e3dba1d6c184ea", "fields ablaze", "田野在燃烧", ""},
    {"speech.monspeak.b2fe05213c676cf4", "{the_monster_1} draws the Storm. \"Thunder and lightning everywhere!\"", "{the_monster_1}抽到了风暴。“到处都是电闪雷鸣！”", "the_monster_1:name"},
    {"speech.monspeak.b3016bd3bd6b854f", "{the_monster_1} says, \"Try not to bleed too much.\"", "{the_monster_1}说：“尽量别流太多血。”", "the_monster_1:name"},
    {"speech.monspeak.b3047c424153740d", "{the_monster_1} says, \"Be happy - you can't get any slower than dead.\"", "{the_monster_1}说：“开心点吧——你没法比死人更慢了。”", "the_monster_1:name"},
    {"speech.monspeak.b30f921f7f2adb15", "{hell_lord_taunt_1}", "{hell_lord_taunt_1}", "hell_lord_taunt_1:text"},
    {"speech.monspeak.b311440fddc839da", "{the_monster_1} growls that the stars belong to nobody but the stars.", "{the_monster_1}低吼道，星辰只属于星辰，不属于任何人。", "the_monster_1:name"},
    {"speech.monspeak.b31de28f8a916f8f", "{channel_1}Hollow, blind eyes appear on {the_monster_possessive_1} head.", "{channel_1}{the_monster_possessive_1}头上出现了空洞而失明的眼睛。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.b3218d3d27abe122", "{channel_1}{the_monster_1} stamps {possessive_1} feet.", "{channel_1}{the_monster_1}跺着{possessive_1}双脚。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.b337d3892326369b", "{the_monster_1} says, \"My boss said I was rubbish. His entrails said otherwise.\"", "{the_monster_1}说：“我老板说我是废物。他的内脏另有说法。”", "the_monster_1:name"},
    {"speech.monspeak.b340104864118272", "{the_monster_1} says {to_foe_1}, \"I've waited for this moment for such a long time.\"", "{the_monster_1}说 {to_foe_1}：“这一刻我已经等了很久了。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.b34e23281d617dbf", "{the_monster_1} says, \"I have seen worlds and universes beyond all imagining.\"", "{the_monster_1}说：“我见过超乎一切想象的世界与宇宙。”", "the_monster_1:name"},
    {"speech.monspeak.b38ff219606d8a62", "{the_monster_1} says, \"ME ROCKS!\"", "{the_monster_1}说：“俺就是石头！”", "the_monster_1:name"},
    {"speech.monspeak.b394dd5b390961db", "{the_monster_1} {wails_1}, \"You will join me soon!\"", "{the_monster_1} {wails_1}：“你很快就会来陪我的！”", "the_monster_1:name;wails_1:text"},
    {"speech.monspeak.b3c6c945a55f3384", "{the_monster_1} screams, \"I am only a sick, bizarre, defaced creation.\"", "{the_monster_1}尖叫道：“我只是一个病态、怪异、被毁了容的造物。”", "the_monster_1:name"},
    {"speech.monspeak.b3cecd6445ccb6a0", "{fleeing_humanoid_common_1}", "{fleeing_humanoid_common_1}", "fleeing_humanoid_common_1:text"},
