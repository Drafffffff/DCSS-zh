    {"speech.monspeak.8d79b9fb275ecfc8", "eyeball", "眼球", ""},
    {"speech.monspeak.8d7a729172f8e5fe", "the alliance of Zin and Elyvilon.", "辛与艾利维隆的同盟。", ""},
    {"speech.monspeak.8d8385613b3667dc", "{the_monster_1} says, \"Form is emptiness; emptiness is form.\"", "{the_monster_1}说：“色即是空，空即是色。”", "the_monster_1:name"},
    {"speech.monspeak.8d8a8463a349ee3e", "{the_monster_1} screams {at_foe_1}, \"Prepare for a defeathering!\"", "{the_monster_1}尖叫道 {at_foe_1}：“准备被拔毛吧！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.8dc393a93fdc089c", "{the_monster_1} mumbles, \"Pollen collection still 41% less efficient. Must improve.\"", "{the_monster_1}咕哝道：“花粉采集效率仍然低了41%。必须改进。”", "the_monster_1:name"},
    {"speech.monspeak.8de79c804a4150ee", "{channel_1}{the_monster_1} whirls about in circles.", "{channel_1}{the_monster_1}原地打转。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.8de8ba97a3485730", "Cholesterol", "胆固醇", ""},
