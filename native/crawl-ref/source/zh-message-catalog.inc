    {"speech.monspeak.f25479f51e65b7e5", "{the_monster_1} says, \"You'd better watch out. The one on the left looks like he gets lost easily.\"", "{the_monster_1}说：“你最好小心点。左边那个看起来很容易迷路。”", "the_monster_1:name"},
    {"speech.monspeak.f261194608d0ad0e", "{the_monster_1} {says_or_shouts_1}, \"I am so glad I met you.\"", "{the_monster_1}{says_or_shouts_1}：“能遇到你我真是太高兴了。”", "the_monster_1:name;says_or_shouts_1:text"},
    {"speech.monspeak.f272b236c0a4913f", "{the_monster_1} {shouts_1}, \"Orcs rule!\"", "{the_monster_1}{shouts_1}：“兽人万岁！”", "the_monster_1:name;shouts_1:text"},
    {"speech.monspeak.f2759121e666418d", "{the_monster_1} screams {at_foe_1}, \"Hey, you killed my favourite bat!\"", "{the_monster_1}尖叫 {at_foe_1}：“嘿，你杀了我最喜欢的蝙蝠！”", "the_monster_1:name;at_foe_1:text"},
