    {"speech.monspeak.197af841f8e399f1", "{the_monster_1} says {to_foe_1}, \"Now you see me, now you don't...\"", "{the_monster_1}说 {to_foe_1}：“一会儿看得见我，一会儿看不见……”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.1989985f405fec2d", "{the_monster_1} affirms to {reflexive_1}, \"Our love will make it through this.\"", "{the_monster_1}对{reflexive_1}坚定地说道：“我们的爱会让我们渡过这一切。”", "the_monster_1:name;reflexive_1:text"},
    {"speech.monspeak.1993e55142a213c1", "our flesh being taken", "我们的肉被割走", ""},
    {"speech.monspeak.199af56faa835156", "{channel_1}{the_monster_1} smiles at you.", "{channel_1}{the_monster_1}冲你微笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.199e8f7fcbe838b1", "{the_monster_1} says, \"ROCKS!\"", "{the_monster_1}说：“石头！”", "the_monster_1:name"},
    {"speech.monspeak.19aa3614f8973068", "{the_monster_1} says {to_foe_1}, \"Know thy enemy, and know thyself.\"", "{the_monster_1}说 {to_foe_1}：“知彼知己。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.19b68a52c92fe1f7", "grunts", "哼声道", ""},
    {"speech.monspeak.19dd6202c32648d3", "{the_monster_1} says, \"You never know good fortune from ill. It is because you cannot see into the future.\"", "{the_monster_1}说：“你从分不清好运与厄运。那是因为你看不见未来。”", "the_monster_1:name"},
    {"speech.monspeak.19fa5bfa5c5bfb81", "{channel_1}{the_monster_1} twists in agony.", "{channel_1}{the_monster_1}在极度痛苦中扭动。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.1a0208786acef812", "{the_monster_1} gurgles loudly.", "{the_monster_1}大声地发出咕噜声。", "the_monster_1:name"},
    {"speech.monspeak.1a24b84535c6cd7c", "{the_monster_1} sings, \"To sleep, to sleep... mayhap to drown.\"", "{the_monster_1}唱道：“睡吧，睡吧……说不定就此溺亡。”", "the_monster_1:name"},
    {"speech.monspeak.1a4b902de04b613e", "{the_monster_1} says, \"You will never get the ORB, sorry.\" {player_only_1}", "{the_monster_1}说：“抱歉，你永远也拿不到宝珠。”{player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.1a61bdfae35d34e6", "{the_monster_1} says {to_foe_1}, \"I shall send you to the shadows!\"", "{the_monster_1}说 {to_foe_1}：“我将把你送进阴影之中！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.1a621cc4533c16fa", "{the_monster_1} says {to_foe_1}, \"Don't just stand there! You can move, can't you\?\"", "{the_monster_1}说 {to_foe_1}：“别就站在那儿！你不是能动的吗？”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.1a62298117a6e4c0", "{the_monster_1} screams {at_foe_1}, \"{foe_god_1} will weep as I flay your corpse!\"", "{the_monster_1}尖叫 {at_foe_1}：“等我剥你的皮时，{foe_god_1}会痛哭的！”", "the_monster_1:name;at_foe_1:text;foe_god_1:name"},
    {"speech.monspeak.1a75ff8fa11d3990", "{the_monster_1} says, \"Get out, get out, get out!\"", "{the_monster_1}说：“滚出去，滚出去，滚出去！”", "the_monster_1:name"},
    {"speech.monspeak.1a8a99b27eb9dd2b", "{the_monster_1} says, \"Challenge me\? You, and whose army\?\" {player_only_1}", "{the_monster_1}说：“挑战我？就你，还有谁的军队？”{player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.1a91af4d896bdd5f", "magnate", "权贵", ""},
    {"speech.monspeak.1a9378d39eb6cb5b", "{the_monster_1} says {to_foe_1}, \"Appear where you are not expected.\"", "{the_monster_1}说 {to_foe_1}：“出现在敌人意想不到的地方。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.1aa6906fda76b74d", "{the_monster_1} says, \"I always freeze up when I think I'm being watched.\"", "{the_monster_1}说：“一想到有人在看我，我就会僵住。”", "the_monster_1:name"},
    {"speech.monspeak.1ab09f660754bebc", "{the_monster_1} says, \"I hate elementals.\"", "{the_monster_1}说：“我讨厌元素生物。”", "the_monster_1:name"},
    {"speech.monspeak.1ab4fcec74d2a7c4", "useless", "白费的", ""},
    {"speech.monspeak.1ac541e6322e711a", "{the_monster_1} says, \"You're just another problem to be solved.\"", "{the_monster_1}说：“你不过是又一个待解决的问题。”", "the_monster_1:name"},
