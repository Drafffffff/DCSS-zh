    {"speech.monspeak.905bacf505864bc7", "proper care of body and soul.", "对身心妥善的照料。", ""},
    {"speech.monspeak.90800547654714de", "{the_monster_1} screams, \"Yes, yes!\"", "{the_monster_1}尖叫道：“好，好！”", "the_monster_1:name"},
    {"speech.monspeak.9082cda599b44c46", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.90863cb9907176ea", "{the_monster_1} says, \"What's so abyssal about tentacles and stars\?\"", "{the_monster_1}说：“触手和星星到底哪里深渊了？”", "the_monster_1:name"},
    {"speech.monspeak.908c51603f045ee6", "{the_monster_1} says, \"I value strength and power. I see none of this in you.\" {player_only_1}", "{the_monster_1}说：“我看重力量和权势。我在你身上一样都看不到。”{player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.909c76f7653452cc", "{the_monster_1} says, \"I just stubbed my toe. Does that mean I'm cleansed\?\"", "{the_monster_1}说：“我刚撞到脚趾了。这是不是说明我被净化了？”", "the_monster_1:name"},
    {"speech.monspeak.90a9f77206e3e7a5", "{channel_1}{the_monster_1} clenches {possessive_1} teeth.", "{channel_1}{the_monster_1}咬紧{possessive_1}牙。", "channel_1:key;the_monster_1:name;possessive_1:text"},
