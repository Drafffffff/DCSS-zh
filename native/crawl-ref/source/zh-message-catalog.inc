    {"monster.special.habitat.walk_water", "{subject} can walk on water.\n", "{subject}能在水面行走。\n", "subject:name"},
    {"monster.special.habitat.water", "{subject} can travel through water.\n", "{subject}能在水中穿行。\n", "subject:name"},
    {"monster.special.insubstantial.plural", "{subject} are insubstantial and immune to ensnarement.\n", "{subject}没有实体，且免疫缠绕。\n", "subject:name"},
    {"monster.special.insubstantial.singular", "{subject} is insubstantial and immune to ensnarement.\n", "{subject}没有实体，且免疫缠绕。\n", "subject:name"},
