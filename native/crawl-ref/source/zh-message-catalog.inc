    {"speech.monspeak.b3dae9eef5ccce52", "{the_monster_1} says, \"A pitiful {player_genus_1} like you will never find the ORB!\"", "{the_monster_1}说：“像你这样可怜的{player_genus_1}，永远也别想找到宝珠！”", "the_monster_1:name;player_genus_1:name"},
