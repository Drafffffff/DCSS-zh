    {"speech.monspeak.8ed9960d0fe7c887", "havoc", "浩劫", ""},
    {"speech.monspeak.8ee25f4b977c2ace", "{the_monster_1} screams {at_foe_1}, \"Die!\"", "{the_monster_1}尖叫 {at_foe_1}：“死！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.8f02fefea6ce517d", "{the_monster_1} says, \"I break bones and crack skulls... with my bare hands.\"", "{the_monster_1}说：“我折断骨头、敲碎头颅……全凭一双空手。”", "the_monster_1:name"},
    {"speech.monspeak.8f1524b095cc5b6c", "{the_monster_1} says, \"I had a teddy bear once. I hated it.\"", "{the_monster_1}说：“我曾经有一只泰迪熊。我讨厌它。”", "the_monster_1:name"},
