    {"speech.monspeak.ef3f583f34e2ab26", "{the_monster_1} shouts, \"{grum_dog_name_1}! Good boy!\"", "{the_monster_1}喊道：“{grum_dog_name_1}！好狗狗！”", "the_monster_1:name;grum_dog_name_1:name"},
    {"speech.monspeak.ef417726ae4bad5f", "{the_monster_1} mumbles, \"They all look like pillowcases to me...\"", "{the_monster_1}咕哝道：“在我眼里它们都像枕套……”", "the_monster_1:name"},
    {"speech.monspeak.ef5156ee74308fc9", "{the_monster_1} says {to_foe_1}, \"Attack is the secret of defence.\"", "{the_monster_1}说 {to_foe_1}：“进攻正是防御的秘诀。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.ef52470878aa18d0", "{channel_1}{the_monster_1} polishes {possessive_1} monocle.", "{channel_1}{the_monster_1}擦拭着{possessive_1}单片眼镜。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.ef540cc23ac3ac09", "{the_monster_1} screams {at_foe_1}, \"Erolcha crush your head!\"", "{the_monster_1}尖叫 {at_foe_1}：“厄洛卡砸碎你的头！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.ef5a6f6f3bdc0ffd", "{the_monster_1} screams at {foe_1}, \"You cannot imagine the pain and torment in store for you!\"", "{the_monster_1}冲{foe_1}尖叫：“等着你的是无尽的痛苦与折磨，你根本想象不到！”", "the_monster_1:name;foe_1:text"},
    {"speech.monspeak.ef7024d948d31494", "{the_monster_1} says, \"It makes honey *and* kills pests. Ingenious!\"", "{the_monster_1}说：“它既能产蜜，又能杀虫。绝妙！”", "the_monster_1:name"},
    {"speech.monspeak.ef8443bd6ea1b66f", "{the_monster_1} says, \"I excel at staving off weak adventurers.\"", "{the_monster_1}说：“用长棍打发弱小冒险者是我的拿手好戏。”", "the_monster_1:name"},
    {"speech.monspeak.ef9ef303db007b3a", "torment and damnation", "折磨与诅咒", ""},
    {"speech.monspeak.efb3ecf1f167ab58", "{the_monster_1} says, \"You came back for me.\"", "{the_monster_1}说：“你回来找我了。”", "the_monster_1:name"},
    {"speech.monspeak.efe75daa686d5f4e", "{channel_1}{the_monster_1} makes a rude gesture at you.", "{channel_1}{the_monster_1}冲你做了个粗鲁的手势。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.f049da60a6d27f39", "{the_monster_1} says, \"Why would you want to visit the Abyss\? For a holiday\?\"", "{the_monster_1}说：“你为什么要去深渊？度假吗？”", "the_monster_1:name"},
    {"speech.monspeak.f073dc943ee844c6", "{the_monster_1} says {to_foe_1}, \"A mighty warrior you might be, a mason you are not!\"", "{the_monster_1}说 {to_foe_1}：“你或许是个强大的战士，但绝不是个石匠！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.f07e92c1af2e7e32", "{subjective_1} shouts, \"{player_name_1} is one of us!\"", "{subjective_1}喊道：“{player_name_1}是我们的一员！”", "subjective_1:text;player_name_1:name"},
    {"speech.monspeak.f08f9d64f07e0f79", "{the_monster_1} shouts, \"Zap! Ha ha ha, made you jump.\"", "{the_monster_1}喊道：“噼啪！哈哈哈，吓你一跳。”", "the_monster_1:name"},
    {"speech.monspeak.f0b97e6d80c14411", "{the_monster_1} says, \"Let's see what's inside you.\"", "{the_monster_1}说：“来看看你肚子里装了些什么。”", "the_monster_1:name"},
    {"speech.monspeak.f0d2a046cb4de226", "{the_monster_1} laughs, \"An explosive gambit... I hate that.\"", "{the_monster_1}笑道：“一场爆炸性的妙着……我讨厌这样。”", "the_monster_1:name"},
