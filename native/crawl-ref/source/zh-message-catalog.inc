    {"speech.monspeak.14b0d1a695021be2", "horse ranch", "马场", ""},
    {"speech.monspeak.1502900ed20c3e70", "dying of thirst", "渴得要死", ""},
    {"speech.monspeak.1506932b198b0393", "{the_monster_1} says, \"Headshot.\"", "{the_monster_1}说：“爆头。”", "the_monster_1:name"},
    {"speech.monspeak.150ecb15d8f6aac0", "{the_monster_1} says {to_foe_1}, \"Listen, it's nothing personal. It's just a job.\"", "{the_monster_1}说 {to_foe_1}：“听着，这不是私人恩怨。这只是份工作。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.153e3da13ac4f43b", "{the_monster_1} says, \"Antaeus said I was his favorite kobold. Me!\"", "{the_monster_1}说：“安泰俄斯说我是他最喜欢的狗头人。我！就我！”", "the_monster_1:name"},
    {"speech.monspeak.154ba6f7a36558a6", "{channel_1}{the_monster_1} shakes in grief and horror.", "{channel_1}{the_monster_1}在悲痛与恐惧中颤抖着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.154d7096fd223442", "Earwax", "耳屎", ""},
    {"speech.monspeak.154e9a0766e6606f", "{the_monster_1} says, \"The air in here stinks. I hate that.\"", "{the_monster_1}说：“这里的空气臭死了。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.15578f912338c19f", "{the_monster_1} roars, \"I'VE KILLED HUNDREDS OF ADVENTURERS!\" {player_only_1}", "{the_monster_1}咆哮道：“我杀过的冒险者数以百计！” {player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.15623e12fb8617e3", "{the_monster_1} {orc_shouts_1} to no one in particular.", "{the_monster_1}{orc_shouts_1}，也不知是说给谁听的。", "the_monster_1:name;orc_shouts_1:text"},
