    {"monster.special.animated_item.singular", "{subject} is an unusual item.\n", "{subject}是一件奇特物品。\n", "subject:name"},
    {"monster.special.burrow", "{subject} can burrow through diggable terrain.\n", "{subject}能在可挖掘地形中掘行。\n", "subject:name"},
    {"monster.special.chaotic.plural", "{subject} are vulnerable to silver and hated by Zin.\n", "{subject}容易受到银器伤害，也为津恩所厌恶。\n", "subject:name"},
    {"monster.special.chaotic.singular", "{subject} is vulnerable to silver and hated by Zin.\n", "{subject}容易受到银器伤害，也为津恩所厌恶。\n", "subject:name"},
    {"monster.special.cold_blooded.plural", "{subject} are cold-blooded and may be slowed by cold attacks.\n", "{subject}是冷血生物，可能会被寒冷攻击减速。\n", "subject:name"},
    {"monster.special.cold_blooded.singular", "{subject} is cold-blooded and may be slowed by cold attacks.\n", "{subject}是冷血生物，可能会被寒冷攻击减速。\n", "subject:name"},
    {"monster.special.explosion_damage", "Explosion damage: {dice}d{sides}\n", "爆炸伤害：{dice}d{sides}\n", "dice:integer;sides:integer"},
