    {"speech.monspeak.5d7de391d8769080", "{the_monster_1} mumbles, \"Nectar collection still 37% less efficient. Must improve.\"", "{the_monster_1}咕哝道：“花蜜采集效率仍然低了37%。必须改进。”", "the_monster_1:name"},
    {"speech.monspeak.5d80285efcab6833", "potions of mutation - the devil's brew!", "变异药水——魔鬼的酿造！", ""},
    {"speech.monspeak.5d8159bba5ff520f", "{the_monster_1} shouts, \"Mine, all mine!\"", "{the_monster_1}喊道：“我的，全是我的！”", "the_monster_1:name"},
    {"speech.monspeak.5d9906cd19fdb21c", "{the_monster_1} screams {at_foe_1}, \"DIE!\"", "{the_monster_1}尖叫 {at_foe_1}：“死！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.5da31ab8a8f787fa", "{the_monster_1} wails, \"So itchy! Itchy, itchy, itchy! Always itchy!\"", "{the_monster_1}哀号道：“好痒！痒，痒，痒！总是痒！”", "the_monster_1:name"},
    {"speech.monspeak.5dc2fe6712872fba", "Snurf", "斯纳夫", ""},
    {"speech.monspeak.5dd3b48115d9a573", "{the_monster_1} says, \"You should only rely on techniques you've developed yourself.\"", "{the_monster_1}说：“你只应依靠自己磨炼出的招式。”", "the_monster_1:name"},
