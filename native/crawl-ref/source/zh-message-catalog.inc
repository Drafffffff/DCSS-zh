    {"speech.monspeak.2878f62aada0bd21", "{the_monster_1} says, \"Did you bring your rings of ice\?\"", "{the_monster_1}说：“你带上你的寒冰戒指了吗？”", "the_monster_1:name"},
    {"speech.monspeak.28920fade10b14bc", "{the_monster_1} says, \"My feet hurt.\"", "{the_monster_1}说：“我的脚好痛。”", "the_monster_1:name"},
