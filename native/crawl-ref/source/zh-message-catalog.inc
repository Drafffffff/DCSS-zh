    {"speech.monspeak.8e6ceb7d381831a1", "{the_monster_1} salutes you before departing.", "{the_monster_1}在离去前向你敬礼。", "the_monster_1:name"},
    {"speech.monspeak.8ebfdb831e51e599", "{the_monster_1} draws {deck_of_oddities_card_1}. \"Wait, this doesn't belong here!\"", "{the_monster_1}抽到了{deck_of_oddities_card_1}。“等等，这张牌不该在这儿！”", "the_monster_1:name;deck_of_oddities_card_1:text"},
