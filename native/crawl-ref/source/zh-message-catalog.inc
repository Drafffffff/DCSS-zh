    {"speech.monspeak.90cb2f6d6af1b14b", "{the_monster_1} grieves for the multitudes of fallen {choice_1}.", "{the_monster_1}为无数覆灭的{choice_1}哀悼。", "the_monster_1:name;choice_1:text"},
    {"speech.monspeak.90cb2f6d6af1b14b.choice_1.alt_0", "empires", "帝国", ""},
    {"speech.monspeak.90cb2f6d6af1b14b.choice_1.alt_1", "civilisations", "文明", ""},
    {"speech.monspeak.90d387c38473cc52", "{channel_1}{the_monster_1} hopefully picks up a piece of driftwood and looks at you.", "{channel_1}{the_monster_1}满怀希望地叼起一块浮木，看着你。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.90d857c0ce72865b", "magnificent", "华丽的", ""},
    {"speech.monspeak.90e044294698842e", ", in orcish tradition.", "，这是兽人的传统。", ""},
    {"speech.monspeak.90e1c0436b964ddd", "{the_monster_1} snorts and paws the {surface_1}.", "{the_monster_1}喷着鼻息，用蹄子刨着{surface_1}。", "the_monster_1:name;surface_1:text"},
