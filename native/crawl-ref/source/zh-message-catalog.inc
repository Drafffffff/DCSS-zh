    {"speech.monspeak.8e337756d5858300", "{the_monster_1} says {to_foe_1}, \"You are dead.\"", "{the_monster_1}说 {to_foe_1}：“你死定了。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.8e43c39320cbff96", "{the_monster_1} says, \"Looks like you fold, gambler.\"", "{the_monster_1}说：“看来你弃牌认输了，赌徒。”", "the_monster_1:name"},
