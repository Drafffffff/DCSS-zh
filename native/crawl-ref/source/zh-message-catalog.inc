    {"item.potion.ac", "If you quaff this potion your AC would be {armour_class}.", "喝下这瓶药水后，你的护甲等级将为{armour_class}。", "armour_class:integer"},
    {"item.potion.cancellation", "\n\nIf you drink this now, you will no longer be {state}.", "\n\n如果你现在喝下它，将不再处于{state}状态。", "state:text"},
    {"item.potion.dexterity", "\n\nIt affects your dexterity ({amount}).", "\n\n它会影响你的敏捷（{amount}）。", "amount:integer"},
    {"item.potion.evasion", "\n\nIt affects your evasion ({amount}).", "\n\n它会影响你的闪避值（{amount}）。", "amount:integer"},
    {"item.potion.intelligence", "\n\nIt affects your intelligence ({amount}).", "\n\n它会影响你的智力（{amount}）。", "amount:integer"},
    {"item.potion.lignify_ac", "If you quaff this potion your AC would be {ac}.", "如果你喝下这瓶药水，护甲将变为{ac}。", "ac:integer"},
    {"item.potion.shielding", "\n\nIt affects your shielding ({amount}).", "\n\n它会影响你的格挡值（{amount}）。", "amount:integer"},
    {"item.potion.strength", "\n\nIt affects your strength ({amount}).", "\n\n它会影响你的力量（{amount}）。", "amount:integer"},
    {"item.projectile.always_destroyed.fixed", "\n\nIt is always destroyed on impact.", "\n\n命中后必定损毁。", ""},
    {"item.projectile.destroy_chance", "\n\nIt has a 1/{chance} chance to be destroyed on impact.", "\n\n它命中后有1/{chance}的几率损毁。", "chance:integer"},
    {"item.projectile.stats_and_minimum_delay", "\n\nBase damage: {damage}  Base attack delay: {base_delay}\nThis projectile's minimum attack delay ({minimum_delay}) is reached at skill level {skill_level}.", "\n\n基础伤害：{damage}  基础攻击延迟：{base_delay}\n该投掷物的最低攻击延迟为{minimum_delay}，在投掷技能{skill_level}级时达到。", "damage:integer;base_delay:number;minimum_delay:number;skill_level:integer"},
    {"item.reason.drink.already_berserk", "You're already berserk!", "你已经处于狂暴状态！", ""},
    {"item.reason.drink.berserk_recovering", "You're still recovering from your berserk rage.", "你仍在狂暴后的恢复期。", ""},
