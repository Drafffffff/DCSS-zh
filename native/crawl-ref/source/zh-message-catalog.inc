    {"detail.monster.status_text", "This creature will be automatically destroyed in a few turns.", "monster.status_text.crumbling_away"},
    {"detail.monster.status_text", "This creature will die in a few turns.\n## Not real statuses, but common clauses to add to some others", "monster.status_text.withering_away"},
    {"detail.monster.status_text", "This creature will inflict a portion of all damage it suffers upon nearby allies,\nwith those closer to it receiving a greater amount.", "monster.status_text.sharing_its_pain"},
    {"detail.monster.status_text", "This creature will never attack you and may attack other creatures hostile to\nyou, but will neither follow you nor obey any direct instructions.", "monster.status_text.peaceful"},
    {"detail.monster.status_text", "This creature will take minor damage whenever it moves.", "monster.status_text.skewered_by_barbs"},
    {"detail.monster.status_text", "This creature's AC is reduced by 8 and its accuracy, spell power, brand damage, and\nwillpower are moderately reduced.", "monster.status_text.misshapen_and_mutated"},
    {"detail.monster.status_text", "This creature's AC is reduced by 8.", "monster.status_text.corroded"},
    {"detail.monster.status_text", "This creature's Sundering weapon is fully charged and its next attack will be\nmore accurate, inflict greatly increased damage, and cleave with increased range.\nThis effect will be lost if it moves.", "monster.status_text.ready_to_sunder"},
    {"detail.monster.status_text", "This creature's evasion is slightly increased.", "monster.status_text.unusually_agile"},
    {"detail.monster.status_text", "This creature's fire resistance is reduced by one level.", "monster.status_text.more_vulnerable_to_fire"},
    {"detail.monster.status_text", "This creature's melee attacks deal 25% more damage, its accuracy is slightly\nincreased, and its spells and abilities have been mildly strengthened.", "monster.status_text.tempered"},
