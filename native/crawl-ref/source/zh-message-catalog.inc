    {"speech.monspeak.f4bdaab2cd8c705d", "{the_monster_1} murmurs some mystic words to {reflexive_1}.", "{the_monster_1}对{reflexive_1}低声念着神秘的咒语。", "the_monster_1:name;reflexive_1:text"},
