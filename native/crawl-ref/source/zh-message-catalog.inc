    {"speech.monspeak.1f3d1b3a0a927f33", "{the_monster_1} asks, \"How many innocent creatures did you kill for those shoes\?\"", "{the_monster_1}问道：“你为了这双鞋杀了多少无辜的生灵？”", "the_monster_1:name"},
    {"speech.monspeak.1f50639358433846", "{channel_1}{the_monster_1} weeps, and shakes {possessive_1} weapon {at_foe_1}.", "{channel_1}{the_monster_1}哭泣着，挥舞{possessive_1}武器朝{at_foe_1}打去。", "channel_1:key;the_monster_1:name;possessive_1:text;at_foe_1:text"},
    {"speech.monspeak.1f67921f4019048d", "{high_priest_rare_1}", "{high_priest_rare_1}", "high_priest_rare_1:text"},
    {"speech.monspeak.1f816941bbc4bbe0", "{the_monster_1} wonders {at_foe_1}, \"Do you still suffer from delusions of adequacy\?\"", "{the_monster_1}纳闷地问 {at_foe_1}：“你还在妄想自己很有能耐吗？”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.1f96fc3a53a36360", "{the_monster_1} says, \"Should we be naught but slaves of fate, I will still speak truth to my dying breath.\"", "{the_monster_1}说：“就算我们不过是命运的奴隶，我也要说到最后一口气，讲出真相。”", "the_monster_1:name"},
    {"speech.monspeak.1f9e1f64a44f6693", "whimpers", "呜咽道", ""},
    {"speech.monspeak.1f9e5b131f15d703", "{the_monster_1} whispers {to_foe_1}, \"It won't be long now.\"", "{the_monster_1}低声说 {to_foe_1}：“不会太久了。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.1fabdfdc0c1eaa9a", "{the_monster_1} says, \"Don't use me like a cheap sock puppet. I hate that.\"", "{the_monster_1}说：“别把我当廉价的袜子木偶使唤。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.1fe50ae38f420e29", "{hostile_orc_beogh_unbeliever_speech_1}", "{hostile_orc_beogh_unbeliever_speech_1}", "hostile_orc_beogh_unbeliever_speech_1:text"},
    {"speech.monspeak.1fef757e22342fc3", "{the_monster_1} says, \"I hate crawling things.\"", "{the_monster_1}说：“我讨厌会爬的东西。”", "the_monster_1:name"},
    {"speech.monspeak.2018061cbaa8ecf9", "{the_monster_1} says, \"You're not very quick on the uptake, are you\?\"", "{the_monster_1}说：“你脑子转得不太快，是吧？”", "the_monster_1:name"},
    {"speech.monspeak.2039613063445a69", "spider", "蜘蛛", ""},
    {"speech.monspeak.20443f668c33223a", "{the_monster_1} says, \"Look at me! I'm running, I'm running!\"", "{the_monster_1}说：“看我！我在跑，我在跑！”", "the_monster_1:name"},
    {"speech.monspeak.206f74cfde69349c", "{the_monster_1} remarks {to_foe_1}, \"Ah, I could eat a centaur!\"", "{the_monster_1}说道 {to_foe_1}：“啊，我能吃下一整只半人马！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.20790f966bee7426", "{channel_1}{the_monster_1} glitters frostily.", "{channel_1}{the_monster_1}闪着冰霜的光泽。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.20969e9f88428fbc", "{the_monster_1} says {to_foe_1}, \"Join my legions of the broken and the beaten.\"", "{the_monster_1}说 {to_foe_1}：“加入我那支由残破者和失败者组成的大军吧。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.20ab9a59c91a616a", "{the_monster_1} says, \"Arachnophobia is no disease, it's common sense.\"", "{the_monster_1}说：“蜘蛛恐惧症不是病，那是常识。”", "the_monster_1:name"},
    {"speech.monspeak.20d6620f676f235e", "{the_monster_1} says, \"Did all the warriors here go to shield school or something\?\"", "{the_monster_1}说：“这里的战士是不是都上过盾牌学校？”", "the_monster_1:name"},
    {"speech.monspeak.20dd2017758fe5ba", "Leather", "皮革", ""},
    {"speech.monspeak.210bd73a6ecfbbbd", "noisily", "吵嚷地", ""},
    {"speech.monspeak.2123e1f6bb8df0eb", "Hah", "哈", ""},
    {"speech.monspeak.212d8eeff0c0d617", "{the_monster_1} says, \"I'm sure you'll make a fine angry ghost.\"", "{the_monster_1}说：“我肯定你会成为一个出色的愤怒怨魂。”", "the_monster_1:name"},
    {"speech.monspeak.212e25a1a8c9508a", "{the_monster_1} shouts, \"Surrender to Beogh and we'll let you live!\"", "{the_monster_1}喊道：“向比欧弗投降，我们就饶你不死！”", "the_monster_1:name"},
    {"speech.monspeak.21375a141928e991", "{sonja_rare_1}", "{sonja_rare_1}", "sonja_rare_1:text"},
    {"speech.monspeak.21502cf3a1f1b6d7", "{menkaure_rare_1}", "{menkaure_rare_1}", "menkaure_rare_1:text"},
    {"speech.monspeak.2164b1718549cdff", "{the_monster_1} says, \"Nobody wants to follow a dead messiah!\"", "{the_monster_1}说：“没人愿意追随一个死掉的弥赛亚！”", "the_monster_1:name"},
    {"speech.monspeak.217ccfaa9e898342", "supplicates abjectly", "苦苦哀求道", ""},
    {"speech.monspeak.21afeb32b70308e4", "{the_monster_1} says {to_foe_1}, \"Who wants to live forever\? Me.\"", "{the_monster_1}说 {to_foe_1}：“谁想永生不死？我想。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.21cbc4edcd928a8d", "{the_monster_1} says, \"Just as planned.\"", "{the_monster_1}说：“一切尽在计划之中。”", "the_monster_1:name"},
    {"speech.monspeak.21d3e1755dba13ac", "{channel_1}{the_monster_1} gestures.\n{channel_2}You feel {choice_1}.", "{channel_1}{the_monster_1}做着手势。\n{channel_2}你感到{choice_1}。", "channel_1:key;the_monster_1:name;channel_2:key;choice_1:text"},
    {"speech.monspeak.21d3e1755dba13ac.choice_1.alt_0", "cursed", "被诅咒", ""},
    {"speech.monspeak.21d3e1755dba13ac.choice_1.alt_1", "doomed", "在劫难逃", ""},
    {"speech.monspeak.21e69484038ccf1f", "{channel_1}{the_monster_1} scratches {possessive_1} ear.", "{channel_1}{the_monster_1}挠着{possessive_1}耳朵。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.21ea7565815ead43", "{the_monster_1} meows.", "{the_monster_1}喵喵叫。", "the_monster_1:name"},
    {"speech.monspeak.220f3ac5e5c62c01", "{the_monster_1} says, \"Leave me alone!\"", "{the_monster_1}说：“别来烦我！”", "the_monster_1:name"},
    {"speech.monspeak.2226f9f18d67de8a", "{the_monster_1} shouts, \"I'm half human! Half horse! And all stone-cold KILLER!\"", "{the_monster_1}喊道：“我一半是人！一半是马！而且是彻头彻尾的冷酷杀手！”", "the_monster_1:name"},
    {"speech.monspeak.222a14756be58fe3", "{the_monster_1} squints, then shrugs and mutters, \"Close enough.\"", "{the_monster_1}眯起眼睛，然后耸耸肩嘟囔道：“差不多吧。”", "the_monster_1:name"},
    {"speech.monspeak.223209b6e6fc49a9", "{channel_1}{the_monster_1} snorts and paws the ground.", "{channel_1}{the_monster_1}喷着鼻息，用蹄子刨着地面。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.2242e597755435b9", "{the_monster_1} says {to_foe_1}, \"I know the secret of eternal life. Do you\?\"", "{the_monster_1}说 {to_foe_1}：“我知道永生的秘密。你知道吗？”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.224a4b7c864a37be", "{the_monster_1} says, \"Is there a plague of frogs happening, or something\? At least it's not locusts.\"", "{the_monster_1}说：“这是闹蛙灾了吗还是怎样？至少不是蝗灾。”", "the_monster_1:name"},
    {"speech.monspeak.225a678d773d2fe6", "demonic laughter", "恶魔的狂笑", ""},
    {"speech.monspeak.225e26f4808eef16", "{the_monster_1} mutters, \"Why... can't we remember...\?\"", "{the_monster_1}喃喃道：“为什么……我们记不起来……？”", "the_monster_1:name"},
    {"speech.monspeak.225e6a94a8fe7fa4", "cloud", "云", ""},
    {"speech.monspeak.2263291e23268f4f", "{hostile_imp_1}", "{hostile_imp_1}", "hostile_imp_1:text"},
    {"speech.monspeak.227ae951e7e69b27", "{the_monster_1} says {to_foe_1}, \"Leave now, and tell all of Maggie's mercy!\"", "{the_monster_1}说 {to_foe_1}：“现在就走，去传扬玛吉的仁慈！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.2283be93968762b4", "{the_monster_1} {laughs_1}, \"I laugh when killing. So smile when dying. SMILE!\"", "{the_monster_1}{laughs_1}道：“我杀人时大笑。所以临死时就微笑吧。微笑！”", "the_monster_1:name;laughs_1:text"},
    {"speech.monspeak.228446c76f0aaa71", "{shouts_1}", "{shouts_1}", "shouts_1:text"},
    {"speech.monspeak.22a7f710a66f9ef2", "{the_monster_1} says {to_foe_1}, \"Summoning is fun!\"", "{the_monster_1}说 {to_foe_1}：“召唤术真好玩！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.22e269f24e8b2ff6", "{the_monster_1} {menkaure_verb_1} in an indecipherable tongue.", "{the_monster_1}用一种无法解读的语言{menkaure_verb_1}。", "the_monster_1:name;menkaure_verb_1:text"},
    {"speech.monspeak.22f4a1e0881fbae6", "{the_monster_1} squints around. \"I can't see a thing. I hate that.\"", "{the_monster_1}眯着眼四处看。“我什么都看不见。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.22ffb6a8c6dd4389", "{channel_1}{the_monster_1} points ostentatiously.", "{channel_1}{the_monster_1}招摇地指指点点。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.23108143bbfd561f", "Queen", "女王", ""},
    {"speech.monspeak.2311ffa3f6898528", "{the_monster_1} says, \"Orcish loyalty transcends such trifles as death.\"", "{the_monster_1}说：“兽人的忠诚超越死亡这类小事。”", "the_monster_1:name"},
    {"speech.monspeak.233eab912848eaf3", "{the_monster_1} says, \"I knew I should've brought a map.\"", "{the_monster_1}说：“我就知道该带张地图的。”", "the_monster_1:name"},
    {"speech.monspeak.233f9e48021979cc", "{the_monster_1} says, \"Really pretty, but really, really boring. I hate that.\"", "{the_monster_1}说：“非常漂亮，但非常非常无聊。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.234306a332ca32e7", "{the_monster_1} says, \"I died to destroy people like you for fun.\"", "{the_monster_1}说：“我死，就是为了毁灭你这种人取乐。”", "the_monster_1:name"},
    {"speech.monspeak.2365037f7da259d8", "hands dragging us downward", "把我们往下拖的手", ""},
    {"speech.monspeak.236ad645fa5030b1", "{the_monster_1} says, \"I resented this body once, but could any human make what I've made\?\"", "{the_monster_1}说：“我曾憎恨这具躯体，但哪个人类能做出我这样的作品？”", "the_monster_1:name"},
    {"speech.monspeak.236aef871f56d902", "{the_monster_1} says {to_foe_1}, \"It's nothing personal, but I have to kill you.\"", "{the_monster_1}说 {to_foe_1}：“这不是私人恩怨，但我必须杀了你。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.23717ef92711d690", "{the_monster_1} says, \"You look bit like rock.\"", "{the_monster_1}说：“你看起来有点像石头。”", "the_monster_1:name"},
    {"speech.monspeak.2376626d110f3b9b", "{the_monster_1} asks, \"How can you live without manners, virtues and honour\?\"", "{the_monster_1}问：“没有礼仪、美德和荣誉，你怎么活得下去？”", "the_monster_1:name"},
    {"speech.monspeak.23794199bc91ffa9", "{the_monster_1} says, \"You must run out of gods to curse by.\"", "{the_monster_1}说：“你诅咒人的时候，能拿来发誓的神一定不够用吧。”", "the_monster_1:name"},
    {"speech.monspeak.237ab56b10b7b346", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.237e7ef918add74d", "undead, and why they are evil.", "亡灵，以及它们为何邪恶。", ""},
    {"speech.monspeak.2384d992c883a57f", "{channel_1}Sweat drips down {the_monster_possessive_1} chest.", "{channel_1}汗水顺着{the_monster_possessive_1}胸膛淌下。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.2391adadb11e4cb3", "{channel_1}{the_monster_1} looks at {possessive_1} body and cries without tears.", "{channel_1}{the_monster_1}看着{possessive_1}身体，无泪地哭泣。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.239c0db827ecf0e2", "{the_monster_1} says, \"For you, today is the most challenging fight of your life. For me... well, I will have lunch shortly.\" {player_only_1}", "{the_monster_1}说：“对你来说，今天是你此生最具挑战的一战。对我来说……嗯，我待会儿就要吃午饭了。”{player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.23a0ca7d2434999e", "{the_monster_1} says, \"I have to say that I admire beauty and perfection. I like to watch it die. The contrast as it decays is exquisite.\"", "{the_monster_1}说：“不得不说，我仰慕美与完美。我喜欢看着它死去。它腐败时的反差妙不可言。”", "the_monster_1:name"},
    {"speech.monspeak.23a28df4dbc63a9d", "{the_monster_1} draws the Pentagram. \"Hope the demon is friendly!\"", "{the_monster_1}抽到了五芒星。“但愿那恶魔是友善的！”", "the_monster_1:name"},
    {"speech.monspeak.23a44c0415d2bf46", "{channel_1}{the_monster_1} flaps {possessive_1} ears in an attempt at flight.", "{channel_1}{the_monster_1}扇动{possessive_1}耳朵，试图飞起来。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.23a9369b5a32afd1", "{the_monster_1} says with laughter: \"And yet I knew I would end up like that...\"", "{the_monster_1}笑着说出：“可我早就知道自己会是这个下场……”", "the_monster_1:name"},
    {"speech.monspeak.23b16e212e999f7e", "{the_monster_1} {wails_1}, \"You must not fail where I succeeded!\"", "{the_monster_1} {wails_1}：“我成功了，你绝不能失败！”", "the_monster_1:name;wails_1:text"},
    {"speech.monspeak.23c9be5e8e11264e", "{the_monster_1} says, \"You know, I thought there'd be more coffins in a crypt...\"", "{the_monster_1}说：“你知道吗，我本以为墓室里会有更多棺材……”", "the_monster_1:name"},
    {"speech.monspeak.23d257f495774b72", "{the_monster_1} mutters, \"Sometimes I wonder if they all really are harpies.\"", "{the_monster_1}嘟囔道：“有时候我也怀疑他们是不是真的都是鸟妖。”", "the_monster_1:name"},
    {"speech.monspeak.23df6c677b5fb4fd", "moth", "蛾子", ""},
    {"speech.monspeak.23e0c81e939566ac", "{the_monster_1} says, \"No, I don't have a problem with mice.\"", "{the_monster_1}说：“不，我对老鼠没什么意见。”", "the_monster_1:name"},
    {"speech.monspeak.242620713169a148", "{the_monster_1} shouts {at_foe_1}, \"You can't hurt me! Ice reforms...\"", "{the_monster_1}喊道 {at_foe_1}：“你伤不了我！冰会重新凝结……”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.24421eca7d95fbc9", "{the_monster_1} says, \"Do you have any idea what people are willing to pay to have you killed, {player_name_1}\?\" {player_only_1}", "{the_monster_1}说：“你知道人们愿意出多少钱买你的命吗，{player_name_1}？”{player_only_1}", "the_monster_1:name;player_name_1:name;player_only_1:text"},
    {"speech.monspeak.24655be8977f8fe9", "{the_monster_1} frowns, \"Willingly giving yourself over as a plaything to Xom... strange behaviour.\"", "{the_monster_1}皱起眉头：“甘愿把自己送给佐姆当玩物……真是古怪的行为。”", "the_monster_1:name"},
    {"speech.monspeak.2469057fc206fca5", "{the_monster_1} says, \"I hate temples.\"", "{the_monster_1}说：“我讨厌神庙。”", "the_monster_1:name"},
    {"speech.monspeak.246bbb5f1d04399e", "{the_monster_1} says, \"So, nagas are stealthy\? Don't make me laugh.\"", "{the_monster_1}说：“所以，纳迦很擅长潜行？别逗我笑。”", "the_monster_1:name"},
    {"speech.monspeak.246c44da6138cc22", "{channel_1}{the_monster_1} relaxes {possessive_1} fighting stance.", "{channel_1}{the_monster_1}放松了{possessive_1}战斗姿态。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.24836947db239dda", "blue", "蓝", ""},
    {"speech.monspeak.249e20e933d8f0c7", "{the_monster_1} says, \"I bet Trog's next axe will take you to the Abyss.\"", "{the_monster_1}说：“我打赌特洛戈的下一把斧子会把你送进深渊。”", "the_monster_1:name"},
    {"speech.monspeak.24adc3defe4fd068", "{the_monster_1} mumbles some mantras.", "{the_monster_1}含糊地念诵着几句真言。", "the_monster_1:name"},
    {"speech.monspeak.24b99d6a919ca64e", "{the_monster_1} {shouts_1}, \"Smite the {orc_heathen_1}s!\"", "{the_monster_1}{shouts_1}：“消灭那些{orc_heathen_1}！”", "the_monster_1:name;shouts_1:text;orc_heathen_1:text"},
    {"speech.monspeak.24bbf492721dc368", "{the_monster_1} prays.", "{the_monster_1}祈祷。", "the_monster_1:name"},
    {"speech.monspeak.24c081c05779402b", "{the_monster_1} says {to_foe_1}, \"Ah, this is what I got into this business for!\"", "{the_monster_1}说 {to_foe_1}：“啊，我入这行就是为了这个！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.24cb7a8488046ac6", "{the_monster_1} mutters, \"Wee kobolds think thay ken whit a cannon is.\"", "{the_monster_1}嘟囔道：“小不点狗头人还以为自己懂什么叫火炮。”", "the_monster_1:name"},
    {"speech.monspeak.24cfa80ba8f8d498", "{the_monster_1} shouts {at_foe_1}, \"I'll tear you apart!\"", "{the_monster_1}喊道 {at_foe_1}：“我要把你撕碎！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.24dbe0f96a6c5fa9", "Line", "线", ""},
    {"speech.monspeak.24e05d8e0935e913", "{the_monster_1} says, \"I don't remember getting an invitation to a convocation.\"", "{the_monster_1}说：“我不记得收到过什么集会请柬。”", "the_monster_1:name"},
    {"speech.monspeak.24e7634540321192", "fast", "快", ""},
    {"speech.monspeak.24e8c666333ce8ac", "{the_monster_1} honks, delighted.", "{the_monster_1}开心地按响了喇叭。", "the_monster_1:name"},
    {"speech.monspeak.25379e5eb4e753bf", "the wailing of the dead", "亡者的哀嚎", ""},
    {"speech.monspeak.254c1706f7c6bc7a", "{channel_1}{the_monster_1} throws some {choice_1} powder {at_foe_1}.", "{channel_1}{the_monster_1}撒出一把{choice_1}粉末，撒向 {at_foe_1}。", "channel_1:key;the_monster_1:name;choice_1:text;at_foe_1:text"},
    {"speech.monspeak.254c1706f7c6bc7a.choice_1.alt_0", "strange", "奇怪的", ""},
    {"speech.monspeak.254c1706f7c6bc7a.choice_1.alt_1", "weird", "诡异的", ""},
    {"speech.monspeak.254c1706f7c6bc7a.choice_1.alt_2", "mysterious", "神秘的", ""},
    {"speech.monspeak.256303c6af2d4202", "{the_monster_1} very coldly says {to_foe_1}, \"I hate your company.\"", "{the_monster_1}非常冷淡地说 {to_foe_1}：“我讨厌有你作伴。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.2581bb757fa2d1e9", "spider", "蜘蛛", ""},
    {"speech.monspeak.25a994ae04be87cf", "{channel_1}{the_monster_1} becomes transparent for a moment.", "{channel_1}{the_monster_1}有那么一瞬间变得透明。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.25aadce30f86bbba", "{the_monster_1} says, \"Are sirens supposed to sound like that\? I can sing better than that!\"", "{the_monster_1}说：“塞壬是该那样叫的吗？我唱得都比她们好听！”", "the_monster_1:name"},
    {"speech.monspeak.25aba46074e437c5", "avoiding mutations.", "避免变异。", ""},
    {"speech.monspeak.25ad26d2044373ea", "{the_monster_1} says, \"What would you do with the Orb, anyway\? Experiment on it\?\"", "{the_monster_1}说：“你打算拿宝珠干什么？拿它做实验？”", "the_monster_1:name"},
    {"speech.monspeak.25c3c85ba454c943", "{channel_1}{the_monster_1} shakes with grief.", "{channel_1}{the_monster_1}悲痛地颤抖着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.25dfe9a718b20f64", "{the_monster_1} says, \"Asmodeus and me are pals. He gave me this whip.\"", "{the_monster_1}说：“阿斯蒙蒂斯和我是哥们儿。这条鞭子就是他送的。”", "the_monster_1:name"},
    {"speech.monspeak.2612431f4ea981e3", "launches into", "着手", ""},
    {"speech.monspeak.26315c83044077a9", "{the_monster_1} draws Wild Magic. \"So many ways magic can go wrong!\"", "{the_monster_1}抽到了狂野魔法。“魔法出错的方式可真多！”", "the_monster_1:name"},
    {"speech.monspeak.2642907434c003d8", "grandiloquent", "雄辩的", ""},
    {"speech.monspeak.2651fcb4f8c3ba20", "{the_monster_1} says, \"The world's bad enough without you corrupting it.\"", "{the_monster_1}说：“这世界已经够糟了，你别再腐化它了。”", "the_monster_1:name"},
    {"speech.monspeak.2669d57fffefa781", "{the_monster_1} says, \"I'm sick of this place. Or maybe that's poison...\"", "{the_monster_1}说：“我受够这个地方了。或者，也许那是中毒了……”", "the_monster_1:name"},
    {"speech.monspeak.26731773fc223a10", "{the_monster_1} unfolds {possessive_1} giant frill.", "{the_monster_1}展开{possessive_1}巨大的褶边。", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.2676cf13afa7fba5", "{the_monster_1} screams {at_foe_1}, \"Me am play god!\"", "{the_monster_1}尖叫 {at_foe_1}：“俺来当神玩玩！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.2679b6937c1919f0", "{the_monster_possessive_1} features momentarily become yours. \"Wouldst slay thyself\?\"", "{the_monster_possessive_1}面容一瞬间变成了你的模样。“你要弑己吗？”", "the_monster_possessive_1:name"},
    {"speech.monspeak.26c435f4aec625f8", "{the_monster_1} says, \"I command an army of devils. What do you command\?\" {player_only_1}", "{the_monster_1}说：“我指挥着一支恶魔大军。你指挥什么？”{player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.26cecb96e5894a64", "absently says", "心不在焉地说", ""},
    {"speech.monspeak.26dc98de29a5166c", "{the_monster_1} says, \"Xom\? Are you insane\?\"", "{the_monster_1}说：“佐姆？你疯了吗？”", "the_monster_1:name"},
    {"speech.monspeak.26e8caeaebf122d0", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
