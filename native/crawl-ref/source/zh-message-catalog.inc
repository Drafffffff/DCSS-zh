    {"speech.monspeak.f1d8aaac34e60518", "{the_monster_1} says {to_foe_1}, \"I didn't need trinkets in life, I don't need them now.\"", "{the_monster_1}说 {to_foe_1}：“我活着时不需要小饰品，现在也不需要。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.f1f2f6bd11c65cdb", "{the_monster_1} {norris_verb_1} {to_foe_1}, \"Let's feed the skysharks together.\"", "{the_monster_1}{norris_verb_1} {to_foe_1}：“让我们一起去喂天上的鲨鱼吧。”", "the_monster_1:name;norris_verb_1:text;to_foe_1:text"},
