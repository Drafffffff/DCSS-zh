    {"speech.monspeak.5b4f2e7fb4d8b1eb", "{the_monster_1} declares, \"When I'm finished with you, I will take on the gods!\"", "{the_monster_1}宣称：“等我把你收拾完，我就要去挑战众神！”", "the_monster_1:name"},
