    {"speech.monspeak.5b6ff013a2a68462", "{channel_1}{the_monster_1} slowly taps {possessive_1} weapon in {possessive_2} hand.", "{channel_1}{the_monster_1}慢慢地用{possessive_1}手敲着{possessive_2}武器。", "channel_1:key;the_monster_1:name;possessive_1:text;possessive_2:text"},
    {"speech.monspeak.5ba59ad3e8b359e2", "{the_monster_1} says {to_foe_1}, \"You can run, but you can't hide!\"", "{the_monster_1}说 {to_foe_1}：“你能跑，但你躲不掉！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.5ba94ef6ef688c68", "{the_monster_1} says, \"The real reality is there, but everything you KNOW about 'it' is in your mind and yours to do with as you like.\"", "{the_monster_1}说：“真实的现实就在那里，但你对‘它’所知道的一切都在你自己脑中，随你怎么处置。”", "the_monster_1:name"},
    {"speech.monspeak.5bf8e6338ce937ee", "{the_monster_1} says, \"Difficult is the way of exertion, difficult to pass, difficult to enter upon.\"", "{the_monster_1}说：“精进之道艰难，难行，难入。”", "the_monster_1:name"},
    {"speech.monspeak.5c659576335263f5", "{the_monster_1} says, \"My wife rejected me, but I had my revenge.\"", "{the_monster_1}说：“我妻子拒绝了我，但我报了仇。”", "the_monster_1:name"},
    {"speech.monspeak.5c7711be1de68d9f", "{the_monster_1} says, \"Better hope you don't develop allergies.\"", "{the_monster_1}说：“你最好祈祷自己别得过敏症。”", "the_monster_1:name"},
    {"speech.monspeak.5cbcaadf0f309f5e", "{the_monster_1} winks {at_foe_1} and says, \"Everything have price.\"", "{the_monster_1}眨了眨眼，说 {at_foe_1}：“什么东西都有价。”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.5cef3fe3a49f00c4", "{the_monster_1} squints and screams {at_foe_1}, \"I know a harpy when I see one!\"", "{the_monster_1}眯起眼睛尖叫道 {at_foe_1}：“鸟妖我一眼就认得出！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.5cf821686f58afd0", "{the_monster_1} says, \"All these vampires have me hopping mad!\"", "{the_monster_1}说：“这些吸血鬼气得我直跳脚！”", "the_monster_1:name"},
    {"speech.monspeak.5d02ac571bb84a83", "{the_monster_1} begs for proper burials for the Dungeon's restless dead.", "{the_monster_1}恳求让地牢中不得安息的亡者得到体面的安葬。", "the_monster_1:name"},
    {"speech.monspeak.5d03f63f54af1aa8", "{the_monster_1} {norris_verb_1} {to_foe_1}, \"Just go with the flow.\"", "{the_monster_1}{norris_verb_1} {to_foe_1}：“随波逐流就好。”", "the_monster_1:name;norris_verb_1:text;to_foe_1:text"},
    {"speech.monspeak.5d1e52575601b34b", "{the_monster_1} says in a calm gravelly voice, \"173 down. One million more to go.\"", "{the_monster_1}用平静沙哑的嗓音说：“已杀173个。还差一百万个。”", "the_monster_1:name"},
    {"speech.monspeak.5d2550f37b3a75ee", "{the_monster_1} says, \"I feel like a jelly sandwich, now.\"", "{the_monster_1}说：“现在我感觉自己像一块果冻三明治。”", "the_monster_1:name"},
