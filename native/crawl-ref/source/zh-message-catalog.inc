    {"speech.monspeak.548b696abaec12ae", "{the_monster_1} says {to_foe_1}, \"Trying to escape from me is {pointless_1}!\"", "{the_monster_1}说 {to_foe_1}：“想从我手里逃走，那是{pointless_1}的！”", "the_monster_1:name;to_foe_1:text;pointless_1:text"},
    {"speech.monspeak.54a2e222f7b29889", "{the_monster_1} says, \"A mage should rely only on their own abilities.\"", "{the_monster_1}说：“法师只应仰赖自身的能力。”", "the_monster_1:name"},
    {"speech.monspeak.54d6c5e4b5d21a28", "{the_monster_1} says, \"I hate getting stuck.\"", "{the_monster_1}说：“我讨厌被黏住。”", "the_monster_1:name"},
    {"speech.monspeak.54d8ce82b5cadd32", "koolooloo", "库鲁鲁", ""},
