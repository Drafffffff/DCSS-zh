    {"skill.menu.switch", " [<yellow>{hotkey}</yellow>] {options}{label}", " [<yellow>{hotkey}</yellow>] {options}{label} ", "hotkey:key;options:text;label:text"},
    {"skill.menu.switch_help.auto", "In automatic mode, skills are trained as you use them.", "自动模式下，你使用技能时会自动训练它们。", ""},
    {"skill.menu.switch_help.cost", "The relative cost of raising each skill is in <cyan>cyan</cyan>.", "提升各技能所需的相对经验消耗以<cyan>青色</cyan>显示。", ""},
    {"skill.menu.switch_help.cost_manual", "The relative cost of raising each skill is in <cyan>cyan</cyan> (or <lightred>red</lightred> if enhanced by a manual).", "提升各技能所需的相对经验消耗以<cyan>青色</cyan>显示；受技能手册加成时以<lightred>红色</lightred>显示。", ""},
    {"skill.menu.switch_help.focus", "Press the letter of a skill to cycle between <darkgrey>disabled</darkgrey> (<darkgrey>-</darkgrey>), enabled (+) and <white>focused</white> (<white>*</white>). Focused skills train twice as fast relative to others.", "按下技能对应的字母，可在<darkgrey>停用</darkgrey>（<darkgrey>-</darkgrey>）、启用（+）和<white>专注</white>（<white>*</white>）之间切换。专注技能相较其他技能以双倍速度训练。", ""},
    {"skill.menu.switch_help.manual", "In manual mode, experience is spread evenly across all activated skills.", "手动模式下，经验会平均分配给所有已启用的技能。", ""},
    {"skill.menu.switch_help.practice", "Press the letter of a skill to choose whether you want to <w>practise</w> it. Skills marked with '<darkgrey>-</darkgrey>' will not be trained.", "按下技能对应的字母，选择是否<w>训练</w>该技能。标有'<darkgrey>-</darkgrey>'的技能不会获得训练。", ""},
    {"skill.menu.switch_help.progress", "The percentage of the progress done before reaching next level is in <cyan>cyan</cyan>.", "距离下一级的进度百分比以<cyan>青色</cyan>显示。", ""},
    {"skill.menu.switch_help.targets", "The current training targets, if any.", "显示当前设定的训练目标（如有）。", ""},
    {"skill.menu.switch_help.training", "The percentage of incoming experience used to train each skill is in <brown>brown</brown>.", "用于训练各技能的经验比例以<brown>棕色</brown>显示。", ""},
