    {"speech.monspeak.f177bcce4d2261ea", "{channel_1}{the_monster_1} scowls and wipes {possessive_1} hands on {possessive_2} robe.", "{channel_1}{the_monster_1}皱着眉头，把{possessive_1}双手在{possessive_2}长袍上擦了擦。", "channel_1:key;the_monster_1:name;possessive_1:text;possessive_2:text"},
    {"speech.monspeak.f17dd098c07aeae3", "{the_monster_1} {norris_verb_1} {to_foe_1}, \"Only fools fear death. I embrace it.\"", "{the_monster_1}{norris_verb_1} {to_foe_1}：“只有傻瓜才畏惧死亡。我拥抱死亡。”", "the_monster_1:name;norris_verb_1:text;to_foe_1:text"},
