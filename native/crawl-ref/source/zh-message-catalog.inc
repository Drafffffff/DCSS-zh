    {"speech.monspeak.15dc1dca633465a6", "{the_monster_1} says, \"Magic will overcome all!\"", "{the_monster_1}说：“魔法能战胜一切！”", "the_monster_1:name"},
    {"speech.monspeak.160d0402ce141d09", "{the_monster_1} says, \"No way as a way\? Sounds like nonsense.\"", "{the_monster_1}说：“‘无路之道’？听着就是胡说八道。”", "the_monster_1:name"},
    {"speech.monspeak.160fef45896ecf83", "{the_monster_1} says, \"What is a 'random number god' anyway\?\"", "{the_monster_1}说：“‘随机数之神’到底是什么玩意？”", "the_monster_1:name"},
    {"speech.monspeak.16441cba8e5a6d3c", "{the_monster_1} laughs {at_foe_1}, \"You, our saviour!\?\"", "{the_monster_1}大笑道 {at_foe_1}：“你？我们的救世主！？”", "the_monster_1:name;at_foe_1:text"},
