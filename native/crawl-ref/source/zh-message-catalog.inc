    {"speech.monspeak.59eb6bfd1ba1acc5", "{the_monster_1} screams {at_foe_1}, \"What ORB\?! I have an entire kingdom!\" {player_only_1}", "{the_monster_1}朝{at_foe_1}尖声喊道：“什么宝珠？！我可是有一整个王国！”{player_only_1}", "the_monster_1:name;at_foe_1:text;player_only_1:text"},
    {"speech.monspeak.59f9c5f00f582797", "{the_monster_1} says {to_foe_1}, \"Dogrw nutew berg.\"", "{the_monster_1}说 {to_foe_1}：“多格鲁·努图·贝格。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.59fdcd527618245f", "{the_monster_1} says {to_foe_1}, \"If I can't kill you now, I'll help my descendant do it later.\"", "{the_monster_1}说 {to_foe_1}：“如果我现在杀不了你，往后我会帮我的后裔动手。”", "the_monster_1:name;to_foe_1:text"},
