    {"speech.monspeak.f425bdc7ca0d3d86", "{the_monster_1} says {to_foe_1}, \"The wise warrior avoids unnecessary battles.\"", "{the_monster_1}说 {to_foe_1}：“明智的战士会避开不必要的战斗。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.f45a23f4fa9bdf09", "{the_monster_1} says, \"I will find her! I will get her back!\"", "{the_monster_1}说：“我会找到她！我会把她带回来！”", "the_monster_1:name"},
