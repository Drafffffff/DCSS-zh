    {"speech.monspeak.b48d40d5f5cc3e2d", "{the_monster_1} hums to {reflexive_1} desperately, trying to keep calm.", "{the_monster_1}拼命地对{reflexive_1}哼唱，努力保持镇定。", "the_monster_1:name;reflexive_1:text"},
    {"speech.monspeak.b4927bb774cc0c44", "{channel_1}{the_monster_1} stares {choice_1} at its reflection in a puddle.", "{channel_1}{the_monster_1}{choice_1}盯着水洼中自己的倒影。", "channel_1:key;the_monster_1:name;choice_1:text"},
