    {"speech.monspeak.8adddbe4e1cc90e6", "{the_monster_1} screams {at_foe_1}, \"Death is my middle name!\"", "{the_monster_1}尖叫 {at_foe_1}：“死亡就是我的中间名！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.8ae303a0353f1797", "{the_monster_1} screams, \"No! No!\"", "{the_monster_1}尖叫道：“不！不！”", "the_monster_1:name"},
    {"speech.monspeak.8af18b99c1b05a0a", "{the_monster_1} says to {possessive_1} squad, \"Do not let the {foe_genus_1} escape!\"", "{the_monster_1}对{possessive_1}小队说：“别让这个{foe_genus_1}跑了！”", "the_monster_1:name;possessive_1:text;foe_genus_1:name"},
    {"speech.monspeak.8af83014e1239e91", "{the_monster_1} yells {at_foe_1}, \"My visage is famous all over the dungeon!\"", "{the_monster_1}大叫道 {at_foe_1}：“我的面容在整个地牢都赫赫有名！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.8aff7988c1699dd0", "the Axioms of Law.", "法则公理", ""},
    {"speech.monspeak.8b3c4d7bcc8dc6c2", "{the_monster_1} says, \"I hate draugr.\"", "{the_monster_1}说：“我讨厌尸鬼。”", "the_monster_1:name"},
    {"speech.monspeak.8b41e692a852106b", "{the_monster_1} utters, \"No lamp to guide me anymore...\"", "{the_monster_1}出声道：“再没有灯为我引路了……”", "the_monster_1:name"},
    {"speech.monspeak.8b539dd8d8b41115", "Fido", "菲多", ""},
    {"speech.monspeak.8b55887da86f1497", "{channel_1}{the_monster_1} ponders the situation.", "{channel_1}{the_monster_1}思索着当前的处境。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.8b56e0f46f1be586", "{the_monster_1} says {to_foe_1}, \"It's your last dance!\"", "{the_monster_1}说 {to_foe_1}：“这是你的最后一支舞！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.8b6ea794909f8371", "{the_monster_1} says {to_foe_1}, \"It's lovely beneath the waves - you'll see!\"", "{the_monster_1}说 {to_foe_1}：“波涛之下美极了——你会看到的！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.8bb542db75b9e483", "{the_monster_1} says, \"I went to a family reunion once. I hated it.\"", "{the_monster_1}说：“我去过一次家族聚会。我讨厌那个。”", "the_monster_1:name"},
    {"speech.monspeak.8bb87e91846356d8", "{the_monster_1} says {to_foe_1}, \"Yer just na down-ta-earth enough.\"", "{the_monster_1}说 {to_foe_1}：“你就是太不接地气。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.8bb915c7971b5873", "{pargi_rare_1}", "{pargi_rare_1}", "pargi_rare_1:text"},
    {"speech.monspeak.8bba566775fcf6ea", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.8bc1ae16722019a9", "{the_monster_1} says, \"Try to look on the bright side. Your death will help put my children through school.\" {player_only_1}", "{the_monster_1}说：“往好处想吧。你的死能帮我的孩子们交学费。”{player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.8bdb8eeb31083bb2", "{channel_1}{the_monster_1} gestures at you to be quiet.", "{channel_1}{the_monster_1}打手势让你安静。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.8bfc0d9c74c2e2c4", "{the_monster_1} says, \"Relying on the deeds of your ancestors brought you no glory.\"", "{the_monster_1}说：“仰仗先祖的功绩，给你带不来任何荣耀。”", "the_monster_1:name"},
    {"speech.monspeak.8c020fa044478ab4", "{the_monster_1} says, \"I don't think I'll ever look at the stars the same way again.\"", "{the_monster_1}说：“我想我再也没法用以前的方式看星星了。”", "the_monster_1:name"},
    {"speech.monspeak.8c11a2712b306186", "{the_monster_1} says, \"No steal rocks!\"", "{the_monster_1}说：“不许偷石头！”", "the_monster_1:name"},
    {"speech.monspeak.8c28c35a73cc40c3", "{the_monster_1} screams {at_foe_1}, \"I'll use your head as a decoration in my hut!\"", "{the_monster_1}尖叫 {at_foe_1}：“我要把你的头挂在我的小屋里当装饰！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.8c2ff0942d4c408d", "{the_monster_1} {grum_verb_1} {at_foe_1}, \"My dogs and I will have a feast tonight...\"", "{the_monster_1} {grum_verb_1} {at_foe_1}：“今晚我和我的狗要大快朵颐……”", "the_monster_1:name;grum_verb_1:text;at_foe_1:text"},
    {"speech.monspeak.8c4a0758bbde9d4b", "{the_monster_1} muses over how flesh is wasted on mortals.", "{the_monster_1}沉思着血肉之躯对凡人而言是多么浪费。", "the_monster_1:name"},
    {"speech.monspeak.8c4b03fd0e70df6b", "{the_monster_1} says, \"Best rocks! Rocks!\"", "{the_monster_1}说：“最好的石头！石头！”", "the_monster_1:name"},
    {"speech.monspeak.8c4f7607f42d5ae9", "growls", "低吼道", ""},
    {"speech.monspeak.8c85e5dd6be6de35", "softly says", "轻声说", ""},
    {"speech.monspeak.8c9a56191046a536", "{the_monster_1} proudly claims, \"A renegade god deserves renegade ghosts.\"", "{the_monster_1}自豪地宣告：“叛神者就该有叛神者的幽灵。”", "the_monster_1:name"},
    {"speech.monspeak.8ce81220cecd8234", "{the_monster_1} sings, \"Roses are red / violets are blue / I hate many things / But most of all you!\"", "{the_monster_1}唱道：“玫瑰红彤彤／紫罗兰蓝盈盈／我讨厌的东西很多／但最讨厌的就是你！”", "the_monster_1:name"},
    {"speech.monspeak.8cf322a5c3ad5809", "{the_monster_1} says {to_foe_1}, \"Come a little closer, will you\?\"", "{the_monster_1}说 {to_foe_1}：“再靠近一点，好吗？”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.8d0a9223e7775ed8", "{the_monster_1} says, \"My, my head's in a spin!\"", "{the_monster_1}说：“哎呀，我的脑袋晕乎乎的！”", "the_monster_1:name"},
    {"speech.monspeak.8d20b942a832e2e6", "{the_monster_1} calls out, \"Join me or die!\"", "{the_monster_1}喊道：“加入我，否则就死！”", "the_monster_1:name"},
