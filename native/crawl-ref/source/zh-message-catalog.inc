    {"speech.monspeak.2e780393be5567fa", "{the_monster_1} says {to_foe_1}, \"Even if there were a messiah, it wouldn't be you.\"", "{the_monster_1}说 {to_foe_1}：“就算真有弥赛亚，那也绝不会是你。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.2e828c29e6f75772", "Paint", "颜料", ""},
    {"speech.monspeak.2e8ac906cba72856", "{the_monster_1} says {to_foe_1}, \"Your valuables will do nicely in my coffers.\" {player_only_1}", "{the_monster_1}说 {to_foe_1}：“你的财物放进我的宝库正合适。”{player_only_1}", "the_monster_1:name;to_foe_1:text;player_only_1:text"},
    {"speech.monspeak.2eddc7db9593ec44", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.2ef6ca45221a7caf", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.2f0435dc0b460f19", "{the_monster_1} screams {at_foe_1}, \"You'll never get it!\"", "{the_monster_1}尖叫 {at_foe_1}：“你永远也得不到它！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.2f1c156e82f6d94a", "{fake_spell_effect_1}", "{fake_spell_effect_1}", "fake_spell_effect_1:text"},
    {"speech.monspeak.2f2fb4627cd34560", "{the_monster_1} says, \"Don't you think the Orb of Power was down there for a reason\?\"", "{the_monster_1}说：“你不觉得力量宝珠待在那底下是有原因的吗？”", "the_monster_1:name"},
    {"speech.monspeak.2f3a678e16ad5eff", "sobs", "抽泣着", ""},
    {"speech.monspeak.2f4e9ce44d457f96", "{the_monster_1} says, \"You're as good as gold.\"", "{the_monster_1}说：“你简直和金子一样好。”", "the_monster_1:name"},
    {"speech.monspeak.2f5c1d7040e6c29a", "Holy", "神圣", ""},
    {"speech.monspeak.2f7fb300c8aabee0", "{channel_1}{the_monster_1} takes a bow.", "{channel_1}{the_monster_1}鞠了一躬。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.2fa282d3990a68fa", "{harold_common_1}", "{harold_common_1}", "harold_common_1:text"},
    {"speech.monspeak.30144510d35a7400", "{the_monster_1} says {to_foe_1}, \"I hope the next monster to meet you likes frozen food!\"", "{the_monster_1}说 {to_foe_1}：“我希望下一个遇上你的怪物爱吃冷冻食品！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.3033603f44431f48", "{the_monster_1} says, \"How deep do you have to dig to get a never-ending supply of wretches\?\"", "{the_monster_1}说：“得挖多深才能有取之不尽的可怜虫？”", "the_monster_1:name"},
    {"speech.monspeak.308d232cc9e21f3d", "{the_monster_1} says, \"I can't smell anything here. I hate that.\"", "{the_monster_1}说：“在这里我什么都闻不到。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.30aa7910a4587be9", "{roxanne_common_1}", "{roxanne_common_1}", "roxanne_common_1:text"},
    {"speech.monspeak.30ad0902f850ad7a", "barks", "吠叫道", ""},
    {"speech.monspeak.30bf637bc5250556", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.30bfe63c1fde43dd", "{the_monster_1} says, \"Make like a tree!\"", "{the_monster_1}说：“装成一棵树吧！”", "the_monster_1:name"},
    {"speech.monspeak.30c03ddd4acef8c0", "{channel_1}{the_monster_1} is briefly surrounded by a halo of {blorkula_colour_1} light.", "{channel_1}{the_monster_1}一时被一圈{blorkula_colour_1}的光环笼罩。", "channel_1:key;the_monster_1:name;blorkula_colour_1:text"},
    {"speech.monspeak.30d85dedfb89f874", "{the_monster_1} says {to_foe_1}, \"Let's see how well you move.\"", "{the_monster_1}说 {to_foe_1}：“让我们看看你的身手如何。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.30e5a023f63482f2", "Rot", "腐烂", ""},
    {"speech.monspeak.310c9b4017986985", "{the_monster_1} screams {at_foe_1}, \"Bird-brain!\"", "{the_monster_1}尖叫道 {at_foe_1}：“鸟脑子！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.3116b26276723bd0", "{the_monster_1} says, \"Lodul motto: Secure Vault\? My fault!\"", "{the_monster_1}说：“洛杜尔的座右铭：宝库守不住？是俺的错！”", "the_monster_1:name"},
    {"speech.monspeak.313a82568506b9c2", "{channel_1}{the_monster_1} droops like a melted candle.", "{channel_1}{the_monster_1}像一支熔化的蜡烛一样瘫软下去。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.3153dbba6b0dda57", "{the_monster_1} says, \"You know that hissing noise\? I hate that.\"", "{the_monster_1}说：“你听到那种嘶嘶声了吗？我讨厌那个。”", "the_monster_1:name"},
    {"speech.monspeak.3177d576a7f899e5", "{the_monster_1} says, \"Destruction is an occupation beyond life.\"", "{the_monster_1}说：“毁灭是一份超越生命的营生。”", "the_monster_1:name"},
    {"speech.monspeak.3193bd42c67a3081", "{the_monster_1} deftly throws insults at you. {player_only_1}", "{the_monster_1}灵巧地朝你抛来一串辱骂。 {player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.3193d637882e2543", "{the_monster_1} grumbles {at_foe_1}, \"You're not even a proper Orc...\"", "{the_monster_1}抱怨道 {at_foe_1}：“你连个像样的兽人都算不上……”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.31a1b3309476dc12", "{the_monster_1} giggles, \"These cerements are ticklish...\"", "{the_monster_1}咯咯笑道：“这些裹尸布好痒……”", "the_monster_1:name"},
    {"speech.monspeak.31b974a0e83402af", "{channel_1}{the_monster_1} stomps the ground.", "{channel_1}{the_monster_1}跺着地面。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.31c75922a98f1e47", "{channel_1}{the_monster_1} grinds {possessive_1} teeth.", "{channel_1}{the_monster_1}咬紧{possessive_1}牙关。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.3232cae5819bab44", "{channel_1}{the_monster_1} looks rather jealous.", "{channel_1}{the_monster_1}看起来颇为嫉妒。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.3234169835055d26", "{the_monster_1} says, \"I've lived long enough to see a hundred people like you fail.\"", "{the_monster_1}说：“我活得够久了，见过上百个像你这样的人失败。”", "the_monster_1:name"},
    {"speech.monspeak.3263130833d2e88c", "{the_monster_1} shouts {at_foe_1}, \"Die, monster!\"", "{the_monster_1}喊道 {at_foe_1}：“去死吧，怪物！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.326457faabaf5ed5", "{channel_1}{the_monster_1} flutters around in erratic circles.", "{channel_1}{the_monster_1}毫无规律地转着圈扑腾。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.3278078fc57ccb18", "{the_monster_1} eyes {foe_1} carefully. \"They told me only worthy opponents would get this far.\"", "{the_monster_1}仔细打量着{foe_1}。“他们跟我说，只有配得上的对手才能走到这里。”", "the_monster_1:name;foe_1:text"},
    {"speech.monspeak.328b713a3c5fb71f", "{saint_roka_generic_1}", "{saint_roka_generic_1}", "saint_roka_generic_1:text"},
    {"speech.monspeak.32a02733d89f5434", "{channel_1}{the_monster_1} twirls {possessive_1} cape.", "{channel_1}{the_monster_1}旋转{possessive_1}披风。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.32afad4b870ce895", "{terence_common_1}", "{terence_common_1}", "terence_common_1:text"},
    {"speech.monspeak.32d6e15abac963fa", "{the_monster_1} giggles crazily.", "{the_monster_1}疯狂地咯咯笑。", "the_monster_1:name"},
    {"speech.monspeak.32f578462b7223c8", "Seed", "种子", ""},
    {"speech.monspeak.32fc62864cb53696", "{the_monster_1} says {to_foe_1}, \"I despise a dishonourable opponent.\"", "{the_monster_1}说 {to_foe_1}：“我鄙视不名誉的对手。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.330fc1f8dafc76a3", "{the_monster_1} asks, \"What kind of bones do {player_genus_plural_1} have\? My dogs are dying to find out.\" {player_only_1}", "{the_monster_1}问：“{player_genus_plural_1}的骨头是什么样的？我的狗都等不及想知道了。”{player_only_1}", "the_monster_1:name;player_genus_plural_1:name;player_only_1:text"},
    {"speech.monspeak.33146c31aece3181", "{the_monster_1} says, \"I'm sure I saw a card fall out of that deck.\"", "{the_monster_1}说：“我肯定看见一张牌从牌组里掉出来了。”", "the_monster_1:name"},
    {"speech.monspeak.332db442e9f9c13b", "{channel_1}{the_monster_1} is suddenly surrounded by pale {spell_colour_1} light.", "{channel_1}{the_monster_1}突然被一层苍白的{spell_colour_1}光包围。", "channel_1:key;the_monster_1:name;spell_colour_1:text"},
    {"speech.monspeak.335a80d266ed5899", "{the_monster_1} fumbles for your pockets and misses.", "{the_monster_1}摸索着你的口袋，却摸了个空。", "the_monster_1:name"},
    {"speech.monspeak.336a661f5bd6f6d8", "{wizard_1}", "{wizard_1}", "wizard_1:text"},
    {"speech.monspeak.336bbd01d65d5c30", "{the_monster_1} says, \"Great. Now my shield is all dirty.\"", "{the_monster_1}说：“好极了。现在我的盾牌全脏了。”", "the_monster_1:name"},
    {"speech.monspeak.337d89d0e61b0465", "{rupert_common_1}", "{rupert_common_1}", "rupert_common_1:text"},
    {"speech.monspeak.3380981d7d43099d", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.33828fcad64ed667", "{the_monster_1} whispers, \"Death doesn't hurt. What you feel is life.\"", "{the_monster_1}低声说：“死亡并不痛苦。你感受到的是生命。”", "the_monster_1:name"},
    {"speech.monspeak.3382a768dcd2f9ea", "{the_monster_1} draws the Rangers. \"New friends who can shoot!\"", "{the_monster_1}抽到了游侠。“会射箭的新朋友！”", "the_monster_1:name"},
    {"speech.monspeak.33b36fca1f4129e9", "{the_monster_1} says, \"I'm looking for Ms. Medusa. Have you seen her\?\"", "{the_monster_1}说：“我在找美杜莎女士。你们见过她吗？”", "the_monster_1:name"},
    {"speech.monspeak.33b90420b8f4f959", "{the_monster_1} gurgles, \"It's true, you are what you eat.\"", "{the_monster_1}咕噜道：“没错，人如其食。”", "the_monster_1:name"},
    {"speech.monspeak.33c08a8cb8cb4136", "{the_monster_1} screams, \"Revenge at last!\"", "{the_monster_1}尖叫道：“终于报仇了！”", "the_monster_1:name"},
    {"speech.monspeak.33d5746d59b0bc8f", "{the_monster_1} {wails_1}, \"You must not succeed where I failed!\"", "{the_monster_1} {wails_1}：“我失败了，你也绝不能成功！”", "the_monster_1:name;wails_1:text"},
    {"speech.monspeak.343964b54f554b9f", "{the_monster_1} howls, \"Hell holds no secrets from me!\"", "{the_monster_1}嚎叫道：“地狱对我毫无秘密可言！”", "the_monster_1:name"},
    {"speech.monspeak.343bcc3a3889accb", "{channel_1}{the_monster_1}, chosen of Okawaru, glows resplendent with favour.", "{channel_1}{the_monster_1}，奥卡瓦鲁的选民，因恩宠而容光焕发。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.3447777b5e988b9e", "{hostile_orc_beogh_believer_speech_common_1}", "{hostile_orc_beogh_believer_speech_common_1}", "hostile_orc_beogh_believer_speech_common_1:text"},
    {"speech.monspeak.3454b0fbbd251b7f", "{the_monster_1} says, \"I saw a draconian who kept changing colours. Some people are so indecisive.\"", "{the_monster_1}说：“我刚才看到一条一直在变颜色的龙人。有些人就是这么优柔寡断。”", "the_monster_1:name"},
    {"speech.monspeak.3461f6945a07f873", "{the_monster_1} says {to_foe_1}, \"Stay away from my face!\"", "{the_monster_1}说 {to_foe_1}：“别靠我的脸这么近！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.34716451cb9e4538", "{channel_1}{the_monster_1} grins malevolently.", "{channel_1}{the_monster_1}恶毒地咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.3471eed590bab6c4", "{channel_1}{the_monster_1} shakes {possessive_1} head sadly.", "{channel_1}{the_monster_1}悲伤地摇着{possessive_1}头。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.347b7b91f5b9202b", "{silenced_humanoid_rare_1}", "{silenced_humanoid_rare_1}", "silenced_humanoid_rare_1:text"},
    {"speech.monspeak.34a8dce71361b038", "a terrible sin", "一桩可怕的罪孽", ""},
    {"speech.monspeak.34a9950efded30a3", "{the_monster_1} says {to_foe_1}, \"Have you seen any dragons\?\"", "{the_monster_1}说 {to_foe_1}：“你见过龙吗？”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.34d1d924f2e0f6d9", "{channel_1}{the_monster_1} wobbles.", "{channel_1}{the_monster_1}摇摆不定。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.34d9a6ab14538970", "{the_monster_1} says, \"So, are you allowed to read books\?\"", "{the_monster_1}说：“那么，你能读书吗？”", "the_monster_1:name"},
    {"speech.monspeak.350215bc5e6776c9", "{bennu_permanently_killed_1}", "{bennu_permanently_killed_1}", "bennu_permanently_killed_1:text"},
    {"speech.monspeak.351418f01c1e4832", "raise", "滋生", ""},
    {"speech.monspeak.353154b13b7106fa", "{the_monster_1} says {to_foe_1}, \"Your future is not even bleak.\"", "{the_monster_1}说 {to_foe_1}：“你的前途连黯淡都算不上。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.354d53780e2f4e59", "{channel_1}{the_monster_1} looks very unfriendly.", "{channel_1}{the_monster_1}看起来很不友善。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.354dc64786d6d73c", "{the_monster_1} preaches about {recite_subject_1}", "{the_monster_1}宣讲{recite_subject_1}", "the_monster_1:name;recite_subject_1:text"},
    {"speech.monspeak.356afe2354f127d7", "mayhem", "混乱", ""},
    {"speech.monspeak.358416e587911fa5", "{the_monster_1} says, \"What's stopping the guards from just stealing the Orb themselves\?\"", "{the_monster_1}说：“是什么拦着守卫们不自己把宝珠偷走？”", "the_monster_1:name"},
    {"speech.monspeak.3594ef7567fb036a", "turtle", "乌龟", ""},
    {"speech.monspeak.35b0e74bca65ee9c", "{the_monster_1} growls {at_foe_1}, \"YOU BORE ME SO.\"", "{the_monster_1}低吼道 {at_foe_1}：“你让我好生无聊。”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.35e16ba06dd94586", "{the_monster_1} says, \"My neck hurts.\"", "{the_monster_1}说：“我的脖子疼。”", "the_monster_1:name"},
    {"speech.monspeak.35ee29332c3d037b", "toodlewoodle", "嘟嘟伍德尔", ""},
    {"speech.monspeak.35f786ff00e1a91f", "Liver", "肝脏", ""},
    {"speech.monspeak.35fa72fece978862", "{the_monster_1} screams {at_foe_1}, \"Payback for my eye!\"", "{the_monster_1}尖叫道 {at_foe_1}：“为我这只眼睛报仇！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.361b9866ffb7f9b2", "{channel_1}{the_monster_1} becomes larger for a moment.", "{channel_1}{the_monster_1}有那么一瞬间变大了。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.3621aad597dd3d79", "{the_monster_1} says, \"Foolish to worship a god whose flame is even dimmer than you.\"", "{the_monster_1}说：“信奉一个火焰比你还要黯淡的神，真是愚蠢。”", "the_monster_1:name"},
    {"speech.monspeak.3622e28ed2a248d8", "place", "住所", ""},
    {"speech.monspeak.36288e09a8dc0a0e", "{channel_1}{the_monster_1} applauds {reflexive_1}.", "{channel_1}{the_monster_1}为{reflexive_1}鼓掌。", "channel_1:key;the_monster_1:name;reflexive_1:text"},
    {"speech.monspeak.362dc147ef461173", "{channel_1}{the_monster_1} grits {possessive_1} teeth and focuses.", "{channel_1}{the_monster_1}咬紧{possessive_1}牙关，凝神聚力。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.3630140ea2fcfbb4", "{the_monster_1} says, \"Acid is thicker than water.\"", "{the_monster_1}说：“酸浓于水。”", "the_monster_1:name"},
    {"speech.monspeak.36358e8ad20cc32b", "{the_monster_1} says {to_foe_1}, \"Hold still for a moment. You're making this shot difficult.\"", "{the_monster_1}说 {to_foe_1}：“站着别动。你害得这一箭不好射。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.363cf0d5d7dbf87a", "{wizard_1}", "{wizard_1}", "wizard_1:text"},
    {"speech.monspeak.36430b5f1b7478ca", "{channel_1}{the_monster_possessive_1} {choice_1} eyes blink slowly.", "{channel_1}{the_monster_possessive_1}{choice_1}眼睛缓缓眨动。", "channel_1:key;the_monster_possessive_1:name;choice_1:text"},
    {"speech.monspeak.36430b5f1b7478ca.choice_1.alt_0", "three nested", "三层嵌套的", ""},
    {"speech.monspeak.36430b5f1b7478ca.choice_1.alt_1", "six fanged", "长着獠牙的六只", ""},
    {"speech.monspeak.36430b5f1b7478ca.choice_1.alt_2", "nine smoking", "冒着烟的九只", ""},
    {"speech.monspeak.366764f86ebbdea7", "{the_monster_1} says, \"How about a game of 52 card pickup\?\"", "{the_monster_1}说：“来玩一局52张牌天女散花怎么样？”", "the_monster_1:name"},
    {"speech.monspeak.366895cf8843b61f", "the Law and the prophets.", "法则与先知。", ""},
    {"speech.monspeak.367874f1f30c7aca", "{the_monster_1} says, \"Curse skulls, curse toes... What next\?\"", "{the_monster_1}说：“诅咒骷髅、诅咒之趾……接下来还有什么？”", "the_monster_1:name"},
    {"speech.monspeak.367932173a3fc66e", "{the_monster_1} says to {foe_1}, \"Money or life\? Never mind, I think I'll take both.\"", "{the_monster_1}对{foe_1}说：“要钱还是要命？算了，我想我两样都要。”", "the_monster_1:name;foe_1:text"},
    {"speech.monspeak.3684445bbf987e79", "{the_monster_1} says {to_foe_1}, \"I'll get you next time!\"", "{the_monster_1}说 {to_foe_1}：“下次我饶不了你！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.36aa29e3f28130aa", "{demon_taunt_1}", "{demon_taunt_1}", "demon_taunt_1:text"},
    {"speech.monspeak.36e02e67fd6a3bc3", "{the_monster_1} says, \"Be careful!\"", "{the_monster_1}说：“小心点！”", "the_monster_1:name"},
    {"speech.monspeak.370d76ecca0929a6", "{the_monster_1} says, \"I wasn't actually sleeping!\"", "{the_monster_1}说：“我刚才才没有睡着！”", "the_monster_1:name"},
    {"speech.monspeak.3710cc632d0e0ad8", "{the_monster_1} says, \"A rock stubbed itself on my toe. I hate that.\"", "{the_monster_1}说：“一块石头自己绊到了我的脚趾上。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.3711d680f5cc4910", "{friendly_fleeing_rare_1}", "{friendly_fleeing_rare_1}", "friendly_fleeing_rare_1:text"},
    {"speech.monspeak.371e2318c13384d1", "{the_monster_1} says, \"I'll be back!\"", "{the_monster_1}说：“我会回来的！”", "the_monster_1:name"},
    {"speech.monspeak.373c7ad723260de9", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.375053c0d53a1745", "{channel_1}{the_monster_1} briefly extends {possessive_1} eye-stalks.", "{channel_1}{the_monster_1}短暂地伸出{possessive_1}眼柄。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.375d34b366d1404a", "{the_monster_1} draws the Wraith. \"Draining hurts!\"", "{the_monster_1}抽到了幽魂。“吸取可疼了！”", "the_monster_1:name"},
    {"speech.monspeak.377a73bf1476c43d", "service", "效劳", ""},
    {"speech.monspeak.3789667fe649e1f6", "{channel_1}{the_monster_1} gestures.", "{channel_1}{the_monster_1}做着手势。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.37b040e8d044f4a4", "{channel_1}{the_monster_1} hisses menacingly.", "{channel_1}{the_monster_1}威胁地嘶嘶作声。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.37b7c94db2a04c3d", "{the_monster_1} shouts, \"I yield! Victory is yours!\"", "{the_monster_1}喊道：“我投降！胜利属于你！”", "the_monster_1:name"},
    {"speech.monspeak.37cc7a255793df4a", "{the_monster_1} says, \"What could mosquitoes possibly want with my blood\?\"", "{the_monster_1}说：“蚊子要我的血干什么？”", "the_monster_1:name"},
    {"speech.monspeak.37d3c5243d1d8bd9", "{channel_1}{the_monster_1} grins madly.", "{channel_1}{the_monster_1}疯狂地咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.37d99f18da6bfad6", "{channel_1}{the_monster_1} looks relaxed.", "{channel_1}{the_monster_1}看起来很放松。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.37f19f1766beba90", "{the_monster_1} {shouts_1} {at_foe_1}, \"Orcs! {foe_name_1} is lying!\"", "{the_monster_1}{shouts_1} {at_foe_1}：“兽人们！{foe_name_1}在撒谎！”", "the_monster_1:name;shouts_1:text;at_foe_1:text;foe_name_1:name"},
    {"speech.monspeak.37fae731a91be32c", "{the_monster_1} says {to_foe_1}, \"I need your bones for a spell of mine.\"", "{the_monster_1}说 {to_foe_1}：“我需要你的骨头来施一个法术。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.381176f41e6b5817", "{the_monster_1} screams {at_foe_1}, \"All trespassers must die!\"", "{the_monster_1}尖叫 {at_foe_1}：“所有擅闯者都得死！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.382322284178d1b0", "grunts", "哼声道", ""},
    {"speech.monspeak.38c547a9e063fce4", "{the_monster_1} asks, \"Have you seen my kris anywhere\?\"", "{the_monster_1}问：“你有没有看见我的马来短剑？”", "the_monster_1:name"},
    {"speech.monspeak.38e5571532b4be83", "{hostile_imp_rare_1}", "{hostile_imp_rare_1}", "hostile_imp_rare_1:text"},
    {"speech.monspeak.38f5644f0ca7ef06", "{the_monster_1} says, \"I can never find the altar I want in here.\"", "{the_monster_1}说：“我在这里从来找不到我想要的神坛。”", "the_monster_1:name"},
    {"speech.monspeak.38fae8bde8bb7112", "{the_monster_1} says {to_foe_1}, \"I died poor and in vain, but not as a freak.\"", "{the_monster_1}说 {to_foe_1}：“我死得贫穷又徒劳，但至少不是个怪胎。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.390502eeba32cb92", "{channel_1}{the_monster_1} beckons and sways in an unseen wind.", "{channel_1}{the_monster_1}在一阵无形的风中招手、摇曳。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.3911f43ff3783355", "{the_monster_1} says {to_foe_1}, \"They call me one-eyed Urug. When I'm done with you they'll have to call you no-head {player_name_1}.\" {player_only_1}", "{the_monster_1}说 {to_foe_1}：“他们叫我独眼尤鲁格。等我收拾完你，他们就只好叫你无头{player_name_1}了。” {player_only_1}", "the_monster_1:name;to_foe_1:text;player_name_1:name;player_only_1:text"},
    {"speech.monspeak.39130a61e250aef0", "{the_monster_1} intones a prayer.\n{channel_1}A sense of peace washes over you.", "{the_monster_1}吟诵着祈祷文。\n{channel_1}一种宁静的感觉涌上你心头。", "the_monster_1:name;channel_1:key"},
    {"speech.monspeak.391cb07781fafb19", "{the_monster_1} says {to_foe_1}, \"My weaknesses are her strengths!\"", "{the_monster_1}说 {to_foe_1}：“我的弱点正是她的强项！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.391e3c520f939863", "{the_monster_1} says, \"Enjoy eternity.\"", "{the_monster_1}说：“享受你的永恒吧。”", "the_monster_1:name"},
    {"speech.monspeak.3957708404feb65f", "{the_monster_1} screams {at_foe_1}, \"All you harpies will die!\"", "{the_monster_1}尖叫道 {at_foe_1}：“你们这些鸟妖全都要死！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.3971a89822916e1a", "{the_monster_1} says, \"Would you challenge me, knowing my power\?\"", "{the_monster_1}说：“知道我的力量后，你还敢向我挑战吗？”", "the_monster_1:name"},
    {"speech.monspeak.398602c1d80083e7", "{the_monster_1} says, \"But I don't want to have to go deeper!\"", "{the_monster_1}说：“可我不想再往更深处走啊！”", "the_monster_1:name"},
    {"speech.monspeak.39893546672911de", "{the_monster_1} says, \"What does a god have to do to get cursed, anyway\?\"", "{the_monster_1}说：“一个神得干出什么事才会被诅咒？”", "the_monster_1:name"},
    {"speech.monspeak.3990d747c82ce6e5", "{the_monster_1} says, \"Honour does not prevent me from taking a tactical advantage.\"", "{the_monster_1}说：“荣誉可不会妨碍我占据战术优势。”", "the_monster_1:name"},
    {"speech.monspeak.399ddbc25c11b208", "{channel_1}{the_monster_1} stares at {foe_1}.", "{channel_1}{the_monster_1}盯着{foe_1}。", "channel_1:key;the_monster_1:name;foe_1:text"},
    {"speech.monspeak.39cf415e051a1b89", "{the_monster_1} unleashes a bloodcurdling roar.", "{the_monster_1}发出令人毛骨悚然的咆哮。", "the_monster_1:name"},
    {"speech.monspeak.39cf756c360d991a", "{the_monster_1} says, \"Ah, a second chance to prove myself in battle!\"", "{the_monster_1}说：“啊，又一个在战斗中证明自己的机会！”", "the_monster_1:name"},
    {"speech.monspeak.39d31ea1c20ecdaa", "{channel_1}{the_monster_1} throbs to the beat of your heart.", "{channel_1}{the_monster_1}随着你心跳的节奏搏动着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.39da5f3d760e4236", "cackles madly", "狂乱地咯咯笑", ""},
    {"speech.monspeak.39de312ecc2dd184", "{beogh_converted_orc_speech_battle_1}", "{beogh_converted_orc_speech_battle_1}", "beogh_converted_orc_speech_battle_1:text"},
    {"speech.monspeak.3a1dbe3be340171c", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.3a5b8448e598dacb", "{channel_1}{the_monster_1} sneers {at_foe_1}.", "{channel_1}{the_monster_1}轻蔑地冷笑 {at_foe_1}。", "channel_1:key;the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.3a65cfbf4ff09d41", "{the_monster_1} says, \"I won't need demonic support against you.\"", "{the_monster_1}说：“对付你，我不需要恶魔助阵。”", "the_monster_1:name"},
    {"speech.monspeak.3a8a2005cd1ae1ec", "{the_monster_1} says, \"The bigger they are, the harder they fall!\"", "{the_monster_1}说：“块头越大，摔得越狠！”", "the_monster_1:name"},
    {"speech.monspeak.3a964065b682117e", "{the_monster_1} says, \"Quick, run away!\"", "{the_monster_1}说：“快，快跑啊！”", "the_monster_1:name"},
    {"speech.monspeak.3aa6166eed8ab218", "{channel_1}Space seems to twist oddly around {the_monster_1}.", "{channel_1}{the_monster_1}周围的空间似乎在古怪地扭曲。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.3aa629523196bdfc", "{the_monster_1} says, \"Been surrounded by packs of demons recently\? I hate that.\"", "{the_monster_1}说：“最近被成群的恶魔围过吗？我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.3afb93ff6b9e8802", "{the_monster_1} asks {foe_1} \"Do you dare to walk upon the beach\?\"", "{the_monster_1}问{foe_1}：“你敢在海滩上行走吗？”", "the_monster_1:name;foe_1:text"},
    {"speech.monspeak.3afc0df42bf09f84", "{the_monster_1} says {to_foe_1}, \"The problem is, you see everything in terms of black and white.\"", "{the_monster_1}说 {to_foe_1}：“问题在于，你看一切都非黑即白。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.3b04a6f81cc15939", "{bai_suzhen_rare_1}", "{bai_suzhen_rare_1}", "bai_suzhen_rare_1:text"},
    {"speech.monspeak.3b0fa7bea9a4b0a0", "{aizul_common_1}", "{aizul_common_1}", "aizul_common_1:text"},
    {"speech.monspeak.3b27fa92cbdfd09c", "{the_monster_1} says, \"Priests don't scare me.\"", "{the_monster_1}说：“牧师吓不到我。”", "the_monster_1:name"},
    {"speech.monspeak.3b40b66ec84f10db", "{the_monster_1} draws Pain. \"Necromancy hurts!\"", "{the_monster_1}抽到了痛苦。“死灵法术可疼了！”", "the_monster_1:name"},
    {"speech.monspeak.3b4560aa35862519", "{the_monster_1} screams {at_foe_1}, \"Don't try to resist!\"", "{the_monster_1}尖叫道 {at_foe_1}：“不要妄想抵抗！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.3b6822c50adc1c6f", "{the_monster_1} shouts, \"Release the hounds!\"", "{the_monster_1}喊道：“放狗！”", "the_monster_1:name"},
    {"speech.monspeak.3b9d2d388ca387b0", "{the_monster_1} says, \"I trampled a caravan once.\"", "{the_monster_1}说：“我曾经踩平过一支商队。”", "the_monster_1:name"},
    {"speech.monspeak.3ba1ec9ed8f0e15d", "{channel_1}{the_monster_possessive_1} deck briefly glows with a rainbow of weird colours.", "{channel_1}{the_monster_possessive_1}牌组短暂地闪起一道五颜六色的奇异光芒。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.3bb8457eec5addfd", "{lodul_rare_1}", "{lodul_rare_1}", "lodul_rare_1:text"},
    {"speech.monspeak.3bbe977d5dd5a87d", "{channel_1}{the_monster_1} looks very confused.", "{channel_1}{the_monster_1}看起来非常困惑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.3bc1e93219907837", "not transforming your body with {choice_1}.", "不用{choice_1}改变身体。", "choice_1:text"},
    {"speech.monspeak.3bc1e93219907837.choice_1.alt_0", "talismans", "护身符", ""},
    {"speech.monspeak.3bc1e93219907837.choice_1.alt_1", "baubles", "小饰物", ""},
    {"speech.monspeak.3bd640538021319c", "{channel_1}{the_monster_1} pats at a spot of missing fur and sighs.", "{channel_1}{the_monster_1}拍了拍身上一处秃掉的地方，叹了口气。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.3bd7ca1ad69a4d25", "spinner", "纺线者", ""},
    {"speech.monspeak.3c2ef6eddd5f8fd7", "{the_monster_1} says, \"I thought violence couldn't solve anything, but it solved me.\"", "{the_monster_1}说：“我曾以为暴力解决不了任何问题，可它解决了我。”", "the_monster_1:name"},
    {"speech.monspeak.3c3fcbb0769a3169", "{channel_1}{the_monster_1} breathes soot at you.", "{channel_1}{the_monster_1}朝你呼出一口烟灰。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.3c57e4197c70184c", "{channel_1}{the_monster_1} ponders the situation.", "{channel_1}{the_monster_1}斟酌着眼前的处境。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.3c6dd3b9bf827d0d", "{the_monster_1} says, \"Don't bother, there's only junk at the bottom.\"", "{the_monster_1}说：“别白费力气了，底下的只有破烂。”", "the_monster_1:name"},
    {"speech.monspeak.3c70d5fc842f6b86", "{the_monster_1} says {to_foe_1}, \"You will find the Path of Peace easy to follow, in death.\"", "{the_monster_1}说 {to_foe_1}：“死后，你会发现和平之路很好走。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.3c7b426e254df285", "{the_monster_1} says, \"Oh, so that's what those runes are for!\"", "{the_monster_1}说：“哦，原来那些符文是干这个用的！”", "the_monster_1:name"},
    {"speech.monspeak.3c7c794efff7f343", "{the_monster_1} says, \"Win and live. Lose and die. It's the rule of life.\"", "{the_monster_1}说：“赢则生，败则死。这就是生存的法则。”", "the_monster_1:name"},
    {"speech.monspeak.3cbc3187b173b590", "{the_monster_1} says, \"Very interesting.\"", "{the_monster_1}说：“非常有意思。”", "the_monster_1:name"},
    {"speech.monspeak.3ccc1649e9cb762c", "{the_monster_1} whines, \"They said I was special. Look at me now!\"", "{the_monster_1}哀怨地说：“他们说我与众不同。看看我现在这副样子！”", "the_monster_1:name"},
    {"speech.monspeak.3cd04a2d1583c59b", "Orb Guardian", "宝珠守护者", ""},
    {"speech.monspeak.3cd2487b0858c9a3", "{the_monster_1} calls out, \"Orcs! Behind me!\"", "{the_monster_1}高声喊道：“兽人们！到我身后！”", "the_monster_1:name"},
    {"speech.monspeak.3d01d0ede9b70bbe", "the lawlessness of {random_god_chaotic_1}.", "{random_god_chaotic_1}的无法无天。", "random_god_chaotic_1:name"},
    {"speech.monspeak.3d09ec472b8d8b16", "{the_monster_1} says, \"Your corpse will decorate my castle walls.\" {player_only_1}", "{the_monster_1}说：“你的尸体会用来装饰我的城堡墙壁。”{player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.3d12a0f267659d5c", "{jeremiah_common_1}", "{jeremiah_common_1}", "jeremiah_common_1:text"},
    {"speech.monspeak.3d6063368b472f6b", "{the_monster_1} bellows, \"I am king! All will kneel!\"", "{the_monster_1}吼道：“我是国王！所有人都要下跪！”", "the_monster_1:name"},
    {"speech.monspeak.3dac6d57d2a312b5", "{the_monster_1} states {to_foe_1}, \"You'll be worm food in some minutes, I'll endure {choice_1}.\"", "{the_monster_1}声明道 {to_foe_1}：“过几分钟你就会变成虫子的食物，而我还能撑{choice_1}。”", "the_monster_1:name;to_foe_1:text;choice_1:text"},
    {"speech.monspeak.3dac6d57d2a312b5.choice_1.alt_0", "millennia", "千年", ""},
    {"speech.monspeak.3dac6d57d2a312b5.choice_1.alt_1", "aeons", "万古", ""},
    {"speech.monspeak.3dc6f69c0b5792eb", "{the_monster_1} purrs.", "{the_monster_1}发出呼噜声。", "the_monster_1:name"},
    {"speech.monspeak.3dd0ee64a058f10c", "{friendly_humanoid_common_1}", "{friendly_humanoid_common_1}", "friendly_humanoid_common_1:text"},
    {"speech.monspeak.3de3aeb16698e781", "{wizard_common_spell_1}\n{fake_spell_effect_1}", "{wizard_common_spell_1}\n{fake_spell_effect_1}", "wizard_common_spell_1:text;fake_spell_effect_1:text"},
    {"speech.monspeak.3def5de239986a31", "{channel_1}{the_monster_1} twirls {possessive_1} quarterstaff.", "{channel_1}{the_monster_1}耍弄着{possessive_1}长棍。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.3e030cc57c7add79", "{robin_rare_1}", "{robin_rare_1}", "robin_rare_1:text"},
    {"speech.monspeak.3e30ba09b6edadb6", "{the_monster_1} says {to_foe_1}, \"I'm done suffering for art; you can suffer instead.\"", "{the_monster_1}说 {to_foe_1}：“我已为艺术受够了苦；换成你来受苦吧。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.3e4048fd77eef122", "{the_monster_1} says, \"I hate existential doubt.\"", "{the_monster_1}说：“我讨厌存在主义式的怀疑。”", "the_monster_1:name"},
    {"speech.monspeak.3e49dbaa37ad92a6", "{the_monster_1} boasts {to_foe_1}, \"Reason would be justified, if not for me!\"", "{the_monster_1}夸口道 {to_foe_1}：“要不是有我，理智本来是有道理的！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.3e672f480f79773d", "{amaemon_common_1}", "{amaemon_common_1}", "amaemon_common_1:text"},
    {"speech.monspeak.3e7d3596241b5221", "{demon_taunt_1}", "{demon_taunt_1}", "demon_taunt_1:text"},
    {"speech.monspeak.3e907b2abb70204e", "{the_monster_1} says, \"Healer, heal thyself.\"", "{the_monster_1}说：“医者，先医你自己吧。”", "the_monster_1:name"},
    {"speech.monspeak.3e9d4f7204db685f", "passionate", "激昂的", ""},
    {"speech.monspeak.3eaf04b15dff24ab", "{the_monster_1} says, \"Against boredom even gods struggle in vain.\"", "{the_monster_1}说：“面对无聊，就连众神也徒然挣扎。”", "the_monster_1:name"},
    {"speech.monspeak.3eb548708bb136ea", "{the_monster_1} mumbles, \"Leave me be, {orc_name_1}. I told you I'm busy...\"", "{the_monster_1}含混地说：“别烦我，{orc_name_1}。我说过我很忙……”", "the_monster_1:name;orc_name_1:text"},
    {"speech.monspeak.3ec1a13e68b31cb0", "{the_monster_1} roars with triumph.", "{the_monster_1}发出胜利的怒吼。", "the_monster_1:name"},
    {"speech.monspeak.3ed9ce06a84a36de", "{the_monster_1} says, \"I asked the warden where the rune was. She slammed the door in my face.\"", "{the_monster_1}说：“我问典狱长符文在哪儿。她当着我的面把门摔上了。”", "the_monster_1:name"},
    {"speech.monspeak.3ef789708b0872bc", "{the_monster_1} says {to_foe_1}, \"Your corpse would blemish any mausoleum.\"", "{the_monster_1}说 {to_foe_1}：“你的尸体只会玷污任何一座陵墓。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.3f14045180a74c3a", "{the_monster_1} says, \"At least there's some dry land. I hate getting wet.\"", "{the_monster_1}说：“至少还有块干地。我讨厌浑身湿透。”", "the_monster_1:name"},
    {"speech.monspeak.3f169abe56210095", "{the_monster_1} says {to_foe_1}, \"Why did you come here\?\"", "{the_monster_1}说 {to_foe_1}：“你为什么来这里？”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.3f1965321c4610cd", "{channel_1}{the_monster_1} throws some purple powder towards you.", "{channel_1}{the_monster_1}朝你撒来一些紫色粉末。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.3fbce0414e8a4f24", "{the_monster_1} shouts {at_foe_1}, \"Too slow!\"", "{the_monster_1}喊道 {at_foe_1}：“太慢了！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.3fbdf5fe69ff5cba", "{the_monster_1} shouts, \"Beogh offers mercy even to people such as you. Join us and be reborn!\"", "{the_monster_1}喊道：“比欧弗连你这样的人也愿意宽恕。加入我们，获得重生！”", "the_monster_1:name"},
    {"speech.monspeak.3fc191ca58ecf41c", "{killer_klown_common_1}", "{killer_klown_common_1}", "killer_klown_common_1:text"},
    {"speech.monspeak.3feb484ef65643fb", "{channel_1}{the_monster_1} grins malevolently.", "{channel_1}{the_monster_1}不怀好意地咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.3ff9f0aecb3c84e3", "{the_monster_1} says, \"Why is it so dark\? Have they never heard of torches\?\"", "{the_monster_1}说：“为什么这里这么黑？他们就没听说过火把吗？”", "the_monster_1:name"},
    {"speech.monspeak.40149e4ca5a2d21d", "{channel_1}{the_monster_1} crushes a nearby insect and laughs.", "{channel_1}{the_monster_1}碾死一只附近的虫子，大笑起来。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.4024d65e9fb12980", "{the_monster_1} sighs, \"Nothing for old {the_monster_2} but {harold_ret_hobby_1} after this.\"", "{the_monster_1}叹息道：“从今往后，老{the_monster_2}除了{harold_ret_hobby_1}，再没别的可干了。”", "the_monster_1:name;the_monster_2:name;harold_ret_hobby_1:text"},
    {"speech.monspeak.404875d305339626", "{the_monster_1} {grum_verb_1}, \"You're dog chow, {player_name_1}!\"", "{the_monster_1} {grum_verb_1}：“你就是狗粮，{player_name_1}！”", "the_monster_1:name;grum_verb_1:text;player_name_1:name"},
    {"speech.monspeak.4052ff0ab6e5bcda", "{default_friendly_humanoid_1}", "{default_friendly_humanoid_1}", "default_friendly_humanoid_1:text"},
    {"speech.monspeak.4070f7f6b3cccc7c", "{the_monster_1} says {to_foe_1}, \"I'll show you my torture chamber!\"", "{the_monster_1}说 {to_foe_1}：“我带你参观我的刑讯室！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.40934156b6a0ad7e", "{the_monster_1} says, \"I hate slime.\"", "{the_monster_1}说：“我讨厌黏液。”", "the_monster_1:name"},
    {"speech.monspeak.409668dc7788d9dd", "{the_monster_1} says, \"It's not the size of the blade that matters, it's how you use it.\"", "{the_monster_1}说：“重要的不是刀刃的大小，而是你怎么用它。”", "the_monster_1:name"},
    {"speech.monspeak.40d807c442989fd6", "{the_monster_1} says, \"I hate venom. I hate getting bitten.\"", "{the_monster_1}说：“我讨厌毒液。我讨厌被咬。”", "the_monster_1:name"},
    {"speech.monspeak.40e176b44c580359", "{the_monster_1} shouts triumpantly, \"Who's laughing NOW\?\"", "{the_monster_1}得意地喊道：“现在是谁在笑？！”", "the_monster_1:name"},
    {"speech.monspeak.40e2e687e9f656e2", "Cujo", "库乔", ""},
    {"speech.monspeak.40f83b574e50ee66", "{the_monster_1} yells, \"Who would have thought, even in death it is a pleasure to sever!\"", "{the_monster_1}吼道：“谁能想到，就算死了，劈斩也还是件乐事！”", "the_monster_1:name"},
    {"speech.monspeak.4109d1f8a9c5e69c", "{grunn_common_1}", "{grunn_common_1}", "grunn_common_1:text"},
    {"speech.monspeak.411700023c1ae573", "song", "歌", ""},
    {"speech.monspeak.416575bdc9063900", "{the_monster_1} says {to_foe_1}, \"I'm academy-trained, you know.\"", "{the_monster_1}说 {to_foe_1}：“我可是学院科班出身的，你知道吗。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.416b17671f21d4d5", "{the_monster_1} says, \"Are you sure that's the real Orb, and not some cheap imitation\?\"", "{the_monster_1}说：“你确定那是真的宝珠，而不是什么廉价仿制品？”", "the_monster_1:name"},
    {"speech.monspeak.41737e14ea08cb43", "{channel_1}{the_monster_1} waves {possessive_1} antennae.", "{channel_1}{the_monster_1}摆动着{possessive_1}触角。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.417ff6556fa229aa", "{the_monster_1} says {to_foe_1}, \"Practise, practise, practise! One day you'll be as good as me.\" {player_only_1}", "{the_monster_1}说 {to_foe_1}：“练，练，再练！总有一天你会和我一样强。”{player_only_1}", "the_monster_1:name;to_foe_1:text;player_only_1:text"},
    {"speech.monspeak.4190e3d11b726f41", "whispers", "耳语道", ""},
    {"speech.monspeak.41a09cc7de1911f4", "{the_monster_1} says {to_foe_1}, \"You haven't seen the last of me!\"", "{the_monster_1}说 {to_foe_1}：“你还没见到我最后一面呢！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.41c310833037158a", "green", "绿", ""},
    {"speech.monspeak.41c62200d87e6987", "{the_monster_1} says {to_foe_1}, \"Did Master Lance send you\?\"", "{the_monster_1}说 {to_foe_1}：“是兰斯师父派你来的吗？”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.41fafabd7ddd6552", "bones breaking beneath stone", "石头下折断的骨头", ""},
    {"speech.monspeak.41fe5fde3989df80", "{crazy_yiuf_wordlist1_1} {crazy_yiuf_wordlist2_1} {crazy_yiuf_wordlist2_2}!", "{crazy_yiuf_wordlist1_1} {crazy_yiuf_wordlist2_1} {crazy_yiuf_wordlist2_2}！", "crazy_yiuf_wordlist1_1:text;crazy_yiuf_wordlist2_1:text;crazy_yiuf_wordlist2_2:text"},
    {"speech.monspeak.424cf5663155b172", "{channel_1}{the_monster_possessive_1} feet meld with the ground, briefly.", "{channel_1}{the_monster_possessive_1}的双脚短暂地与地面融为一体。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.4260cc35715055d5", "{the_monster_1} shouts {at_foe_1}, \"You disturbed my rest! Die!\"", "{the_monster_1}喊道 {at_foe_1}：“你打扰了我的安眠！死吧！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.426feb79011cf721", "{the_monster_1} says {to_foe_1}, \"I'll give you a battle you'll never forget!\"", "{the_monster_1}说 {to_foe_1}：“我会给你一场永生难忘的战斗！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.4276ef122b53bbab", "{the_monster_1} mumbles, \"If ye must ken, mah gran stiched it fur me.\"", "{the_monster_1}咕哝道：“非要知道的话，这是俺奶奶给俺缝的。”", "the_monster_1:name"},
    {"speech.monspeak.428cfa3aa6d50843", "{the_monster_1} says, \"I have plenty of time to study, now.\"", "{the_monster_1}说：“如今我可有的是时间研习了。”", "the_monster_1:name"},
    {"speech.monspeak.42989d694bdf26fa", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.4298a7a0495a72db", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.42a7cd5c0b594dfd", "{fleeing_silenced_common_1}", "{fleeing_silenced_common_1}", "fleeing_silenced_common_1:text"},
    {"speech.monspeak.42a93dbf29cd601e", "{channel_1}{the_monster_1} looks eager to get this over with.", "{channel_1}{the_monster_1}看起来巴不得赶紧了结此事。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.42afa3d9ed1f9700", "stern", "严厉的", ""},
    {"speech.monspeak.42c2f9faf419dfee", "{the_monster_1} says, \"Big rocks, small rocks, huge rocks! Magic rocks!\"", "{the_monster_1}说：“大石头，小石头，巨大石头！魔法石头！”", "the_monster_1:name"},
    {"speech.monspeak.42c3ab00b872a13a", "chicken", "鸡", ""},
    {"speech.monspeak.42cad5180ff29ed1", "{the_monster_1} says, \"I'm a little confused.\"", "{the_monster_1}说：“我有点糊涂了。”", "the_monster_1:name"},
    {"speech.monspeak.42fe89c916672043", "{the_monster_1} screams {at_foe_1}, \"Die, harpy!\"", "{the_monster_1}尖叫道 {at_foe_1}：“死吧，鸟妖！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.4341182139ec5159", "{the_monster_1} says, \"What lunatic would build a room out of doors\?\"", "{the_monster_1}说：“什么样的疯子会用门造出一间房间？”", "the_monster_1:name"},
    {"speech.monspeak.4358ecdc10ca2649", "{the_monster_1} says, \"Maybe I'll visit Hell next.\"", "{the_monster_1}说：“也许我接下来就去逛逛地狱。”", "the_monster_1:name"},
    {"speech.monspeak.437812c285a96290", "{the_monster_1} says, \"Won't need this ring of positive energy, then, will I\?\"", "{the_monster_1}说：“那我就不需要这枚正能量戒指了，是吧？”", "the_monster_1:name"},
    {"speech.monspeak.438b0a5bd03b3184", "{the_monster_1} laughs insanely.", "{the_monster_1}疯狂地大笑。", "the_monster_1:name"},
    {"speech.monspeak.439316b68cc5deb1", "{channel_1}{the_monster_1} slips into the dungeon's darkness for a moment.", "{channel_1}{the_monster_1}悄然滑入地牢的黑暗之中，停留了片刻。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.4397cdf8a0b25e65", "Ten", "十", ""},
    {"speech.monspeak.43a71f2f26c2df44", "{the_monster_1} gibbers meaninglessly.", "{the_monster_1}语无伦次地胡言乱语。", "the_monster_1:name"},
    {"speech.monspeak.43ef295cbd915932", "{the_monster_1} says, \"Robes are for wimps. Real warriors wear heavy armour!\"", "{the_monster_1}说：“长袍是给软蛋穿的。真正的战士要穿重甲！”", "the_monster_1:name"},
    {"speech.monspeak.442c99d65e27b56d", "{channel_1}{the_monster_1} looks very sad for a moment.", "{channel_1}{the_monster_1}有一瞬间看上去非常伤心。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.4433993216fa0464", "{mara_rare_1}", "{mara_rare_1}", "mara_rare_1:text"},
    {"speech.monspeak.4441563a25fc10cd", "{channel_1}{the_monster_1} consults an enormous parchment and nods.", "{channel_1}{the_monster_1}查阅着一大卷羊皮纸，点了点头。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.44435b64f7674b79", "{the_monster_1} says, \"You found it!\"", "{the_monster_1}说：“你找到了！”", "the_monster_1:name"},
    {"speech.monspeak.4454e0399b61f723", "writing", "写作", ""},
    {"speech.monspeak.4462685caeebbf51", "{the_monster_1} says {to_foe_1}, \"May your bottom itch incessantly and may your {player_arms_1} be too short to scratch it.\"", "{the_monster_1}说 {to_foe_1}：“愿你的屁股痒个不停，而你的{player_arms_1}又短得挠不到它。”", "the_monster_1:name;to_foe_1:text;player_arms_1:text"},
    {"speech.monspeak.44815fb3e55f4134", "{the_monster_1} says, \"How do you pronounce that\?\"", "{the_monster_1}说：“那个到底怎么发音？”", "the_monster_1:name"},
    {"speech.monspeak.4484c59da24d4420", "{channel_1}{the_monster_1} flutters around in erratic circles.", "{channel_1}{the_monster_1}毫无规律地转着圈扑腾。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.448a5b6e592fc1b9", "neqoxecs and zykzyls - may they all be destroyed!", "奈库塞克与兹克兹尔——愿它们全被消灭！", ""},
    {"speech.monspeak.448d3b936314fe1d", "{the_monster_1} laughs crazily.", "{the_monster_1}疯狂地大笑。", "the_monster_1:name"},
    {"speech.monspeak.44932f7faadae357", "{the_monster_1} says, \"Allow me to demonstrate the bee of the future!\"", "{the_monster_1}说：“请允许我演示未来的蜜蜂！”", "the_monster_1:name"},
    {"speech.monspeak.44ac17fcbaa0f7e1", "mansion", "庄园", ""},
    {"speech.monspeak.44b967fabdc3d68d", "{the_monster_1} gurgles, \"I bet you'll be tasty.\"", "{the_monster_1}咕噜道：“我打赌你一定很好吃。”", "the_monster_1:name"},
    {"speech.monspeak.44c398fe50e7a760", "{the_monster_1} prays for help.", "{the_monster_1}祈祷求助。", "the_monster_1:name"},
    {"speech.monspeak.44d414a958991689", "Rover", "罗孚", ""},
    {"speech.monspeak.45017f32ccd950bb", "{the_monster_1} says, \"Actually, I like you.\"", "{the_monster_1}说：“其实，我喜欢你。”", "the_monster_1:name"},
    {"speech.monspeak.45027d0d0c90d1e9", "{the_monster_1} says, \"That's not dancing; that's just a fancy way of killing things.\"", "{the_monster_1}说：“那根本不是跳舞；那只是杀东西的花哨方式。”", "the_monster_1:name"},
    {"speech.monspeak.4509cf2aae70d149", "{the_monster_1} says {to_foe_1}, \"Swear allegiance to our queen and you may yet be spared!\"", "{the_monster_1}说 {to_foe_1}：“宣誓效忠我们的女王，你或许还能保全性命！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.45156ae30bc2f4ba", "{the_monster_1} shouts, \"NO!\"", "{the_monster_1}喊道：“不！”", "the_monster_1:name"},
    {"speech.monspeak.45224513dadfabff", "{the_monster_1} says, \"No maze can contain me.\"", "{the_monster_1}说：“没有哪座迷宫能困住我。”", "the_monster_1:name"},
    {"speech.monspeak.4523ea5b88f752ea", "{the_monster_1} says {to_foe_1}, \"An icy embrace awaits you...\"", "{the_monster_1}说 {to_foe_1}：“冰冷的拥抱在等着你……”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.45696a9a6942ca1c", "{the_monster_1} mumbles, \"Perhaps it could use a bit more zinc in the wings....\"", "{the_monster_1}咕哝道：“也许翅膀里该再多加点锌……”", "the_monster_1:name"},
    {"speech.monspeak.457a4e0b21b68bc0", "{the_monster_1} says, \"Everybody knows that one already. Try something more original.\"", "{the_monster_1}说：“这个大家都知道。换个新鲜点的。”", "the_monster_1:name"},
    {"speech.monspeak.458f3bac4ecdc120", "{the_monster_1} says, \"At least you've got demons for company.\"", "{the_monster_1}说：“至少你还有恶魔做伴。”", "the_monster_1:name"},
    {"speech.monspeak.459069293e393965", "{channel_1}{the_monster_1} wildly rolls {possessive_1} eye at {foe_1}.", "{channel_1}{the_monster_1}朝{foe_1}翻着{possessive_1}眼睛。", "channel_1:key;the_monster_1:name;possessive_1:text;foe_1:text"},
    {"speech.monspeak.459f918233b41a25", "{the_monster_1} says, \"The life which is unexamined is not worth living.\"", "{the_monster_1}说：“未经省察的人生不值得过。”", "the_monster_1:name"},
    {"speech.monspeak.45a4781e72a460db", "{channel_1}{the_monster_1} winks {at_foe_1}... or blinks.", "{channel_1}{the_monster_1}使了个眼色 {at_foe_1}……也或者只是眨了眨眼。", "channel_1:key;the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.45abea0803e926de", "a well... tainted with poison", "一口……被毒污染的水井", ""},
    {"speech.monspeak.45c7477978efc0c8", "{holy_being_1}", "{holy_being_1}", "holy_being_1:text"},
    {"speech.monspeak.45de080db0cf7f7d", "{the_monster_1} says, \"I knew I could rely on you.\"", "{the_monster_1}说：“我就知道可以指望你。”", "the_monster_1:name"},
    {"speech.monspeak.45e3a6aaa95e1086", "The priest sneers, \"Beogh may forgive you, but I don't!\"", "祭司讥笑道：“比欧弗或许会原谅你，我可不会！”", ""},
    {"speech.monspeak.45e4d93d1eb1f485", "sighs", "叹息道", ""},
    {"speech.monspeak.45f02f3f565bb8c6", "{the_monster_1} sings a {choice_1} {choice_2}.", "{the_monster_1}唱起一支{choice_1}{choice_2}。", "the_monster_1:name;choice_1:text;choice_2:text"},
    {"speech.monspeak.45f02f3f565bb8c6.choice_1.alt_0", "strange", "奇异的", ""},
    {"speech.monspeak.45f02f3f565bb8c6.choice_1.alt_1", "haunting", "萦绕不去的", ""},
    {"speech.monspeak.45f02f3f565bb8c6.choice_2.alt_0", "sea-chanty", "水手号子", ""},
    {"speech.monspeak.45f02f3f565bb8c6.choice_2.alt_1", "melody", "旋律", ""},
    {"speech.monspeak.460ec32c311177c5", "{the_monster_1} screams in rage.", "{the_monster_1}愤怒地尖叫。", "the_monster_1:name"},
    {"speech.monspeak.462ff7acaddc1e64", "{channel_1}{the_monster_possessive_1} foilage glows and foams.", "{channel_1}{the_monster_possessive_1}枝叶发出微光，泛起泡沫。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.46541ada212c8866", "{channel_1}{the_monster_1} scowls with righteous anger.", "{channel_1}{the_monster_1}义愤填膺地沉下脸。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.4657126d77633eb5", "{the_monster_1} says, \"I hope I don't run into any orbs of ice down here!\"", "{the_monster_1}说：“希望我在这底下别撞上什么寒冰宝珠！”", "the_monster_1:name"},
    {"speech.monspeak.466b96ee9128f9ad", "{the_monster_1} says {to_foe_1}, \"Ponder and deliberate before you make a move.\"", "{the_monster_1}说 {to_foe_1}：“行动之前，须深思熟虑。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.466cddd3b2e9db64", "childish", "幼稚", ""},
    {"speech.monspeak.46823f654cece39b", "{wiglaf_rare_1}", "{wiglaf_rare_1}", "wiglaf_rare_1:text"},
    {"speech.monspeak.46b987a03f0e2f01", "{channel_1}{the_monster_1} stares {at_foe_1} with {possessive_1} one eyeball.", "{channel_1}{the_monster_1}用{at_foe_1}唯一的一只眼球盯着 {possessive_1}。", "channel_1:key;the_monster_1:name;at_foe_1:text;possessive_1:text"},
    {"speech.monspeak.46bd9b1275859f47", "{the_monster_1} asks, \"Why wear clothes with body like mine\?\"", "{the_monster_1}问道：“有我这副身体，干嘛还要穿衣服？”", "the_monster_1:name"},
    {"speech.monspeak.46d1f7b24ce3618d", "{the_monster_1} says {to_foe_1}, \"After I kill you, I will kill you again.\"", "{the_monster_1}说 {to_foe_1}：“等我杀了你，我还要再杀你一次。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.46d7540579db4d4a", "{the_monster_1} {weeps_1} at its own {choice_1} state.", "{the_monster_1}为自己{choice_1}的状态{weeps_1}。", "the_monster_1:name;weeps_1:text;choice_1:text"},
    {"speech.monspeak.46d7540579db4d4a.choice_1.alt_0", "deplorable", "可悲", ""},
    {"speech.monspeak.46d7540579db4d4a.choice_1.alt_1", "decrepit", "衰朽", ""},
    {"speech.monspeak.47198144dbd1d20c", "{the_monster_1} says, \"Intruder eliminated.\"", "{the_monster_1}说：“入侵者已清除。”", "the_monster_1:name"},
    {"speech.monspeak.471a11ae9c06f1a6", "{the_monster_1} says, \"Our battle was as dull and shapeless as your god.\"", "{the_monster_1}说：“我们的战斗和你的神一样乏味、一样不成形状。”", "the_monster_1:name"},
    {"speech.monspeak.471a861dd3fe608c", "{the_monster_1} says, \"I won't go back, never!\"", "{the_monster_1}说：“我不会回去的，绝不！”", "the_monster_1:name"},
    {"speech.monspeak.4729af392164d2ea", "{the_monster_1} whispers {to_foe_1}, \"There is no future for you.\"", "{the_monster_1}低声说 {to_foe_1}：“你没有未来。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.472d13209851059b", "{the_monster_1} says, \"In my day, to be a hero meant something. Now, it just means you die quicker.\"", "{the_monster_1}说：“在我那个年代，当英雄还有点意义。现在，它只意味着你死得更快。”", "the_monster_1:name"},
    {"speech.monspeak.472de3394adaeaaa", "{the_monster_1} says, \"Nagas are pretty ugly. I hate nagas.\"", "{the_monster_1}说：“纳迦真是丑。我讨厌纳迦。”", "the_monster_1:name"},
    {"speech.monspeak.473bb935355ffcae", "{the_monster_1} says {to_foe_1}, \"{foe_god_1} be with thee, mortal!\" {player_only_1}", "{the_monster_1}说 {to_foe_1}：“愿{foe_god_1}与你同在，凡人！” {player_only_1}", "the_monster_1:name;to_foe_1:text;foe_god_1:name;player_only_1:text"},
    {"speech.monspeak.474beac90800d9f3", "{the_monster_1} says, \"May Beogh smile on you, {player_name_1}.\"", "{the_monster_1}说：“愿比欧弗对你微笑，{player_name_1}。”", "the_monster_1:name;player_name_1:name"},
    {"speech.monspeak.475cca8855ddce32", "{the_monster_1} says, \"What's with all that fungus\?\"", "{the_monster_1}说：“那么多真菌是怎么回事？”", "the_monster_1:name"},
    {"speech.monspeak.478cbadb43957792", "{the_monster_1} says, \"Resistance is futile!\"", "{the_monster_1}说：“抵抗是徒劳的！”", "the_monster_1:name"},
    {"speech.monspeak.47c3ae997a236e91", "{the_monster_1} says {to_foe_1}, \"I shall freeze you to your soul!\"", "{the_monster_1}说 {to_foe_1}：“我要把你连灵魂一起冻住！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.4820de2ff93294ec", "{the_monster_1} says, \"What do they mine anyway\? I've never seen them mine anything.\"", "{the_monster_1}说：“他们到底在挖什么？我从没见过他们挖出过任何东西。”", "the_monster_1:name"},
    {"speech.monspeak.48385e25fc8ed3c7", "{the_monster_1} says, \"Are you a fish\?\"", "{the_monster_1}说：“你是条鱼吗？”", "the_monster_1:name"},
    {"speech.monspeak.4846647b704259d2", "{the_monster_1} shouts {at_foe_1}, \"Can you die now\? I had plans for the rest of the day!\"", "{the_monster_1}喊道 {at_foe_1}：“你能现在就去死吗？我今天剩下的时间都安排好了！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.484992a471f97682", "{wizard_rare_1}", "{wizard_rare_1}", "wizard_rare_1:text"},
    {"speech.monspeak.485d32d80a113790", "{the_monster_1} screams {at_foe_1}, \"At last I'll have my revenge!\"", "{the_monster_1}尖叫 {at_foe_1}：“我终于可以报仇了！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.489adbcb874af91f", "{the_monster_1} {grum_verb_1} {at_foe_1}, \"Me and {grum_dog_name_1} will play fetch with your bones!\"", "{the_monster_1} {grum_verb_1} {at_foe_1}：“我和{grum_dog_name_1}会拿你的骨头玩抛接！”", "the_monster_1:name;grum_verb_1:text;at_foe_1:text;grum_dog_name_1:name"},
    {"speech.monspeak.489ed7361a2c669e", "{the_monster_1} mumbles, \"Stop that blasted singing, {orc_name_1}. You were always terrible.\"", "{the_monster_1}含混地说：“别唱那该死的歌了，{orc_name_1}。你一直唱得很难听。”", "the_monster_1:name;orc_name_1:text"},
    {"speech.monspeak.48a59876eeb33523", "{the_monster_1} says, \"Did you drop out of Necromancy School\?\"", "{the_monster_1}说：“你是从死灵学院退学的吗？”", "the_monster_1:name"},
    {"speech.monspeak.48b0892f1ca98fd5", "{nessos_rare_1}", "{nessos_rare_1}", "nessos_rare_1:text"},
    {"speech.monspeak.48b603754563204a", "{channel_1}{the_monster_1} grits {possessive_1} teeth and focuses.", "{channel_1}{the_monster_1}咬紧{possessive_1}牙关，集中起精神。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.48b880ca0b6b4789", "{the_monster_1} mutters {at_foe_1}, \"Right between the eyes...\"", "{the_monster_1}嘟囔道 {at_foe_1}：“正中眉心……”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.48cf96ef68f8012c", "{the_monster_1} ponders, \"They're ugly as hell, too!\"", "{the_monster_1}琢磨道：“他们也丑得要命！”", "the_monster_1:name"},
    {"speech.monspeak.48d92735f4af4606", "{the_monster_1} claims, \"I care not for such insignificant forces as time or death.\"", "{the_monster_1}宣称：“我才不在乎时间或死亡这种微不足道的力量。”", "the_monster_1:name"},
    {"speech.monspeak.48fd83a0849f4fe7", "{channel_1}{the_monster_1} flaps {possessive_1} cloak.", "{channel_1}{the_monster_1}抖动着{possessive_1}斗篷。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.490a8cb8c0fa1449", "{the_monster_1} shouts {at_foe_1}, \"No! I'll never do that again!\"", "{the_monster_1}喊道 {at_foe_1}：“不！我再也不干那种事了！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.491a05b19197a35e", "{the_monster_1} says, \"Why not just HIT them without all this spinning and flipping nonsense\?\"", "{the_monster_1}说：“为什么不干脆直接揍他们，非要转啊翻啊的？”", "the_monster_1:name"},
    {"speech.monspeak.49451638671d51a0", "Tosser", "蠢货", ""},
    {"speech.monspeak.49575ea034931b0d", "{the_monster_1} shouts {at_foe_1}, \"I have come for you, {foe_name_1}!\"", "{the_monster_1}喊道 {at_foe_1}：“我是来找你的，{foe_name_1}！”", "the_monster_1:name;at_foe_1:text;foe_name_1:name"},
    {"speech.monspeak.495efb45d5cfb326", "{the_monster_1} says, \"Your appearance changed my life!\"", "{the_monster_1}说：“你的出现改变了我的人生！”", "the_monster_1:name"},
    {"speech.monspeak.4974c9321ec2d389", "{the_monster_1} says, \"A storm is coming...\"", "{the_monster_1}说：“风暴要来了……”", "the_monster_1:name"},
    {"speech.monspeak.4975ecd001fc8103", "{the_monster_1} says, \"I hate clowns.\"", "{the_monster_1}说：“我讨厌小丑。”", "the_monster_1:name"},
    {"speech.monspeak.49a5f09b8b3c63e8", "{channel_1}{the_monster_possessive_1} robes are whipped around by a magical breeze.", "{channel_1}{the_monster_possessive_1}的长袍被一阵魔法之风卷起。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.49aecd0740eafaa5", "{the_monster_1} whispers, \"Time's up, {foe_name_1}!\"", "{the_monster_1}低声说：“时间到了，{foe_name_1}！”", "the_monster_1:name;foe_name_1:name"},
    {"speech.monspeak.49ddcb7ea36040a8", "{channel_1}{the_monster_1} cries.", "{channel_1}{the_monster_1}哭了起来。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.49e36dbe87dae03c", "{the_monster_1} says, \"You stick out like a sore thumb. Or at least, a shining one.\"", "{the_monster_1}说：“你显眼得像根肿起来的拇指。至少也算是位闪闪发光的那位。”", "the_monster_1:name"},
    {"speech.monspeak.49ecce495ce81818", "{the_monster_1} says, \"Me has best rocks.\"", "{the_monster_1}说：“俺的石头最好。”", "the_monster_1:name"},
    {"speech.monspeak.49fde8f1e962734a", "{robin_common_1}", "{robin_common_1}", "robin_common_1:text"},
    {"speech.monspeak.4a0af7ae4ae838f9", "{the_monster_1} roars.", "{the_monster_1}咆哮着。", "the_monster_1:name"},
    {"speech.monspeak.4a0bb7c43ccc29e4", "{the_monster_1} says, \"You gave up too much of yourself.\"", "{the_monster_1}说：“你舍弃了太多自我。”", "the_monster_1:name"},
    {"speech.monspeak.4a1f030012f91ffc", "{channel_1}{the_monster_1} sloshes about.", "{channel_1}{the_monster_1}咕唧作响地蠕动着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.4a445bf514931d15", "{channel_1}{the_monster_1} bows elegantly.", "{channel_1}{the_monster_1}优雅地行礼。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.4a55d56875beee69", "{the_monster_1} says, \"I mislead the hearts of men!\"", "{the_monster_1}说：“我误导人心！”", "the_monster_1:name"},
    {"speech.monspeak.4a63ea6b32e2cc28", "{the_monster_1} cries out, \"For our kin! And for all that died before them!\"", "{the_monster_1}喊道：“为了我们的同胞！也为了所有先他们而死的人！”", "the_monster_1:name"},
    {"speech.monspeak.4a6b36dfd932b0bc", "{the_monster_1} says, \"At least there's gold. That doesn't make up for it.\"", "{the_monster_1}说：“至少这儿有金子。可这弥补不了什么。”", "the_monster_1:name"},
    {"speech.monspeak.4a85b7bed1c7d7c1", "{the_monster_1} asks, \"Have you seen my surfboard\?\"", "{the_monster_1}问道：“你看见我的冲浪板了吗？”", "the_monster_1:name"},
    {"speech.monspeak.4a8954fe36549045", "{channel_1}{the_monster_1} picks up some beetles from the {surface_1} and offers them to you.", "{channel_1}{the_monster_1}从{surface_1}里捡起几只甲虫，递给你。", "channel_1:key;the_monster_1:name;surface_1:text"},
    {"speech.monspeak.4acf09e251c967fa", "{the_monster_1} says, \"What do potions have to do with a god of gold, anyway\?\"", "{the_monster_1}说：“药水跟一位黄金之神有什么关系？”", "the_monster_1:name"},
    {"speech.monspeak.4ae52d96c9a5288a", "{the_monster_1} yells, \"Get them off me!\"", "{the_monster_1}大吼：“把它们从我身上弄下去！”", "the_monster_1:name"},
    {"speech.monspeak.4ae83f90e453f57f", "{channel_1}{the_monster_1} is momentarily hidden by a cloud of flames.", "{channel_1}{the_monster_1}一时被一团火焰遮住了身影。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.4b175446d9e410c6", "{friendly_beogh_speech_common_1}", "{friendly_beogh_speech_common_1}", "friendly_beogh_speech_common_1:text"},
    {"speech.monspeak.4b18c900a13c6c2f", "{the_monster_1} whispers, \"The ORB doesn't exist.\" {player_only_1}", "{the_monster_1}低声说：“宝珠根本不存在。”{player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.4b1b51a939fc8a07", "{the_monster_1} gurgles, \"Huuuuuuuuuuungry!\"", "{the_monster_1}咕噜道：“饿饿饿饿饿死啦！”", "the_monster_1:name"},
    {"speech.monspeak.4b25c51d5466512b", "shouts", "喊道", ""},
    {"speech.monspeak.4b271df435e383a3", ", as Orcs often do.", "，就像兽人常做的那样。", ""},
    {"speech.monspeak.4b3312c058f0bc34", "{the_monster_1} says, \"Do you think you're a hero\? I hate that.\"", "{the_monster_1}说：“你以为你是英雄？我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.4b3c8e6bd7e1db46", "{the_monster_1} sings off-key, \"You got some money for me\?\"", "{the_monster_1}跑调地唱道：“你有钱给我花吗？”", "the_monster_1:name"},
    {"speech.monspeak.4b51abe707f94bbc", "{the_monster_1} says {to_foe_1}, \"I will drown you in your own blood.\"", "{the_monster_1}说 {to_foe_1}：“我要用你自己的血把你淹死。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.4b834c90039e6322", "{the_monster_1} says, \"Feeling lonely\?\"", "{the_monster_1}说：“感到孤单了吗？”", "the_monster_1:name"},
    {"speech.monspeak.4b8b6f28234c9943", "{the_monster_1} says {to_foe_1}, \"Thou must remain pure in the battle against evil.\"", "{the_monster_1}说 {to_foe_1}：“在与邪恶作战时，你必须保持纯洁。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.4bb51209056dbc01", "{channel_1}{the_monster_1} is momentarily distracted by a flea in {possessive_1} coat.", "{channel_1}{the_monster_1}一时被{possessive_1}外套里的一只跳蚤分了神。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.4bd581a28433ab54", "{the_monster_1} screams, \"Time for next experiment!\"", "{the_monster_1}尖叫道：“该做下个实验了！”", "the_monster_1:name"},
    {"speech.monspeak.4bda5709283ac75e", "snockshim", "斯诺克希姆", ""},
    {"speech.monspeak.4bfcbfea3b406a6d", "{the_monster_1} says, \"I hate vampires.\"", "{the_monster_1}说：“我讨厌吸血鬼。”", "the_monster_1:name"},
    {"speech.monspeak.4c0ca23349bb575b", "{wiglaf_nondwarf_1}", "{wiglaf_nondwarf_1}", "wiglaf_nondwarf_1:text"},
    {"speech.monspeak.4c10f9cfcc4daee1", "{default_friendly_related_humanoid_1}", "{default_friendly_related_humanoid_1}", "default_friendly_related_humanoid_1:text"},
    {"speech.monspeak.4c3bd0fbfe99d998", "{the_monster_1} whispers, \"It is all a dream - a grotesque and foolish dream.\"", "{the_monster_1}低声说：“这一切都是一场梦——一场荒诞而愚蠢的梦。”", "the_monster_1:name"},
    {"speech.monspeak.4c42b86e95d96f60", "{the_monster_1} says, \"None of these elves know how to fight. I hate that.\"", "{the_monster_1}说：“这些精灵没一个会打架的。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.4c551fc2005212ed", "{the_monster_1} shouts {at_foe_1}, \"You must be punished!\"", "{the_monster_1}喊道 {at_foe_1}：“你必须受到惩罚！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.4c6c29f133a2fdcd", "{the_monster_1} screams {at_foe_1}, \"You can't withstand my power!\"", "{the_monster_1}尖叫 {at_foe_1}：“你抵挡不住我的力量！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.4c83f109a06e1ab7", "{the_monster_1} says {to_foe_1}, \"For all the tithing, I expected a more glorious afterlife than this.\"", "{the_monster_1}说 {to_foe_1}：“交了那么多什一税，我本以为来世会比这荣耀些。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.4ca7242d264dda40", "{the_monster_1} shouts {at_foe_1}, \"You are history!\"", "{the_monster_1}喊道 {at_foe_1}：“你已经是历史了！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.4ca7ec058bbba111", "fly", "苍蝇", ""},
    {"speech.monspeak.4cadb5b4bec6ff64", "{channel_1}For a moment, {the_monster_1} blends into the shadows.", "{channel_1}有那么一瞬间，{the_monster_1}融入了阴影之中。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.4cb72b0446d56911", "{the_monster_1} says, \"Slow down!\"", "{the_monster_1}说：“慢一点！”", "the_monster_1:name"},
    {"speech.monspeak.4ce8341e0d1dae54", "{channel_1}{the_monster_1} does a flip.", "{channel_1}{the_monster_1}翻了个筋斗。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.4cea3eb357e952b9", "{cognitogaunt_1}", "{cognitogaunt_1}", "cognitogaunt_1:text"},
    {"speech.monspeak.4ceb45ae3dfb06db", "{the_monster_1} shouts {at_foe_1}, \"The curse of the Pharaohs be upon you!\"", "{the_monster_1}喊道 {at_foe_1}：“愿法老的诅咒降临于你！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.4d012c9aded518ac", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.4d1f97e028dfd006", "{the_monster_1} {orc_says_to_foe_1}, \"Beogh's messiah is just a fairy-tale.\"", "{the_monster_1}{orc_says_to_foe_1}：“比欧弗的弥赛亚只是个童话。”", "the_monster_1:name;orc_says_to_foe_1:text"},
    {"speech.monspeak.4d29234e55f072f5", "{the_monster_1} says, \"I've killed five 'adventurers' today. Will you be the sixth\?\"", "{the_monster_1}说：“我今天已经杀了五个‘冒险者’了。你会是第六个吗？”", "the_monster_1:name"},
    {"speech.monspeak.4d3afef7eccefd59", "{the_monster_1} says, \"I hate complainers so much.\"", "{the_monster_1}说：“我最恨爱抱怨的家伙了。”", "the_monster_1:name"},
    {"speech.monspeak.4d74f84a6f1f8b80", "{the_monster_1} says {to_foe_1}, \"You child of a rabid dog! Grandchild of a stinking jackal! Great-grandchild of a plucked vulture!\"", "{the_monster_1}说 {to_foe_1}：“你这疯狗的崽子！臭豺狼的孙子！拔光毛的秃鹫的曾孙！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.4d8b88311bda09c4", "{the_monster_1} flexes and says, \"Free ticket to bow show!\"", "{the_monster_1}翘起肌肉说：“肌肉秀免费看！”", "the_monster_1:name"},
    {"speech.monspeak.4d90801fa73073ff", "{louise_rare_1}", "{louise_rare_1}", "louise_rare_1:text"},
    {"speech.monspeak.4d98bb5e0840bf4a", "{channel_1}{the_monster_1} brushes some snowflakes from {possessive_1} robe.", "{channel_1}{the_monster_1}拂去{possessive_1}长袍上的几片雪花。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.4d9bea20141296f2", "{channel_1}{the_monster_1} smiles at {foe_1}.", "{channel_1}{the_monster_1}对 {foe_1}微笑。", "channel_1:key;the_monster_1:name;foe_1:text"},
    {"speech.monspeak.4da06745ad98c013", "{channel_1}{the_monster_1} gestures wildly.", "{channel_1}{the_monster_1}疯狂地比划着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.4db29f83a3d2ca28", "{the_monster_1} says, \"I was weak before I became an orc, but now I'm strong. And I'll get stronger.\"", "{the_monster_1}说：“在变成兽人之前我很弱小，但现在我很强壮。而且我会越来越强。”", "the_monster_1:name"},
    {"speech.monspeak.4dc3beebbb73ec82", "gibbers darkly", "阴森地咕哝", ""},
    {"speech.monspeak.4dc58bc953b29cc2", "{the_monster_1} gurgles, \"Let's see if you taste as good as that wizard did.\"", "{the_monster_1}咕噜道：“让我看看你有没有那个巫师那么好吃。”", "the_monster_1:name"},
    {"speech.monspeak.4dd39b763bfc18fe", "{says_imp_taunt_1}", "{says_imp_taunt_1}", "says_imp_taunt_1:text"},
    {"speech.monspeak.4e0c3101177c1707", "{the_monster_1} sings, \"Trees, trees, trees, circus!\"", "{the_monster_1}唱道：“树，树，树，马戏团！”", "the_monster_1:name"},
    {"speech.monspeak.4e17a5b95edf0761", "{the_monster_1} says {to_foe_1}, \"This isn't over yet!\"", "{the_monster_1}说 {to_foe_1}：“这事还没完！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.4e1d2779074ade89", "{the_monster_1} screams in a voice full of rage, \"No, no!\"", "{the_monster_1}用充满怒火的声音尖叫道：“不，不！”", "the_monster_1:name"},
    {"speech.monspeak.4e356344d98a111c", "{the_monster_1} says, \"It's nice to have friends.\"", "{the_monster_1}说：“有朋友真好。”", "the_monster_1:name"},
    {"speech.monspeak.4e383982c6acbfbc", "{the_monster_1} gurgles, \"About time. I'm starving!\"", "{the_monster_1}咕噜道：“可算到时候了。我快饿死了！”", "the_monster_1:name"},
    {"speech.monspeak.4e5bd203d1726eb1", "{the_monster_1} says {to_foe_1}, \"Praised be {good_god_1} in the heavens above!\"", "{the_monster_1}说 {to_foe_1}：“愿{good_god_1}在天上受赞美！”", "the_monster_1:name;to_foe_1:text;good_god_1:name"},
    {"speech.monspeak.4e72207cd9d28dd6", "{the_monster_1} wildly gestures.", "{the_monster_1}疯狂地比划着。", "the_monster_1:name"},
    {"speech.monspeak.4e8fbd5b288e5b08", "{the_monster_1} whispers, \"Be very very quiet, I'm hunting {player_genus_plural_1}.\" {player_only_1}", "{the_monster_1}低语道：“非常非常安静，我正在猎捕{player_genus_plural_1}。” {player_only_1}", "the_monster_1:name;player_genus_plural_1:name;player_only_1:text"},
    {"speech.monspeak.4e98703a87a2dec2", "sow", "播下", ""},
    {"speech.monspeak.4ea516ff43926f44", "hog", "猪", ""},
    {"speech.monspeak.4eb94e27339ebb5e", "{the_monster_1} says, \"What's a barding, anyway\? Does it sing for its supper\?\"", "{the_monster_1}说：“话说马甲是什么？它会唱歌讨饭吗？”", "the_monster_1:name"},
    {"speech.monspeak.4ee40cc5e097eee5", "says", "说道", ""},
    {"speech.monspeak.4f06bc8d16c04f27", "{the_monster_1} starts to sing a prayer.", "{the_monster_1}开始吟唱祷文。", "the_monster_1:name"},
    {"speech.monspeak.4f0f5889e3ae9a6b", "{the_monster_1} says, \"That ghoul gave me heartburn.\"", "{the_monster_1}说：“那个食尸鬼让我烧心。”", "the_monster_1:name"},
    {"speech.monspeak.4f38df0e9b58eb48", "{channel_1}{the_monster_1} gives {reflexive_1} a magical halo, but it quickly sputters out.", "{channel_1}{the_monster_1}给{reflexive_1}套上一圈魔法光环，但光环很快便噼啪熄灭。", "channel_1:key;the_monster_1:name;reflexive_1:text"},
    {"speech.monspeak.4f7c7fd7b4303afa", "Gnoll", "豺狼人", ""},
    {"speech.monspeak.4f80e6534ad65224", "Whippet", "小灵缇", ""},
    {"speech.monspeak.4f85d80730213f94", "green", "绿色", ""},
    {"speech.monspeak.4f9c7677454d6123", "{the_monster_1} says, \"I can never work out what any of these scrolls mean.\"", "{the_monster_1}说：“我永远搞不懂这些卷轴是什么意思。”", "the_monster_1:name"},
    {"speech.monspeak.4fb3d97ee66e7f3d", "{the_monster_1} boasts {to_foe_1}, \"If terror be the object, I am a masterpiece!\"", "{the_monster_1}夸口道 {to_foe_1}：“若恐怖是件作品，那我就是杰作！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.4fb400184c74518e", "{the_monster_1} says {to_foe_1}, \"You will make a fine ice sculpture.\"", "{the_monster_1}说 {to_foe_1}：“你会成为一件精美的冰雕。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.4fbf508e252fad7f", "{the_monster_1} says, \"Is it cursed, or does it curse\? I can never tell.\"", "{the_monster_1}说：“它是被诅咒的，还是它诅咒人？我永远分不清。”", "the_monster_1:name"},
    {"speech.monspeak.4fc92a1173de3a71", "{the_monster_possessive_1} lion-head roars!", "{the_monster_possessive_1}狮首发出吼叫！", "the_monster_possessive_1:name"},
    {"speech.monspeak.4fcda186818c49b9", "lengthy", "冗长的", ""},
    {"speech.monspeak.4fd25d78d0fb5cb6", "{the_monster_1} says, \"And that's the last I'll see of you.\"", "{the_monster_1}说：“这就是我最后一次见到你了。”", "the_monster_1:name"},
    {"speech.monspeak.4fdc63d837ac8be4", "{the_monster_1} explains the importance of {important_subject_1}", "{the_monster_1}讲解{important_subject_1}的重要性", "the_monster_1:name;important_subject_1:text"},
    {"speech.monspeak.4fe449a147f88d4d", "{the_monster_1} says, \"Now the real fun starts!\"", "{the_monster_1}说：“真正的好戏这才开场！”", "the_monster_1:name"},
    {"speech.monspeak.5015d05965b6c34c", "{the_monster_1} says happily, \"You and me, we're family.\"", "{the_monster_1}开心地说：“你和我，我们是一家人。”", "the_monster_1:name"},
    {"speech.monspeak.503741fb05e64bce", "{the_monster_1} says, \"I hate hellfire.\"", "{the_monster_1}说：“我讨厌地狱火。”", "the_monster_1:name"},
    {"speech.monspeak.5038dad82951103e", "{the_monster_1} says {to_foe_1}, \"I will show you what pain is.\"", "{the_monster_1}说 {to_foe_1}：“我会让你知道什么叫痛苦。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.503a2f7ab25c71fe", "{the_monster_1} wonders, \"What am I doing in here\?\"", "{the_monster_1}纳闷道：“我在这里干什么？”", "the_monster_1:name"},
    {"speech.monspeak.5050fcb68318b7fe", "{the_monster_1} says, \"Don't worry, you'll be warm in a moment.\"", "{the_monster_1}说：“别担心，你马上就会暖和起来。”", "the_monster_1:name"},
    {"speech.monspeak.506b5c86dc1a0daf", "{the_monster_1} says, \"I asked for directions to the rune, but they belched at me.\"", "{the_monster_1}说：“我问他们符文在哪儿，他们却冲我打嗝。”", "the_monster_1:name"},
    {"speech.monspeak.507d5f3c3eba9415", "{the_monster_1} says, \"I just hope the loot isn't guarded by liches. I hate liches.\"", "{the_monster_1}说：“我只希望财宝不是由巫妖把守的。我讨厌巫妖。”", "the_monster_1:name"},
    {"speech.monspeak.50830806ba0eecd2", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.509ef8e143d38390", "{the_monster_1} screams, \"What are you staring at, {player_name_1}\? I'm stylish!\" {player_only_1}", "{the_monster_1}尖叫道：“你在盯着看什么，{player_name_1}？我很时髦！”{player_only_1}", "the_monster_1:name;player_name_1:name;player_only_1:text"},
    {"speech.monspeak.50a56e00cb91ca17", "{channel_1}{the_monster_1} stares off into space for a moment.", "{channel_1}{the_monster_1}茫然地盯着虚空看了一会儿。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.50a74c1bb2e1e2d5", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.50a8f947885f3291", "{the_monster_1} {menkaure_verb_1}, \"It doesn't hurt if you pull your brain out of your nose yourself.\"", "{the_monster_1} {menkaure_verb_1}：“你自己把脑子从鼻子里拽出来，就不会疼了。”", "the_monster_1:name;menkaure_verb_1:text"},
    {"speech.monspeak.50c1ebb1f08a7aed", "{the_monster_1} says, \"The sword shall overcome grief!\"", "{the_monster_1}说：“剑能战胜悲痛！”", "the_monster_1:name"},
    {"speech.monspeak.50e5e80a047d85cb", "{friendly_fleeing_common_1}", "{friendly_fleeing_common_1}", "friendly_fleeing_common_1:text"},
    {"speech.monspeak.50fb7d8297f39b72", "{the_monster_1} says, \"My favourite colour of blood is {blorkula_colour_1}. Wait, no, {blorkula_colour_2}.\"", "{the_monster_1}说：“我最喜欢的血的颜色是{blorkula_colour_1}。等等，不对，是{blorkula_colour_2}。”", "the_monster_1:name;blorkula_colour_1:text;blorkula_colour_2:text"},
    {"speech.monspeak.510a869757adef0a", "{channel_1}{the_monster_1} smiles happily.", "{channel_1}{the_monster_1}开心地微笑着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.511fd4d71aa4d8e0", "{generic_ranged_1}", "{generic_ranged_1}", "generic_ranged_1:text"},
    {"speech.monspeak.51279673e506b09d", "{the_monster_1} says, \"Duck!\"", "{the_monster_1}说：“低头！”", "the_monster_1:name"},
    {"speech.monspeak.515c1e74546152d5", "{the_monster_1} grins, \"Not even the Unformed can stop the chosen ones of Beogh!\"", "{the_monster_1}咧嘴一笑：“连无形之神也挡不住比欧弗的天选之子！”", "the_monster_1:name"},
    {"speech.monspeak.515e6770413ee8c0", "{the_monster_1} draws Vitriol. \"Acid hurts!\"", "{the_monster_1}抽到了硫酸。“酸可疼了！”", "the_monster_1:name"},
    {"speech.monspeak.516d4fe7c9fa12e0", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.516f93f2074075cd", "{channel_1}{the_monster_1} stares at you quizzically. {player_only_1}", "{channel_1}{the_monster_1}疑惑地盯着你。 {player_only_1}", "channel_1:key;the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.5194ef6a8d3024ff", "{the_monster_1} says, \"Want to take a trip\?\"", "{the_monster_1}说：“想去旅行吗？”", "the_monster_1:name"},
    {"speech.monspeak.519716a5f78c28e9", "{channel_1}{the_monster_1} gestures obscenely.", "{channel_1}{the_monster_1}做出下流的手势。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.5198415ff91cb0f0", "The priest shouts, \"You had your chance, apostate scum!\"", "祭司喊道：“机会已经给过你了，叛教的渣滓！”", ""},
    {"speech.monspeak.51de7129593fbc2e", "{the_monster_1} {norris_verb_1} {to_foe_1}, \"Aren't you the least bit curious about what happens next\?\"", "{the_monster_1}{norris_verb_1} {to_foe_1}：“接下来会发生什么，你就一点都不好奇吗？”", "the_monster_1:name;norris_verb_1:text;to_foe_1:text"},
    {"speech.monspeak.5217971059eea655", "{the_monster_1} says, \"You want the ORB\? You'll never get it.\" {player_only_1}", "{the_monster_1}说：“你想要宝珠？你永远也别想得到。”{player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.52198f1643ce5946", "our heart stopping", "我们的心脏停止了", ""},
    {"speech.monspeak.521f54cb7b8920df", "{channel_1}{the_monster_1} swings {possessive_1} fists at you. {player_only_1}", "{channel_1}{the_monster_1}朝你挥出{possessive_1}拳头。 {player_only_1}", "channel_1:key;the_monster_1:name;possessive_1:text;player_only_1:text"},
    {"speech.monspeak.52275500e209cad7", "{channel_1}{the_monster_1} stares at you with {possessive_1} ghostly eyes.", "{channel_1}{the_monster_1}用{possessive_1}幽灵般的眼睛盯着你。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.523ea6b2c1580222", "blue", "蓝色", ""},
    {"speech.monspeak.5243aaefc8ee0338", "{tormentor_rare_1}", "{tormentor_rare_1}", "tormentor_rare_1:text"},
    {"speech.monspeak.52669954df5dd114", "{the_monster_1} crumbles to pieces from sheer guilt.", "{the_monster_1}因为纯粹的内疚碎成了渣。", "the_monster_1:name"},
    {"speech.monspeak.527b1da58f09cfb8", "{the_monster_1} says {to_foe_1}, \"Just let the darkness consume you.\"", "{the_monster_1}说 {to_foe_1}：“就让黑暗吞噬你吧。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.52cfb7aaedaceb37", "{the_monster_1} cries, \"You know not what is at stake here!\"", "{the_monster_1}哭喊道：“你根本不知道这关系到什么！”", "the_monster_1:name"},
    {"speech.monspeak.52e3daf158e96a37", "{the_monster_1} says, \"I won. I... don't hate that.\"", "{the_monster_1}说：“我赢了。我……不讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.52e83cc6a2c6b12b", "{the_monster_1} rasps, \"We were once... so many....\"", "{the_monster_1}嘶哑地说：“我们曾经……那么多……”", "the_monster_1:name"},
    {"speech.monspeak.52f3f6d4de005e39", "{the_monster_1} sighs, \"Someday I'll have a real challenge.\"", "{the_monster_1}叹息道：“总有一天我会遇上一个真正的挑战。”", "the_monster_1:name"},
    {"speech.monspeak.52faa8b5f9b16793", "{the_monster_1} yowls pathetically as {subjective_1} dies!", "{the_monster_1}在{subjective_1}死去时凄惨地哀嚎！", "the_monster_1:name;subjective_1:text"},
    {"speech.monspeak.533e41b2a3fe86fc", "{the_monster_1} screams at {foe_1}, \"You haven't seen true ruin and despair yet!\"", "{the_monster_1}冲{foe_1}尖叫：“你还没见识过真正的毁灭与绝望！”", "the_monster_1:name;foe_1:text"},
    {"speech.monspeak.535b422584240290", "{the_monster_1} says, \"And I thought they were famous for their poetry.\"", "{the_monster_1}说：“我还以为他们以诗歌闻名呢。”", "the_monster_1:name"},
    {"speech.monspeak.536195994bdb0ce5", "{the_monster_1} says, \"Another soul for the market.\"", "{the_monster_1}说：“又多了一个能卖到市场上的灵魂。”", "the_monster_1:name"},
