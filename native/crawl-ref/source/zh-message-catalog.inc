    {"speech.monspeak.272c0149fa6522a6", "{grum_common_1}", "{grum_common_1}", "grum_common_1:text"},
    {"speech.monspeak.273e336463d4462e", "{the_monster_1} says {to_foe_1}, \"Odis was a nice man; you're awful.\"", "{the_monster_1}说 {to_foe_1}：“奥德修斯是个好人，你可真差劲。”", "the_monster_1:name;to_foe_1:text"},
