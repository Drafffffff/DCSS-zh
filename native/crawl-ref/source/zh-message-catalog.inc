    {"speech.monspeak.560b0373afbb4934", "{blorkula_the_orcula_1}", "{blorkula_the_orcula_1}", "blorkula_the_orcula_1:text"},
    {"speech.monspeak.561a3d17fcf3118f", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
