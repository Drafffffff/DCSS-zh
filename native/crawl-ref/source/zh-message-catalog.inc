    {"speech.monspeak.5764fa3ba3dd2d86", "not dealing with demons.", "不与恶魔打交道。", ""},
    {"speech.monspeak.577a3214a83157eb", "{channel_1}{the_monster_1} smiles {at_foe_1}.", "{channel_1}{the_monster_1}露出微笑 {at_foe_1}。", "channel_1:key;the_monster_1:name;at_foe_1:text"},
