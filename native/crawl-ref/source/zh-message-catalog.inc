    {"speech.monspeak.283ecca72c526831", "{the_monster_1} says, \"How can I live without her\?\"", "{the_monster_1}说：“没有她，我怎么活得下去？”", "the_monster_1:name"},
    {"speech.monspeak.284804026ad2d344", "{the_monster_1} says, \"Nice gear. Can I borrow some\?\"", "{the_monster_1}说：“好装备。能借我点儿吗？”", "the_monster_1:name"},
