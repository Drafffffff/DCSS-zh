    {"speech.monspeak.d241da95a834bb13", "{the_monster_1} mutters something uncomplimentary.", "{the_monster_1}嘟囔了几句不中听的话。", "the_monster_1:name"},
    {"speech.monspeak.d24470873aee81a3", "{channel_1}{the_monster_1} pantomimes {foe_possessive_1} execution.", "{channel_1}{the_monster_1}用哑剧表演{foe_possessive_1}处决。", "channel_1:key;the_monster_1:name;foe_possessive_1:text"},
    {"speech.monspeak.d24ad51b46525d0d", "{the_monster_1} shouts {to_foe_1}, \"You're giving me such wonderful data!\"", "{the_monster_1}喊道 {to_foe_1}：“你给我提供了多么精彩的数据！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.d2509c7f00a7d937", "{friendly_confused_medium_1}", "{friendly_confused_medium_1}", "friendly_confused_medium_1:text"},
    {"speech.monspeak.d257df5ff61a5d97", "{the_monster_1} says, \"The ORB is mine by right.\"", "{the_monster_1}说：“宝珠理应归我。”", "the_monster_1:name"},
    {"speech.monspeak.d25e8e84a25ff5fd", "{the_monster_1} says, \"I'll show you the great annihilating truth!\"", "{the_monster_1}说：“我会向你展示那伟大的湮灭真理！”", "the_monster_1:name"},
    {"speech.monspeak.d298460328fd1bbd", "destruction", "毁灭", ""},
    {"speech.monspeak.d2a112c5572a29a2", "{the_monster_1} says, \"Turn her back! At once!\"", "{the_monster_1}说：“把她变回来！马上！”", "the_monster_1:name"},
    {"speech.monspeak.d2b2d0a665c3070f", "{the_monster_1} says, \"Nothing ever attacks me when I'm in the Abyss.\"", "{the_monster_1}说：“我在深渊里的时候，什么都不会来攻击我。”", "the_monster_1:name"},
    {"speech.monspeak.d2bdf0bd8b3bdb2f", "Whiteboard", "白板", ""},
    {"speech.monspeak.d2ca437bbf6a7ca3", "{the_monster_1} {orc_says_to_foe_1}, \"For a messiah, you look rather {choice_1}.\"", "{the_monster_1}{orc_says_to_foe_1}：“作为一个弥赛亚，你看起来相当{choice_1}。”", "the_monster_1:name;orc_says_to_foe_1:text;choice_1:text"},
    {"speech.monspeak.d2ca437bbf6a7ca3.choice_1.alt_0", "sorry", "寒酸", ""},
    {"speech.monspeak.d2ca437bbf6a7ca3.choice_1.alt_1", "pathetic", "可悲", ""},
    {"speech.monspeak.d2ca437bbf6a7ca3.choice_1.alt_2", "miserable", "凄惨", ""},
    {"speech.monspeak.d2d54ffc590ddf90", "{the_monster_1} says, \"I touched Geryon's horn once.\"", "{the_monster_1}说：“我摸过一次吉里昂的犄角。”", "the_monster_1:name"},
    {"speech.monspeak.d2d6fe98710eb3b8", "{the_monster_1} says, \"I keep hearing this weird shrieking in my head. I hate that.\"", "{the_monster_1}说：“我脑子里老是听到奇怪的尖啸。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.d2e939f2b87caa8c", "{the_monster_1} {orc_says_to_foe_1}, \"Orcs don't need Beogh!\"", "{the_monster_1}{orc_says_to_foe_1}：“兽人不需要比欧弗！”", "the_monster_1:name;orc_says_to_foe_1:text"},
    {"speech.monspeak.d2f0fd71b77548f7", "shouts", "喊道", ""},
    {"speech.monspeak.d2f33ff8dfe0245a", "{the_monster_1} says, \"You have the Orb. Was it worth it\?\"", "{the_monster_1}说：“宝珠到手了。值得吗？”", "the_monster_1:name"},
    {"speech.monspeak.d2ffbd0160ab0c7f", "{the_monster_1} says {to_foe_1}, \"You will be nailed to the ground forevermore.\"", "{the_monster_1}说 {to_foe_1}：“你将被永远钉在地上。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.d31b0e10822e4106", "{channel_1}{the_monster_1} rolls {possessive_1} eyes.", "{channel_1}{the_monster_1}翻了翻{possessive_1}眼睛。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.d343244d32a61053", "{the_monster_1} says, \"I'll never walk a tight-rope again!\"", "{the_monster_1}说：“我再也不会去走钢丝了！”", "the_monster_1:name"},
    {"speech.monspeak.d37122465b73ee46", "{the_monster_1} says {to_foe_1}, \"Let your plans be as dark and impenetrable as the night.\"", "{the_monster_1}说 {to_foe_1}：“让你的计划像黑夜一样幽暗而深不可测。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.d3a12d0e038c3c71", "{the_monster_1} says, \"You're grass, mortal.\"", "{the_monster_1}说：“你不过是棵草，凡人。”", "the_monster_1:name"},
    {"speech.monspeak.d3a441a46c234b20", "{the_monster_1} screams in pain as {subjective_1} dies!", "{the_monster_1}在{subjective_1}死去时痛苦地尖叫！", "the_monster_1:name;subjective_1:text"},
    {"speech.monspeak.d3e4d6f5748fe9ae", "{the_monster_1} says, \"I practised a lot since I died.\"", "{the_monster_1}说：“我死了以后可练了不少。”", "the_monster_1:name"},
    {"speech.monspeak.d3f597f6e8c6c14f", "{channel_1}{the_monster_1} pulls a severed tentacle out of their boot and sighs heavily.", "{channel_1}{the_monster_1}从靴子里拽出一条断掉的触手，重重叹了口气。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.d3f9a1677f26277d", "Defame", "诽谤", ""},
    {"speech.monspeak.d407b7979d0824fd", "{channel_1}{the_monster_1} rams the {surface_1} with {possessive_1} head heavily.", "{channel_1}{the_monster_1}用{surface_1}头狠狠地撞向{possessive_1}。", "channel_1:key;the_monster_1:name;surface_1:text;possessive_1:text"},
    {"speech.monspeak.d417b432e4fd8b3e", "{the_monster_1} wonders wistfully, \"Should I have meditated another thousand years\?\"", "{the_monster_1}惆怅地感慨：“我是不是该再打坐上千年？”", "the_monster_1:name"},
    {"speech.monspeak.d427c508d149797f", "{the_monster_1} says, \"If I pretend to be a jelly, can I have your stuff\?\"", "{the_monster_1}说：“如果我装作是胶冻，能把你的东西给我吗？”", "the_monster_1:name"},
    {"speech.monspeak.d427fdbfcc5e81d0", "{wizard_common_spell_1}\n{fake_spell_effect_1}", "{wizard_common_spell_1}\n{fake_spell_effect_1}", "wizard_common_spell_1:text;fake_spell_effect_1:text"},
    {"speech.monspeak.d4469a4e1ea3d208", "{the_monster_1} lets out a booming laugh, sending rocks and debris crashing down.", "{the_monster_1}发出一阵雷鸣般的大笑，震得岩石和碎屑纷纷坠落。", "the_monster_1:name"},
    {"speech.monspeak.d4585d6e9e15ae54", "{the_monster_1} says, \"I was going to become a lich, but this is almost as good.\"", "{the_monster_1}说：“我本打算变成巫妖的，不过现在这样也差不多。”", "the_monster_1:name"},
    {"speech.monspeak.d45fa97e027b8679", "{the_monster_1} {wails_1}, \"Why can't you leave me to my rest\?\"", "{the_monster_1} {wails_1}：“你为什么不能让我安息？”", "the_monster_1:name;wails_1:text"},
    {"speech.monspeak.d4689f072b71c5f9", "{the_monster_1} complains, \"You're an easy kill, but not a fun one.\"", "{the_monster_1}抱怨道：“你杀起来很容易，可一点也不好玩。”", "the_monster_1:name"},
    {"speech.monspeak.d47edbf9fe811b5e", "{the_monster_1} says, \"This tentacle just came out of nowhere and touched me. I hate tentacles!\"", "{the_monster_1}说：“这条触手不知从哪儿冒出来碰了我一下。我讨厌触手！”", "the_monster_1:name"},
    {"speech.monspeak.d494e86ad4c0fae0", "{the_monster_1} says, \"I used to sell toenails on the black market.\"", "{the_monster_1}说：“我以前在黑市上卖脚趾甲。”", "the_monster_1:name"},
    {"speech.monspeak.d4a4ff89b2de4a7f", "{the_monster_1} pleads {to_foe_1}, \"Don't hit me!\"", "{the_monster_1}恳求道 {to_foe_1}：“别打我！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.d4c0132de3a476dd", "{sojobo_rare_1}", "{sojobo_rare_1}", "sojobo_rare_1:text"},
    {"speech.monspeak.d4c757c36988da09", "{the_monster_1} {wails_1}, \"I have seen your future, and it is all used up.\"", "{the_monster_1} {wails_1}：“我见过你的未来，它已经被消耗殆尽。”", "the_monster_1:name;wails_1:text"},
    {"speech.monspeak.d4ca6aa6cf52b474", "{the_monster_1} says, \"You're jumping off the walls\? I hate that.\"", "{the_monster_1}说：“你还会从墙上跳开？我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.d4da15422d50e10f", "{the_monster_1} says, \"Do you like preaching on mountaintops\?\"", "{the_monster_1}说：“你喜欢在山顶上布道吗？”", "the_monster_1:name"},
    {"speech.monspeak.d4dacd3baa2b2253", "{channel_1}{the_monster_1} is bathed in the radiant lights of Iskenderun.", "{channel_1}{the_monster_1}沐浴在伊斯坎德伦的光辉之中。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.d4f932595fdabae9", "{subjective_1} says, \"You must be the Messiah, I see it now!\"", "{subjective_1}说：“你一定就是弥赛亚，我现在明白了！”", "subjective_1:text"},
    {"speech.monspeak.d51527ac98b8498e", "{channel_1}{the_monster_1} bows.", "{channel_1}{the_monster_1}鞠了一躬。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.d51566b60e5887cf", "shunning all {choice_1}.", "避开一切{choice_1}。", "choice_1:text"},
    {"speech.monspeak.d51566b60e5887cf.choice_1.alt_0", "talismans", "护身符", ""},
    {"speech.monspeak.d51566b60e5887cf.choice_1.alt_1", "baubles", "小饰物", ""},
    {"speech.monspeak.d5458e017d5289ca", "{hostile_orc_beogh_unbeliever_speech_rare_1}", "{hostile_orc_beogh_unbeliever_speech_rare_1}", "hostile_orc_beogh_unbeliever_speech_rare_1:text"},
    {"speech.monspeak.d54913f6b1b4ca5a", "{the_monster_1} hisses {to_foe_1}, \"Insulting my beauty only makes me fight harder!\"", "{the_monster_1}尖声说 {to_foe_1}：“侮辱我的美貌只会让我打得更狠！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.d54c2bb95d2d4d74", "{the_monster_1} shouts {at_foe_1}, \"Die, {foe_name_1}!\"", "{the_monster_1}喊道 {at_foe_1}：“死吧，{foe_name_1}！”", "the_monster_1:name;at_foe_1:text;foe_name_1:name"},
    {"speech.monspeak.d572c22e2f1871c7", "{the_monster_1} bows and submits to you. \"Nah, just kidding.\"", "{the_monster_1}鞠了一躬，向你臣服。“哈，开玩笑的。”", "the_monster_1:name"},
    {"speech.monspeak.d57a708e37a9544a", "Announcement", "公告", ""},
    {"speech.monspeak.d58877884d187773", "{the_monster_1} grins {at_foe_1} greedily, jangling a coin purse.", "{the_monster_1}贪婪地咧嘴一笑 {at_foe_1}，晃了晃钱袋。", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.d5894866bcb806b7", "{the_monster_1} shouts, \"You will never get the ORB!\" {player_only_1}", "{the_monster_1}喊道：“你永远也别想拿到宝珠！”{player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.d5a3a4b1e033d25e", "{the_monster_1} screams, \"Zot is a myth, the ORB is a fable, you'll soon be a tale!\" {player_only_1}", "{the_monster_1}尖叫道：“佐特是神话，宝珠是寓言，而你很快就会成为传说！”{player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.d5afdbb86b62b4b7", "{the_monster_1} says, \"In my kingdom, weaklings like you are put to the sword.\" {player_only_1}", "{the_monster_1}说：“在我的王国里，像你这样的弱者只有被处死的份。”{player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.d5ca293eb5aaf84d", "{channel_1}{the_monster_1} strikes a fencing pose.", "{channel_1}{the_monster_1}摆出一个击剑姿势。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.d5daeea6ed16265d", "{the_monster_1} shouts, \"No mercy! Kill them all!\"", "{the_monster_1}喊道：“不留活口！全都杀掉！”", "the_monster_1:name"},
    {"speech.monspeak.d5f01c9d9ac166ad", "sighs", "叹息", ""},
    {"speech.monspeak.d5f10c10e2c1cb00", "an army like a tide", "如潮水般的大军", ""},
    {"speech.monspeak.d5f60f1da0adc8a1", "{the_monster_1} shouts, \"Blood calls out to blood!\"", "{the_monster_1}吼道：“血债血偿！”", "the_monster_1:name"},
    {"speech.monspeak.d60b2b6addb419e1", "{the_monster_1} says {to_foe_1}, \"I might not be good at magic, but I can still kill you!\"", "{the_monster_1}说 {to_foe_1}：“我可能不擅长魔法，但我照样能杀了你！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.d61bfe6c08bfeb6b", "{channel_1}{the_monster_1} grows four more heads, takes them off and juggles!", "{channel_1}{the_monster_1}又长出四个脑袋，把它们摘下来耍起了抛接！", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.d6220393f43a7a67", "{sigmund_common_1}", "{sigmund_common_1}", "sigmund_common_1:text"},
    {"speech.monspeak.d625d1de5554212d", "{the_monster_1} says, \"Cleansing flame\? What's it supposed to be cleansing\? The floor\?\"", "{the_monster_1}说：“净化之焰？它到底是在净化什么？地板吗？”", "the_monster_1:name"},
    {"speech.monspeak.d627ec34be670063", "{the_monster_1} wonders, \"Can you step in the same river twice\?\"", "{the_monster_1}好奇地想：“人能两次踏进同一条河吗？”", "the_monster_1:name"},
    {"speech.monspeak.d659d70b1d914aa7", "{generic_orc_speech_1}", "{generic_orc_speech_1}", "generic_orc_speech_1:text"},
    {"speech.monspeak.d65ad61f2b8dd9d4", "{channel_1}{the_monster_1} looks very confused.", "{channel_1}{the_monster_1}看起来非常困惑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.d666ecbb6d90ffe7", "{the_monster_1} \"Baaaas\" sleepily.", "{the_monster_1}睡意朦胧地“咩咩”叫着。", "the_monster_1:name"},
    {"speech.monspeak.d66d4e1530777d8d", "{the_monster_1} says, \"Join me in the dance of death.\"", "{the_monster_1}说：“和我一起共舞死亡之舞吧。”", "the_monster_1:name"},
    {"speech.monspeak.d673b83d0df1e4a4", "{channel_1}{the_monster_1} shuffles {possessive_1} notes under {possessive_2} cloak.", "{channel_1}{the_monster_1}把{possessive_1}笔记塞进{possessive_2}斗篷底下。", "channel_1:key;the_monster_1:name;possessive_1:text;possessive_2:text"},
    {"speech.monspeak.d682698ac64dc862", "You hear a distant wail of despair.", "你听到远方传来绝望的哀号。", ""},
    {"speech.monspeak.d68a6128492e5f33", "{edmund_rare_1}", "{edmund_rare_1}", "edmund_rare_1:text"},
    {"speech.monspeak.d68e8719dd4cbf45", "{the_monster_1} roars fiercely, eyes lowered.", "{the_monster_1}低垂着双眼，凶猛地吼叫。", "the_monster_1:name"},
    {"speech.monspeak.d694f521ec966372", "ban", "藩主", ""},
    {"speech.monspeak.d6aa3b1cebf0adef", "{the_monster_1} says, \"I got nailed to the sky once. No big deal, really.\"", "{the_monster_1}说：“我有一次被钉在天上。没什么大不了的，真的。”", "the_monster_1:name"},
    {"speech.monspeak.d6ae8ecb65f4781d", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.d6d38c3c5da23eb1", "{the_monster_1} whispers, \"Death is liberation.\"", "{the_monster_1}低声说：“死亡即是解脱。”", "the_monster_1:name"},
    {"speech.monspeak.d6d775be5d92e967", "{the_monster_1} says, \"Missed me!\"", "{the_monster_1}说：“没打中我！”", "the_monster_1:name"},
    {"speech.monspeak.d6ea3387766999e3", "{the_monster_1} barks orders to {possessive_1} subordinates.", "{the_monster_1}向{possessive_1}部下厉声下达命令。", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.d7022870d2ba1a11", "{the_monster_1} says {to_foe_1}, \"The whole secret lies in confusing the enemy.\"", "{the_monster_1}说 {to_foe_1}：“全部的秘诀在于迷惑敌人。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.d70c379a01519b2e", "{the_monster_1} says, \"What use are spells, anyway\?\"", "{the_monster_1}说：“法术到底有什么用？”", "the_monster_1:name"},
    {"speech.monspeak.d721b3f696fc65ee", "{the_monster_1} says, \"Can you spell it for me - slowly\?\"", "{the_monster_1}说：“你能拼给我听吗——慢一点？”", "the_monster_1:name"},
    {"speech.monspeak.d722899dc1c0e92c", "{the_monster_1} says, \"Just stop there for a second...\"", "{the_monster_1}说：“就先在那儿停一会儿……”", "the_monster_1:name"},
    {"speech.monspeak.d72753f631c051c9", "{the_monster_1} says {to_foe_1}, \"Have ye nae fought a dwarf before\?\"", "{the_monster_1}说 {to_foe_1}：“你以前没跟矮人打过架吗？”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.d74394c04769dfa8", "{the_monster_1} asks {foe_1} \"Say, could you scratch my back for me\?\"", "{the_monster_1}问道 {foe_1}“我说，你能帮我挠挠背吗？”", "the_monster_1:name;foe_1:text"},
    {"speech.monspeak.d7484b2706a56b2c", "{channel_1}{the_monster_1} glows brightly for a moment.", "{channel_1}{the_monster_1}有那么一瞬间发出明亮的光芒。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.d7585e7f562963ba", "{the_monster_1} says, \"Are you still afraid of the dark\?\"", "{the_monster_1}说：“你还怕黑吗？”", "the_monster_1:name"},
    {"speech.monspeak.d777f315d7845117", "{the_monster_1} says, \"A more permanent form of banishment for you, mortal.\"", "{the_monster_1}说：“对你而言，这是一种更永久的放逐，凡人。”", "the_monster_1:name"},
    {"speech.monspeak.d7797168846f228c", "Strange mechanisms whir as {the_monster_1} focuses on {foe_1}.", "奇怪的机械装置嗡嗡作响，{the_monster_1}全神贯注地盯着{foe_1}。", "the_monster_1:name;foe_1:text"},
    {"speech.monspeak.d7841684f7796f6b", "{the_monster_1} stomps with a crash on the {surface_1}.", "{the_monster_1}重重地跺了一下{surface_1}。", "the_monster_1:name;surface_1:text"},
    {"speech.monspeak.d78607ccb1d47a20", "{the_monster_1} remarks {to_foe_1}, \"Ah, I'm absolutely famished!\"", "{the_monster_1}说道 {to_foe_1}：“啊，我饿得要命！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.d78a4768c9f433be", "{the_monster_1} cries, \"Return their pain upon them a hundredfold!\"", "{the_monster_1}喊道：“把他们的痛苦百倍奉还！”", "the_monster_1:name"},
    {"speech.monspeak.d79b0c7582fe0137", "{the_monster_1} hisses menacingly.", "{the_monster_1}威胁地发出嘶嘶声。", "the_monster_1:name"},
    {"speech.monspeak.d7abe344d2233129", "{channel_1}{the_monster_1} grins.", "{channel_1}{the_monster_1}咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.d7b2c416ee9d6987", "the evilness of {random_god_evil_1}.", "{random_god_evil_1}的邪恶。", "random_god_evil_1:name"},
    {"speech.monspeak.d7b70167ce9a8d2a", "{channel_1}{the_monster_possessive_1} eyes glow red.", "{channel_1}{the_monster_possessive_1}的双眼发出红光。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.d7d0b7e1fd2642aa", "{the_monster_1} says, \"I'll never be able to carry all this gold! I hate that.\"", "{the_monster_1}说：“这么多金子我根本搬不完！我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.d7dab8e0cf78d94a", "{channel_1}{the_monster_1} waves {possessive_1} antennae.", "{channel_1}{the_monster_1}摆动着{possessive_1}触角。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.d7f368c037f2f473", "{the_monster_1} says, \"There's a spider on your neck!\"", "{the_monster_1}说：“你脖子上有只蜘蛛！”", "the_monster_1:name"},
    {"speech.monspeak.d80299978a3dddc2", "{the_monster_1} says, \"This is what relying on the gods got me.\"", "{the_monster_1}说：“这就是信赖众神给我的回报。”", "the_monster_1:name"},
    {"speech.monspeak.d829f513e72fa52d", "{the_monster_1} screams {at_foe_1}, \"Burn! Burn! All of it must BURN!\"", "{the_monster_1}尖叫 {at_foe_1}：“烧！烧！一切都必须烧掉！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.d832a5eb7b5f34c7", "{the_monster_1} screams {at_foe_1}, \"Ergichanteg reztahaw!\"", "{the_monster_1}尖叫 {at_foe_1}：“艾尔吉昌特格·雷兹塔哈！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.d8491980525355df", "{channel_1}{the_monster_1} seems to say something.", "{channel_1}{the_monster_1}似乎是说了些什么。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.d84ad04d6c4bf858", "my", "我的", ""},
    {"speech.monspeak.d855f16529ef0c5c", "{the_monster_1} says, \"Just more dross for the fire.\"", "{the_monster_1}说：“火里不过又多些渣滓罢了。”", "the_monster_1:name"},
    {"speech.monspeak.d875509ddcdffb9a", "{the_monster_1} says, \"There's only one good use for a tongue: cutting it out.\"", "{the_monster_1}说：“舌头只有一种好用法：割掉它。”", "the_monster_1:name"},
    {"speech.monspeak.d886336e20ddc8cd", "{the_monster_1} says, \"I've seen this trick before. You've got the ace up your sleeve, right\?\"", "{the_monster_1}说：“这招我见过。你把王牌藏在袖子里，对吧？”", "the_monster_1:name"},
    {"speech.monspeak.d88a9105a9d47f7b", "{the_monster_1} says, \"Live by the sword, die by the sword.\"", "{the_monster_1}说：“以剑而生，以剑而死。”", "the_monster_1:name"},
    {"speech.monspeak.d88c039bc2e0d16d", "{josephina_common_1}", "{josephina_common_1}", "josephina_common_1:text"},
    {"speech.monspeak.d8969b331fd24038", "{channel_1}{the_monster_possessive_1} eyes start to glow with a {spell_colour_1} light.", "{channel_1}{the_monster_possessive_1}双眼开始发出{spell_colour_1}光芒。", "channel_1:key;the_monster_possessive_1:name;spell_colour_1:text"},
    {"speech.monspeak.d8c8bd4854d4f2c4", "{the_monster_1} cries, \"Kill them all! Beogh will know Beogh's own!\"", "{the_monster_1}大喊道：“把他们全杀了！比欧弗认得出谁是自己人！”", "the_monster_1:name"},
    {"speech.monspeak.d8ca0943ff72d7c0", "villa", "别墅", ""},
    {"speech.monspeak.d8d3d4c41a6a79fb", "{channel_1}One of {the_monster_possessive_1} claws falls out.", "{channel_1}{the_monster_possessive_1}一只爪子脱落了。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.d8f2777ac57a57f7", "{the_monster_1} says {to_foe_1}, \"May the fleas of a thousand camels infest your armpits.\"", "{the_monster_1}说 {to_foe_1}：“愿一千头骆驼的跳蚤爬满你的腋窝。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.d93662b2fc36c398", "{the_monster_1} says, \"We wiped out the hill dwarves - you're next!\"", "{the_monster_1}说：“我们灭了丘陵矮人——下一个就是你！”", "the_monster_1:name"},
    {"speech.monspeak.d9542fbfc35d5c56", "{channel_1}One of {the_monster_possessive_1} icy fingers falls off.", "{channel_1}{the_monster_possessive_1}一根冰冷的手指脱落了。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.d956e99f6c09ac93", "{the_monster_1} muses, \"Oh, to fly as furtive as a ghost moth...\"", "{the_monster_1}沉思道：“啊，要是能像幽灵蛾一样悄无声息地飞翔……”", "the_monster_1:name"},
    {"speech.monspeak.d96eeeff0294a249", "{the_monster_1} says {to_foe_1}, \"Right in the middle of my sermon, too.\"", "{the_monster_1}说 {to_foe_1}：“偏偏赶在我布道讲到一半的时候。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.d974354c4f48e296", "East", "东", ""},
    {"speech.monspeak.d9975ab71cc8a8c8", "return to song", "回归歌唱", ""},
    {"speech.monspeak.d9b6726155567065", "{the_monster_1} grunts, \"Curses!\"", "{the_monster_1}咕哝道：“可恶！”", "the_monster_1:name"},
    {"speech.monspeak.d9bce36c31fcc1aa", "{hostile_orc_beogh_unbeliever_speech_common_1}", "{hostile_orc_beogh_unbeliever_speech_common_1}", "hostile_orc_beogh_unbeliever_speech_common_1:text"},
    {"speech.monspeak.d9ca5533434144f4", "{the_monster_1} says {to_foe_1}, \"Crushing you to a pulp will hurt a lot. After that\? Painless! I promise!\"", "{the_monster_1}说 {to_foe_1}：“把你砸成肉泥会很疼。那之后呢？一点都不疼了！我保证！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.d9d94f45b351762a", "{the_monster_1} sings, \"Eyes close, heart stop, nighty-night for you...\"", "{the_monster_1}唱道：“闭上眼，停下心跳，晚安啦……”", "the_monster_1:name"},
    {"speech.monspeak.d9e90937276abb57", "{the_monster_1} screams, \"No! No! NO!\"", "{the_monster_1}尖叫道：“不！不！不！！！”", "the_monster_1:name"},
    {"speech.monspeak.da0dc317f69d3152", "{sigmund_rare_1}", "{sigmund_rare_1}", "sigmund_rare_1:text"},
    {"speech.monspeak.da23705cc9f8f852", "{channel_1}{the_monster_1} seems to be having trouble coordinating all six of {possessive_1} legs.", "{channel_1}{the_monster_1}似乎协调不好{possessive_1}全部六条腿。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.da3556052704b6f8", "{the_monster_1} says, \"You know, if you want, I know a very good posture trainer.\"", "{the_monster_1}说：“知道吗，你要是想，我认识一位特别好的体态教练。”", "the_monster_1:name"},
    {"speech.monspeak.da57a2cd8bdb566b", "{the_monster_1} says {to_foe_1}, \"There's so much colour in the world. Let me show it to you.\"", "{the_monster_1}说 {to_foe_1}：“这世上有那么多的颜色。让我展示给你看。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.da6b4504c9cb67fb", "{the_monster_1} says, \"Just tell me who NOT to kill.\"", "{the_monster_1}说：“只要告诉我谁不用杀就行。”", "the_monster_1:name"},
    {"speech.monspeak.da71b7342ba7b159", "{the_monster_1} says, \"Reason is nothing but a wonderful and unintelligible instinct in our souls.\"", "{the_monster_1}说：“理性不过是我们灵魂中一种奇妙而不可解的直觉。”", "the_monster_1:name"},
    {"speech.monspeak.da80aa1dd21f06da", "{the_monster_1} wails, \"It wants to be free! It wants to enslave everyone!\"", "{the_monster_1}哀号道：“它想获得自由！它想把所有人都变成奴隶！”", "the_monster_1:name"},
    {"speech.monspeak.da84be801862f285", "{the_monster_1} cries, \"Beogh give me strength!\"", "{the_monster_1}喊道：“比欧弗赐我力量！”", "the_monster_1:name"},
    {"speech.monspeak.da8b049373bdea99", "{the_monster_1} says, \"You cannot hurt me!\"", "{the_monster_1}说：“你伤不了我！”", "the_monster_1:name"},
    {"speech.monspeak.da95a3326a336671", "{the_monster_1} says {to_foe_1}, \"Why should I even bother fighting the likes of you\?\"", "{the_monster_1}说 {to_foe_1}：“我何必费劲跟你这种货色打？”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.dacf82a8b7851fda", "{channel_1}{the_monster_1} smashes {possessive_1} foot into the {surface_1}.", "{channel_1}{the_monster_1}用{possessive_1}脚猛砸{surface_1}。", "channel_1:key;the_monster_1:name;possessive_1:text;surface_1:text"},
    {"speech.monspeak.dade69804a79613b", "{channel_1}{the_monster_1} counts something out on {possessive_1} fingers.", "{channel_1}{the_monster_1}用{possessive_1}手指一下一下地数着什么。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.dae54ffb105389dd", "{the_monster_1} says, \"I hope these swamp worms drown.\"", "{the_monster_1}说：“我希望这些沼泽虫全淹死。”", "the_monster_1:name"},
    {"speech.monspeak.daf95bab9f1e5295", "{channel_1}{the_monster_1} tries to hide somewhere.", "{channel_1}{the_monster_1}想找个地方躲起来。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.db173d5b6d84140c", "{the_monster_1} says, \"The present is the child, and the necessary child, of all the past, and the mother of all the future.\"", "{the_monster_1}说：“现在是所有过去的孩子，也是必然的孩子，又是所有未来的母亲。”", "the_monster_1:name"},
    {"speech.monspeak.db254ddb867844d0", "{maurice_medium_1}", "{maurice_medium_1}", "maurice_medium_1:text"},
    {"speech.monspeak.db4f007e2782810e", "repeatedly", "反复地", ""},
    {"speech.monspeak.db6407716573b314", "{the_monster_1} shouts, \"Faster, {grum_dog_name_1}! Kill! Kill!\"", "{the_monster_1}喊道：“快上，{grum_dog_name_1}！杀！杀！”", "the_monster_1:name;grum_dog_name_1:name"},
    {"speech.monspeak.db647e743d943b41", "mosquito", "蚊子", ""},
    {"speech.monspeak.db94cf57facf95b8", "{the_monster_1} screams {at_foe_1}, \"You will die horribly!\"", "{the_monster_1}尖叫道 {at_foe_1}：“你会死得非常惨！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.dbb0779002c30ba9", "{the_monster_1} says, \"I hate maniacal laughter.\"", "{the_monster_1}说：“我讨厌疯狂的大笑。”", "the_monster_1:name"},
    {"speech.monspeak.dbb6ca09e7c7b871", "dark", "暗", ""},
    {"speech.monspeak.dbd801b4d2df8b8d", "{channel_1}{the_monster_1} waves a pennant with your name on it.", "{channel_1}{the_monster_1}挥舞着一面写着你的名字的三角旗。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.dbf684756b930c49", "{the_monster_1} says {to_foe_1}, \"I'm your fate.\"", "{the_monster_1}说 {to_foe_1}：“我就是你的命运。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.dc1b90b70a061502", "{the_monster_1} says, \"Time for you to vanish into the darkness.\"", "{the_monster_1}说：“该让你消失在黑暗之中了。”", "the_monster_1:name"},
    {"speech.monspeak.dc58a954f47db162", "{important_subject_1}", "{important_subject_1}", "important_subject_1:text"},
    {"speech.monspeak.dc83c22f4f1bb0a2", "{the_monster_1} says, \"I will blast you to bits.\"", "{the_monster_1}说：“我要把你炸成碎片。”", "the_monster_1:name"},
    {"speech.monspeak.dc9bb34bf9c401b5", "{the_monster_1} says, \"I bet you have to pay people to get friends.\"", "{the_monster_1}说：“我打赌你得花钱才能交到朋友。”", "the_monster_1:name"},
    {"speech.monspeak.dcd87e43d0d23350", "{channel_1}{the_monster_1} looks irritated.", "{channel_1}{the_monster_1}显得很不耐烦。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.dcdd555084c01e20", "{duvessa_common_1}", "{duvessa_common_1}", "duvessa_common_1:text"},
    {"speech.monspeak.dd043ba50be91fe7", "{the_monster_1} draws Degeneration. \"So many ways to mutate things!\"", "{the_monster_1}抽到了退化。“让东西变异的方法可真多！”", "the_monster_1:name"},
    {"speech.monspeak.dd5a5f88ed58617d", "{the_monster_1} howls, \"My nostrils!\"", "{the_monster_1}嚎叫道：“我的鼻孔！”", "the_monster_1:name"},
    {"speech.monspeak.dd664be279e0f0d9", "{the_monster_1} shouts {at_foe_1}, \"Leave me alone!\"", "{the_monster_1}喊道 {at_foe_1}：“别来烦我！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.dd6e6d81a4e50b65", "{the_monster_1} screams.", "{the_monster_1}尖叫。", "the_monster_1:name"},
    {"speech.monspeak.dd7bed9d8bfca0ff", "{the_monster_1} mumbles, \"We raided the strongholds of evil. Now I walk alone.\"", "{the_monster_1}嘟囔道：“我们曾突袭邪恶的堡垒。如今我独自游荡。”", "the_monster_1:name"},
    {"speech.monspeak.dd93c0f1f42dd397", "{the_monster_1} says happily, \"The price on your head will fill my nest egg nicely!\" {player_only_1}", "{the_monster_1}开心地说：“你脑袋上的赏金正好能填满我的养老本！”{player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.ddbd19fd43505603", "{the_monster_1} says {to_foe_1}, \"You're the second biggest fool I've ever met!\"", "{the_monster_1}说 {to_foe_1}：“你是我见过第二大的傻瓜！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.ddbda2643e54e64e", "{channel_1}{the_monster_possessive_1} eyes look fiery.", "{channel_1}{the_monster_possessive_1}双眼仿佛燃起火焰。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.ddc986cd596828a4", "{channel_1}{the_monster_1} splashes a potion {at_foe_1}.", "{channel_1}{the_monster_1}把一瓶药水泼向 {at_foe_1}。", "channel_1:key;the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.ddebe5579a01a890", "{channel_1}{the_monster_1} pulls ten torches off {possessive_1} hat and starts juggling.", "{channel_1}{the_monster_1}从{possessive_1}帽子里抽出十支火把，开始耍弄起来。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.de7d38bda7277c2f", "{the_monster_1} asks {foe_1}, \"Would you mind waking me up\? Thanks muchly.\"", "{the_monster_1}问{foe_1}：“能麻烦你叫醒我吗？多谢了。”", "the_monster_1:name;foe_1:text"},
    {"speech.monspeak.decb2e481ba32df9", "{the_monster_1} says, \"Circuses are really nothing more than prisons.\"", "{the_monster_1}说：“马戏团其实只不过是监狱罢了。”", "the_monster_1:name"},
    {"speech.monspeak.ded2394b98dfb723", "{agnes_rare_1}", "{agnes_rare_1}", "agnes_rare_1:text"},
    {"speech.monspeak.dee8015d3f3c5675", "{the_monster_1} says, \"Can't wait to tell my little ones about this.\"", "{the_monster_1}说：“我迫不及待要把这事讲给我的孩子们听。”", "the_monster_1:name"},
    {"speech.monspeak.deefa7dabb983814", "{the_monster_1} snags a nearby {frog_food_1} with {possessive_1} tongue.", "{the_monster_1}用{frog_food_1}舌头卷住附近的一只{possessive_1}。", "the_monster_1:name;frog_food_1:text;possessive_1:text"},
    {"speech.monspeak.df08e6ca327de4a6", "{the_monster_1} says, \"I'm not crazy!\"", "{the_monster_1}说：“俺没疯！”", "the_monster_1:name"},
    {"speech.monspeak.df0a947825fc2f51", "{channel_1}{the_monster_1} grows dozens of eye stalks in order to get a better look at {foe_1}.", "{channel_1}{the_monster_1}长出几十根眼柄，好把{foe_1}看得更清楚。", "channel_1:key;the_monster_1:name;foe_1:text"},
    {"speech.monspeak.df0c0460763154b6", "{the_monster_1} says, \"Have you ever seen an orcish miner\? Me neither.\"", "{the_monster_1}说：“你见过兽人矿工吗？我也没见过。”", "the_monster_1:name"},
    {"speech.monspeak.df11ead9a045c3ac", "{the_monster_1} falls to {possessive_1} knees.", "{the_monster_1}跪倒在{possessive_1}膝前。", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.df14c42695c641cd", "{the_monster_1} says, \"I saw a sphinx earlier. I hate that.\"", "{the_monster_1}说：“我刚才看到一只斯芬克斯。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.df58367783ab7e81", "{hostile_imp_1}", "{hostile_imp_1}", "hostile_imp_1:text"},
    {"speech.monspeak.df765880864e5262", "the alliance of Zin and the Shining One.", "辛与光明神的同盟。", ""},
    {"speech.monspeak.df77f89a7ed13b2c", "{the_monster_1} says, \"If it's mutations you're wanting, wouldn't Jiyva be a better deal\?\"", "{the_monster_1}说：“你要是想要变异，信吉瓦不是更划算吗？”", "the_monster_1:name"},
    {"speech.monspeak.df83b060d52749f7", "{the_monster_1} says {to_foe_1}, \"Do you like to play 'catch'\?\"", "{the_monster_1}说 {to_foe_1}：“你喜欢玩“接球”吗？”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.df931c872b77a79f", "cause", "引发", ""},
    {"speech.monspeak.df944bf41ead7590", "{the_monster_1} says, \"Hah! I saw you coming a mile away.\"", "{the_monster_1}说：“哈！你一里地外我就看见了。”", "the_monster_1:name"},
    {"speech.monspeak.df98b6e3c7a347fc", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.dfc875d075a53c65", "{the_monster_1} cries, \"In the name of Beogh, DIE!\"", "{the_monster_1}喊道：“以比欧弗之名，死吧！”", "the_monster_1:name"},
    {"speech.monspeak.dfc90420fbf08291", "{margery_common_1}", "{margery_common_1}", "margery_common_1:text"},
    {"speech.monspeak.dfd75ac4768f4d23", "{the_monster_1} says, \"I hope the rune isn't sticky.\"", "{the_monster_1}说：“但愿这枚符文不是黏的。”", "the_monster_1:name"},
    {"speech.monspeak.dfdd427665125292", "murmurs", "低语道", ""},
    {"speech.monspeak.e004c634e08b72dc", "{the_monster_1} says, \"I hate storms.\"", "{the_monster_1}说：“我讨厌风暴。”", "the_monster_1:name"},
    {"speech.monspeak.e06513b6ffe837b3", "{the_monster_1} screams, \"This atrocity can only be purified with blood!\"", "{the_monster_1}尖叫道：“如此暴行只能用鲜血来洗清！”", "the_monster_1:name"},
    {"speech.monspeak.e07833549416162f", "{the_monster_1} pulsates with a strange energy.", "{the_monster_1}随着一股奇异的能量脉动着。", "the_monster_1:name"},
    {"speech.monspeak.e08081064743be3c", "{channel_1}{the_monster_1} glares at {foe_1} with {possessive_1} lone eye.", "{channel_1}{the_monster_1}用{possessive_1}独眼瞪着{foe_1}。", "channel_1:key;the_monster_1:name;foe_1:text;possessive_1:text"},
    {"speech.monspeak.e08f7512572b0c74", "{snorg_common_1}", "{snorg_common_1}", "snorg_common_1:text"},
    {"speech.monspeak.e0a1701be71957a7", "{beogh_converted_orc_speech_vengeance_1}", "{beogh_converted_orc_speech_vengeance_1}", "beogh_converted_orc_speech_vengeance_1:text"},
    {"speech.monspeak.e0a797f614a5dcbc", "{the_monster_1} shouts, \"Beware of monsters!\"", "{the_monster_1}喊道：“小心怪物！”", "the_monster_1:name"},
    {"speech.monspeak.e0b183b34dd2c2b2", "{the_monster_1} says {to_foe_1}, \"I love to horrify, but killing's even better.\"", "{the_monster_1}说 {to_foe_1}：“我爱让人恐惧，但杀人更妙。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.e0b7ae5d644692fc", "{vashnia_rare_1}", "{vashnia_rare_1}", "vashnia_rare_1:text"},
    {"speech.monspeak.e0bf9191131f356d", "{channel_1}{the_monster_1} says something you can't hear.", "{channel_1}{the_monster_1}说了些什么，但你没听见。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.e0c0ecbddcbe751b", "{channel_1}{the_monster_1} briefly grows a face disturbingly similar to your own.", "{channel_1}{the_monster_1}短暂地长出一张与你惊人相似的脸。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.e10f50e4c5bda32b", "{the_monster_1} says, \"I stand as high above you as a star above the ocean's bottom.\"", "{the_monster_1}说：“我高踞于你之上，如同星辰之于海渊。”", "the_monster_1:name"},
    {"speech.monspeak.e146c71fc8aa2839", "{high_priest_medium_1}", "{high_priest_medium_1}", "high_priest_medium_1:text"},
    {"speech.monspeak.e14bb1f44f4a91e2", "{the_monster_1} says, \"Orcs smell really bad. Yuck.\"", "{the_monster_1}说：“兽人的味道真难闻。恶心。”", "the_monster_1:name"},
    {"speech.monspeak.e156132b1df4d01f", "{the_monster_1} says, \"I hate the rich.\"", "{the_monster_1}说：“我讨厌有钱人。”", "the_monster_1:name"},
    {"speech.monspeak.e16317c8cdaf0e32", "{bai_suzhen_common_1}", "{bai_suzhen_common_1}", "bai_suzhen_common_1:text"},
    {"speech.monspeak.e16c502deb9f72dd", "{holy_being_1}", "{holy_being_1}", "holy_being_1:text"},
    {"speech.monspeak.e18c4fc550293ee7", "water", "水", ""},
    {"speech.monspeak.e1a01084b5e2cdc8", "{the_monster_1} draws Velocity. \"Know when to walk away, know when to run.\"", "{the_monster_1}抽到了迅捷。“该走开时就走开，该跑时就跑。”", "the_monster_1:name"},
    {"speech.monspeak.e1adabf51685fab0", "Shadow", "影", ""},
    {"speech.monspeak.e1b23decc80e0050", "mutters", "咕哝道", ""},
    {"speech.monspeak.e1cea3d1ad73a4e3", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.e1d27c09265da445", "{the_monster_1} says, \"I'd get sick of only having three followers at most.\"", "{the_monster_1}说：“最多只能有三个追随者，我可受不了。”", "the_monster_1:name"},
    {"speech.monspeak.e1db1ecd50dfa63c", "{channel_1}{the_monster_1} whispers something so quietly that you cannot hear {objective_1}.", "{channel_1}{the_monster_1}低声说了些什么，轻得你听不见{objective_1}。", "channel_1:key;the_monster_1:name;objective_1:text"},
    {"speech.monspeak.e1e58a59b3f80257", "Orb", "宝珠", ""},
    {"speech.monspeak.e1e5a1d7cb63fd75", "{the_monster_1} grins and says, \"Time to carve some turkeys.\"", "{the_monster_1}咧嘴一笑：“该给火鸡开膛破肚了。”", "the_monster_1:name"},
    {"speech.monspeak.e1f51332afcb4997", "{the_monster_1} sings a few bars of a dwarven mine shanty. Very poorly.", "{the_monster_1}唱了几句矮人矿工号子。唱得很差。", "the_monster_1:name"},
    {"speech.monspeak.e20c203d7f2563f0", "by the lake", "湖畔", ""},
    {"speech.monspeak.e2198629f2e70fd8", "{the_monster_1} says, \"Don't worry. I'm here with you.\"", "{the_monster_1}说：“别担心。有我在你身边。”", "the_monster_1:name"},
    {"speech.monspeak.e229fb0f1d17e374", "model-building", "做模型", ""},
    {"speech.monspeak.e24761fbfe907ea4", "{the_monster_1} {says_1} {to_foe_1}, \"{imp_taunt_1}\"", "{the_monster_1} {says_1} {to_foe_1}：“{imp_taunt_1}”", "the_monster_1:name;says_1:text;to_foe_1:text;imp_taunt_1:text"},
    {"speech.monspeak.e259dc6307d54747", "{the_monster_1} says, \"Someone is going to come looking for that Orb.\"", "{the_monster_1}说：“会有人来找那枚宝珠的。”", "the_monster_1:name"},
    {"speech.monspeak.e26d0a20dcbf483e", "{channel_1}{the_monster_1} jubilantly flits about.", "{channel_1}{the_monster_1}欢快地翩然飞舞。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.e26dc010292521f5", "{the_monster_1} {recites_start_1} a {lecture_modifier_1} sermon about {recite_subject_1}", "{the_monster_1}{recites_start_1}一场{lecture_modifier_1}布道，宣讲{recite_subject_1}", "the_monster_1:name;recites_start_1:text;lecture_modifier_1:text;recite_subject_1:text"},
    {"speech.monspeak.e27861ccd18a6629", "{the_monster_1} shouts {at_foe_1}, \"You must die NOW!\"", "{the_monster_1}喊道 {at_foe_1}：“你必须现在就死！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.e2786630f48191e8", "{the_monster_1} laughs, \"And you think you're capable of finding the ORB\? I had it, you know. Then I gave it away so I could steal it AGAIN.\"", "{the_monster_1}大笑道：“你还以为自己能找到宝珠？告诉你，我拿到过它。后来我把它送了出去，好再把它偷回来一次。”", "the_monster_1:name"},
    {"speech.monspeak.e27a07c69bc76f9a", "{the_monster_1} laughs crazily.", "{the_monster_1}疯狂地大笑。", "the_monster_1:name"},
    {"speech.monspeak.e27b76beeaf42324", "{channel_1}{the_monster_1} begins carving another notch in {possessive_1} scythe.", "{channel_1}{the_monster_1}开始在{possessive_1}镰刀上又刻下一道痕。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.e28448a02ed5808e", "{the_monster_1} screams {at_foe_1}, \"Your bloody kin took my one good eye. Now you die, harpy!\"", "{the_monster_1}尖叫道 {at_foe_1}：“你那帮该死的同族夺走了我唯一的好眼睛。现在你死定了，鸟妖！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.e29937885c201a29", "{the_monster_1} says, \"What kind of a name is Fauntleroy\?\"", "{the_monster_1}说：“福恩特罗伊算什么名字？”", "the_monster_1:name"},
    {"speech.monspeak.e2b69de7ec483037", "{the_monster_1} hisses {at_foe_1}, \"I bite!\"", "{the_monster_1}嘶声道 {at_foe_1}：“我咬人！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.e2c7ddce477100c9", "{the_monster_1} screams {at_foe_1}, \"Don't try to defend! You have no chance!\"", "{the_monster_1}尖叫 {at_foe_1}：“别想着防守！你毫无胜算！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.e2ec3061ef400bcc", "shouts", "喊道", ""},
    {"speech.monspeak.e2fb39bbfc01b3f2", "{channel_1}A stray blade cuts {the_monster_possessive_1} own flesh. {subjective_1} ignores it.", "{channel_1}一片乱飞的刀刃割伤了{the_monster_possessive_1}血肉。{subjective_1}对此毫不在意。", "channel_1:key;the_monster_possessive_1:name;subjective_1:text"},
    {"speech.monspeak.e30097c38c2aa67c", "shivering with cold", "冻得浑身发抖", ""},
    {"speech.monspeak.e312e409f111b803", "Sparky", "斯帕奇", ""},
    {"speech.monspeak.e33202315dfa60f1", "{the_monster_1} says {to_foe_1}, \"Avoid what is strong, and strike at what is weak.\"", "{the_monster_1}说 {to_foe_1}：“避实而击虚。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.e34072e261e6e769", "{the_monster_1} lets out a smug laugh.", "{the_monster_1}得意地笑了一声。", "the_monster_1:name"},
    {"speech.monspeak.e344bd37c4957e6e", "{channel_1}A dozen eyes blink open in {the_monster_possessive_1} chest.", "{channel_1}{the_monster_possessive_1}胸腔上睁开十几只眼睛。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.e35e5416819e581a", "{the_monster_1} says, \"I'll see you on the other side, friend.\"", "{the_monster_1}说：“咱们另一头见，朋友。”", "the_monster_1:name"},
    {"speech.monspeak.e35f5274a2c5d0ec", "{the_monster_1} draws the Elixir. \"Healing and magic\? Woohoo!\"", "{the_monster_1}抽到了灵药。“治疗加魔法？哇呼！”", "the_monster_1:name"},
    {"speech.monspeak.e360ea4794e3d5a2", "{louise_common_1}", "{louise_common_1}", "louise_common_1:text"},
    {"speech.monspeak.e36d669324055be5", "{the_monster_1} wails, \"Just end it! Let me go!\"", "{the_monster_1}哀号道：“快结束吧！放我走！”", "the_monster_1:name"},
    {"speech.monspeak.e37cc4725c3fec20", "Famine", "饥荒", ""},
    {"speech.monspeak.e3863718ad5e3e71", "{the_monster_1} says, \"First nagas, now salamanders. What's next, crocodiles with mirrors on their heads\?\"", "{the_monster_1}说：“先是纳迦，现在是火蜥蜴。接下来是什么，头顶镜子的鳄鱼？”", "the_monster_1:name"},
    {"speech.monspeak.e388e9c81e32060d", "{channel_1}{the_monster_1} stares at {foe_1}.", "{channel_1}{the_monster_1}凝视着{foe_1}。", "channel_1:key;the_monster_1:name;foe_1:text"},
    {"speech.monspeak.e39048aa56ce2d2f", "{the_monster_1} says, \"Kneel, worm!\"", "{the_monster_1}说：“跪下，虫子！”", "the_monster_1:name"},
    {"speech.monspeak.e39725efea0ece29", "{the_monster_1} growls {at_foe_1}.", "{the_monster_1}低声咆哮着 {at_foe_1}。", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.e39f4397670a5904", "{channel_1}{the_monster_1} smiles happily.", "{channel_1}{the_monster_1}开心地微笑着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.e3ab61397af84da7", "{the_monster_1} says, \"Finally, I'll be able to get some peace and quiet.\"", "{the_monster_1}说：“终于，我可以清静清静了。”", "the_monster_1:name"},
    {"speech.monspeak.e3b32be94c05108f", "{channel_1}{the_monster_1} says something but you don't hear anything.", "{channel_1}{the_monster_1}说了些什么，但你什么也没听见。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.e3be6ee05f537ec1", "{the_monster_1} shouts {at_foe_1}, \"Prepare for my thousand needles of pain!\"", "{the_monster_1}喊道 {at_foe_1}：“准备承受我的千根痛针！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.e3c47f5c27caf647", "high", "高", ""},
    {"speech.monspeak.e4010e78a33244da", "{the_monster_1} says, \"Xom just doesn't make any sense. I hate that.\"", "{the_monster_1}说：“佐姆根本毫无道理可言。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.e40696384a4acf9a", "blood and fire", "血与火", ""},
    {"speech.monspeak.e40b3281c604a66e", "{the_monster_1} {recites_start_1} a {lecture_modifier_1} speech about {recite_subject_1}", "{the_monster_1}{recites_start_1}一场{lecture_modifier_1}演讲，讲解{recite_subject_1}", "the_monster_1:name;recites_start_1:text;lecture_modifier_1:text;recite_subject_1:text"},
    {"speech.monspeak.e40bc2cce0736b06", "{the_monster_1} growls, \"Give us... back... our names!\"", "{the_monster_1}低吼道：“把……我们的名字……还回来！”", "the_monster_1:name"},
    {"speech.monspeak.e414178645f8686c", "{erica_common_1}", "{erica_common_1}", "erica_common_1:text"},
    {"speech.monspeak.e439a408c79d785f", "{channel_1}{the_monster_1} twitches {possessive_1} whiskers.", "{channel_1}{the_monster_1}抽动着{possessive_1}胡须。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.e449515f956fb42a", "{the_monster_1} says, \"You need to come to terms with your gambling problem.\"", "{the_monster_1}说：“你得正视自己的赌博问题。”", "the_monster_1:name"},
    {"speech.monspeak.e44e77d5f621a93d", "{channel_1}{the_monster_1} curls up and begins to purr.", "{channel_1}{the_monster_1}蜷起身子，开始打起呼噜。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.e4516ba0cb5dfe19", "{the_monster_1} says, \"What sane person could live in this world and not be crazy\?\"", "{the_monster_1}说：“哪个神志正常的人能活在这世上而不发疯？”", "the_monster_1:name"},
    {"speech.monspeak.e4618c94f36b539f", "grunts", "哼声道", ""},
    {"speech.monspeak.e4733ad015446fcd", "{the_monster_1} says {to_foe_1}, \"Kill me\? I think not!\"", "{the_monster_1}说 {to_foe_1}：“杀我？我看未必！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.e48ad5e77c47fada", "{the_monster_1} says, \"Which is more difficult, to awaken one who sleeps or to awaken one who, awake, dreams that he is awake\?\"", "{the_monster_1}说：“把睡着的人唤醒，和唤醒一个醒着却梦见自己醒着的人，哪个更难？”", "the_monster_1:name"},
    {"speech.monspeak.e4913cb1ad7b6383", "{the_monster_1} wails, \"NOOOO!\"", "{the_monster_1}哀号道：“不——！”", "the_monster_1:name"},
    {"speech.monspeak.e49be2c4179a1efe", "Shower", "淋浴", ""},
    {"speech.monspeak.e4d5e5156d6b9a93", "knee", "膝盖", ""},
    {"speech.monspeak.e4e35b31203a9c37", "{channel_1}A flash of anger passes briefly over {the_monster_possessive_1} face.", "{channel_1}一丝怒意从{the_monster_possessive_1}脸上闪过。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.e4e4a78ed5660bc7", "{the_monster_1} says, \"I hate ruin.\"", "{the_monster_1}说：“我讨厌毁灭。”", "the_monster_1:name"},
    {"speech.monspeak.e4e8318df84876a2", "King", "国王", ""},
    {"speech.monspeak.e4e908689916f5a0", "{the_monster_1} says, \"That guy with the scythe is really mean.\"", "{the_monster_1}说：“那个拿镰刀的家伙真刻薄。”", "the_monster_1:name"},
    {"speech.monspeak.e4feb307052288f0", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.e515b304e4b6a4a3", "{channel_1}{the_monster_1} fans some cards from one of {possessive_1} decks.", "{channel_1}{the_monster_1}从{possessive_1}牌组中展开几张牌。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.e52501c12a60b88e", "{channel_1}{the_monster_1} gestures {at_foe_1} with {possessive_1} flail.", "{channel_1}{the_monster_1}挥舞着{possessive_1}连枷，指向{at_foe_1}。", "channel_1:key;the_monster_1:name;at_foe_1:text;possessive_1:text"},
    {"speech.monspeak.e52f2dbb10f76f0a", "{the_monster_1} screams, \"Me go back to drawing board!\"", "{the_monster_1}尖叫道：“俺得回去重画图纸！”", "the_monster_1:name"},
    {"speech.monspeak.e55035be3360e28c", "{the_monster_1} stares {at_foe_1}, then turns away, jangling a coin purse.", "{the_monster_1}盯着 {at_foe_1}，然后转过身去，晃了晃钱袋。", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.e56d5ec7c2528513", "{the_monster_1} says, \"We come from slime, we turn to slime.\"", "{the_monster_1}说：“我们来自黏液，我们化为黏液。”", "the_monster_1:name"},
    {"speech.monspeak.e5777657f74db2ec", "{the_monster_1} says, \"Tides\? I despise tides. No, wait, I hate tides!\"", "{the_monster_1}说：“潮汐？我鄙视潮汐。不对，等等，我讨厌潮汐！”", "the_monster_1:name"},
    {"speech.monspeak.e5863c6ae302ee6b", "{channel_1}{the_monster_1} is buffeted by a sudden breeze.", "{channel_1}{the_monster_1}被一阵突如其来的风吹得摇晃。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.e58c953b48c67954", "{snorg_rare_1}", "{snorg_rare_1}", "snorg_rare_1:text"},
    {"speech.monspeak.e5a40f77115e37e9", "{the_monster_1} intently looks at {foe_1}, slowly moving {possessive_1} tail.", "{the_monster_1}目不转睛地盯着{foe_1}，{possessive_1}尾巴缓缓摆动。", "the_monster_1:name;foe_1:text;possessive_1:text"},
    {"speech.monspeak.e5bb6e614d293362", "{channel_1}{the_monster_possessive_1} {hands_1} start to glow.", "{channel_1}{the_monster_possessive_1}{hands_1}开始发光。", "channel_1:key;the_monster_possessive_1:name;hands_1:text"},
    {"speech.monspeak.e5be346b1da95cb0", "{channel_1}{the_monster_1} considers dialectic materialism.", "{channel_1}{the_monster_1}思考着辩证唯物主义。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.e5c68dce596c1ef7", "{wiglaf_rare_1}", "{wiglaf_rare_1}", "wiglaf_rare_1:text"},
    {"speech.monspeak.e5cdfb5b4f49ebe9", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.e5e186adc7a7f2e2", "{channel_1}{the_monster_1} generates a fountain of clear water, and laughs cruelly.", "{channel_1}{the_monster_1}变出一道清水喷泉，冷酷地大笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.e5e2c0e87ac3a199", "{channel_1}{the_monster_1} polishes a blade.", "{channel_1}{the_monster_1}擦拭着一片刀刃。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.e60d568d85a6d576", "{the_monster_1} muses, \"Oh, to leap as freely as a jumping spider...\"", "{the_monster_1}沉思道：“啊，要是能像跳蛛一样自由地跳跃……”", "the_monster_1:name"},
    {"speech.monspeak.e60ef158c20a3175", "{killer_klown_rare_1}", "{killer_klown_rare_1}", "killer_klown_rare_1:text"},
    {"speech.monspeak.e62d21f74300fd67", "{channel_1}{the_monster_1} disappears for a moment.", "{channel_1}{the_monster_1}有那么一瞬间消失了。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.e632a09c678f55ce", "{the_monster_1} growls, \"To hell with you, honourless miscreant!\"", "{the_monster_1}吼道：“见鬼去吧，你这无信的恶棍！”", "the_monster_1:name"},
    {"speech.monspeak.e662572ce3953521", "{the_monster_1} says, \"Productive ogre is happy ogre.\"", "{the_monster_1}说：“能干的食人魔就是快乐的食人魔。”", "the_monster_1:name"},
    {"speech.monspeak.e68d91e608a1e69b", "{channel_1}{the_monster_possessive_1} eyestalks wobble, almost dislodging {possessive_1} wizard hat.", "{channel_1}{the_monster_possessive_1}的眼柄摇晃着，差点把{possessive_1}巫师帽晃掉。", "channel_1:key;the_monster_possessive_1:name;possessive_1:text"},
    {"speech.monspeak.e69e3df59ebdc682", "{channel_1}{the_monster_1} points at {foe_1} threateningly.", "{channel_1}{the_monster_1}威胁地指着{foe_1}。", "channel_1:key;the_monster_1:name;foe_1:text"},
    {"speech.monspeak.e6ab25d14b220fde", "{the_monster_1} {menkaure_verb_1}, \"Let me perform the rites...\"", "{the_monster_1} {menkaure_verb_1}：“让我来完成仪式……”", "the_monster_1:name;menkaure_verb_1:text"},
    {"speech.monspeak.e6b786db0679f6f0", "{channel_1}{the_monster_1} yawns, and then pretends {subjective_1} didn't.", "{channel_1}{the_monster_1}打了个哈欠，随后假装{subjective_1}什么也没做。", "channel_1:key;the_monster_1:name;subjective_1:text"},
    {"speech.monspeak.e6c15e5a541d28c5", "{joseph_common_1}", "{joseph_common_1}", "joseph_common_1:text"},
    {"speech.monspeak.e6c2dbe2902b7a20", "{the_monster_1} says {to_foe_1}, \"Your head would complement my pike nicely.\"", "{the_monster_1}说 {to_foe_1}：“你的头会把我这杆长矛点缀得相当不错。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.e6c6e6694128ba5a", "{the_monster_1} laughs crazily.", "{the_monster_1}疯狂地大笑。", "the_monster_1:name"},
    {"speech.monspeak.e6d78ef087659df5", "{the_monster_1} says, \"All the lords of Hell know my name!\"", "{the_monster_1}说：“地狱里所有的领主都知道我的名字！”", "the_monster_1:name"},
    {"speech.monspeak.e6f3d1e79f8ce859", "{prince_ribbit_rare_1}", "{prince_ribbit_rare_1}", "prince_ribbit_rare_1:text"},
    {"speech.monspeak.e714402f729a808e", "{wizard_common_spell_1}\n{fake_spell_effect_1}", "{wizard_common_spell_1}\n{fake_spell_effect_1}", "wizard_common_spell_1:text;fake_spell_effect_1:text"},
    {"speech.monspeak.e7259e6f63a8cd85", "{margery_rare_1}", "{margery_rare_1}", "margery_rare_1:text"},
    {"speech.monspeak.e72a167514c93522", "{the_monster_1} says, \"You're supposed to blow everything up for a god who barely gives you powers\?\"", "{the_monster_1}说：“你为了一位几乎不给什么力量的神，就得把一切都炸上天？”", "the_monster_1:name"},
    {"speech.monspeak.e73823eb87a9b4b6", "{the_monster_1} screams, \"I will never die! I am immortal!\"", "{the_monster_1}尖叫道：“我永远不会死！我是不朽的！”", "the_monster_1:name"},
    {"speech.monspeak.e73fc528d6344162", "{the_monster_1} says {to_foe_1}, \"Fast and perfect. Such is my way of killing.\"", "{the_monster_1}说 {to_foe_1}：“又快又完美。这就是我杀人的方式。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.e77c82e11356b4fa", "{the_monster_1} howls {at_foe_1}, \"I'll flense you until there's nothing left!\"", "{the_monster_1}嚎叫道 {at_foe_1}：“我要把你削到一点都不剩！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.e7964dc1ec8cb0d0", "{the_monster_1} whines, \"My parents never had time for me!\"", "{the_monster_1}哀怨地说：“我父母从来都没时间陪我！”", "the_monster_1:name"},
    {"speech.monspeak.e79eb80c124b4657", "{channel_1}{the_monster_1} whirls a spectral sling over {possessive_1} head.", "{channel_1}{the_monster_1}在{possessive_1}头顶抡着一把幽灵投石索。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.e7a105327f341a43", "{the_monster_1} shouts, \"Cover me!\"", "{the_monster_1}喊道：“掩护我！”", "the_monster_1:name"},
    {"speech.monspeak.e7a90def3b6535ef", "{channel_1}{the_monster_1} jumps up and down, looking for your attention.", "{channel_1}{the_monster_1}蹦蹦跳跳，想引起你的注意。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.e7a919dc65de20d0", "{azrael_common_1}", "{azrael_common_1}", "azrael_common_1:text"},
    {"speech.monspeak.e7bfa4ab211c1e80", "{channel_1}{the_monster_1} grins.", "{channel_1}{the_monster_1}咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.e7f877a1b716177a", "hippo", "河马", ""},
    {"speech.monspeak.e80a809c5d78e622", "{the_monster_1} says {to_foe_1}, \"Tha earth be me home, an' ye be trespassing!\"", "{the_monster_1}说 {to_foe_1}：“大地就是俺的家，是你在擅闯！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.e823d739c3debc69", "{the_monster_1} howls with blood-lust.", "{the_monster_1}嗜血地嚎叫着。", "the_monster_1:name"},
    {"speech.monspeak.e86a481ea140effd", "{the_monster_1} lectures {possessive_1} feet at length about {important_subject_1}", "{the_monster_1}对着{possessive_1}脚长篇大论地讲{important_subject_1}", "the_monster_1:name;possessive_1:text;important_subject_1:text"},
    {"speech.monspeak.e86bb003bafb9a07", "{the_monster_1} says {to_foe_1}, \"In life, I might have healed you instead.\"", "{the_monster_1}说 {to_foe_1}：“若我还活着，我或许会医治你。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.e88a17ea94503b83", "{the_monster_1} {says_1} {to_foe_1}, \"{demon_taunt_1}\"", "{the_monster_1} {says_1} {to_foe_1}：“{demon_taunt_1}”", "the_monster_1:name;says_1:text;to_foe_1:text;demon_taunt_1:text"},
    {"speech.monspeak.e88d475d19b83a9c", "{the_monster_1} {laughs_1} at the Dungeon's lack of mercy or dignity.", "{the_monster_1}{laughs_1}着，笑地牢既无怜悯，也无尊严。", "the_monster_1:name;laughs_1:text"},
    {"speech.monspeak.e89cba7877aa875d", "running... falling", "奔跑……坠落", ""},
    {"speech.monspeak.e8c0223c07541394", "{the_monster_1} says, \"They wouldn't let me join their adventuring club without the Orb.\"", "{the_monster_1}说：“没有宝珠，他们就不让我加入他们的冒险俱乐部。”", "the_monster_1:name"},
    {"speech.monspeak.e8e3c5e662801d0e", "{the_monster_possessive_1} eyes glow.\nYou hear demonic laughter.", "{the_monster_possessive_1}的双眼发光。\n你听到恶魔的笑声。", "the_monster_possessive_1:name"},
    {"speech.monspeak.e8f2e6a22e185cf8", "{the_monster_1} says, \"A terrible fate awaits all who seek the ORB - and yours worst of all.\" {player_only_1}", "{the_monster_1}说：“可怕的命运等着所有追寻宝珠的人——而你的命运最是可怕。” {player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.e90a8ec062c8dd80", "{the_monster_1} looks {at_foe_1} and {grum_verb_1}, \"Time to put down the runt of the litter.\"", "{the_monster_1}看着 {at_foe_1}，{grum_verb_1}：“是时候处理掉这窝里最弱的那只了。”", "the_monster_1:name;at_foe_1:text;grum_verb_1:text"},
    {"speech.monspeak.e90e1dbdfed96931", "{the_monster_1} queries, \"My people built me a pyramid - what did your people build for you\?\"", "{the_monster_1}问道：“我的人民为我建了一座金字塔——你的人民为你建了什么？”", "the_monster_1:name"},
    {"speech.monspeak.e9176197d69a2490", "{the_monster_1} says {to_foe_1}, \"My allies will avenge me.\"", "{the_monster_1}说 {to_foe_1}：“我的盟友会替我报仇。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.e9295e1cda258672", "{the_monster_1} says, \"There, on the ceiling! And on that wall!\"", "{the_monster_1}说：“在那儿，天花板上！还有那面墙上！”", "the_monster_1:name"},
    {"speech.monspeak.e9374bb8687cd69c", "{rupert_rare_1}", "{rupert_rare_1}", "rupert_rare_1:text"},
    {"speech.monspeak.e93999ceb22092ab", "{the_monster_1} says {to_foe_1}, \"Coming here was your last mistake.\"", "{the_monster_1}说 {to_foe_1}：“来这里是你犯的最后一个错误。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.e96ac1128c3fac34", "{the_monster_1} says, \"It's nice to have friends.\"", "{the_monster_1}说：“有朋友真好。”", "the_monster_1:name"},
    {"speech.monspeak.e98be59d846ad877", "{channel_1}{the_monster_possessive_1} bangles clink loudly.", "{channel_1}{the_monster_possessive_1}手镯叮当作响。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.e9aa90b96519b7e8", "{xtahua_rare_1}", "{xtahua_rare_1}", "xtahua_rare_1:text"},
    {"speech.monspeak.e9b7a2dae2fc819d", "{channel_1}{the_monster_1} glares at {foe_1}.", "{channel_1}{the_monster_1}怒视着 {foe_1}。", "channel_1:key;the_monster_1:name;foe_1:text"},
    {"speech.monspeak.e9cd045df0b4c63b", "{the_monster_1} says, \"Who do you take me for, some common mercenary\?\"", "{the_monster_1}说：“你把我当成什么了，普通的雇佣兵吗？”", "the_monster_1:name"},
    {"speech.monspeak.e9e0387820d2603e", "{the_monster_1} mutters, \"Now, where did I put that quill...\"", "{the_monster_1}嘟囔道：“唔，我把那支羽毛笔放哪儿了……”", "the_monster_1:name"},
    {"speech.monspeak.ea26a24b4dc3e37d", "{the_monster_1} screams {at_foe_1}, \"Erolcha happy to kill you!\"", "{the_monster_1}尖叫 {at_foe_1}：“厄洛卡很喜欢杀你！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.ea3f52e34546f072", "{the_monster_1} says, \"I heard Trog has abandonment issues.\"", "{the_monster_1}说：“我听说特洛戈有被抛弃的心理阴影。”", "the_monster_1:name"},
    {"speech.monspeak.ea404cad624c0669", "{the_monster_1} laughs crazily.", "{the_monster_1}疯狂地大笑。", "the_monster_1:name"},
    {"speech.monspeak.ea407a1457658f3b", "{the_monster_1} says, \"They don't shamble much, do they\? I hate that.\"", "{the_monster_1}说：“他们也不太会拖着步子走，对吧？我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.ea51b1a3ab07da43", "{the_monster_1} grins wickedly and says, \"Money make world go round.\"", "{the_monster_1}邪恶地咧嘴一笑，说：“钱让世界转起来。”", "the_monster_1:name"},
    {"speech.monspeak.ea956e598254214b", "{the_monster_1} dodges and says, \"Too slow!\"", "{the_monster_1}闪身躲过，说：“太慢了！”", "the_monster_1:name"},
    {"speech.monspeak.ea9aa7c439547d8e", "A faint prismatic mist rises from Blorkula's broken form and then dissipates.", "一缕淡淡的虹彩雾气从布洛克拉破碎的身躯上升起，随即消散了。", ""},
    {"speech.monspeak.ea9e5fcbf19ce8f0", "{channel_1}{the_monster_1} grins malevolently.", "{channel_1}{the_monster_1}恶毒地咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.eab45f2d5c330e90", "{the_monster_1} grouses that life is wasted on the living.", "{the_monster_1}抱怨说，生命都让活着的人给浪费了。", "the_monster_1:name"},
    {"speech.monspeak.eabd8d514edd0d2f", "{demon_taunt_1}", "{demon_taunt_1}", "demon_taunt_1:text"},
    {"speech.monspeak.eac61c508da66440", "the word of Zin on", "辛的圣言中关于", ""},
    {"speech.monspeak.eac81a5fbf27ddd7", "{channel_1}{the_monster_1} grins impishly at you.", "{channel_1}{the_monster_1}冲你调皮地咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.eacbcfc9be50243e", "{channel_1}{the_monster_1} plants {possessive_1} feet in a plie.", "{channel_1}{the_monster_1}摆出屈膝舞步，稳稳站住{possessive_1}双脚。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.eaeb9e11c2e99df3", "{the_monster_1} asks {foe_1} \"What the hell are we doing here\? Hmm, I see...\"", "{the_monster_1}问{foe_1}：“我们到底在这里做什么？唔，我明白了……”", "the_monster_1:name;foe_1:text"},
    {"speech.monspeak.eb04b2f2e8e37fb9", "{the_monster_1} says {to_foe_1}, \"I retired to this dungeon. Do you want to retire to the afterlife\?\"", "{the_monster_1}说 {to_foe_1}：“我退隐到了这座地牢。你想退隐到来世去吗？”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.eb096baa5bfeac65", "{the_monster_1} says, \"You wouldn't believe how much I paid for this flail.\"", "{the_monster_1}说：“你不会相信我花多少钱买了这把连枷。”", "the_monster_1:name"},
    {"speech.monspeak.eb2adab24877603e", "{the_monster_1} screams {at_foe_1}, \"Bow down before your king! Bow! Bow!!\" {player_only_1}", "{the_monster_1}朝{at_foe_1}尖声喊道：“向你的国王跪下！跪下！快跪下！！”{player_only_1}", "the_monster_1:name;at_foe_1:text;player_only_1:text"},
    {"speech.monspeak.eb51b34a4d262ed1", "{the_monster_1} says {to_foe_1}, \"Does this not give you the chills\?\"", "{the_monster_1}说 {to_foe_1}：“这难道不让你不寒而栗吗？”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.eb52315edc39be4f", "{the_monster_1} {laughs_1} at how history will forget everyone present.", "{the_monster_1}{laughs_1}着，笑历史将如何遗忘在场的每一个人。", "the_monster_1:name;laughs_1:text"},
    {"speech.monspeak.eb545e37eb75ebcf", "{the_monster_1} muses, \"Oh, to inspire such passion as a moth of wrath...\"", "{the_monster_1}沉思道：“啊，要是能像狂怒蛾一样激起这般狂热……”", "the_monster_1:name"},
    {"speech.monspeak.eb6b7e6ccd912c59", "{the_monster_1} wonders, \"Maybe oil would work\? Probably not.\"", "{the_monster_1}想道：“也许抹点油管用？大概不管用。”", "the_monster_1:name"},
    {"speech.monspeak.eb84bc647202830d", "{the_monster_1} says, \"You'd think a god of fire would be a bit brighter.\"", "{the_monster_1}说：“你会以为火神多少该亮一点。”", "the_monster_1:name"},
    {"speech.monspeak.eb865508f3d6da6c", "{the_monster_1} says, \"Even the Halls of Hell could not contain me.\"", "{the_monster_1}说：“连地狱的殿堂都困不住我。”", "the_monster_1:name"},
    {"speech.monspeak.ebba8400ac80410f", "sallow", "蜡黄", ""},
    {"speech.monspeak.ebbad3a4e6ffe4c9", "{the_monster_1} says, \"How does a bone dragon fly, anyway\?\"", "{the_monster_1}说：“话说，骨龙到底是怎么飞的？”", "the_monster_1:name"},
    {"speech.monspeak.ebbd29aee1cc780f", "{the_monster_1} says, \"This isn't even all that spooky.\"", "{the_monster_1}说：“这里其实一点也不阴森。”", "the_monster_1:name"},
    {"speech.monspeak.ebcf062c2aec4231", "Bowser", "鲍泽", ""},
    {"speech.monspeak.ebe1c6a9c04f5ad0", "{channel_1}{the_monster_1} grins with joy.", "{channel_1}{the_monster_1}开心地咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.ebf03593675b9270", "{channel_1}{the_monster_1} gestures ominously {at_foe_1}.", "{channel_1}{the_monster_1}不祥地做着手势 {at_foe_1}。", "channel_1:key;the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.ebf718ec66ac195a", "{the_monster_possessive_1} eyes darken. \"You have made a grave mistake.\"", "{the_monster_possessive_1}双眼暗了下来。“你犯下了大错。”", "the_monster_possessive_1:name"},
    {"speech.monspeak.ebfa1f90db0396ba", "{the_monster_1} says, \"What's with all the gesturing\? I hate that.\"", "{the_monster_1}说：“他们怎么老是比划来比划去的？我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.ec0c00f9d70b1724", "{the_monster_1} says, \"You're so much nicer than my last boss.\"", "{the_monster_1}说：“你可比我上一任老大好多了。”", "the_monster_1:name"},
    {"speech.monspeak.ec15b97b3beae156", "{the_monster_1} gurgles.", "{the_monster_1}发出咕噜声。", "the_monster_1:name"},
    {"speech.monspeak.ec16cb255e397883", "{the_monster_1} says {to_foe_1}, \"Beauty is only skin deep, and my weapons penetrate much further than that.\"", "{the_monster_1}说 {to_foe_1}：“美貌只是皮相，而我的武器能刺得比那深得多。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.ec1ae87fbc60a790", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.ec2254ac8c543460", "bow", "叩首", ""},
    {"speech.monspeak.ec2a437c0e2468d0", "{channel_1}{the_monster_1} grins evilly.", "{channel_1}{the_monster_1}邪恶地咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.ec2e938ed6df25e7", "{the_monster_1} {wails_1}, \"I was like you once.\"", "{the_monster_1} {wails_1}：“我曾经也和你一样。”", "the_monster_1:name;wails_1:text"},
    {"speech.monspeak.ec332cf3c54eebed", "{the_monster_1} says {to_foe_1}, \"What's my secret\? I feed my dogs {player_genus_plural_1}. It makes their fur nice and shiny.\" {player_only_1}", "{the_monster_1}说 {to_foe_1}：“我的秘诀是什么？我喂我的狗吃{player_genus_plural_1}。这让它们的毛皮又亮又滑。”{player_only_1}", "the_monster_1:name;to_foe_1:text;player_genus_plural_1:name;player_only_1:text"},
    {"speech.monspeak.ec36de6a756d3e18", "{channel_1}{the_monster_1} grins evilly.", "{channel_1}{the_monster_1}恶狠狠地咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.ec4009fa768c4e3e", "Flower", "花", ""},
    {"speech.monspeak.ec409cb0105566b3", "{channel_1}Something foul drips from {the_monster_possessive_1} claws.", "{channel_1}污秽的液体从{the_monster_possessive_1}的爪子上滴下来。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.ec5584ee8a833e3f", "says {to_foe_1}", "说 {to_foe_1}", "to_foe_1:text"},
    {"speech.monspeak.ec5e9b66f18cfdb0", "the one true way.", "唯一的真道。", ""},
    {"speech.monspeak.ec61e0f8087abf36", "{the_monster_1} says {to_foe_1}, \"{foe_genus_1} for dinner\? Sounds delicious!\"", "{the_monster_1}说 {to_foe_1}：“晚餐吃{foe_genus_1}？听起来很美味！”", "the_monster_1:name;to_foe_1:text;foe_genus_1:name"},
    {"speech.monspeak.ec64c653c79f293a", "{channel_1}{the_monster_1} grins madly.", "{channel_1}{the_monster_1}疯狂地咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.ecad537b2af4b486", "rumpyflump", "伦皮弗兰普", ""},
    {"speech.monspeak.ed4749d3a765dbe0", "{channel_1}{the_monster_1} looks scornfully at {foe_1}.", "{channel_1}{the_monster_1}轻蔑地看着 {foe_1}。", "channel_1:key;the_monster_1:name;foe_1:text"},
    {"speech.monspeak.ed4a4a90bdcb0a2e", "{the_monster_1} says, \"I am undefeated in single-handed combat.\"", "{the_monster_1}说：“我单打独斗从未败过。”", "the_monster_1:name"},
    {"speech.monspeak.ed4d4feaaceb8c7a", "{the_monster_1} says, \"What kind of dance blows up spectators\?\"", "{the_monster_1}说：“什么样的舞能把观众都炸飞？”", "the_monster_1:name"},
    {"speech.monspeak.ed535dff404fce76", "{the_monster_1} moans, \"No job prospects! Who wants sleepy Aizul to guard their treasure\?\"", "{the_monster_1}哀叹道：“没有职业前景！谁想要嗜睡的艾祖替他们看守财宝？”", "the_monster_1:name"},
    {"speech.monspeak.ed717c6ba004059a", "{the_monster_1} says, \"What have I done\? What have I done\?\"", "{the_monster_1}说：“我做了什么？我做了什么？”", "the_monster_1:name"},
