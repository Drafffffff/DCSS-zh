    {"item.origin.genie_draw", "\nYou drew the Genie {place}.", "\n你在{place}抽到了精灵。", "place:text"},
    {"item.origin.god_gift", "\n{god} gifted it to you {place}.", "\n{god}在{place}赐予了你这件物品。", "god:name;place:text"},
    {"item.origin.invented", "\nYou invented it yourself {place}.", "\n你在{place}亲手创造了它。", "place:text"},
