    {"speech.monspeak.5a8472a0f693712b", "{the_monster_1} squints and says {to_foe_1}, \"You're the ugliest harpy I ever saw.\"", "{the_monster_1}眯起眼睛说 {to_foe_1}：“你是我见过最丑的鸟妖。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.5a8657d4c8950933", "{the_monster_1} says, \"Dance\? No thanks, I don't dance.\"", "{the_monster_1}说：“跳舞？不了，谢谢，我不跳舞。”", "the_monster_1:name"},
