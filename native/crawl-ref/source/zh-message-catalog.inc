    {"speech.monspeak.901f9cb70ff79a0e", "{the_monster_1} says, \"I like the beach, but I hate the sea.\"", "{the_monster_1}说：“我喜欢沙滩，但我讨厌海。”", "the_monster_1:name"},
    {"speech.monspeak.90398a3dbb995b11", "{the_monster_1} asks, \"What happened\? Did... did you die\?\"", "{the_monster_1}问道：“发生什么事了？你……你死了吗？”", "the_monster_1:name"},
    {"speech.monspeak.903c9cb724e782a2", "{the_monster_1} reminisces, \"I miss the gifts and the pranks.\"", "{the_monster_1}追忆道：“我怀念那些礼物和恶作剧。”", "the_monster_1:name"},
    {"speech.monspeak.904673cad91d8fa0", "Rex", "雷克斯", ""},
