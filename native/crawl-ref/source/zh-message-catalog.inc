    {"speech.monspeak.8fa503cb75501c91", "{the_monster_1} says, \"I wonder if I left the window open.\"", "{the_monster_1}说：“我是不是忘了关窗户？”", "the_monster_1:name"},
    {"speech.monspeak.8fdc326a167a1f5f", "{jory_silent_1}", "{jory_silent_1}", "jory_silent_1:text"},
    {"speech.monspeak.8fe924988d97e8ac", "{channel_1}{the_monster_1} bares {possessive_1} teeth.", "{channel_1}{the_monster_1}龇出{possessive_1}牙齿。", "channel_1:key;the_monster_1:name;possessive_1:text"},
