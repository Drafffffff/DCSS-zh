    {"speech.monspeak.000333e481378505", "{the_monster_1} says, \"Can you balance on a beach ball\? I can!\"", "{the_monster_1}说：“你能在沙滩球上保持平衡吗？我能！”", "the_monster_1:name"},
    {"speech.monspeak.0009e18568a82f2e", "{the_monster_1} says, \"Adventurers these days do not know how to walk, let alone fight.\"", "{the_monster_1}说：“如今的冒险者连走路都不会，更别说战斗了。”", "the_monster_1:name"},
    {"speech.monspeak.001497f6a23ecd44", "Lugonu", "卢格努", ""},
    {"speech.monspeak.0030d1e552423fb7", "{the_monster_1} draws the Tomb. \"I don't want to be sealed in with no windows!\"", "{the_monster_1}抽到了陵墓。“我可不想被关在没窗户的地方！”", "the_monster_1:name"},
    {"speech.monspeak.00402f2929ca9973", "{channel_1}{the_monster_1} summons a swarm of flies.", "{channel_1}{the_monster_1}召唤出一群苍蝇。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.00470576bb8c0b86", "{the_monster_1} screams, \"No! How DARE you!\"", "{the_monster_1}尖叫道：“不！你竟敢？！”", "the_monster_1:name"},
    {"speech.monspeak.0066ef208dbf39b5", "{the_monster_1} says {to_foe_1}, \"Where the sword fails, magic succeeds!\"", "{the_monster_1}说 {to_foe_1}：“剑所不能及之处，魔法必达！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.00688aafe1c0ffd3", "{the_monster_1} says {to_foe_1}, \"May tha earth consume ye!\"", "{the_monster_1}说 {to_foe_1}：“愿大地吞了你！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.007e9b71a382d74e", "{channel_1}{the_monster_1} writhes her tentacles angrily.", "{channel_1}{the_monster_1}愤怒地扭动着她的触手。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.007eadd413041e8c", "{the_monster_1} says, \"Get me out of this place.\"", "{the_monster_1}说：“带我离开这个地方。”", "the_monster_1:name"},
    {"speech.monspeak.008084a1ec2288e7", "{the_monster_1} prays for a Stone to Flesh spell.", "{the_monster_1}祈祷着能有一个化石为肉的法术。", "the_monster_1:name"},
    {"speech.monspeak.0089f554b151c6b5", "{the_monster_1} says {to_foe_1}, \"What's the hurry\? You'll die anyway.\"", "{the_monster_1}说 {to_foe_1}：“急什么？你横竖都是死。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.009c0c8c5d83ff4f", "{the_monster_1} cries {to_foe_1}, \"Mercy!\"", "{the_monster_1}哭喊着 {to_foe_1}：“饶命！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.00b8d862f30e0969", "{the_monster_1} says, \"Why would someone put a sword in a little box\?\"", "{the_monster_1}说：“为什么会有人把剑放进小盒子里？”", "the_monster_1:name"},
    {"speech.monspeak.00cfe72d6b442730", "{channel_1}{the_monster_1} begins hyperventilating.", "{channel_1}{the_monster_1}开始过度换气。", "channel_1:key;the_monster_1:name"},
