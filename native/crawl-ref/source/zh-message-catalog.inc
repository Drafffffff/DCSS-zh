    {"speech.monspeak.1d0b0701c6d6f880", "{the_monster_1} innocently whispers {to_foe_1}, \"Don't trust the tales, trust me!\"", "{the_monster_1}无辜地低声说 {to_foe_1}：“别信那些故事，相信我！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.1d3049ddfdb80de5", "{the_monster_1} says, \"Where do you keep all those decks\?\"", "{the_monster_1}说：“你那些牌组都放在哪儿？”", "the_monster_1:name"},
    {"speech.monspeak.1d3e181c1ad20eab", "{the_monster_1} says, \"Resolve to dissolve!\"", "{the_monster_1}说：“下决心溶解吧！”", "the_monster_1:name"},
    {"speech.monspeak.1d442af364771894", "{the_monster_1} covers {possessive_1} ears. \"Shut up!\"", "{the_monster_1}捂住{possessive_1}耳朵。“闭嘴！”", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.1d473bb0354a75f9", "{the_monster_1} says, \"Come on. Make me an offer of peace that I can't refuse!\"", "{the_monster_1}说：“来吧。给我一个我无法拒绝的和平提议！”", "the_monster_1:name"},
    {"speech.monspeak.1d53ede7da10bb86", "{the_monster_1} shouts, \"Faster, {grum_dog_name_1}! Kill! Kill!\"", "{the_monster_1}喊道：“快上，{grum_dog_name_1}！杀！杀！”", "the_monster_1:name;grum_dog_name_1:name"},
    {"speech.monspeak.1d5b7816615f6b1d", "{the_monster_1} says {to_foe_1}, \"I'm committing your attacks to memory.\"", "{the_monster_1}说 {to_foe_1}：“我正在把你的招数一一记在心里。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.1d60bafa5545cb92", "{the_monster_1} hisses, \"Days like this make me miss drinking.\"", "{the_monster_1}嘶嘶地说：“这样的日子让我真想喝上一杯。”", "the_monster_1:name"},
    {"speech.monspeak.1d631b96f7164c2e", "{channel_1}Some snowflakes condense on {the_monster_1}.", "{channel_1}一些雪花在{the_monster_1}身上凝结。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.1d78e22aed9dd183", "{the_monster_1} {norris_verb_1} {to_foe_1}, \"After death you'll find inner peace.\"", "{the_monster_1}{norris_verb_1} {to_foe_1}：“死后你就会找到内心的平静。”", "the_monster_1:name;norris_verb_1:text;to_foe_1:text"},
    {"speech.monspeak.1d88ce3814c9c72c", "{subjective_1} yells, \"I follow Beogh's word, I swear it!\"", "{subjective_1}大叫道：“我听从比欧弗的旨意，我发誓！”", "subjective_1:text"},
    {"speech.monspeak.1d93340e45982b2b", "{the_monster_1} says, \"I hate Vehumet.\"", "{the_monster_1}说：“我讨厌维胡梅特。”", "the_monster_1:name"},
    {"speech.monspeak.1da7b12666d0c856", "{the_monster_1} says, \"The outcome was never in doubt.\"", "{the_monster_1}说：“结果从来就没有过悬念。”", "the_monster_1:name"},
    {"speech.monspeak.1db654fe6560b206", "{channel_1}{the_monster_1} gestures wildly.", "{channel_1}{the_monster_1}疯狂地比划着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.1db84e2a3a6280f4", "carpentry", "做木工", ""},
    {"speech.monspeak.1dc57cebe39929d1", "Moaning pathetically, {the_monster_possessive_1} spirit plunges into the ground.", "{the_monster_possessive_1}灵魂可怜地呻吟着，一头扎进了地面。", "the_monster_possessive_1:name"},
    {"speech.monspeak.1dcc3179a23f8581", "cottage", "小屋", ""},
    {"speech.monspeak.1dcf984300010a24", "{the_monster_1} says, \"I prefer the Lair of the Beasts, to be honest. At least animals don't complain.\"", "{the_monster_1}说：“说实话，我更愿意待在野兽之巢。至少动物不会抱怨。”", "the_monster_1:name"},
    {"speech.monspeak.1e0c235960cda2a3", "{the_monster_1} says, \"Oh, this must be a dream. This is totally unrealistic.\"", "{the_monster_1}说：“哦，这一定是个梦。这完全不真实。”", "the_monster_1:name"},
    {"speech.monspeak.1e0fdb2897bd0052", "{hostile_orc_beogh_believer_speech_rare_1}", "{hostile_orc_beogh_believer_speech_rare_1}", "hostile_orc_beogh_believer_speech_rare_1:text"},
    {"speech.monspeak.1e16e24d2dcf5855", "{the_monster_1} says, \"I hate suffering.\"", "{the_monster_1}说：“我讨厌受苦。”", "the_monster_1:name"},
    {"speech.monspeak.1e2a545e18aebd4b", "{the_monster_1} {shouts_1} {at_foe_1}, \"You're not the messiah, I am!\"", "{the_monster_1}{shouts_1} {at_foe_1}：“你不是弥赛亚，我才是！”", "the_monster_1:name;shouts_1:text;at_foe_1:text"},
    {"speech.monspeak.1e493e661eb0b5b5", "{the_monster_1} says, \"{player_genus_1}kind's got to stick together!\"", "{the_monster_1}说：“{player_genus_1}一家就该团结在一起！”", "the_monster_1:name;player_genus_1:name"},
    {"speech.monspeak.1e81e600426af5a7", "{the_monster_1} screams in rage.", "{the_monster_1}愤怒地尖叫。", "the_monster_1:name"},
    {"speech.monspeak.1ea64d667e4642d7", "{the_monster_1} squints and screams {at_foe_1}, \"A harpy\? Time to die, you blasted buzzard!\"", "{the_monster_1}眯起眼睛尖叫道 {at_foe_1}：“是鸟妖？那就去死吧，你这该死的秃鹫！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.1ec02996dce69e8f", "{the_monster_1} says, \"I hate zombies.\"", "{the_monster_1}说：“我讨厌僵尸。”", "the_monster_1:name"},
    {"speech.monspeak.1ec59d6e64b6d7e4", "{channel_1}{the_monster_1} twitches its length with the pilfered instincts of {choice_1}.", "{channel_1}{the_monster_1}带着偷来的{choice_1}本能，扭动着身体。", "channel_1:key;the_monster_1:name;choice_1:text"},
