    {"shared.restriction.logs", "A magic seal in the Gauntlet prevents you from opening a passage!", "shared.log.transloc.gauntlet_seal"},
    {"shared.restriction.logs", "A red film seems to cover your vision as you go berserk!", "shared.log.berserk.red_vision"},
    {"shared.restriction.logs", "Boing!", "shared.log.transloc.boing"},
    {"shared.restriction.logs", "Controlled teleport interrupted by HUP signal, cancelling teleport.", "shared.log.teleport.hup_cancel"},
    {"shared.restriction.logs", "Creating a passage of Golubria requires sufficient empty space.", "shared.log.transloc.passage_space"},
    {"shared.restriction.logs", "Even you can't go there right now. Sorry!", "shared.log.teleport.wizard_blocked"},
    {"shared.restriction.logs", "Not with that terrain in the way!", "shared.log.transloc.terrain_blocked"},
    {"shared.restriction.logs", "Oops! There was something there already!", "shared.log.blink.occupied"},
    {"shared.restriction.logs", "Please don't blink into the map border.", "shared.log.transloc.blink_map_border"},
    {"shared.restriction.logs", "Please don't try to blink into monsters.", "shared.log.transloc.blink_monsters"},
    {"shared.restriction.logs", "Something buggy happened.", "shared.log.transloc.bug"},
    {"shared.restriction.logs", "Space begins to contract around you, but something blocks your path.", "shared.log.transloc.space_blocked"},
    {"shared.restriction.logs", "Space momentarily warps into an impossible shape!", "shared.log.transloc.warp"},
    {"shared.restriction.logs", "That's out of range!", "shared.log.transloc.out_of_range"},
    {"shared.restriction.logs", "The air shimmers briefly around you.", "shared.log.transloc.air_shimmers"},
    {"shared.restriction.logs", "This transformation would significantly lower your maximum hit points. Transform anyway\?", "shared.prompt.transform.lower_max_hp"},
    {"shared.restriction.logs", "Transforming right now would cause you to burn!", "shared.log.transform.burn"},
    {"shared.restriction.logs", "Transforming right now would cause you to drown!", "shared.log.transform.drown"},
    {"shared.restriction.logs", "You are hurled out of the way!", "shared.log.transloc.hurled_away"},
    {"shared.restriction.logs", "You can't create a passage there!", "shared.log.transloc.passage_blocked"},
    {"shared.restriction.logs", "You can't see anything to attack.", "shared.log.transloc.no_attack_target"},
    {"shared.restriction.logs", "You can't see anything you can safely attack.", "shared.log.transloc.no_safe_attack_target"},
    {"shared.restriction.logs", "You cannot apport that!", "shared.log.transloc.cannot_apport"},
    {"shared.restriction.logs", "You cannot create a passage on the other side of the transparent wall.", "shared.log.transloc.passage_other_side_wall"},
    {"shared.restriction.logs", "You charge forward in eerie silence!", "shared.log.transloc.charge_silence"},
    {"shared.restriction.logs", "You charge forward with an electric crackle!", "shared.log.transloc.charge_crackle"},
    {"shared.restriction.logs", "You don't see anything to apport there.", "shared.log.transloc.no_apport_target"},
    {"shared.restriction.logs", "You feel a distressing malevolence running through your instability!", "shared.log.teleport.start_hostile"},
