    {"speech.monspeak.58fab4045c10f958", "{the_monster_1} says {to_foe_1}, \"You are a traitor to our kind!\"", "{the_monster_1}说 {to_foe_1}：“你是我们族类的叛徒！”", "the_monster_1:name;to_foe_1:text"},
