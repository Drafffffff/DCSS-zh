    {"speech.monspeak.f58107f8ebc2bb6b", "{sonja_common_1}", "{sonja_common_1}", "sonja_common_1:text"},
    {"speech.monspeak.f59369e045c1c1c4", "{the_monster_1} roars {at_foe_1}, \"DIE, PUNY ONE!\"", "{the_monster_1}咆哮道 {at_foe_1}：“死吧，渺小的东西！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.f5bbfa8cb5cca529", "{the_monster_1} says, \"I am smarter than you!\"", "{the_monster_1}说：“我比你聪明！”", "the_monster_1:name"},
    {"speech.monspeak.f5c7d82793f3da47", "{the_monster_1} promises, \"I will read your future in your entrails.\"", "{the_monster_1}许诺道：“我会从你的内脏里读出你的未来。”", "the_monster_1:name"},
    {"speech.monspeak.f5dbf3de0e4fdfcf", "{the_monster_1} cowers and screams, \"Me head! Aaaah! Get out now!\"", "{the_monster_1}缩成一团，尖叫道：“俺的脑袋！啊啊啊！给俺滚出去！”", "the_monster_1:name"},
    {"speech.monspeak.f5f3c2f449ed8ecd", "{channel_1}{the_monster_1} smiles chillingly.", "{channel_1}{the_monster_1}露出令人胆寒的微笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.f5f8ace21ea62f30", "{channel_1}{the_monster_1} scratches {possessive_1} head thoughtfully.", "{channel_1}{the_monster_1}若有所思地挠着{possessive_1}头。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.f5fbecb34224ff5d", "{channel_1}{the_monster_1} looks desperately for an escape route.", "{channel_1}{the_monster_1}绝望地寻找着逃跑的路线。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.f616322c48e0fc51", "Walk", "行走", ""},
    {"speech.monspeak.f61901cd38db17e5", "{urug_1}", "{urug_1}", "urug_1:text"},
    {"speech.monspeak.f61b722458d5351e", "{the_monster_1} fumbles a card and drops it. \"Whoops!\"", "{the_monster_1}笨手笨脚地掉了一张牌。“哎呀！”", "the_monster_1:name"},
    {"speech.monspeak.f627e17914a535e8", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.f6292276bf0f831d", "{channel_1}{the_monster_1} adjusts {possessive_1} eyepatch.", "{channel_1}{the_monster_1}调整{possessive_1}眼罩。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.f62eed3ebb9f87ed", "{the_monster_1} curses the gods.", "{the_monster_1}咒骂着众神。", "the_monster_1:name"},
    {"speech.monspeak.f659b429d221c9d0", "{channel_1}{the_monster_1} takes aim {at_foe_1}.", "{channel_1}{the_monster_1}瞄准了 {at_foe_1}。", "channel_1:key;the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.f684e97834dcd11b", "{fannar_common_1}", "{fannar_common_1}", "fannar_common_1:text"},
    {"speech.monspeak.f6a20dca90a3703e", "a rockslide like thunder", "如雷鸣般的山崩", ""},
    {"speech.monspeak.f6ab968cc88e7724", "{polyphemus_rare_1}", "{polyphemus_rare_1}", "polyphemus_rare_1:text"},
    {"speech.monspeak.f6dc8bdec9573aa0", "{urug_rare_1}", "{urug_rare_1}", "urug_rare_1:text"},
    {"speech.monspeak.f6eeb92c1a8ec642", "{the_monster_1} says, \"Everyone has the same god; only people differ.\"", "{the_monster_1}说：“每个人都有同一个神；不同的只是人。”", "the_monster_1:name"},
    {"speech.monspeak.f6f0ea39f5885b17", "{the_monster_1} mourns the many lost in the orcish exodus to the Dungeon.", "{the_monster_1}为兽人大迁徙中在地牢里丧生的众多亡者哀悼。", "the_monster_1:name"},
    {"speech.monspeak.f7152e5124cf8d1d", "{the_monster_1} mutters, \"So much for the promised afterlife.\"", "{the_monster_1}嘟囔道：“说好的来世呢。”", "the_monster_1:name"},
    {"speech.monspeak.f73bccb880084199", "{the_monster_1} caws, \"Nevermore!\"", "{the_monster_1}呱呱叫道：“永不复焉！”", "the_monster_1:name"},
    {"speech.monspeak.f746df1ae5deed98", "{maggie_rare_1}", "{maggie_rare_1}", "maggie_rare_1:text"},
    {"speech.monspeak.f77da91464dfa1e2", "whispers", "低语", ""},
    {"speech.monspeak.f798c009e2f56496", "{the_monster_1} says, \"I hope you love dancing weapons. I hate them.\"", "{the_monster_1}说：“希望你喜欢跳舞的武器。我讨厌它们。”", "the_monster_1:name"},
    {"speech.monspeak.f7d5cfdb832c8266", "{channel_1}{the_monster_1} drips {choice_1} stolen formulae onto the {surface_1}.", "{channel_1}{the_monster_1}把{choice_1}偷来的公式滴落在{surface_1}上。", "channel_1:key;the_monster_1:name;choice_1:text;surface_1:text"},
    {"speech.monspeak.f7d5cfdb832c8266.choice_1.alt_0", "complex", "复杂的", ""},
    {"speech.monspeak.f7d5cfdb832c8266.choice_1.alt_1", "unknown", "未知的", ""},
    {"speech.monspeak.f7f6d7a36cbf0771", "{the_monster_1} says, \"You don't look like a good insulator.\"", "{the_monster_1}说：“你看起来不像是什么好的绝缘体。”", "the_monster_1:name"},
    {"speech.monspeak.f7fda4a6b6b27914", "{the_monster_1} says {to_foe_1}, \"No gallows around, so decapitation it is.\"", "{the_monster_1}说 {to_foe_1}：“附近没有绞刑架，那就斩首吧。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.f809004d3b8f69af", "{the_monster_1} says, \"I've got two hundred gold pieces. Is that enough to cure these mutations\?\"", "{the_monster_1}说：“我有两百枚金币。这些够治好我身上的变异吗？”", "the_monster_1:name"},
    {"speech.monspeak.f80bb9416f9d3d79", "{the_monster_1} says {to_foe_1}, \"I'll crush your bones, one by one.\"", "{the_monster_1}说 {to_foe_1}：“我要把你的骨头一根一根碾碎。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.f80fdbde13550f78", "{the_monster_1} says {to_foe_1}, \"You lack the discipline to defeat me.\"", "{the_monster_1}说 {to_foe_1}：“你缺乏击败我的那份修为。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.f8293f45d625ea4d", "{channel_1}{the_monster_1} angrily waves {possessive_1} antennae.", "{channel_1}{the_monster_1}愤怒地摆动着{possessive_1}触角。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.f8296950864234f2", "{channel_1}{the_monster_1} glitters, immutable and inevitable, in the dim dungeon light.", "{channel_1}{the_monster_1}在昏暗的地牢光线下闪闪发亮，不可更改，无可避免。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.f8432fb6eea50939", "{parghit_rare_1}", "{parghit_rare_1}", "parghit_rare_1:text"},
    {"speech.monspeak.f84a4ab8b62801f8", "{the_monster_1} says, \"You'll burn in Gehenna!\" {player_only_1}", "{the_monster_1}说：“你会在欣嫩谷里烧成灰！” {player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.f86f619e135525d9", "{the_monster_1} says, \"We all must contribute to the advancement of science.\"", "{the_monster_1}说：“我们都必须为科学的进步出力。”", "the_monster_1:name"},
    {"speech.monspeak.f88da0243aeac40f", "{channel_1}{the_monster_possessive_1} form shimmers in the rain.", "{channel_1}{the_monster_possessive_1}的身形在雨中摇曳不定。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.f8ae7805b05f4834", "{the_monster_1} shouts {at_foe_1}, \"There can only be one messiah: ME!\"", "{the_monster_1}喊道 {at_foe_1}：“弥赛亚只能有一个：那就是我！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.f8bbe03de711ff21", "{the_monster_1} yells at you, \"GO AWAY!\"", "{the_monster_1}冲你大吼：“滚开！”", "the_monster_1:name"},
    {"speech.monspeak.f8cc04d631774dae", "{the_monster_1} says, \"I am transcendence, you are transpiration.\"", "{the_monster_1}说：“我是超凡脱俗，你是汗流浃背。”", "the_monster_1:name"},
    {"speech.monspeak.f8d3ecdfc86e8550", "{the_monster_1} rumbles {at_foe_1}, \"YOU'RE BARELY A SNACK.\"", "{the_monster_1}低沉地吼道 {at_foe_1}：“你连塞牙缝都不够。”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.f8d546afeb72b4eb", "{the_monster_1} says, \"You know a god's a real winner when you're their only follower, right\?\"", "{the_monster_1}说：“你是祂唯一的信徒，可见这位神有多成功，对吧？”", "the_monster_1:name"},
    {"speech.monspeak.f8f2147e96552408", "{the_monster_1} screams.", "{the_monster_1}尖叫。", "the_monster_1:name"},
    {"speech.monspeak.f95be3fdae1129c9", "{the_monster_1} says {to_foe_1}, \"You will soon forget everything.\"", "{the_monster_1}说 {to_foe_1}：“你很快就会忘掉一切。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.f961d13a8a3d7869", "{the_monster_1} says, \"You think you're the Messiah\? I met another orc who thought that, too.\"", "{the_monster_1}说：“你以为你是弥赛亚？我还见过另一个兽人这么想呢。”", "the_monster_1:name"},
    {"speech.monspeak.f9678a9045112946", "{the_monster_1} says, \"I hope this rune is worth it!\"", "{the_monster_1}说：“但愿这枚符文值得我跑这一趟！”", "the_monster_1:name"},
    {"speech.monspeak.f96b9c730513d91b", "{the_monster_1} draws the Orb. \"Orbs of destruction hurt!\"", "{the_monster_1}抽到了宝珠。“毁灭宝珠可疼了！”", "the_monster_1:name"},
    {"speech.monspeak.f99d70962654a276", "{the_monster_1} screams, \"Help!\"", "{the_monster_1}尖叫道：“救命！”", "the_monster_1:name"},
    {"speech.monspeak.f9ad360b4f458c90", "{channel_1}{the_monster_1} says something you can't hear. It was probably not a compliment. {player_only_1}", "{channel_1}{the_monster_1}说了些什么，可你听不见。那多半不是什么恭维话。 {player_only_1}", "channel_1:key;the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.f9b7bae91fe8e0c3", "{the_monster_1} says, \"Me has lots rocks.\"", "{the_monster_1}说：“俺有很多石头。”", "the_monster_1:name"},
    {"speech.monspeak.f9f1d01185a5288b", "{the_monster_1} giggles, \"Hey deadhead, what fun to see your head drop dead!\"", "{the_monster_1}咯咯笑道：“嘿，榆木脑袋，看你脑袋掉地死掉多好玩！”", "the_monster_1:name"},
    {"speech.monspeak.f9f4b29ffb4b313c", "{the_monster_1} {shouts_1} with approval.", "{the_monster_1}{shouts_1}，表示赞同。", "the_monster_1:name;shouts_1:text"},
    {"speech.monspeak.fa1484829173427d", "{the_monster_1} says {to_foe_1}, \"You'll make a fine pincushion.\"", "{the_monster_1}说 {to_foe_1}：“你会是个不错的针插。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.fa1fbbb2f646ec5e", "yield", "屈服", ""},
    {"speech.monspeak.fa26a4625eb4d7d9", "{the_monster_1} says, \"O terrible one, your will is done.\"", "{the_monster_1}说：“哦，可怖的存在啊，你的意志已经实现了。”", "the_monster_1:name"},
    {"speech.monspeak.fa30062cd9dddb2c", "{the_monster_1} says, \"Found the spell you wanted yet\?\"", "{the_monster_1}说：“你要找的法术找到了吗？”", "the_monster_1:name"},
    {"speech.monspeak.fa5f153b8cdafd08", "{the_monster_1} {shouts_1} {at_foe_1}, \"You will make a great snack!\"", "{the_monster_1}{shouts_1}{at_foe_1}：“你会成为一顿美餐！”", "the_monster_1:name;shouts_1:text;at_foe_1:text"},
    {"speech.monspeak.fa9333a72e816116", "{the_monster_1} says, \"I've got a headache. I hate that.\"", "{the_monster_1}说：“我头疼。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.fa9f2ecef08a530d", "{channel_1}{the_monster_1} is surrounded with an aura of peace.", "{channel_1}{the_monster_1}被一圈宁静的光环环绕。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.faa2b9db9da06dd7", "{fannar_rare_1}", "{fannar_rare_1}", "fannar_rare_1:text"},
    {"speech.monspeak.facf4b9e3e3dcb61", "{the_monster_1} says {to_foe_1}, \"The wages of sin are death, you know.\"", "{the_monster_1}说 {to_foe_1}：“你知道的，罪的工价乃是死。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.fad1b4e0693d670a", "{channel_1}{the_monster_1} begins coughing up blood.", "{channel_1}{the_monster_1}开始咳血。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.fae615200b257b23", "{the_monster_1} says, \"Wait for me!\"", "{the_monster_1}说：“等等我！”", "the_monster_1:name"},
    {"speech.monspeak.faee7ef4c3ef7ce3", "{the_monster_1} yells {to_foe_1}, \"Into the Nile with you!\"", "{the_monster_1}吼道 {to_foe_1}：“到尼罗河里去！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.faf50ae6c75575a2", "{the_monster_1} says, \"I hate disasters.\"", "{the_monster_1}说：“我讨厌天灾。”", "the_monster_1:name"},
    {"speech.monspeak.fb1a83e5cba55c24", "{the_monster_1} says, \"Ghost stories\? Ooh, I'm so scared!\"", "{the_monster_1}说：“鬼故事？哎哟，我好怕啊！”", "the_monster_1:name"},
    {"speech.monspeak.fb2ec99eca644ce8", "{the_monster_1} sings badly, off-key.", "{the_monster_1}跑调地唱着难听的歌。", "the_monster_1:name"},
    {"speech.monspeak.fb3cec32fbf7bb1b", "the Ace of Spades", "黑桃A", ""},
    {"speech.monspeak.fb3ea15e25856456", "{gastronok_common_1}", "{gastronok_common_1}", "gastronok_common_1:text"},
    {"speech.monspeak.fb7b275fd475b4d4", "{subjective_1} says, \"I'm so glad you are here now.\"", "{subjective_1}说：“我真高兴你现在来了。”", "subjective_1:text"},
    {"speech.monspeak.fb83b6239aecca4d", "{the_monster_1} snuffles in challenge.", "{the_monster_1}用鼻息发出挑战。", "the_monster_1:name"},
    {"speech.monspeak.fb8b5c45e6c805bf", "Tonal", "音调", ""},
    {"speech.monspeak.fb9554049f79ee80", "{the_monster_1} says, \"I will never forget you!\"", "{the_monster_1}说：“我永远不会忘记你！”", "the_monster_1:name"},
    {"speech.monspeak.fb9eeffbcc97992f", "{the_monster_1} says, \"Find comfort in joining the legions you worship.\"", "{the_monster_1}说：“加入你所膜拜的军团吧，那里会给你安慰。”", "the_monster_1:name"},
    {"speech.monspeak.fba519e9d68c59d3", "{murray_rare_1}", "{murray_rare_1}", "murray_rare_1:text"},
    {"speech.monspeak.fbb39d15429d2678", "{the_monster_1} says, \"I hate the colour green.\"", "{the_monster_1}说：“我讨厌绿色。”", "the_monster_1:name"},
    {"speech.monspeak.fbd4007aeaab14cb", "{the_monster_1} says {to_foe_1}, \"Argatax netranoch dertex.\"", "{the_monster_1}说 {to_foe_1}：“阿尔加塔克斯·内特拉诺赫·德尔特克斯。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.fc01c0c2e141fd2e", "{channel_1}{the_monster_1} gestures at you. {player_only_1}", "{channel_1}{the_monster_1}向你做着手势。 {player_only_1}", "channel_1:key;the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.fc389a8c896c51d1", "{the_monster_1} says, \"A few more walls knocked out 'ere an' thar an' 'tis whole place will come crashin' down.\"", "{the_monster_1}说：“再往外敲掉几堵墙，这地方整个都得塌下来。”", "the_monster_1:name"},
    {"speech.monspeak.fc38d4775343e1d2", "{channel_1}{the_monster_1} waves a bulging coin purse at you.", "{channel_1}{the_monster_1}朝你晃了晃一个鼓鼓囊囊的钱袋。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.fc3d998a9bc6c644", "{the_monster_1} sings.", "{the_monster_1}唱起歌来。", "the_monster_1:name"},
    {"speech.monspeak.fc57d1c845985892", "{the_monster_1} says, \"You have no idea what it means to truly have nothing. We will teach you.\"", "{the_monster_1}说：“你根本不知道真正的一无所有意味着什么。我们会教你的。”", "the_monster_1:name"},
    {"speech.monspeak.fca50231f71a5d77", "{the_monster_1} whispers, \"Meet the emptiness of death!\"", "{the_monster_1}低声说：“迎接死亡的虚空吧！”", "the_monster_1:name"},
    {"speech.monspeak.fca9f7b99dc7dcdc", "Pluto", "布鲁托", ""},
    {"speech.monspeak.fcaa368852853294", "mumblescurry", "咖喱咕哝", ""},
    {"speech.monspeak.fcbfdd856b25f9c5", "{channel_1}You see your fractured reflection in {the_monster_1} contort and writhe. {player_only_1}", "{channel_1}你看见自己支离破碎的倒影在{the_monster_1}表面扭曲翻腾。 {player_only_1}", "channel_1:key;the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.fccdd0185b31444a", "{channel_1}{the_monster_1} looks very angry.", "{channel_1}{the_monster_1}看起来非常愤怒。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.fcf0dd5ce2b86185", "{the_monster_1} boasts, \"I am lord over the four continents and the two thousand adjacent isles.\"", "{the_monster_1}夸口道：“我是四大洲与两千座近海岛屿之主。”", "the_monster_1:name"},
    {"speech.monspeak.fcf6cc0ba21974d1", "{the_monster_1} begins burbling mirthfully and uncontrollably.", "{the_monster_1}开始无法自控地欢乐咕噜起来。", "the_monster_1:name"},
    {"speech.monspeak.fd0295052c014e3a", "{menkaure_common_1}", "{menkaure_common_1}", "menkaure_common_1:text"},
    {"speech.monspeak.fd0b9b3497b0d5a4", "{the_monster_1} says, \"You don't even know how to die right.\"", "{the_monster_1}说：“你连死都死不利索。”", "the_monster_1:name"},
    {"speech.monspeak.fd121701417fd746", "{the_monster_1} says, \"What good are steel and magic against my illusions\?\"", "{the_monster_1}说：“钢铁与魔法，对我的幻象又有何用？”", "the_monster_1:name"},
    {"speech.monspeak.fd13615d9de22493", "{channel_1}{the_monster_1} twists and twirls {possessive_1} body through the storm.", "{channel_1}{the_monster_1}在风暴中扭动、旋转着{possessive_1}身躯。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.fd2d937cf0e73a58", "bovine", "牛科的", ""},
    {"speech.monspeak.fd35223bf4db1c7d", "{the_monster_1} says, \"How do you flay a ghost, anyway\?\"", "{the_monster_1}说：“话说，你要怎么剥一个幽灵的皮？”", "the_monster_1:name"},
    {"speech.monspeak.fd4fc9acd97b98a0", "{the_monster_1} says, \"Thanks for carrying the Orb of Power for me.\"", "{the_monster_1}说：“谢谢你替我背着力量宝珠。”", "the_monster_1:name"},
    {"speech.monspeak.fd5f55bebed65b04", "{the_monster_1} says, \"I hate wrenching sensations.\"", "{the_monster_1}说：“我讨厌那种被硬生生撕扯的感觉。”", "the_monster_1:name"},
    {"speech.monspeak.fd687f1a2896e0f2", "{channel_1}{the_monster_1} wobbles unsteadily, but gives you a thumbs up.", "{channel_1}{the_monster_1}摇摇晃晃地站不稳，却还是冲你竖起了大拇指。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.fd6cf189e3717e5e", "{the_monster_1} {says_or_shouts_1}, \"I fight for {player_name_1}, for Beogh shepherds all!\"", "{the_monster_1}{says_or_shouts_1}：“我为{player_name_1}而战，因为比欧弗牧养众生！”", "the_monster_1:name;says_or_shouts_1:text;player_name_1:name"},
    {"speech.monspeak.fd82a39ba51d4152", "{the_monster_1} screams, \"NO! What have I done\?\"", "{the_monster_1}尖叫道：“不！我做了什么？”", "the_monster_1:name"},
    {"speech.monspeak.fd82c7ca0abf3c2e", "{the_monster_1} says {to_foe_1}, \"Pain is my business; you will see!\"", "{the_monster_1}说 {to_foe_1}：“痛苦就是我的生意；你会见识到的！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.fd833e7a5819f1e2", "You feel something passing dangerously close to your head. {player_only_1}", "你感觉到有什么东西危险地从你头边掠过。{player_only_1}", "player_only_1:text"},
    {"speech.monspeak.fd8db4679c1a185f", "{the_monster_1} whispers {to_foe_1}, \"No {player_genus_1} can resist me...\"", "{the_monster_1}低声说 {to_foe_1}：“没有哪个{player_genus_1}能抵抗我……”", "the_monster_1:name;to_foe_1:text;player_genus_1:name"},
    {"speech.monspeak.fda21c8ee207d1a3", "{the_monster_1} says, \"Heed my words or we all shall suffer their consequence.\"", "{the_monster_1}说：“听我的话，否则我们都要承担后果。”", "the_monster_1:name"},
    {"speech.monspeak.fdd31d78a15291a2", "{the_monster_1} says, \"A dead adventurer is a good adventurer.\" {player_only_1}", "{the_monster_1}说：“死的冒险者才是好冒险者。”{player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.fddba152c3568081", "{the_monster_1} says, \"I'll be sure to include this battle in my report!\"", "{the_monster_1}说：“我一定要把这场战斗写进报告里！”", "the_monster_1:name"},
    {"speech.monspeak.fde0f2b5cabeea1c", "Zin", "辛", ""},
    {"speech.monspeak.fde5d28701774031", "{the_monster_1} hisses {at_foe_1}.", "{the_monster_1}嘶叫着 {at_foe_1}。", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.fdffb4bcc2d864ea", "{channel_1}{the_monster_1} extends {possessive_1} claws.", "{channel_1}{the_monster_1}伸出{possessive_1}爪子。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.fe0c65c74782f23c", "Goober", "古伯", ""},
    {"speech.monspeak.fe12a5a0fec22acf", "{the_monster_1} says {to_foe_1}, \"Down here, you're an orc or you're nobody.\"", "{the_monster_1}说 {to_foe_1}：“在这下面，你要么是兽人，要么就什么都不是。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.fe223da4f0910345", "{channel_1}{the_monster_1} weeps.", "{channel_1}{the_monster_1}哭泣着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.fe4cf1469336f8aa", "{the_monster_1} says, \"Bow before me, strongest of all the hobgoblins!\"", "{the_monster_1}说：“在我面前跪下吧，大地精里最强的一个！”", "the_monster_1:name"},
    {"speech.monspeak.fe502f0f5e975ca4", "{channel_1}{the_monster_1} renews {reflexive_1} in a burst of flame!", "{channel_1}{the_monster_1}在一团火焰中让{reflexive_1}焕然重生！", "channel_1:key;the_monster_1:name;reflexive_1:text"},
    {"speech.monspeak.fe5820116bca7d98", "{the_monster_1} says, \"Me like rocks.\"", "{the_monster_1}说：“俺喜欢石头。”", "the_monster_1:name"},
    {"speech.monspeak.fe65889991bc3c52", "{the_monster_1} says, \"I hate the gods, and the gods hate me.\"", "{the_monster_1}说：“我讨厌众神，众神也讨厌我。”", "the_monster_1:name"},
    {"speech.monspeak.fe89b0f904c768f4", "{the_monster_1} keens inconsolably.", "{the_monster_1}无法自抑地哀泣。", "the_monster_1:name"},
    {"speech.monspeak.fea871aba73b0faa", "{the_monster_1} says {to_foe_1}, \"Foolish people, craving for loot.\"", "{the_monster_1}说 {to_foe_1}：“愚蠢的人们，贪求着战利品。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.fec3c4dbe291b85e", "{the_monster_1} says, \"I stay hydrated... with blood of my enemies!\"", "{the_monster_1}说：“我一直补充水分……用敌人的血！”", "the_monster_1:name"},
    {"speech.monspeak.fec91e40fc96c4ca", "{channel_1}{the_monster_1} grins evilly.", "{channel_1}{the_monster_1}邪恶地咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.fee234a87dfb7247", "{channel_1}{the_monster_1} gnaws at a bone — where's that from\?", "{channel_1}{the_monster_1}啃着一根骨头——这是从哪儿来的？", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.fef1a89845abd736", "{the_monster_1} ducks and says, \"Too high!\"", "{the_monster_1}低头躲开，说：“太高了！”", "the_monster_1:name"},
    {"speech.monspeak.ff078204415ed9f7", "{the_monster_1} says, \"That mummy wasn't so great.\"", "{the_monster_1}说：“那具木乃伊也没多厉害。”", "the_monster_1:name"},
    {"speech.monspeak.ff3cd063ca48ed27", "{the_monster_1} {crazy_yiuf_speech_verbs_1}, \"{crazy_yiuf_sentence_1}\"", "{the_monster_1} {crazy_yiuf_speech_verbs_1}：“{crazy_yiuf_sentence_1}”", "the_monster_1:name;crazy_yiuf_speech_verbs_1:text;crazy_yiuf_sentence_1:text"},
    {"speech.monspeak.ff3f15b9a87609df", "{the_monster_1} screams, \"NO! I can't bear this much noise.\"", "{the_monster_1}尖叫道：“不！我受不了这么大的噪音。”", "the_monster_1:name"},
    {"speech.monspeak.ff4d8247fccf8d8c", "{the_monster_1} says, \"You must hate doors a lot.\"", "{the_monster_1}说：“你肯定特别讨厌门。”", "the_monster_1:name"},
    {"speech.monspeak.ff5fe2002ae53c81", "{the_monster_1} mewls in sadness.", "{the_monster_1}悲伤地喵喵叫着。", "the_monster_1:name"},
    {"speech.monspeak.ff972c6a7f66c666", "greatest", "最伟大的", ""},
    {"speech.monspeak.ffab3aab1ffad784", "{norris_rare_1}", "{norris_rare_1}", "norris_rare_1:text"},
    {"speech.monspeak.ffc9366aed72cb85", "{the_monster_1} says, \"Family always sticks together, {player_name_1}!\"", "{the_monster_1}说：“一家人就要一条心，{player_name_1}！”", "the_monster_1:name;player_name_1:name"},
    {"speech.monspeak.ffe6e80ba93b9d4e", "{the_monster_1} says, \"I proud of my employees.\"", "{the_monster_1}说：“俺为俺的雇员感到自豪。”", "the_monster_1:name"},
    {"speech.monspeak.fffbcf1b09373b19", "{the_monster_1} says {to_foe_1}, \"Did you see that move\? Perfect!\"", "{the_monster_1}说 {to_foe_1}：“看到刚才那招了吗？完美！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.shout.demon_taunt", "{the_monster_1} {says_1}, \"{demon_taunt_1}\"", "{the_monster_1}{says_1}：“{demon_taunt_1}”", "the_monster_1:name;says_1:text;demon_taunt_1:text"},
    {"speech.shout.imp_taunt", "{channel_1}{the_monster_1} {says_1}, \"{imp_taunt_1}\"", "{channel_1}{the_monster_1}{says_1}：“{imp_taunt_1}”", "channel_1:key;the_monster_1:name;says_1:text;imp_taunt_1:text"},
