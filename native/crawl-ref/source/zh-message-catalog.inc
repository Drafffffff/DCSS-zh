    {"speech.monspeak.8a0876a447d9cb24", "Duke", "杜克", ""},
    {"speech.monspeak.8a0f653284326b6d", "{the_monster_1} mutters {at_foe_1}, \"You're NOT the saviour of the Orcs.\"", "{the_monster_1}嘟囔道 {at_foe_1}：“你根本不是兽人的救世主。”", "the_monster_1:name;at_foe_1:text"},
