    {"speech.monspeak.f1f52c3fe1eff142", "{the_monster_1} says, \"Where are all the doors\?\"", "{the_monster_1}说：“门都上哪儿去了？”", "the_monster_1:name"},
    {"speech.monspeak.f20708b8541cf144", "{the_monster_1} relaxes {possessive_1} fighting stance and smiles at you.", "{the_monster_1}放松了{possessive_1}战斗姿态，冲你微笑。", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.f21ad9670bf2a8ab", "{the_monster_1} says, \"The road you walk has only one end and you would not wish it even upon your enemies.\"", "{the_monster_1}说：“你走的这条路只有一个终点，而这结局你连敌人都不忍心看到。”", "the_monster_1:name"},
    {"speech.monspeak.f231ed96d9b12074", "{the_monster_1} screams {at_foe_1}, \"I'm going to kill you! Now!\"", "{the_monster_1}尖叫 {at_foe_1}：“我要杀了你！就现在！”", "the_monster_1:name;at_foe_1:text"},
