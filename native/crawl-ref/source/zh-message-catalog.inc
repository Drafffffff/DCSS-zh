    {"speech.monspeak.13929a5cf8adb4ea", "{channel_1}{the_monster_1} sticks a finger up {possessive_1} nose.", "{channel_1}{the_monster_1}把一根手指伸进{possessive_1}鼻孔。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.13b58262430dfe9b", "wrapper", "包装纸", ""},
    {"speech.monspeak.13e92cc19c720c47", "{the_monster_1} says, \"There are too many gods demanding my worship. I hate that.\"", "{the_monster_1}说：“要我去拜的神太多了。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.13eb74cafe6d4a26", "{the_monster_1} says, \"Did you remember that thing that you forgot\? I hate that.\"", "{the_monster_1}说：“你想起你忘掉的那件事了吗？我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.140a74ee33df711b", "{the_monster_1} says, \"How can I live after this\?\"", "{the_monster_1}说：“出了这种事，我还有什么脸活下去？”", "the_monster_1:name"},
