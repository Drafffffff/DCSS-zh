    {"speech.monspeak.026c5fb529288b2c", "{the_monster_1} shouts {at_foe_1}, \"Death awaits you!\"", "{the_monster_1}喊道 {at_foe_1}：“死亡在等着你！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.029d66cd75a3fdf5", "{the_monster_1} says, \"They said they'd gotten someone better!\"", "{the_monster_1}说：“他们说自己找到了更好的人选！”", "the_monster_1:name"},
    {"speech.monspeak.02c832b0a22ffeed", "{the_monster_1} says {to_foe_1}, \"Breathe deeply.\"", "{the_monster_1}说 {to_foe_1}：“深呼吸。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.02f0bada43582396", "{the_monster_1} screams, \"Science deserve better than this!\"", "{the_monster_1}尖叫道：“科学不该受这种罪！”", "the_monster_1:name"},
    {"speech.monspeak.02f963d2eec20650", "{the_monster_1} says {to_foe_1}, \"I can no longer spread life, but I can still bring your death!\"", "{the_monster_1}说 {to_foe_1}：“我已无法散播生命，但我仍能带来你的死亡！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.02fe687558cb1b5f", "{the_monster_1} says, \"What is divine providence, anyway\? I hate that.\"", "{the_monster_1}说：“‘神意’到底是个什么？我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.0316f77d6ee99bdd", "{the_monster_1} says {to_foe_1}, \"Taste sacred energy, fool.\"", "{the_monster_1}说 {to_foe_1}：“尝尝神圣之力吧，蠢货。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.03324b2de9ac86b8", "{the_monster_1} boasts, \"I have defeated monsters you have never seen.\"", "{the_monster_1}吹嘘道：“我打败过你见都没见过的怪物。”", "the_monster_1:name"},
    {"speech.monspeak.03361a72fb2009a7", "{the_monster_1} says, \"There's no good or evil. Just power and will.\"", "{the_monster_1}说：“无所谓善恶。只有力量和意志。”", "the_monster_1:name"},
    {"speech.monspeak.03367304d19f2ecd", "{the_monster_1} says, \"Hold still for a moment, will you\? I've got a trick shot I want to try here.\"", "{the_monster_1}说：“你就站着别动一会儿，好吗？我这儿有一记花式箭法想试试。”", "the_monster_1:name"},
    {"speech.monspeak.0340966e563e5c35", "{the_monster_1} screams {at_foe_1}, \"Don't stand in way of progress!\"", "{the_monster_1}尖叫 {at_foe_1}：“别挡着进步的路！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.03551a9d02b02cd1", "{the_monster_1} says, \"Don't tell anyone, but I think Ereshkigal likes me.\"", "{the_monster_1}说：“别告诉别人，但我觉得埃列什基伽勒喜欢我。”", "the_monster_1:name"},
    {"speech.monspeak.0362bf979760d336", "{channel_1}{the_monster_1} grins evilly.", "{channel_1}{the_monster_1}邪恶地咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.036712f7bee9067c", "{channel_1}{the_monster_1} shines with the incandescence of long-dead nights.", "{channel_1}{the_monster_1}闪耀着早已死去的夜晚的光辉。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.03699fb1df634cac", "{the_monster_1} bellows, \"My home has fourteen doors!\"", "{the_monster_1}吼道：“我的家有十四道门！”", "the_monster_1:name"},
    {"speech.monspeak.036aa95b90cdc10a", "{channel_1}{the_monster_1} is momentarily overtaken with rage!", "{channel_1}{the_monster_1}一时被怒火吞噬！", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.037aec712c9bb408", "{the_monster_1} says, \"What's that horrible smell\? It's like... yuck.\"", "{the_monster_1}说：“那股恶心味是什么？就像是……呃。”", "the_monster_1:name"},
    {"speech.monspeak.0381027e94cc2fce", "{the_monster_1} says {to_foe_1}, \"My silk is a match for both steel and spell.\"", "{the_monster_1}说 {to_foe_1}：“我的蛛丝既敌得过钢铁，也敌得过法术。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.03e23e3d00bde1e7", "{channel_1}{the_monster_1} gazes at {foe_1} {choice_1}.", "{channel_1}{the_monster_1}{choice_1}凝视着{foe_1}。", "channel_1:key;the_monster_1:name;foe_1:text;choice_1:text"},
    {"speech.monspeak.03e23e3d00bde1e7.choice_1.alt_0", "hypnotically", "催眠般地", ""},
    {"speech.monspeak.03e23e3d00bde1e7.choice_1.alt_1", "seductively", "魅惑地", ""},
    {"speech.monspeak.0402a0c16446355d", "{channel_1}{the_monster_1} lashes {possessive_1} tail.", "{channel_1}{the_monster_1}甩动着{possessive_1}尾巴。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.04197507f373a830", "{the_monster_1} screams {at_foe_1}, \"You must be punished!\"", "{the_monster_1}尖叫 {at_foe_1}：“你必须受到惩罚！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.041a4c578ebf99e0", "{frances_rare_1}", "{frances_rare_1}", "frances_rare_1:text"},
    {"speech.monspeak.043ca34287132121", "{the_monster_1} says, \"I hate blood.\"", "{the_monster_1}说：“我讨厌血。”", "the_monster_1:name"},
    {"speech.monspeak.0447d8d2b91eec11", "fishing", "钓鱼", ""},
    {"speech.monspeak.046d1864f8ac76fd", "{demon_taunt_1}", "{demon_taunt_1}", "demon_taunt_1:text"},
    {"speech.monspeak.046fd13bdb1069ea", "{the_monster_1} threatens, \"I'm fresh out of hellfire, but you will end anyway.\"", "{the_monster_1}威胁道：“我的地狱火用完了，但你还是会完蛋。”", "the_monster_1:name"},
    {"speech.monspeak.04a2384af360cdef", "{the_monster_1} warns, \"If you see one of my golems, approach with caution, they bite.\"", "{the_monster_1}警告道：“要是你看到我的魔像，靠近时可要小心，它们会咬人。”", "the_monster_1:name"},
    {"speech.monspeak.04c30a448607e780", "{the_monster_1} says, \"Now I can live to fight another day.\"", "{the_monster_1}说：“现在我又能活下去，改日再战了。”", "the_monster_1:name"},
    {"speech.monspeak.04dc728607ed4ed2", "{channel_1}{the_monster_1} flutters as if in a wind.", "{channel_1}{the_monster_1}像被风吹动般飘动着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.04e6e852721360b3", "{the_monster_1} pines for {possessive_1} lost husband.", "{the_monster_1}为{possessive_1}亡夫/亡妻而黯然神伤。", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.04e965949a13d416", "{the_monster_1} shouts {at_foe_1}, \"Return immediately or I'll kill you!\"", "{the_monster_1}喊道 {at_foe_1}：“马上回去，否则我就杀了你！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.051356610a10eb24", "{the_monster_1} says, \"For every monster you don't kill, I'll kill three.\"", "{the_monster_1}说：“你每少杀一个怪物，我就多杀三个。”", "the_monster_1:name"},
    {"speech.monspeak.052b8f31e5e62b3e", "{the_monster_1} smirks. \"I shall give thine eyesight a greater riddle by far.\"", "{the_monster_1}得意地一笑。“我要给你的眼力出一道难得多的大谜题。”", "the_monster_1:name"},
    {"speech.monspeak.0556ff1c9912a67f", "{the_monster_1} says, \"Strength rules this world!\"", "{the_monster_1}说：“力量统治这个世界！”", "the_monster_1:name"},
    {"speech.monspeak.055a2ea22cf25480", "{the_monster_1} shouts, \"Patent thief! You won\\'t get away with this!\"", "{the_monster_1}喊道：“专利小偷！你别想就这么算了！”", "the_monster_1:name"},
    {"speech.monspeak.058854d3e97eaa59", "{the_monster_1} laughs insanely.", "{the_monster_1}疯狂地大笑。", "the_monster_1:name"},
    {"speech.monspeak.05a2c9c456266072", "{channel_1}{the_monster_1} shakes in a combination of rage and grief.", "{channel_1}{the_monster_1}在狂怒与悲痛中颤抖着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.05b233a6f8431add", "{the_monster_1} howls in rage.", "{the_monster_1}愤怒地嚎叫。", "the_monster_1:name"},
    {"speech.monspeak.05e9189e3834eb14", "{the_monster_1} says {to_foe_1}, \"Need some antivenom\? Don't worry, you can trust me.\"", "{the_monster_1}说 {to_foe_1}：“需要点抗毒血清吗？别担心，你可以相信我。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.060ba5f11d637201", "{the_monster_1} says, \"You'll make a fine lemure.\" {player_only_1}", "{the_monster_1}说：“你会成为一个不错的劣魔。” {player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.06119437dc65343b", "{the_monster_1} {says_or_shouts_1}, \"Orcs will kill them all!\"", "{the_monster_1}{says_or_shouts_1}：“兽人会把它们杀得一个不剩！”", "the_monster_1:name;says_or_shouts_1:text"},
    {"speech.monspeak.061ed26aada27e2a", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.0627077cf19b0731", "{the_monster_1} says, \"Kikubaa-what\? How do you even say that\?\"", "{the_monster_1}说：“奇库巴什么？这名字到底怎么念？”", "the_monster_1:name"},
    {"speech.monspeak.064d0177b950af13", "canine", "犬科的", ""},
    {"speech.monspeak.066ae23d1ef30e75", "{channel_1}{the_monster_1} looks very balanced.", "{channel_1}{the_monster_1}显得非常平和。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.0682fbb57b03e291", "{the_monster_1} says, \"What a barren place. A pity you won't get a chance to visit the Abyss!\"", "{the_monster_1}说：“多么荒芜的地方。可惜你没机会去深渊看看了！”", "the_monster_1:name"},
    {"speech.monspeak.068ba8186f1142d6", "{the_monster_1} says, \"I hate skeletons.\"", "{the_monster_1}说：“我讨厌骷髅。”", "the_monster_1:name"},
    {"speech.monspeak.0692ff6b8a304ea0", "{the_monster_1} says, \"It's good how you can learn magic as if by magic.\"", "{the_monster_1}说：“你能像变魔法一样学会魔法，这挺好的。”", "the_monster_1:name"},
    {"speech.monspeak.0695fa89fe125f46", "{the_monster_1} shouts, \"You saved me!\"", "{the_monster_1}喊道：“你救了我！”", "the_monster_1:name"},
    {"speech.monspeak.06c9c78fd96ae475", "{the_monster_1} says, \"Entranced by some poetic flight, are you\?\"", "{the_monster_1}说：“你被某段诗意的飞升迷住了，是吗？”", "the_monster_1:name"},
    {"speech.monspeak.06f88a91b0119f58", "{the_monster_1} says, \"Tell me all your secrets, or I'll kill you.\"", "{the_monster_1}说：“把你的秘密全都告诉我，不然我就杀了你。”", "the_monster_1:name"},
    {"speech.monspeak.07a77b754e31f960", "{the_monster_1} says {to_foe_1}, \"It is my duty to kill you, but also my pleasure.\"", "{the_monster_1}说 {to_foe_1}：“杀了你是我的职责，也是我的乐趣。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.07d8c5866ebbba7c", "{the_monster_1} croaks regally.", "{the_monster_1}威严地呱呱叫着。", "the_monster_1:name"},
    {"speech.monspeak.07dad82f24672a68", "{channel_1}{the_monster_1} looks lost in thought, consulting taken memories.", "{channel_1}{the_monster_1}若有所思，翻检着窃取来的记忆。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.07eed0f421476994", "{the_monster_1} says, \"If I give you twenty gold pieces, can you get rid of this nasty case of scales I've got\?\"", "{the_monster_1}说：“我给你二十枚金币，你能帮我弄掉这身讨厌的鳞片吗？”", "the_monster_1:name"},
    {"speech.monspeak.07fe89bfe71221fd", "{rainbow_colour_1}", "{rainbow_colour_1}", "rainbow_colour_1:text"},
    {"speech.monspeak.081778aed310a6e6", "Papa", "爸爸", ""},
    {"speech.monspeak.08186f11795a21e6", "{player_ghost_common_1}", "{player_ghost_common_1}", "player_ghost_common_1:text"},
    {"speech.monspeak.083904e958c9dbef", "{the_monster_1} screams {at_foe_1}, \"If I had legs, you would be dead twenty times over!\"", "{the_monster_1}尖叫道 {at_foe_1}：“我要是有腿，你早就死上二十回了！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.08454d3f88143415", "{friendly_imp_rare_1}", "{friendly_imp_rare_1}", "friendly_imp_rare_1:text"},
    {"speech.monspeak.0846a2fe59c15923", "{the_monster_1} calls on the powers of shadow!", "{the_monster_1}呼唤阴影之力！", "the_monster_1:name"},
    {"speech.monspeak.085864f0e28d7a49", "{generic_orc_speech_1}", "{generic_orc_speech_1}", "generic_orc_speech_1:text"},
    {"speech.monspeak.085f4dad41b0ef71", "says", "说", ""},
    {"speech.monspeak.086816cbd25aba0f", "{the_monster_1} thinks, and says {to_foe_1}, \"Perhaps I'll take up {harold_ret_hobby_1} after I'm done here...\"", "{the_monster_1}想了想，说 {to_foe_1}：“等我干完这票，也许我就去{harold_ret_hobby_1}了……”", "the_monster_1:name;to_foe_1:text;harold_ret_hobby_1:text"},
    {"speech.monspeak.08814542eb37d3d5", "{natasha_permanently_killed_1}", "{natasha_permanently_killed_1}", "natasha_permanently_killed_1:text"},
    {"speech.monspeak.0885f7e32b66815e", "{the_monster_1} says, \"What's the point of conjuring, anyway\?\"", "{the_monster_1}说：“塑能到底有什么意义？”", "the_monster_1:name"},
    {"speech.monspeak.089c627295253220", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.08b1bcee2eb1300e", "{the_monster_1} shouts {at_foe_1}, \"You can't withstand my power!\"", "{the_monster_1}喊道 {at_foe_1}：“你抵挡不住我的力量！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.08b492f1b8e1785d", "{the_monster_1} says, \"Are they setting up a circus down here\?\"", "{the_monster_1}说：“他们是在这底下搭马戏团吗？”", "the_monster_1:name"},
    {"speech.monspeak.08dca3dfc6c49549", "{the_monster_1} whispers to {reflexive_1}, \"Everyone I saved... Everyone I doomed...\"", "{the_monster_1}对{reflexive_1}低声说道：“我救过的每一个人……我害过的每一个人……”", "the_monster_1:name;reflexive_1:text"},
    {"speech.monspeak.08dd3c1ea733fc57", "{the_monster_1} rants about the fall of honour.", "{the_monster_1}痛斥荣誉的沦丧。", "the_monster_1:name"},
    {"speech.monspeak.08eda7573d69ed8f", "{the_monster_1} {wails_1}, \"Very impressive. But it won't help. Nothing will.\"", "{the_monster_1} {wails_1}：“很了不起。但这没有用。什么都救不了你。”", "the_monster_1:name;wails_1:text"},
    {"speech.monspeak.09082ae4a73550b1", "{yredelemnul_donald_1}", "{yredelemnul_donald_1}", "yredelemnul_donald_1:text"},
    {"speech.monspeak.091de479bf2bc8ee", "{parghit_common_1}", "{parghit_common_1}", "parghit_common_1:text"},
    {"speech.monspeak.094b01b25483e303", "{channel_1}{the_monster_1} spins like a top.", "{channel_1}{the_monster_1}像陀螺一样旋转。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.094d2574fa67c9da", "Focus", "专注", ""},
    {"speech.monspeak.0956f08ca59d2a82", "{the_monster_1} hisses {at_foe_1}, \"I bite!\"", "{the_monster_1}嘶声道 {at_foe_1}：“我咬人！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.098dfcd8d753b357", "{the_monster_1} booms, \"Everyone will worship Khufu but you!\"", "{the_monster_1}吼道：“所有人都会崇拜胡夫，除了你！”", "the_monster_1:name"},
    {"speech.monspeak.09922432da92d4c6", "{channel_1}{the_monster_1} seems overcome with grief.", "{channel_1}{the_monster_1}似乎悲痛欲绝。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.099e56d8183da8b1", "{channel_1}{the_monster_1} cocks {possessive_1} head sideways at you.", "{channel_1}{the_monster_1}歪着{possessive_1}脑袋看你。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.09cb10fe3f4df19d", "{the_monster_1} draws the Dance. \"Hope the weapon's aim is true!\"", "{the_monster_1}抽到了舞蹈。“但愿那武器的准头够好！”", "the_monster_1:name"},
    {"speech.monspeak.09d7e546c930acbf", "{the_monster_1} {norris_verb_1} {to_foe_1}, \"Peace! I bring you eternal peace!\"", "{the_monster_1}{norris_verb_1} {to_foe_1}：“和平！我为你带来永恒的和平！”", "the_monster_1:name;norris_verb_1:text;to_foe_1:text"},
    {"speech.monspeak.09d936f9afceb4c1", "{channel_1}{the_monster_1} opens {possessive_1} mouth, as if shouting.", "{channel_1}{the_monster_1}张开{possessive_1}嘴，仿佛要大喊。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.09dd75746a1e2691", "Unholy", "邪恶", ""},
    {"speech.monspeak.09e95a3768da7993", "{the_monster_1} says, \"This place is pretty cryptic.\"", "{the_monster_1}说：“这地方挺墓里墓气的。”", "the_monster_1:name"},
    {"speech.monspeak.09ec4f3616f4934a", "disruption", "动荡", ""},
    {"speech.monspeak.09eec075e7f5dc63", "{the_monster_1} says, \"I will find a way to undo this!\"", "{the_monster_1}说：“我会找到办法逆转这一切！”", "the_monster_1:name"},
    {"speech.monspeak.09ef1952532351d8", "{the_monster_1} says {to_foe_1}, \"At least I didn't end up somewhere with nobody to talk to.\"", "{the_monster_1}说 {to_foe_1}：“至少我没落到一个连说话的人都没有的地方。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.0a08094ff49dd5f3", "{the_monster_1} hisses menacingly.", "{the_monster_1}威胁地发出嘶嘶声。", "the_monster_1:name"},
    {"speech.monspeak.0a2cf02e99d77a18", "{the_monster_1} says {to_foe_1}, \"There's nothing like you and me, on the beach...\"", "{the_monster_1}说 {to_foe_1}：“在海滩上，没有什么比得上你和我……”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.0a388f1ac2800069", "lumber", "木料", ""},
    {"speech.monspeak.0a3f45a00b6e541a", "{the_monster_1} says, \"I saw some gold over there. Quick, better go get it!\"", "{the_monster_1}说：“我刚才看见那边有金子。快，赶紧去捡！”", "the_monster_1:name"},
    {"speech.monspeak.0a4b5aab393876cc", "{the_monster_1} says, \"Maybe I'll buy a title. How does Count Edmund sound\?\"", "{the_monster_1}说：“也许我该买个头衔。‘埃德蒙伯爵’听起来怎么样？”", "the_monster_1:name"},
    {"speech.monspeak.0a4d15550b6a0906", "{channel_1}{the_monster_1} smiles, but it's obviously fake.", "{channel_1}{the_monster_1}微笑着，但一看就是装的。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.0a72ba53eafd8062", "{the_monster_1} says, \"Isn't this more fun with friends\?\"", "{the_monster_1}说：“有朋友一起不是更好玩吗？”", "the_monster_1:name"},
    {"speech.monspeak.0a7ca4948a761fc0", "{the_monster_1} says, \"I hate demons.\"", "{the_monster_1}说：“我讨厌恶魔。”", "the_monster_1:name"},
    {"speech.monspeak.0a8ed62a7d59e8ee", "{the_monster_1} says, \"DUCK!\"", "{the_monster_1}说：“蹲下！”", "the_monster_1:name"},
    {"speech.monspeak.0a909aa1d51d0e4a", "hums", "哼唱着", ""},
    {"speech.monspeak.0ac8c1f8d6685a14", "{the_monster_1} says, \"I could take you in a fair duel. No cheating!\"", "{the_monster_1}说：“公平决斗的话我能赢你。不许耍赖！”", "the_monster_1:name"},
    {"speech.monspeak.0adc6093e3ee4d34", "{the_monster_1} {orc_says_to_foe_1}, \"Beogh will surely punish you for your arrogance!\"", "{the_monster_1}{orc_says_to_foe_1}：“比欧弗一定会惩罚你的傲慢！”", "the_monster_1:name;orc_says_to_foe_1:text"},
    {"speech.monspeak.0af0ff4dcb3888bf", "{the_monster_1} says, \"Watching you spin around is making me dizzy. I hate that.\"", "{the_monster_1}说：“看你转来转去，我都晕了。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.0afef56a9999c045", "{the_monster_1} {shouts_1} {to_foe_1}, \"You can run, but you cannot escape us forever!\" {player_only_1}", "{the_monster_1} {shouts_1} {to_foe_1}：“你可以逃，但你不可能永远躲开我们！”{player_only_1}", "the_monster_1:name;shouts_1:text;to_foe_1:text;player_only_1:text"},
    {"speech.monspeak.0b034abda455def8", "{the_monster_1} says, \"Am I talking too fast for you\?\"", "{the_monster_1}说：“我说话是不是太快了？”", "the_monster_1:name"},
    {"speech.monspeak.0b05499a86c82d86", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.0b494f1c19ebbded", "{the_monster_1} {says_or_shouts_1}, \"Beogh is great, and so is {player_name_1}!\"", "{the_monster_1}{says_or_shouts_1}：“比欧弗伟大，{player_name_1}也一样伟大！”", "the_monster_1:name;says_or_shouts_1:text;player_name_1:name"},
    {"speech.monspeak.0b51a71d508d4f90", "{the_monster_1} {wails_1}, \"There is no future for me!\"", "{the_monster_1} {wails_1}：“我没有未来！”", "the_monster_1:name;wails_1:text"},
    {"speech.monspeak.0b7a2e538abce2ff", "{the_monster_1} says, \"How does that torch stay lit when you throw its fire all over\?\"", "{the_monster_1}说：“你把火把的火到处乱扔，它怎么还亮着？”", "the_monster_1:name"},
    {"speech.monspeak.0b880a5caec83fab", "{dowan_common_1}", "{dowan_common_1}", "dowan_common_1:text"},
    {"speech.monspeak.0b9667d4950451ab", "{the_monster_1} lets out a mournful croak.", "{the_monster_1}发出一声哀伤的呱呱叫。", "the_monster_1:name"},
    {"speech.monspeak.0ba0775fb60b5648", "{channel_1}{the_monster_1} looks around cautiously.", "{channel_1}{the_monster_1}警惕地四下张望。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.0ba3a810e04d90ba", "{the_monster_1} says, \"What does 'eldritch' mean, anyway\?\"", "{the_monster_1}说：“‘诡异’到底是什么意思？”", "the_monster_1:name"},
    {"speech.monspeak.0bc12c6da5735f05", "{the_monster_1} says, \"I'm sure the Orcish Mines are around here somewhere...\"", "{the_monster_1}说：“我敢肯定兽人矿井就在这附近的什么地方……”", "the_monster_1:name"},
    {"speech.monspeak.0bf7d55bd37b20d9", "{the_monster_1} says {to_foe_1}, \"I am all your nightmares come true.\"", "{the_monster_1}说 {to_foe_1}：“我是你所有噩梦成真的样子。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.0c00a398b92b6cb9", "{the_monster_1} screams {at_foe_1}, \"I've slain countless dragons!\"", "{the_monster_1}尖叫 {at_foe_1}：“我杀过的龙数都数不清！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.0c21788f2d5b5f67", "{channel_1}{the_monster_1} jiggles.", "{channel_1}{the_monster_1}颤动着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.0c32affd68c7f7a6", "{the_monster_1} says {to_foe_1}, \"Fancy a snooze\?\"", "{the_monster_1}说 {to_foe_1}：“想小睡一会儿吗？”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.0c3440936ebe18b6", "{channel_1}{the_monster_1} sheds a single tear.", "{channel_1}{the_monster_1}落下一滴眼泪。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.0c51f73a4553384c", "{vashnia_rare_1}", "{vashnia_rare_1}", "vashnia_rare_1:text"},
    {"speech.monspeak.0ca1a7fd8281fbf9", "mouse", "老鼠", ""},
    {"speech.monspeak.0cc22c389003ffe6", "{the_monster_1} says, \"I was once a great warrior, and I still am!\"", "{the_monster_1}说：“我曾是一名伟大的战士，现在依然是！”", "the_monster_1:name"},
    {"speech.monspeak.0cee6bb743180041", "{the_monster_1} {begs_1} {to_foe_1}, \"Please don't kill me!\"", "{the_monster_1} {begs_1} {to_foe_1}：“请不要杀我！”", "the_monster_1:name;begs_1:text;to_foe_1:text"},
    {"speech.monspeak.0d0ebbe0445ae2d6", "{the_monster_1} looks {at_foe_1} in disgust and {grum_verb_1}, \"You ain't no friend of mine.\"", "{the_monster_1}厌恶地看着 {at_foe_1}，{grum_verb_1}：“你可不是我的朋友。”", "the_monster_1:name;at_foe_1:text;grum_verb_1:text"},
    {"speech.monspeak.0d1e7a26e86d0746", "{tormentor_1}", "{tormentor_1}", "tormentor_1:text"},
    {"speech.monspeak.0d29ebab2b6a0df4", "{the_monster_1} says {to_foe_1}, \"Ye cannae match dwarven artillery.\"", "{the_monster_1}说 {to_foe_1}：“你可比不过矮人的火炮。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.0d4336b597419695", "{the_monster_1} says {to_foe_1}, \"You child of a motherless goat.\"", "{the_monster_1}说 {to_foe_1}：“你这没娘的山羊崽子。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.0d4c22f836afa6bf", "{channel_1}{the_monster_1} flies around in tight circles.", "{channel_1}{the_monster_1}绕着紧小的圈子飞。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.0d736f9970aa3e79", "{the_monster_1} says, \"The Vaults\? They should've called it the Dumps.\"", "{the_monster_1}说：“宝库？他们该管它叫垃圾场。”", "the_monster_1:name"},
    {"speech.monspeak.0d8e01ce5bf2e302", "{the_monster_1} ululates chillingly with {possessive_1} many mouths.", "{the_monster_1}用{possessive_1}众多嘴巴发出令人毛骨悚然的嚎叫。", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.0dad423e18b8fd76", "{the_monster_1} {grum_verb_1} {at_foe_1}, \"I'll squash you like a puppy.\"", "{the_monster_1} {grum_verb_1} {at_foe_1}：“我要像捏死只小狗一样捏扁你。”", "the_monster_1:name;grum_verb_1:text;at_foe_1:text"},
    {"speech.monspeak.0daf79ea1c58a639", "unthinkable", "难以想象", ""},
    {"speech.monspeak.0dba3842b652cc1e", "{channel_1}{the_monster_1} does some quick breathing exercises.", "{channel_1}{the_monster_1}快速做了几下呼吸练习。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.0dc28b1ca1cb9dfc", "{the_monster_1} yells {at_foe_1}, \"Perjured traitor, DIE!\"", "{the_monster_1}大喊 {at_foe_1}：“作伪证的叛徒，死吧！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.0dc8369632b3d843", "{pikel_common_1}", "{pikel_common_1}", "pikel_common_1:text"},
    {"speech.monspeak.0dd00c7269586fbf", "{the_monster_1} says, \"Do you like gardening\? I hate gardening.\"", "{the_monster_1}说：“你喜欢园艺吗？我讨厌园艺。”", "the_monster_1:name"},
    {"speech.monspeak.0ddc779e23eddcd2", "{azrael_rare_1}", "{azrael_rare_1}", "azrael_rare_1:text"},
    {"speech.monspeak.0de4c79491c421c7", "{the_monster_1} says, \"What's the big idea\?!\"", "{the_monster_1}说：“你这是什么意思？！”", "the_monster_1:name"},
    {"speech.monspeak.0e0e74d11253248e", "{the_monster_1} says, \"What sort of name is 'necrophage', anyway\?\"", "{the_monster_1}说：“‘食尸者’这算哪门子名字？”", "the_monster_1:name"},
    {"speech.monspeak.0e1815850d2bbea4", "{the_monster_1} screams {at_foe_1}, \"You are already dead.\"", "{the_monster_1}尖叫道 {at_foe_1}：“你已经死了。”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.0e2056b650d5f267", "{the_monster_1} screams {at_foe_1}, \"Get out, before I make you get out!\"", "{the_monster_1}尖叫道 {at_foe_1}：“滚出去，别逼我动手赶你出去！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.0e3ce1a253a914e5", "{the_monster_1} mutters to {reflexive_1}, \"Master Lance won't take me back. This is the way forward.\"", "{the_monster_1}对{reflexive_1}喃喃道：“兰斯师父不会再收留我了。前进才是出路。”", "the_monster_1:name;reflexive_1:text"},
    {"speech.monspeak.0e4476baae350262", "{the_monster_1} despairs {at_foe_1}, \"False prophets abound here!\"", "{the_monster_1}绝望地喊道 {at_foe_1}：“这里到处都是假先知！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.0e6c87d38580bd9b", "{generic_orc_speech_1}", "{generic_orc_speech_1}", "generic_orc_speech_1:text"},
    {"speech.monspeak.0e70a4e73f97d375", "{the_monster_1} says, \"What's up with all this goo\? It's like a world of goo. I hate goo.\"", "{the_monster_1}说：“这么多黏糊糊的东西是怎么回事？就像一个黏液世界。我讨厌黏液。”", "the_monster_1:name"},
    {"speech.monspeak.0e840fe64e8dfe2e", "{channel_1}{the_monster_1} frantically looks around.", "{channel_1}{the_monster_1}发狂似地环顾四周。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.0ebbaa60e76bce1a", "{the_monster_1} grins. \"So many cards! Brought to you by {my_god_1}!\"", "{the_monster_1}咧嘴一笑。“好多牌啊！由{my_god_1}赞助！”", "the_monster_1:name;my_god_1:name"},
    {"speech.monspeak.0ec647055b531df5", "pontify", "说教", ""},
    {"speech.monspeak.0ed1028f8ceb47c9", "{channel_1}{the_monster_1} winces.", "{channel_1}{the_monster_1}皱起眉头。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.0eda00273284779b", "{channel_1}{the_monster_1} runs in silly circles!", "{channel_1}{the_monster_1}傻乎乎地转着圈跑！", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.0edc465a75a0cfa5", "{the_monster_1} says, \"I hate trees. I hate swamp water. I hate this place.\"", "{the_monster_1}说：“我讨厌树。我讨厌沼泽水。我讨厌这个地方。”", "the_monster_1:name"},
    {"speech.monspeak.0edc4a96be50511c", "{the_monster_1} sings praise to Elyvilon.", "{the_monster_1}歌颂艾利维隆。", "the_monster_1:name"},
    {"speech.monspeak.0ef574ad2282cc15", "{blorkula_common_1}", "{blorkula_common_1}", "blorkula_common_1:text"},
    {"speech.monspeak.0f4f9ac79c081869", "{the_monster_1} says, \"I'll split you in two!\"", "{the_monster_1}说：“我要把你劈成两半！”", "the_monster_1:name"},
    {"speech.monspeak.0f634c13ba97c9a3", "{the_monster_1} shouts, \"Over here! I found it!\"", "{the_monster_1}喊道：“在这儿！我找到了！”", "the_monster_1:name"},
    {"speech.monspeak.0f6699e1fec1eb7c", "{the_monster_1} screams, \"No, no!\" before exploding into a cloud of blood!", "{the_monster_1}尖叫着“不，不！”，随即炸成了一团血雾！", "the_monster_1:name"},
    {"speech.monspeak.0f84f9acc3e09956", "fishing boat", "钓鱼船", ""},
    {"speech.monspeak.0f864bf8d6c08ca3", "{the_monster_1} snarls {at_foe_1}, \"Go! Away!\"", "{the_monster_1}咆哮道 {at_foe_1}：“走！走开！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.0f8b9abdbc5f7ad8", "{the_monster_1} says, \"My legs! My legs! What happened to my legs\?\"", "{the_monster_1}说：“我的腿！我的腿！我的腿怎么了？”", "the_monster_1:name"},
    {"speech.monspeak.0f94b496a29889d9", "{channel_1}{the_monster_1} revs up and whimsically whirls.", "{channel_1}{the_monster_1}加速运转，古怪地旋转着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.0f9621709a3dedda", "{the_monster_1} says, \"Look what I've done to myself! Think you can do worse\?\"", "{the_monster_1}说：“看看我把自己变成了什么样！你觉得你能做得更狠吗？”", "the_monster_1:name"},
    {"speech.monspeak.0fb6b90f0362b1ca", "{the_monster_1} lunges for your pockets and trips.", "{the_monster_1}朝你的口袋扑去，却绊了一跤。", "the_monster_1:name"},
    {"speech.monspeak.0fc75e592c419ca3", "{channel_1}{the_monster_1} gurgles, unable to form words.", "{channel_1}{the_monster_1}发出咯咯声，说不出话来。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.0fe334d4b3bf971c", "{the_monster_1} screams {at_foe_1}, \"Me yet to meet anyone who can outsmart wand!\"", "{the_monster_1}尖叫 {at_foe_1}：“俺还没见过谁能斗得过俺的法杖！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.0ff1ed2666b35d11", "yells", "大喊道", ""},
    {"speech.monspeak.101551b41e6166cb", "{the_monster_1} says, \"All clear. Let's check for more.\"", "{the_monster_1}说：“一切安全。再查查还有没有别的。”", "the_monster_1:name"},
    {"speech.monspeak.102580eef12dec08", "{channel_1}{the_monster_1} flickers in and out of reality.", "{channel_1}{the_monster_1}的身影在现实中忽明忽灭。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.10283382f28ffb75", "{the_monster_1} {norris_verb_1} {to_foe_1}, \"Why delay the inevitable\?\"", "{the_monster_1}{norris_verb_1} {to_foe_1}：“何必拖延这不可避免之事？”", "the_monster_1:name;norris_verb_1:text;to_foe_1:text"},
    {"speech.monspeak.10491d102f2575b7", "{the_monster_1} gasps with {possessive_1} dying breath, \"I... tried to warn you...\"", "{the_monster_1}用{possessive_1}最后一口气喘息道：“我……试着警告过你……”", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.1049c1f21f24a414", "{natasha_rare_1}", "{natasha_rare_1}", "natasha_rare_1:text"},
    {"speech.monspeak.104fab3bf32d8b13", "{the_monster_1} says, \"I saw some yaktaurs earlier, but I bolted.\"", "{the_monster_1}说：“我刚才看到几只牦牛人，不过我撒腿就跑了。”", "the_monster_1:name"},
    {"speech.monspeak.106507ab2ef9bd56", "{the_monster_1} says, \"Poetry of the foot\? All you're doing is stomping around.\"", "{the_monster_1}说：“脚的诗歌？你不就是在原地跺来跺去吗。”", "the_monster_1:name"},
    {"speech.monspeak.108b0a23944b5416", "{the_monster_1} says {to_foe_1}, \"You'll feel the lick of my whip!\"", "{the_monster_1}说 {to_foe_1}：“你会尝到我鞭子的滋味！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.108e4844e7fc0e9c", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.108e764ef90e30fa", "sow", "播种", ""},
    {"speech.monspeak.10932332063389c9", "Fluffy", "毛球", ""},
    {"speech.monspeak.1096475fbb72628e", "{the_monster_1} says {to_foe_1}, \"Time is money, and you're costing me too much!\"", "{the_monster_1}说 {to_foe_1}：“时间就是金钱，而你让我亏得太多！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.109df4d4d9ca65c9", "{the_monster_1} growls.", "{the_monster_1}低吼。", "the_monster_1:name"},
    {"speech.monspeak.10a419a5f8f0c64e", "{the_monster_1} shouts wrathfully, \"No!\"", "{the_monster_1}怒吼道：“不！”", "the_monster_1:name"},
    {"speech.monspeak.10ab85035a42cdfd", "{the_monster_1} says, \"You're really going to get a charge out of this one.\"", "{the_monster_1}说：“这一战准会让你充满电。”", "the_monster_1:name"},
    {"speech.monspeak.10b027508817a05c", "{the_monster_1} cheerfully says, \"No dog meat for Grum tonight!\"", "{the_monster_1}兴高采烈地说：“今晚格鲁姆没有狗肉吃了！”", "the_monster_1:name"},
    {"speech.monspeak.10b70cfea29af38b", "You hear a faint echoing roar filled with hate and sorrow!", "你听到一声微弱的、回荡着的咆哮，充满了仇恨与悲伤！", ""},
    {"speech.monspeak.10c62229bb19d9aa", "{the_monster_1} says {to_foe_1}, \"All sinners must die.\"", "{the_monster_1}说 {to_foe_1}：“所有的罪人都得死。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.10d2165fa48c3dd0", "{the_monster_1} says {to_foe_1}, \"I will deal out your death!\"", "{the_monster_1}说 {to_foe_1}：“我来给你发一手死亡的牌！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.10f7f55cd53b9235", "{the_monster_1} says {to_foe_1}, \"You would make a fine zombie.\"", "{the_monster_1}说 {to_foe_1}：“你会成为一个不错的丧尸。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.10fabdb64a4802b5", "{the_monster_1} says, \"How come everyone is wearing a cloak down here\?\"", "{the_monster_1}说：“为什么这底下人人都披着斗篷？”", "the_monster_1:name"},
    {"speech.monspeak.10fcbdedf39a359b", "{channel_1}{the_monster_1} tries to recover {possessive_1} lost courage.", "{channel_1}{the_monster_1}试图重拾{possessive_1}失去的勇气。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.1107bd218a1320b0", "{the_monster_1} shudders. \"I think my head was attached to my elbow for a minute there...\"", "{the_monster_1}打了个寒战。“刚才有那么一分钟，我的脑袋好像长在手肘上……”", "the_monster_1:name"},
    {"speech.monspeak.110d81ec7ebfd772", "{the_monster_1} says, \"You think walking on water is cool\? I can swim.\"", "{the_monster_1}说：“你觉得在水上行走很酷？我会游泳。”", "the_monster_1:name"},
    {"speech.monspeak.1110600d60aa4351", "{the_monster_1} says, \"People accused me of being a cutpurse!\"", "{the_monster_1}说：“有人指控我是扒手！”", "the_monster_1:name"},
    {"speech.monspeak.113c24cc2f41b38d", "{the_monster_1} says, \"Can I borrow that {choice_1} for a second\? You must have some to spare.\"", "{the_monster_1}说：“那个{choice_1}能借我用一下吗？你肯定有多余的。”", "the_monster_1:name;choice_1:text"},
    {"speech.monspeak.113c24cc2f41b38d.choice_1.alt_0", "wand", "魔杖", ""},
    {"speech.monspeak.113c24cc2f41b38d.choice_1.alt_1", "lamp", "灯", ""},
    {"speech.monspeak.113c24cc2f41b38d.choice_1.alt_2", "fan", "扇子", ""},
    {"speech.monspeak.1156f13d3d427fe9", "{the_monster_1} says, \"I hate hidden layers of reality.\"", "{the_monster_1}说：“我讨厌现实的隐藏层面。”", "the_monster_1:name"},
    {"speech.monspeak.1159e9c8dc54beea", "{the_monster_1} {weeps_1} over the unstoppable march of time and entropy.", "{the_monster_1}为时间与熵不可阻挡的行进{weeps_1}。", "the_monster_1:name;weeps_1:text"},
    {"speech.monspeak.115d008f26801fec", "{the_monster_1} says, \"Hell isn't that bad.\"", "{the_monster_1}说：“地狱也没那么糟。”", "the_monster_1:name"},
    {"speech.monspeak.11669c334e1e1bf9", "{the_monster_1} says, \"I used to walk on water. Now I just fly over it.\"", "{the_monster_1}说：“我以前能在水面上行走。现在我不过是从水面上飞过。”", "the_monster_1:name"},
    {"speech.monspeak.116ad1bd25647177", "{channel_1}{the_monster_1} says something but you don't hear anything.", "{channel_1}{the_monster_1}说了些什么，但你什么也没听到。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.1171c58a21ee1747", "{the_monster_1} roars {at_foe_1}, \"COMING HERE WAS YOUR LAST MISTAKE!\"", "{the_monster_1}咆哮道 {at_foe_1}：“来这里是你犯下的最后一个错误！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.117a428fc46420e4", "{the_monster_1} rasps, \"Tell us... who... we are....\"", "{the_monster_1}嘶哑地说：“告诉我们……我们……是谁……”", "the_monster_1:name"},
    {"speech.monspeak.11895a14772227d4", "{the_monster_1} {norris_verb_1} {to_foe_1}, \"Life is just suffering. I'll help you.\"", "{the_monster_1}{norris_verb_1} {to_foe_1}：“生命不过是苦难。我会帮你解脱。”", "the_monster_1:name;norris_verb_1:text;to_foe_1:text"},
    {"speech.monspeak.1197fd4f1000268b", "{the_monster_1} shouts, \"Who\\'s been selling my blueprints\? Tell me!\"", "{the_monster_1}喊道：“是谁在卖我的图纸？告诉我！”", "the_monster_1:name"},
    {"speech.monspeak.11a9c2a730f5dfaf", "{the_monster_1} says, \"The more heads they grow, the more I hate hydras.\"", "{the_monster_1}说：“九头蛇的头长得越多，我就越讨厌它们。”", "the_monster_1:name"},
    {"speech.monspeak.11b4d5d9dfa87556", "{the_monster_1} says {to_foe_1}, \"No trespassing is allowed here.\"", "{the_monster_1}说 {to_foe_1}：“这里禁止擅闯。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.11bd423cb3595053", "stair", "楼梯", ""},
    {"speech.monspeak.11d721e84ca6e313", "{channel_1}{the_monster_possessive_1} flesh secretes a thick mucus.", "{channel_1}{the_monster_possessive_1}血肉分泌出黏稠的黏液。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.11e2fd4404181131", "{the_monster_1} gripes about being made of rot and starlight.", "{the_monster_1}抱怨着自己是由腐肉和星光构成的。", "the_monster_1:name"},
    {"speech.monspeak.11fe6c6559fff455", "{the_monster_1} looks {at_foe_1} and says, \"I'd rather not die in your service, {player_name_1}.\"", "{the_monster_1}看着 {at_foe_1}说：“我宁愿不要为效忠你而死，{player_name_1}。”", "the_monster_1:name;at_foe_1:text;player_name_1:name"},
    {"speech.monspeak.121faa22c67dd2ec", "heathen", "异教徒", ""},
    {"speech.monspeak.1220478de17cc2b1", "{the_monster_1} lets out a long, sad whine.", "{the_monster_1}发出一声长长的、凄凉的哀鸣。", "the_monster_1:name"},
    {"speech.monspeak.12573904723aeccd", "{the_monster_1} says {to_foe_1}, \"Slay the {foe_genus_1} at once!\" {player_only_1}", "{the_monster_1}说 {to_foe_1}：“立刻杀了这个{foe_genus_1}！” {player_only_1}", "the_monster_1:name;to_foe_1:text;foe_genus_1:name;player_only_1:text"},
    {"speech.monspeak.12636b79b0921f52", "{the_monster_1} shouts {at_foe_1}, \"You're disturbing me! I'll have to kill you!\"", "{the_monster_1}喊道 {at_foe_1}：“你打扰到我了！我只好杀了你！”", "the_monster_1:name;at_foe_1:text"},
