    {"speech.monspeak.131795265a33e47e", "millipede", "马陆", ""},
    {"speech.monspeak.131fb83685a77280", "{the_monster_1} {mutters_1}, \"Damn and blast!\"", "{the_monster_1} {mutters_1}：“该死！真倒霉！”", "the_monster_1:name;mutters_1:text"},
    {"speech.monspeak.132b651668b27e70", "{the_monster_1} says, \"I need a test subject for my new stingers. I volunteer you.\"", "{the_monster_1}说：“我的新刺针需要一个测试对象。我选你。”", "the_monster_1:name"},
