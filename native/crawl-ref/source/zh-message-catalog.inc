    {"speech.monspeak.5371f58addecab53", "{channel_1}{the_monster_1} suddenly sprouts two large horns!", "{channel_1}{the_monster_1}突然长出两只大角！", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.53b02f857e76a1ab", "the sky cracking open", "天空裂开了", ""},
