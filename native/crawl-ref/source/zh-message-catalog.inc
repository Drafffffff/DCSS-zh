    {"speech.monspeak.1c8fea93043db401", "{the_monster_1} points {possessive_1} finger {at_foe_1} and {grum_verb_1}, \"Attack!\"", "{the_monster_1}用{possessive_1}手指指着{at_foe_1}，{grum_verb_1}：“攻击！”", "the_monster_1:name;possessive_1:text;at_foe_1:text;grum_verb_1:text"},
    {"speech.monspeak.1c9d2ca894b50b05", "{the_monster_1} says, \"Don't you get lonely without a god\?\"", "{the_monster_1}说：“没有神，你不觉得孤单吗？”", "the_monster_1:name"},
    {"speech.monspeak.1ca7acafd22bcd65", "{the_monster_1} shouts {to_foe_1}, \"Off with your head!\"", "{the_monster_1}喊道 {to_foe_1}：“砍掉你的脑袋！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.1cbe7d5d01370ed4", "{the_monster_1} mumbles some strange prayers.", "{the_monster_1}咕哝着一些奇怪的祷文。", "the_monster_1:name"},
