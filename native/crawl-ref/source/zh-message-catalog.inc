    {"speech.monspeak.178e2e1cecc009ad.choice_1.alt_1", "bow", "不肯鞠躬", ""},
    {"speech.monspeak.17bffb06971d4164", "{the_monster_1} says {to_foe_1}, \"Get ready! Throes of agony await you.\"", "{the_monster_1}说 {to_foe_1}：“准备好吧！痛苦的挣扎等着你。”", "the_monster_1:name;to_foe_1:text"},
