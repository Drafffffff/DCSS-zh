    {"speech.monspeak.5fc2c83db4fd7412", "{grinder_rare_1}", "{grinder_rare_1}", "grinder_rare_1:text"},
    {"speech.monspeak.5fd71e5e39d5d38e", "{channel_1}{the_monster_1} is caught in a moment of prayer.", "{channel_1}{the_monster_1}陷入了片刻的祈祷。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.5fd88557b89f1743", "{vashnia_common_1}", "{vashnia_common_1}", "vashnia_common_1:text"},
    {"speech.monspeak.5fe51874b570ddba", "{the_monster_1} says {to_foe_1}, \"I've sent legions of armataurs to their deaths. With their elephants.\"", "{the_monster_1}说 {to_foe_1}：“我送成群的甲马去送死。连同他们的大象一起。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.5fee52e6a0c19547", "{the_monster_1} {norris_verb_1}, \"Wisdom is knowing when to give up.\"", "{the_monster_1}{norris_verb_1}：“智慧就是懂得何时该放手。”", "the_monster_1:name;norris_verb_1:text"},
    {"speech.monspeak.602c280ef27ddfe1", "{the_monster_1} says, \"Oh, I wondered where that burning smell was coming from.\"", "{the_monster_1}说：“哦，我还在想那股烧焦味是从哪来的。”", "the_monster_1:name"},
    {"speech.monspeak.60303c5add49ab03", "{the_monster_1} begins to weave its threads into a brightly glowing ball.", "{the_monster_1}开始把丝线编织成一个明亮发光的圆球。", "the_monster_1:name"},
    {"speech.monspeak.6031db47b8b21050", "heretic", "异端", ""},
    {"speech.monspeak.60684cc4e919f36a", "{the_monster_1} cries, \"You leg down broken song, no\?\"", "{the_monster_1}哭喊道：“你腿下断歌，不是吗？”", "the_monster_1:name"},
    {"speech.monspeak.608e8a67cb5b78ef", "{the_monster_1} says {to_foe_1}, \"Your skull will make great drinking cup.\"", "{the_monster_1}说 {to_foe_1}：“你的头骨会是个很棒的酒杯。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.60bd566ae2c41d46", "{the_monster_1} says, \"This place probably doesn't see many tourists.\"", "{the_monster_1}说：“这地方大概没多少游客来。”", "the_monster_1:name"},
    {"speech.monspeak.60c1871b23d63f9a", "{the_monster_1} screams, \"They call me mad!\"", "{the_monster_1}尖叫道：“他们都说俺疯了！”", "the_monster_1:name"},
    {"speech.monspeak.60cb7ae511232387", "{the_monster_1} asks, \"Where am I\?\"", "{the_monster_1}问：“我在哪儿？”", "the_monster_1:name"},
    {"speech.monspeak.60cd92f3085824d8", "Mama", "妈妈", ""},
    {"speech.monspeak.60d0a393c4e4e916", "{the_monster_1} says, \"If I tell you I hate magic, will you worship me\?\"", "{the_monster_1}说：“要是我告诉你我讨厌魔法，你会崇拜我吗？”", "the_monster_1:name"},
    {"speech.monspeak.60d3debe155e7ab8", "{channel_1}{the_monster_1} weeps.", "{channel_1}{the_monster_1}哭泣着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.60fe950081cfa44c", "{channel_1}{the_monster_1} coils and then uncoils.", "{channel_1}{the_monster_1}盘起身子又舒展开来。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.612c42b9bb316cb8", "baby bat", "蝙蝠幼崽", ""},
    {"speech.monspeak.61643b5363e10727", "{the_monster_1} says {to_foe_1}, \"You cannot defeat me so easily!\"", "{the_monster_1}说 {to_foe_1}：“你不可能这么轻易就击败我！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.616a17d1fc619f79", "{the_monster_1} mutters, \"Why is everything {blorkula_colour_1} all of a sudden\?\"", "{the_monster_1}咕哝道：“为什么突然什么东西都是{blorkula_colour_1}的了？”", "the_monster_1:name;blorkula_colour_1:text"},
    {"speech.monspeak.616e7e6de5793635", "{the_monster_1} says {to_foe_1}, \"You can't kill me in a way that matters.\"", "{the_monster_1}说 {to_foe_1}：“你杀不死我——用任何有意义的方式都不行。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.61749ae038a39353", "{the_monster_1} screams {at_foe_1}, \"Blood!\"", "{the_monster_1}尖叫 {at_foe_1}：“血！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.618737faf82e064a", "{the_monster_1} says, \"All the demons know me. They respect me.\"", "{the_monster_1}说：“所有的恶魔都认识我。他们都敬重我。”", "the_monster_1:name"},
    {"speech.monspeak.61a23b52dce1621b", "{the_monster_1} says, \"Slime for the Slime God!\"", "{the_monster_1}说：“为黏液神献上黏液！”", "the_monster_1:name"},
    {"speech.monspeak.61a4cfad3f17fe5d", "{the_monster_1} mumbles something.", "{the_monster_1}咕哝着什么。", "the_monster_1:name"},
    {"speech.monspeak.61b38e9dff13b15e", "{the_monster_1} says, \"One skewered {foe_genus_1}, coming right up.\"", "{the_monster_1}说：“一串烤{foe_genus_1}，马上就好。”", "the_monster_1:name;foe_genus_1:name"},
    {"speech.monspeak.61b7337b2cc50b42", "{the_monster_1} says {to_foe_1}, \"We're having tasty {foe_genus_1} kabobs tonight!\"", "{the_monster_1}说 {to_foe_1}：“今晚我们有美味的{foe_genus_1}肉串吃！”", "the_monster_1:name;to_foe_1:text;foe_genus_1:name"},
    {"speech.monspeak.61c40070b6a11e95", "the lawlessness of gambling.", "赌博的无法无天。", ""},
    {"speech.monspeak.61d6c2afbe22c731", "{the_monster_1} says, \"Why are there poltergeists guarding this place, but not the Crypt\?\"", "{the_monster_1}说：“为什么这里有骚灵把守，墓室反倒没有？”", "the_monster_1:name"},
    {"speech.monspeak.61e005c2cb75ab9b", "{the_monster_1} says, \"Oh, this is an awfully strange dream.\"", "{the_monster_1}说：“哦，这真是个非常奇怪的梦。”", "the_monster_1:name"},
    {"speech.monspeak.61eef10746aa082d", "{the_monster_1} mutters, \"I never trained for this.\"", "{the_monster_1}咕哝道：“我从没受过这种训练。”", "the_monster_1:name"},
    {"speech.monspeak.61f8b30e205d9d7c", "{channel_1}{the_monster_1} howls in pain.", "{channel_1}{the_monster_1}痛苦地嚎叫。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.62093c46b7a55e73", "{the_monster_1} says, \"I hate branding.\"", "{the_monster_1}说：“我讨厌烙印。”", "the_monster_1:name"},
    {"speech.monspeak.622a2960f1c83ed6", "{the_monster_1} says, \"Okawaru's gifts are murder.\"", "{the_monster_1}说：“奥卡瓦鲁的礼物就是谋杀。”", "the_monster_1:name"},
    {"speech.monspeak.623b5f4adec48ab6", "{nellie_rare_1}", "{nellie_rare_1}", "nellie_rare_1:text"},
    {"speech.monspeak.623bb59e101b3bf6", "{the_monster_1} beseeches you, \"Abandon your quest, lest a terrible end find us all.\" {player_only_1}", "{the_monster_1}恳求你：“放弃你的追寻吧，免得我们全都落得可怕的结局。” {player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.6240bc17c1ec0250", "{the_monster_1} laughs.", "{the_monster_1}大笑。", "the_monster_1:name"},
    {"speech.monspeak.624201bacb57c0e8", "{channel_1}{the_monster_1} frowns in concentration.", "{channel_1}{the_monster_1}眉头紧锁，专心凝聚法力。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.626f0273cd265571", "tortoise", "陆龟", ""},
    {"speech.monspeak.62961d8c37536941", "Xom", "佐姆", ""},
    {"speech.monspeak.629b354d0bcdfa2b", "{channel_1}{the_monster_1} takes a defensive stance.", "{channel_1}{the_monster_1}摆出防御姿态。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.62a57dd7e3ca6c5c", "being eaten by rats", "被老鼠啃食", ""},
    {"speech.monspeak.62dd503bab3c9684", "{the_monster_1} says, \"My insurmountable tactics guarantee your defeat.\"", "{the_monster_1}说：“我不可战胜的战术保证你会失败。”", "the_monster_1:name"},
    {"speech.monspeak.63416233f4b5a267", "{the_monster_1} says {to_foe_1}, \"I was hoping my final job would be more of a challenge, but money is money.\"", "{the_monster_1}说 {to_foe_1}：“我本希望我最后一单能更有挑战性，但钱就是钱。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.636069175cacde9f", "murmurs", "喃喃自语", ""},
    {"speech.monspeak.6382c3fbbbbe0857", "{the_monster_1} draws the Swine. \"I'm a pig now!\"", "{the_monster_1}抽到了猪。“我现在是头猪了！”", "the_monster_1:name"},
    {"speech.monspeak.63c80d0f106ca46d", "{the_monster_1} says, \"I crush you like a bug!\"", "{the_monster_1}说：“我要把你像虫子一样碾碎！”", "the_monster_1:name"},
    {"speech.monspeak.63e0642f653407e5", "{subjective_1} shouts, \"You have your revenge! Let me go!\"", "{subjective_1}喊道：“你的仇已经报了！放我走！”", "subjective_1:text"},
    {"speech.monspeak.640882a4020a9562", "{natasha_killed_1}", "{natasha_killed_1}", "natasha_killed_1:text"},
    {"speech.monspeak.640f6ed8f5b62c8a", "{the_monster_1} says {to_foe_1}, \"You'll be the most ugly mummy ever seen.\"", "{the_monster_1}说 {to_foe_1}：“你会成为有史以来最丑陋的木乃伊。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.6412eed87d939b0b", "{demon_taunt_1}", "{demon_taunt_1}", "demon_taunt_1:text"},
    {"speech.monspeak.6425a0ef9ebd40dd", "{the_monster_1} says, \"Perhaps I shall have lamb for dinner.\"", "{the_monster_1}说：“也许晚饭我该吃羊肉。”", "the_monster_1:name"},
    {"speech.monspeak.642c110d4c2bf369", "unbeliever", "无信者", ""},
    {"speech.monspeak.646ac25847e016c2", "sneers", "讥笑道", ""},
    {"speech.monspeak.646e00021c3b723f", "{the_monster_1} {grum_verb_1}.", "{the_monster_1} {grum_verb_1}。", "the_monster_1:name;grum_verb_1:text"},
    {"speech.monspeak.64742439617d3941", "{the_monster_1} mutters some incantations to {reflexive_1}.", "{the_monster_1}对{reflexive_1}低声念着咒语。", "the_monster_1:name;reflexive_1:text"},
    {"speech.monspeak.649caa240c2e8253", "{the_monster_1} grouses about {choice_1}.", "{the_monster_1}抱怨着{choice_1}。", "the_monster_1:name;choice_1:text"},
    {"speech.monspeak.649caa240c2e8253.choice_1.alt_0", "the pranks of immortal alchemists", "长生不老药师的恶作剧", ""},
    {"speech.monspeak.649caa240c2e8253.choice_1.alt_1", "immature sisters", "不成熟的妹妹", ""},
    {"speech.monspeak.649cf08bb7e9e2fa", "{the_monster_1} whispers {to_foe_1}, \"I'll spare you if you take my job.\"", "{the_monster_1}低声说 {to_foe_1}：“你要是肯接我的班，我就饶你一命。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.64a7d8967ae0ee57", "ice in our veins", "血管里结了冰", ""},
    {"speech.monspeak.64b70b0a7f6a7049", "{the_monster_1} says {to_foe_1}, \"Catch me, touch me, love me, feed me!\"", "{the_monster_1}说 {to_foe_1}：“来抓我，来触碰我，来爱我，来喂养我！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.64b9e9268c4dca3a", "{jessica_rare_1}", "{jessica_rare_1}", "jessica_rare_1:text"},
    {"speech.monspeak.64c94894e8b0ee07", "{channel_1}{the_monster_1} does a happy little dance.", "{channel_1}{the_monster_1}开心地跳了一小段舞。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.64df213eee84add5", "{the_monster_1} screams, \"No! What have I done\?\"", "{the_monster_1}尖叫道：“不！我做了什么？”", "the_monster_1:name"},
    {"speech.monspeak.64ee5ec618c1ad57", "{player_ghost_medium_1}", "{player_ghost_medium_1}", "player_ghost_medium_1:text"},
    {"speech.monspeak.64f92b1128a3ca8f", "{the_monster_1} says {to_foe_1}, \"I guard Vaults good! You no get in!\"", "{the_monster_1}说 {to_foe_1}：“俺看守宝库很在行！你进不来！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.6506851d8bce4e00", "{the_monster_1} asks how much longer can this world bear the weight of past lives.", "{the_monster_1}发问：这个世界还能背负逝去生命的重量多久。", "the_monster_1:name"},
    {"speech.monspeak.651017af113b7845", "{dowan_rare_1}", "{dowan_rare_1}", "dowan_rare_1:text"},
    {"speech.monspeak.651398cca627fa68", "{channel_1}{the_monster_1} stares at you suspiciously.", "{channel_1}{the_monster_1}满腹狐疑地盯着你。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.651e9076b8af503d", "{the_monster_1} gurgles, \"Time to dig in!\"", "{the_monster_1}咕噜道：“开饭啦！”", "the_monster_1:name"},
    {"speech.monspeak.65391d90f8f2518e", "{the_monster_1} says, \"Can we stop fighting\? I have some good wine for you...\" {player_only_1}", "{the_monster_1}说：“我们别打了好吗？我这儿有好酒给你……” {player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.654407ef7a5487f4", "{confused_humanoid_medium_1}", "{confused_humanoid_medium_1}", "confused_humanoid_medium_1:text"},
    {"speech.monspeak.654439521df0bad9", "{the_monster_1} screams {at_foe_1}, \"One false step and I'll kill you.\"", "{the_monster_1}尖叫 {at_foe_1}：“走错一步我就宰了你。”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.654b54280933af48", "{the_monster_1} stands on {possessive_1} hind legs for a moment.", "{the_monster_1}用{possessive_1}后腿站立了片刻。", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.655f683e53932905", "{the_monster_1} says, \"I got whit I came for, but wha passes up a proper rammy\?\"", "{the_monster_1}说：“俺要的东西到手了，可谁舍得放过一场好架呢？”", "the_monster_1:name"},
    {"speech.monspeak.6561107028340f79", "{the_monster_1} writhes with frustration over not yet finding solutions for supernovas.", "{the_monster_1}因尚未找到超新星的解决方案而烦恼地扭动着。", "the_monster_1:name"},
    {"speech.monspeak.65a6bfb922c4f7a8", "{the_monster_1} screams {at_foe_1}, \"Eat!\"", "{the_monster_1}尖叫 {at_foe_1}：“吃！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.65c746833b28d34d", "{the_monster_1} says, \"What kind of god gives you spells but not spellbooks\?\"", "{the_monster_1}说：“哪有神给法术却不给魔法书的？”", "the_monster_1:name"},
    {"speech.monspeak.65cc5665fa0e21d2", "{the_monster_1} offers a few words of tactical advice.", "{the_monster_1}给出几句战术上的忠告。", "the_monster_1:name"},
    {"speech.monspeak.66147008eab7a386", "King", "国王", ""},
    {"speech.monspeak.661b478d849b5aac", "{channel_1}{the_monster_1} beckons to {foe_1}.", "{channel_1}{the_monster_1}向{foe_1}招手示意。", "channel_1:key;the_monster_1:name;foe_1:text"},
    {"speech.monspeak.662cfe87cc96cf81", "{the_monster_1} says, \"So, how do you deal with the weeds\?\"", "{the_monster_1}说：“那么，你是怎么处理那些杂草的？”", "the_monster_1:name"},
    {"speech.monspeak.664e00811f82e6f2", "{channel_1}{the_monster_possessive_1} hands start to glow.", "{channel_1}{the_monster_possessive_1}的双手开始发光。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.667323a47760d99f", "{channel_1}{the_monster_1} draws a finger across {possessive_1} throat.", "{channel_1}{the_monster_1}用一根手指划过{possessive_1}喉咙。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.668359af80f109fa", "{the_monster_1} lets out a long cackle.", "{the_monster_1}发出一阵长长的咯咯怪笑。", "the_monster_1:name"},
    {"speech.monspeak.669a20dfc315894f", "{channel_1}{the_monster_1} feints to the {choice_1}.", "{channel_1}{the_monster_1}向{choice_1}虚晃一招。", "channel_1:key;the_monster_1:name;choice_1:text"},
    {"speech.monspeak.669a20dfc315894f.choice_1.alt_0", "left", "左", ""},
    {"speech.monspeak.669a20dfc315894f.choice_1.alt_1", "right", "右", ""},
    {"speech.monspeak.669ce8f00725c703", "{the_monster_1} says, \"Take it from an old woman: your time is up.\"", "{the_monster_1}说：“听一个老太婆一句劝：你的大限到了。”", "the_monster_1:name"},
    {"speech.monspeak.669e115498a11d2a", "{channel_1}{the_monster_1} looks very self-confident.", "{channel_1}{the_monster_1}看起来非常自信。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.66a11f4231450d80", "{the_monster_1} draws the Cloud. \"No fresh air for enemies!\"", "{the_monster_1}抽到了云。“不给敌人留一口新鲜空气！”", "the_monster_1:name"},
    {"speech.monspeak.66bce23ceb5f42c6", "{channel_1}A brief shower of sparks shoots from {the_monster_possessive_1} claws.", "{channel_1}一阵火花从{the_monster_possessive_1}爪尖迸射而出。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.66c7165b768f1657", "{the_monster_1} sneers {at_foe_1}, \"There are one thousand and one flaws in your strategy!\"", "{the_monster_1}讥笑道 {at_foe_1}：“你的战术有一千零一个破绽！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.66cdfa9cb630c1bb", "{the_monster_1} leaves to spread the word of Beogh to the surface.", "{the_monster_1}动身前往地表，去传播比欧弗的福音。", "the_monster_1:name"},
    {"speech.monspeak.66de20a77e829ade", "{xtahua_common_1}", "{xtahua_common_1}", "xtahua_common_1:text"},
    {"speech.monspeak.66df242560761ed2", "the eternal Law.", "永恒的法则。", ""},
    {"speech.monspeak.66e53eb7cc85de27", "{the_monster_1} says, \"Don't you hate leeches\? I know I do.\"", "{the_monster_1}说：“你不讨厌水蛭吗？反正我讨厌。”", "the_monster_1:name"},
    {"speech.monspeak.670403d87497d454", "{wizard_common_spell_1}", "{wizard_common_spell_1}", "wizard_common_spell_1:text"},
    {"speech.monspeak.67095335ad9ea04a", "{the_monster_1} says {to_foe_1}, \"You look like me... when I was tiny, weak little boy.\"", "{the_monster_1}说 {to_foe_1}：“你看起来就像我……当我还是个瘦小孱弱的小男孩的时候。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.670aa3653fb0cf08", "verde", "绿色", ""},
    {"speech.monspeak.6731173bcd50fa72", "{the_monster_1} says, \"The other people here are really rude.\"", "{the_monster_1}说：“这里的其他人都好粗鲁。”", "the_monster_1:name"},
    {"speech.monspeak.673c24d6ffe52cd2", "{the_monster_1} says, \"Acid to acid, slime to slime.\"", "{the_monster_1}说：“酸归于酸，黏液归于黏液。”", "the_monster_1:name"},
    {"speech.monspeak.6750cfc388bec6c5", "{the_monster_1} says, \"Couldn't find enough potions\?\"", "{the_monster_1}说：“找不到足够的药水？”", "the_monster_1:name"},
    {"speech.monspeak.6768179321b65dd2", "{the_monster_1} says, \"You must really love pain. I hate it.\"", "{the_monster_1}说：“你一定真爱痛苦。我讨厌痛苦。”", "the_monster_1:name"},
    {"speech.monspeak.676b12dc8ca8d63e", "{the_monster_1} states, \"It's not just demons who despoil everything they cannot have.\"", "{the_monster_1}宣称：“得不到便要毁掉的，可不只有恶魔。”", "the_monster_1:name"},
    {"speech.monspeak.677836f4867f3085", "{the_monster_1} says, \"May you follow the Path of Peace in your next life.\"", "{the_monster_1}说：“愿你来世走上和平之道。”", "the_monster_1:name"},
    {"speech.monspeak.677afb16bc0682a6", "{the_monster_1} boasts, \"I survived the Crucible of Flesh! I fear nothing now!\"", "{the_monster_1}夸口道：“我活着走出了血肉熔炉！如今我无所畏惧！”", "the_monster_1:name"},
    {"speech.monspeak.679a5a300bacb3dc", "{the_monster_1} wonders, \"When I cut you open, what secrets will I find\?\"", "{the_monster_1}想道：“把你剖开时，我会发现什么秘密呢？”", "the_monster_1:name"},
    {"speech.monspeak.67c2cc41a91e3eba", "{channel_1}{the_monster_1} hisses and glimmers.", "{channel_1}{the_monster_1}嘶嘶作响，闪着微光。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.67c9119ee2d28cb3", "{the_monster_1} says, \"Killing adventurers, taking their stuff. It's what he did, it's what I do.\"", "{the_monster_1}说：“杀冒险者，抢他们的东西。他当年这么干，我也这么干。”", "the_monster_1:name"},
    {"speech.monspeak.67d7ef83973ed8c1", "{the_monster_1} says, \"I slipped earlier. I hate that.\"", "{the_monster_1}说：“我刚才滑了一跤。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.67e1fbae13e29e02", "{the_monster_1} shouts {at_foe_1}, \"Let the forces of evil and voodoo overcome you!\"", "{the_monster_1}喊道 {at_foe_1}：“让邪恶与巫毒的力量压倒你吧！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.67f6fd6e7bd9f9f3", "{channel_1}{the_monster_1}, emptied of spiritual energy, fades out from this realm.", "{channel_1}{the_monster_1}的灵魂能量被抽空，从这片领域中消散了。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.680e805a9ca4e726", "{the_monster_1} says, \"I keep feeling something staring at me. Is it you\?\"", "{the_monster_1}说：“我总觉得有什么东西在盯着我。是你吗？”", "the_monster_1:name"},
    {"speech.monspeak.681cdec84f46c505", "{the_monster_1} says, \"My mother, she was a queen.\" {player_only_1}", "{the_monster_1}说：“我的母亲，她曾是一位女王。”{player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.681cdfd5433b697a", "Cod", "鳕鱼", ""},
    {"speech.monspeak.682af1c2b534712d", "{the_monster_1} says, \"That'll show my brother!\"", "{the_monster_1}说：“这下我哥哥可看见了！”", "the_monster_1:name"},
    {"speech.monspeak.6848c0e599d2ce8a", "{the_monster_1} growls in agony!", "{the_monster_1}在剧痛中咆哮！", "the_monster_1:name"},
    {"speech.monspeak.684f78b8312b1f6e", "{the_monster_1} says {to_foe_1}, \"The claw is nothing compared to the sucker!\"", "{the_monster_1}说 {to_foe_1}：“跟吸盘比起来，爪子根本不算什么！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.68a90853463d989f", "curses", "咒骂道", ""},
    {"speech.monspeak.68bf6884b74c8861", "{the_monster_1} suddenly {orc_shouts_1}{orc_modifier_1}", "{the_monster_1}突然{orc_shouts_1}{orc_modifier_1}", "the_monster_1:name;orc_shouts_1:text;orc_modifier_1:text"},
    {"speech.monspeak.68db3ab69113b45a", "{the_monster_1} says, \"Word to the wise: Murray's a real chatterbox.\"", "{the_monster_1}说：“给你句忠告：默里那张嘴可真是停不下来。”", "the_monster_1:name"},
    {"speech.monspeak.68de13ba53625ff4", "{the_monster_1} prays for help.", "{the_monster_1}祈祷求助。", "the_monster_1:name"},
    {"speech.monspeak.68de83d7d3e9c093", "{the_monster_1} says, \"Would you like to be cremated\?\"", "{the_monster_1}说：“你想被火化吗？”", "the_monster_1:name"},
    {"speech.monspeak.68f63139305f4170", "{roxanne_medium_1}", "{roxanne_medium_1}", "roxanne_medium_1:text"},
    {"speech.monspeak.6916b3fc0d5c6947", "{the_monster_1} boasts with wailing echoes, \"My power is unlimited.\"", "{the_monster_1}伴随着哀鸣般的回响夸口道：“我的力量是无穷的。”", "the_monster_1:name"},
    {"speech.monspeak.693e12e70a663496", "{the_monster_1} says, \"If I draw a card, can you tell me which one it is\?\"", "{the_monster_1}说：“我抽一张牌，你能说出它是哪张吗？”", "the_monster_1:name"},
    {"speech.monspeak.69578857d89b6ddc", "{channel_1}{the_monster_1} winks several times {at_foe_1}.", "{channel_1}{the_monster_1}眨了好几次眼 {at_foe_1}。", "channel_1:key;the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.695fc54b952314b1", "servitude", "奴役", ""},
    {"speech.monspeak.69714d19d20c5556", "{the_monster_1} says, \"I like you, cousin!\"", "{the_monster_1}说：“我喜欢你，同类！”", "the_monster_1:name"},
    {"speech.monspeak.6973f05de8b50ccd", "{the_monster_1} says, \"Man, that must be some big library.\"", "{the_monster_1}说：“天哪，那图书馆肯定大得吓人。”", "the_monster_1:name"},
    {"speech.monspeak.698e7c36e9a555dd", "{the_monster_1} says, \"Makhleb has given me powers of destruction.\"", "{the_monster_1}说：“马科列布赐予了我毁灭之力。”", "the_monster_1:name"},
    {"speech.monspeak.69e126129ae8430a", "{the_monster_1} says, \"I bet you wish you could cast spells now, right\?\"", "{the_monster_1}说：“我打赌你现在肯定很希望能施法，对吧？”", "the_monster_1:name"},
    {"speech.monspeak.69efe721cc5c8e63", "{the_monster_1} howls with blood-lust!", "{the_monster_1}嗜血地嚎叫！", "the_monster_1:name"},
    {"speech.monspeak.69f266071e8ac474", "{the_monster_1} says, \"Lost something\?\"", "{the_monster_1}说：“丢了什么东西吗？”", "the_monster_1:name"},
    {"speech.monspeak.6a020e00ebae21cc", "{the_monster_1} laughs merrily.", "{the_monster_1}欢快地大笑。", "the_monster_1:name"},
    {"speech.monspeak.6a0f14e67965ac6f", "Rifle", "步枪", ""},
    {"speech.monspeak.6a0fbcfc435067d6", "{the_monster_1} says, \"I hate chants.\"", "{the_monster_1}说：“我讨厌吟唱。”", "the_monster_1:name"},
    {"speech.monspeak.6a2608b80af69132", "Millennium", "千年", ""},
    {"speech.monspeak.6a2848a0f61cd457", "{the_monster_1} says, \"These tides are fast. That can't be natural!\"", "{the_monster_1}说：“这潮水涨得也太快了。这肯定不正常！”", "the_monster_1:name"},
    {"speech.monspeak.6a29917f22872a08", "{the_monster_1} asks {foe_1}, \"Have you seen the dreamshard\? I... I need it...\"", "{the_monster_1}问{foe_1}：“你见过梦之碎片吗？我……我需要它……”", "the_monster_1:name;foe_1:text"},
    {"speech.monspeak.6a31465815a56ee7", "{channel_1}{the_monster_1} tries to stalk through the shadows.", "{channel_1}{the_monster_1}试图潜行于阴影之中。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.6a3690891f677daa", "{channel_1}{the_monster_1} grins evilly.", "{channel_1}{the_monster_1}邪恶地咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.6a5458aabc47c606", "{the_monster_1} says, \"I hope I haven't come all this way for a glorified paperweight.\"", "{the_monster_1}说：“希望我跑这么远来，不是为了一个花哨的镇纸。”", "the_monster_1:name"},
    {"speech.monspeak.6a57d53b9e0c002b", "stone statue", "石像", ""},
    {"speech.monspeak.6a6e39dac66812eb", "{channel_1}{the_monster_1} jiggles.", "{channel_1}{the_monster_1}轻轻抖动着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.6a7ba5c39de9cacc", "{the_monster_1} says, \"Spells\? Hah! My gadgets will show what real magic is!\"", "{the_monster_1}说：“法术？哈！我的小装置会让你见识见识什么叫真正的魔法！”", "the_monster_1:name"},
    {"speech.monspeak.6a81ecc7eca95484", "{the_monster_1} makes a strange noise.", "{the_monster_1}发出奇怪的声响。", "the_monster_1:name"},
    {"speech.monspeak.6a8c787b6bc186a2", "{the_monster_1} moans, \"Why did I trust plants to save my life\?\"", "{the_monster_1}哀叹道：“我当初怎么会指望植物来救我的命？”", "the_monster_1:name"},
    {"speech.monspeak.6a948af01ebf4d7e", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.6ac80c20599e90b1", "{the_monster_1} snarls {at_foe_1}, \"My home! Leave!\"", "{the_monster_1}咆哮道 {at_foe_1}：“我的家！出去！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.6b167ef2065d9a5e", "{the_monster_1} barks {at_foe_1}, \"Your form is terrible!\"", "{the_monster_1}吼道 {at_foe_1}：“你的架势糟透了！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.6b2b49e67ceac8aa", "{the_monster_1} cheers {loudly_or_repeatedly_1}.", "{the_monster_1}{loudly_or_repeatedly_1}欢呼着。", "the_monster_1:name;loudly_or_repeatedly_1:text"},
    {"speech.monspeak.6b5e172c58c84335", "{channel_1}{the_monster_1} rolls in a circle.", "{channel_1}{the_monster_1}原地滚了一圈。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.6b5fb939541bb919", "{the_monster_1} screams, \"The ORB is only a tale, but I will kill you anyway!\" {player_only_1}", "{the_monster_1}尖叫道：“宝珠只是个传说，但我照样要杀了你！”{player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.6b68f08c1f11f2a2", "master", "主人", ""},
    {"speech.monspeak.6b6b458b2603d6f0", "{the_monster_1} screams {at_foe_1}, \"Die, monster!\"", "{the_monster_1}尖叫道 {at_foe_1}：“死吧，怪物！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.6b7c9d5993c8c41b", "{the_monster_1} says, \"What sort of name is 'naga' anyway\? They're not even good at nagging.\"", "{the_monster_1}说：“‘纳迦’这算哪门子名字？他们连唠叨都不在行。”", "the_monster_1:name"},
    {"speech.monspeak.6ba8236857534631", "the Helix", "螺旋", ""},
    {"speech.monspeak.6bf7310df4f49dd8", "Ghoul", "食尸鬼", ""},
    {"speech.monspeak.6bf815a0d79c2ea5", "{channel_1}{the_monster_1} grins evilly.", "{channel_1}{the_monster_1}邪恶地咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.6c1304d2fe909753", "{the_monster_1} says, \"Once, I gave up drinking for a week. I hated that.\"", "{the_monster_1}说：“有一次我戒酒戒了一星期。我讨厌那样。”", "the_monster_1:name"},
    {"speech.monspeak.6c2942b273c621d3", "{channel_1}{the_monster_1} smiles happily.", "{channel_1}{the_monster_1}开心地微笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.6c2d4df41d093eb6", "{the_monster_1} says {to_foe_1}, \"Appear weak when you are strong, and strong when you are weak.\"", "{the_monster_1}说 {to_foe_1}：“强而示之弱，弱而示之强。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.6c3fa64e15149f93", "{channel_1}{the_monster_1} looks {at_foe_around_1} nervously.", "{channel_1}{the_monster_1}紧张地望向{at_foe_around_1}。", "channel_1:key;the_monster_1:name;at_foe_around_1:text"},
    {"speech.monspeak.6c57d4c1a9afc155", "{the_monster_1} scoffs, \"You didn't have a chance.\"", "{the_monster_1}嗤笑道：“你根本没有胜算。”", "the_monster_1:name"},
    {"speech.monspeak.6c5969c6ec5f6e7e", "{the_monster_1} says, \"I got a splinter from a draugr. I hate that.\"", "{the_monster_1}说：“一根尸鬼身上的木刺扎进了我的手。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.6c6e976ef4671125", "{the_monster_1} {recites_start_1} a {lecture_modifier_1} lecture about {recite_subject_1}", "{the_monster_1}{recites_start_1}一场{lecture_modifier_1}讲座，讲解{recite_subject_1}", "the_monster_1:name;recites_start_1:text;lecture_modifier_1:text;recite_subject_1:text"},
    {"speech.monspeak.6c6e9ef10e42e1e2", "{the_monster_1} screams {at_foe_1}, \"Level is mine! All mine!\"", "{the_monster_1}尖叫 {at_foe_1}：“这一层是俺的！全是俺的！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.6c8e00e9e18e9c12", "{channel_1}{the_monster_1} {choice_1} in the surf!", "{channel_1}{the_monster_1}在浪花里{choice_1}！", "channel_1:key;the_monster_1:name;choice_1:text"},
    {"speech.monspeak.6c8e00e9e18e9c12.choice_1.alt_0", "plays", "玩耍", ""},
    {"speech.monspeak.6c8e00e9e18e9c12.choice_1.alt_1", "frolics", "嬉戏", ""},
    {"speech.monspeak.6caf82ba59b63bd6", "{the_monster_1} says, \"Aren't you worried about radiation\? You should put that down.\"", "{the_monster_1}说：“你不担心辐射吗？你该把它放下。”", "the_monster_1:name"},
    {"speech.monspeak.6cb6ab83fedcfe31", "{the_monster_1} grumbles constantly over the stars not yet being right.", "{the_monster_1}不断抱怨星辰尚未归位。", "the_monster_1:name"},
    {"speech.monspeak.6cc02adfbe9e44fb", "{channel_1}{the_monster_1} seems to be having trouble coordinating {possessive_1} many legs.", "{channel_1}{the_monster_1}似乎协调不好{possessive_1}那么多条腿。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.6cc2db7589b61a57", "{the_monster_1} {shouts_1}, \"Let's {choice_1} whoever stands in our way!\"", "{the_monster_1}{shouts_1}：“凡是挡路的，统统{choice_1}！”", "the_monster_1:name;shouts_1:text;choice_1:text"},
    {"speech.monspeak.6cc2db7589b61a57.choice_1.alt_0", "kill", "杀掉", ""},
    {"speech.monspeak.6cc2db7589b61a57.choice_1.alt_1", "smash", "砸碎", ""},
    {"speech.monspeak.6cc2db7589b61a57.choice_1.alt_2", "burn", "烧死", ""},
    {"speech.monspeak.6cc2db7589b61a57.choice_1.alt_3", "maim", "弄残", ""},
    {"speech.monspeak.6cd42da4cdf49c0c", "{the_monster_1} says {to_foe_1}, \"May a porcupine live in your trousers for a thousand days and die there for a thousand and one.\"", "{the_monster_1}说 {to_foe_1}：“愿一只豪猪在你的裤子里住上一千天，再在那里死上一千零一天。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.6ce479a86b28d94e", "{the_monster_1} says, \"I hate orbs.\"", "{the_monster_1}说：“我讨厌宝珠。”", "the_monster_1:name"},
    {"speech.monspeak.6ce6c0d03be34c1c", "{the_monster_1} says, \"It's dangerous to adventure alone.\"", "{the_monster_1}说：“独自冒险是很危险的。”", "the_monster_1:name"},
    {"speech.monspeak.6cebaa34ac5a1e02", "{the_monster_1} shouts, \"Please protect me!\"", "{the_monster_1}喊道：“请保护我！”", "the_monster_1:name"},
    {"speech.monspeak.6cecea7d3b2ab3a6", "{the_monster_1} says, \"I ran into an orc. He called himself a warlord, and I asked what war\?\"", "{the_monster_1}说：“我碰到一个兽人。他自称军阀，我就问他打过什么仗？”", "the_monster_1:name"},
    {"speech.monspeak.6ceea36d1dea5526", "mumbles", "咕哝", ""},
    {"speech.monspeak.6cf74f5d000effe3", "{the_monster_1} says, \"You took it. Me saw.\"", "{the_monster_1}说：“你拿了。俺看见了。”", "the_monster_1:name"},
    {"speech.monspeak.6d110ddb842d1211", "near the shore", "海滨", ""},
    {"speech.monspeak.6d1c8bd3fd8292d6", "{the_monster_1} mutters, \"When I said I wanted to live forever... this was not what I had in mind.\"", "{the_monster_1}嘟囔道：“我说想永生的时候……可没想到会是这样。”", "the_monster_1:name"},
    {"speech.monspeak.6d1dfe6e2a6b31d0", "{channel_1}{the_monster_1} laughs at nothing.", "{channel_1}{the_monster_1}对着空无一物的地方大笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.6d2dd17325c083da", "{the_monster_1} {shouts_1}, \"Take back everything that was taken from us!\"", "{the_monster_1}{shouts_1}：“把被夺走的一切都夺回来！”", "the_monster_1:name;shouts_1:text"},
    {"speech.monspeak.6d3e6fc40227fa8c", "{the_monster_1} says {to_foe_1}, \"Oblivion to the unbeliever.\"", "{the_monster_1}说 {to_foe_1}：“不信者必遭湮灭。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.6d4b63a18f2e127a", "{the_monster_1} says {to_foe_1}, \"Where magic fails, the sword succeeds!\"", "{the_monster_1}说 {to_foe_1}：“魔法失手之处，利剑成功！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.6d6a821e52f902d1", "{the_monster_1} {grum_verb_1} {at_foe_1}, \"You look like good eating.\"", "{the_monster_1} {grum_verb_1} {at_foe_1}：“你看起来很好吃。”", "the_monster_1:name;grum_verb_1:text;at_foe_1:text"},
    {"speech.monspeak.6d720ad293e265bf", "{default_friendly_humanoid_1}", "{default_friendly_humanoid_1}", "default_friendly_humanoid_1:text"},
    {"speech.monspeak.6d9950b48702b354", "{the_monster_1} stomps in frustration.", "{the_monster_1}懊恼地跺脚。", "the_monster_1:name"},
    {"speech.monspeak.6da21d3ec76058fb", "{the_monster_1} {mutters_1}, \"Of all the rotten luck!\"", "{the_monster_1} {mutters_1}：“真是倒霉透了！”", "the_monster_1:name;mutters_1:text"},
    {"speech.monspeak.6da60beeab039d72", "{the_monster_1} says, \"Man, snails must be faster than these guys.\"", "{the_monster_1}说：“天哪，蜗牛肯定都比这些家伙快。”", "the_monster_1:name"},
    {"speech.monspeak.6dacf2060f23f5ca", "leg", "腿", ""},
    {"speech.monspeak.6dd13533817721e1", "{eustachio_common_1}", "{eustachio_common_1}", "eustachio_common_1:text"},
    {"speech.monspeak.6de432b924b410bd", "{the_monster_1} says, \"Your greed held you back.\"", "{the_monster_1}说：“你的贪婪拖了你的后腿。”", "the_monster_1:name"},
    {"speech.monspeak.6df3133ca1c29113", "{the_monster_1} says, \"I'm dying. I hate that.\"", "{the_monster_1}说：“我要死了。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.6e0d316007a63cb6", "{the_monster_1} says, \"I hate sacrificants.\"", "{the_monster_1}说：“我讨厌献祭者。”", "the_monster_1:name"},
    {"speech.monspeak.6e1a4b0006e0541f", "{the_monster_1} rambles incoherently.", "{the_monster_1}语无伦次地东拉西扯。", "the_monster_1:name"},
    {"speech.monspeak.6e2f202c0ab387c2", "{the_monster_1} roars {at_foe_1}, \"FACE MY WRATH!\"", "{the_monster_1}咆哮道 {at_foe_1}：“面对我的怒火吧！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.6e3d43e839c7440c", "{the_monster_1} crumbles to pieces from sheer joy.", "{the_monster_1}因为纯粹的欢喜碎成了渣。", "the_monster_1:name"},
    {"speech.monspeak.6e75cb994f888f1a", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.6e79fe6b6336e02d", "{the_monster_1} raises {possessive_1} hands in surrender.", "{the_monster_1}举起{possessive_1}双手投降。", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.6e7cbace5f89d381", "{channel_1}{the_monster_1} cries.", "{channel_1}{the_monster_1}哭了起来。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.6e8491df21597927", "rejecting the service of demons.", "拒绝为恶魔效力。", ""},
    {"speech.monspeak.6e94d8bd528dab93", "{the_monster_1} says {to_foe_1}, \"The Royal Ballet doesn't accept kobolds. That's why I went into killing people.\"", "{the_monster_1}说 {to_foe_1}：“皇家芭蕾舞团不收狗头人。所以我才干起了杀人的行当。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.6e97b8639ce6d56e", "blue-tailed skink", "蓝尾石龙子", ""},
    {"speech.monspeak.6ecf177191da02c4", "{the_monster_1} says, \"I hate revenants, but I forget why! And I hate that, too!\"", "{the_monster_1}说：“我讨厌亡魂，但我忘了为什么！这我也讨厌！”", "the_monster_1:name"},
    {"speech.monspeak.6ed8d245b658a616", "{the_monster_1} says {to_foe_1}, \"You will soon be helpless to avoid my power.\"", "{the_monster_1}说 {to_foe_1}：“你很快就会无力躲避我的力量。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.6ef4225d2cb6a0a5", "commit", "效忠", ""},
    {"speech.monspeak.6ef67632a3209b54", "O", "哦", ""},
    {"speech.monspeak.6ef708603148f591", "{hostile_imp_common_1}", "{hostile_imp_common_1}", "hostile_imp_common_1:text"},
    {"speech.monspeak.6efe8ae866fd3193", "{the_monster_1} says, \"Well, maybe you weren't so bad after all.\"", "{the_monster_1}说：“好吧，也许你其实没那么差。”", "the_monster_1:name"},
    {"speech.monspeak.6f08b01dbe0f9742", "{the_monster_1} screams, \"{player_name_1}! What's going on\?!\"", "{the_monster_1}尖叫道：“{player_name_1}！这是怎么回事？！”", "the_monster_1:name;player_name_1:name"},
    {"speech.monspeak.6f12fea4397567e9", "{the_monster_1} says {to_foe_1}, \"We will meet again!\"", "{the_monster_1}说 {to_foe_1}：“我们还会再见的！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.6f2a99fbdc4f9015", "{the_monster_1} tells you, \"The cards don't hold a good future for you.\"", "{the_monster_1}告诉你：“牌面里没有你的好未来。”", "the_monster_1:name"},
    {"speech.monspeak.6f3425e614f050ad", "{natasha_death_rare_1}", "{natasha_death_rare_1}", "natasha_death_rare_1:text"},
    {"speech.monspeak.6f3a763fe8077277", "{channel_1}{the_monster_1} yawns.", "{channel_1}{the_monster_1}打了个哈欠。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.6f3de96811bc89c5", "{the_monster_1} says, \"Screaming refractions\? What's next, yodelling boulders\?\"", "{the_monster_1}说：“尖叫的折射体？接下来是什么，唱约德尔调的巨石？”", "the_monster_1:name"},
    {"speech.monspeak.6f4a220cb80b5b65", "sing", "歌唱", ""},
    {"speech.monspeak.6f4be11696908ac4", "{the_monster_1} asks {foe_1} \"Won't you come swim with me\?\"", "{the_monster_1}问{foe_1}：“要不要来和我一起游泳？”", "the_monster_1:name;foe_1:text"},
    {"speech.monspeak.6f6b178a10c3a422", "{the_monster_1} says {to_foe_1}, \"Return every stolen item!\"", "{the_monster_1}说 {to_foe_1}：“把偷来的每件东西都交出来！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.6f6d1e02551b0c59", "{the_monster_1} screams {at_foe_1}, \"Nothing can help you.\"", "{the_monster_1}尖叫 {at_foe_1}：“什么都救不了你。”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.6f774b0377b7e91f", "{the_monster_1} says {to_foe_1}, \"Your suffering will cleanse you of your heresy.\"", "{the_monster_1}说 {to_foe_1}：“你的苦难会洗清你的异端之罪。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.6fbd6931d8955bd4", "{the_monster_1} says, \"What kind of torch can only be lit once per level\?\"", "{the_monster_1}说：“什么样的火把一层只能用一次？”", "the_monster_1:name"},
    {"speech.monspeak.6fc6c458d02ba495", "{the_monster_1} mutters ill rumours of the current state of the heavens.", "{the_monster_1}含糊地念叨着关于天庭现状的凶险传言。", "the_monster_1:name"},
    {"speech.monspeak.6fca1cf511735802", "meccalolo", "梅卡洛洛", ""},
    {"speech.monspeak.6fd253820c7793ef", "Prologue", "序言", ""},
    {"speech.monspeak.70017b618fdde438", "{channel_1}{the_monster_1} looks angry.", "{channel_1}{the_monster_1}看上去很愤怒。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.70080c76ad30e0d6", "{maggie_common_1}", "{maggie_common_1}", "maggie_common_1:text"},
    {"speech.monspeak.701c74f6bdb7fc3c", "Cake", "蛋糕", ""},
    {"speech.monspeak.702cc2d43653496b", "{channel_1}{the_monster_1} waves at you.", "{channel_1}{the_monster_1}朝你挥手。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.7032770bd0104f3d", "{erolcha_rare_1}", "{erolcha_rare_1}", "erolcha_rare_1:text"},
    {"speech.monspeak.7042961a7b6330c2", "{the_monster_1} says, \"Hey, I wasn't done torturing you yet!\"", "{the_monster_1}说：“喂，我还没折磨够你呢！”", "the_monster_1:name"},
    {"speech.monspeak.705efbad8c634bab", "{the_monster_1} says, \"Have you seen my cloak\?\"", "{the_monster_1}说：“你们见到我的斗篷了吗？”", "the_monster_1:name"},
    {"speech.monspeak.7088dfefe5850c95", "{the_monster_1} falls on {possessive_1} knees before you.", "{the_monster_1}跪在你面前，屈下{possessive_1}膝盖。", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.70b90d559deb107f", "the goodness of {random_god_good_1}.", "{random_god_good_1}的善良。", "random_god_good_1:name"},
    {"speech.monspeak.70bfaa517d453f9e", "{the_monster_1} screams {at_foe_1}, \"Damn your eyes!\"", "{the_monster_1}尖叫道 {at_foe_1}：“你这双该死的眼睛！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.70c70f2241404a7b", "{the_monster_1} says, \"I think I hate rivers, but I can't remember why.\"", "{the_monster_1}说：“我想我讨厌河流，但我想不起来为什么。”", "the_monster_1:name"},
    {"speech.monspeak.71136680dd235d3f", "{the_monster_1} says, \"Don't you just hate miscasts\?\"", "{the_monster_1}说：“你就说，你不讨厌法术失误吗？”", "the_monster_1:name"},
    {"speech.monspeak.711aea0f629833e4", "{the_monster_1} says, \"I hate pacts.\"", "{the_monster_1}说：“我讨厌契约。”", "the_monster_1:name"},
    {"speech.monspeak.711f7822f2d2c999", "{the_monster_1} roars, \"Even the heavens can't separate us forever!\"", "{the_monster_1}吼道：“就算是老天也不能永远把我们分开！”", "the_monster_1:name"},
    {"speech.monspeak.712223d67ca4b11b", "rustles", "沙沙作响", ""},
    {"speech.monspeak.71341567387e8dfe", "The death cob makes a corny joke.", "亡灵玉米棒讲了个土得掉渣的笑话。", ""},
    {"speech.monspeak.713fdcb356098958", "{the_monster_1} says, \"Orcs complain a lot, don't they\? I hate it.\"", "{the_monster_1}说：“兽人一天到晚都在抱怨，对吧？我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.7140270ebb816594", "{the_monster_1} says, \"I'd like to see you come back from this one.\"", "{the_monster_1}说：“我倒是想看看你怎么从这一下里回来。”", "the_monster_1:name"},
    {"speech.monspeak.7144881ac888cc62", "{channel_1}{the_monster_1} grinds {possessive_1} teeth, and then sighs.", "{channel_1}{the_monster_1}咬了咬{possessive_1}牙，然后叹了口气。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.714a6a74445cb279", "{the_monster_1} says {to_foe_1}, \"I'm selling these fine leather pelts.\"", "{the_monster_1}说 {to_foe_1}：“我在卖这些上好的皮革毛皮。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.71582262b9bffd6f", "{the_monster_1} grins and asks {foe_1} \"Are you {choice_1}\?\"", "{the_monster_1}咧嘴一笑，问{foe_1}：“你{choice_1}吗？”", "the_monster_1:name;foe_1:text;choice_1:text"},
    {"speech.monspeak.71582262b9bffd6f.choice_1.alt_0", "flammable", "易燃", ""},
    {"speech.monspeak.71582262b9bffd6f.choice_1.alt_1", "inflammable", "助燃", ""},
    {"speech.monspeak.71582262b9bffd6f.choice_1.alt_2", "feeling hot", "觉得热", ""},
    {"speech.monspeak.7165c739e8572734", "{the_monster_1} sneers, \"Do you call that fighting\?\"", "{the_monster_1}讥笑道：“这也叫战斗？”", "the_monster_1:name"},
    {"speech.monspeak.719e5654b6479ff3", "{boris_medium_1}", "{boris_medium_1}", "boris_medium_1:text"},
    {"speech.monspeak.71baf0a491ae045a", "{the_monster_1} says, \"I never had a vision before.\"", "{the_monster_1}说：“我以前从未见过神启。”", "the_monster_1:name"},
    {"speech.monspeak.71c38ba137f041e3", "{channel_1}{the_monster_1} heaves a sigh in contemplation.", "{channel_1}{the_monster_1}沉思着，长叹了一口气。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.71c9c51435f2fce7", "roars", "咆哮道", ""},
    {"speech.monspeak.71d20351d4a22733", "{the_monster_1} says, \"Let nature run its course against you!\"", "{the_monster_1}说：“就让大自然朝你倾泻它的力量吧！”", "the_monster_1:name"},
    {"speech.monspeak.71d725f2c0228dd9", "{the_monster_1} says, \"What is the universe for\?\"", "{the_monster_1}说：“宇宙存在的目的是什么？”", "the_monster_1:name"},
    {"speech.monspeak.71e55aa8b8e25f16", "{the_monster_1} says, \"I used to wander and follow the dancing life. Look where it got me.\"", "{the_monster_1}说：“我曾四处游荡，追随着舞蹈般的人生。看看它把我带到了哪里。”", "the_monster_1:name"},
    {"speech.monspeak.71f723196bfd55d4", "Cards", "纸牌", ""},
    {"speech.monspeak.71f8b138020f8a79", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.71ff0669e9cb11cc", "{the_monster_1} sings a few bars from the Orcish anthem.", "{the_monster_1}唱了几句兽人颂歌。", "the_monster_1:name"},
    {"speech.monspeak.720c4430582b14b7", "{the_monster_1} {shouts_1}, \"Wait for me, {player_name_1}! Could you help me\?\"", "{the_monster_1} {shouts_1}：“等等我，{player_name_1}！你能帮帮我吗？”", "the_monster_1:name;shouts_1:text;player_name_1:name"},
    {"speech.monspeak.720f0921adad2d23", "{the_monster_1} sighs {at_foe_1}, \"It's not easy being green!\"", "{the_monster_1}叹息着说 {at_foe_1}：“身为绿色可不容易啊！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.72201fe4a41e0de6", "Hack", "乱砍", ""},
    {"speech.monspeak.724be1c113a95386", "{the_monster_1} screams, \"I'll kill you anyway!\"", "{the_monster_1}尖叫道：“反正我还是要杀了你！”", "the_monster_1:name"},
    {"speech.monspeak.725152146a734894", "{the_monster_1} says, \"Do you know Lommy\? A good friend!\"", "{the_monster_1}说：“你认识洛米吗？我的好朋友！”", "the_monster_1:name"},
    {"speech.monspeak.7256476e3b3ef3d3", "{hostile_imp_1}", "{hostile_imp_1}", "hostile_imp_1:text"},
    {"speech.monspeak.725f583465aceeac", "{hostile_orc_beogh_believer_speech_1}", "{hostile_orc_beogh_believer_speech_1}", "hostile_orc_beogh_believer_speech_1:text"},
    {"speech.monspeak.72647330b2b72469", "{the_monster_1} says, \"Follow my lead, little ones.\"", "{the_monster_1}说：“跟着我走，小家伙们。”", "the_monster_1:name"},
    {"speech.monspeak.7293b88900067d5e", "{the_monster_1} says, \"What's the point of being all-knowing if you can't do anything\?\"", "{the_monster_1}说：“如果什么都做不了，那无所不知还有什么意义？”", "the_monster_1:name"},
    {"speech.monspeak.729454ddb97cfe29", "Lay", "躺", ""},
    {"speech.monspeak.72da10080f8d4bcd", "{friendly_confused_rare_1}", "{friendly_confused_rare_1}", "friendly_confused_rare_1:text"},
    {"speech.monspeak.72ed93c7e05a0203", "{the_monster_1} says {to_foe_1}, \"I know your fate. It's pain.\"", "{the_monster_1}说 {to_foe_1}：“我知道你的命运。那就是痛苦。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.73135e344427b539", "{the_monster_1} says, \"In life I battled great evil. Now I just battle.\"", "{the_monster_1}说：“我生前与巨大的邪恶作战。如今我只是一味作战。”", "the_monster_1:name"},
    {"speech.monspeak.7315709608def834", "{channel_1}{the_monster_1} cries.", "{channel_1}{the_monster_1}哭了起来。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.732812a60d89d5da", "{the_monster_1} rasps, \"Now... you are also... Nobody.\"", "{the_monster_1}嘶哑地说：“现在……你也……谁都不是了。”", "the_monster_1:name"},
    {"speech.monspeak.732a88fb5aedd575", "{the_monster_1} hisses.", "{the_monster_1}嘶嘶作声。", "the_monster_1:name"},
    {"speech.monspeak.733f91debcadd25e", "{the_monster_1} hisses menacingly.", "{the_monster_1}威胁地发出嘶嘶声。", "the_monster_1:name"},
    {"speech.monspeak.734f84f7b26371a5", "{the_monster_1} gurgles.", "{the_monster_1}发出咕噜声。", "the_monster_1:name"},
    {"speech.monspeak.73616257a734c787", "supplicates", "哀求道", ""},
    {"speech.monspeak.7368d7db6dcab433", "howls", "嚎叫道", ""},
    {"speech.monspeak.736db5b547dd8248", "{channel_1}{the_monster_1} glares icily {at_foe_1}.", "{channel_1}{the_monster_1}冰冷地瞪视 {at_foe_1}。", "channel_1:key;the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.7393bcf223a0bebc", "The priest curses, \"Your faithless show of piety disgusts me!\"", "祭司咒骂道：“你这不虔的伪善模样让我恶心！”", ""},
    {"speech.monspeak.73a8b4b70a551755", "{the_monster_1} says, \"This hit and run is way beneath me.\"", "{the_monster_1}说：“这种打了就跑的把戏，实在有失我的身份。”", "the_monster_1:name"},
    {"speech.monspeak.73b94367654b5ff2", "{channel_1}{the_monster_1} pauses a moment, imagining something with a smile on {possessive_1} face.", "{channel_1}{the_monster_1}停顿片刻，脸上带着微笑，想象着{possessive_1}心中所想。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.73bdb3ba0d7008bf", "{the_monster_1} roars.", "{the_monster_1}咆哮。", "the_monster_1:name"},
    {"speech.monspeak.73bf283e500e3488", "{the_monster_1} whispers, \"I have become one of them.\"", "{the_monster_1}低语道：“我已经变成了他们中的一员。”", "the_monster_1:name"},
    {"speech.monspeak.73c1bb811be316f1", "{channel_1}{the_monster_1} attempts to regain {possessive_1} composure.", "{channel_1}{the_monster_1}试图恢复{possessive_1}镇定。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.73d460416705366b", "{related_beogh_orc_1}", "{related_beogh_orc_1}", "related_beogh_orc_1:text"},
    {"speech.monspeak.73d6fa4e1d538939", "{the_monster_1} says, \"You troglodyte!\"", "{the_monster_1}说：“你这个穴居人！”", "the_monster_1:name"},
    {"speech.monspeak.73d8235c3d850a08", "{the_monster_1} says, \"I will journey to Hell to retrieve him!\"", "{the_monster_1}说：“我要下地狱把他带回来！”", "the_monster_1:name"},
    {"speech.monspeak.73eb63f20a1859c9", "{the_monster_1} screams {at_foe_1}, \"I want to be left alone!\"", "{the_monster_1}尖叫道 {at_foe_1}：“我只想一个人待着！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.73f0717c3862d9d6", "{the_monster_1} whispers, \"I obey. I obey. I obey.\"", "{the_monster_1}低声说：“我服从。我服从。我服从。”", "the_monster_1:name"},
    {"speech.monspeak.73fa33034488436c", "ladder", "梯子", ""},
    {"speech.monspeak.73fd55b30b6f202e", "{the_monster_1} gurgles, \"You're how I like my food. Fast!\"", "{the_monster_1}咕噜道：“你正是我喜欢的食物。快！”", "the_monster_1:name"},
    {"speech.monspeak.7401cfb11e7bd959", "{the_monster_1} says, \"Didn't you like your horns\?\"", "{the_monster_1}说：“你不喜欢你的角吗？”", "the_monster_1:name"},
    {"speech.monspeak.74229fb88d8195e1", "{the_monster_1} says {to_foe_1}, \"Someone hired me to kill you, but I'm not supposed to say who.\"", "{the_monster_1}说 {to_foe_1}：“有人雇我来杀你，但我不该说是谁。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.742e1ffc09dbe125", "{the_monster_1} says, \"Please, won't you take my hand.\"", "{the_monster_1}说：“求你了，来握住我的手吧。”", "the_monster_1:name"},
    {"speech.monspeak.74351da11a3e61dd", "{the_monster_1} says, \"I hate draconians.\"", "{the_monster_1}说：“我讨厌龙人。”", "the_monster_1:name"},
    {"speech.monspeak.744ba1bbfe44aedb", "the Feast", "盛宴", ""},
    {"speech.monspeak.745367a23c070970", "{the_monster_1} screams, \"{player_name_1}! Help!\"", "{the_monster_1}尖叫道：“{player_name_1}！救命！”", "the_monster_1:name;player_name_1:name"},
    {"speech.monspeak.7485a5fd7a48c630", "{the_monster_1} says {to_foe_1}, \"You need a new perspective.\"", "{the_monster_1}说 {to_foe_1}：“你需要换个角度看世界。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.748d608bd81f5476", "{crazy_yiuf_speech_1}", "{crazy_yiuf_speech_1}", "crazy_yiuf_speech_1:text"},
    {"speech.monspeak.74a7f6721d509ad4", "{the_monster_1} says, \"I don't get what's so special about the number twenty-seven.\"", "{the_monster_1}说：“我不懂二十七这个数字有什么特别的。”", "the_monster_1:name"},
    {"speech.monspeak.74a9e9dfd7928745", "{the_monster_1} {norris_verb_1} {to_foe_1}, \"The universe is like a big fish.\"", "{the_monster_1}{norris_verb_1} {to_foe_1}：“宇宙就像一条大鱼。”", "the_monster_1:name;norris_verb_1:text;to_foe_1:text"},
    {"speech.monspeak.74b6ffb4ca2a21a4", "{the_monster_1} says {to_foe_1}, \"Afraid of a little sting\?\"", "{the_monster_1}说 {to_foe_1}：“怕这点小蜇刺吗？”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.74bc410c893f6d13", "begs", "恳求道", ""},
    {"speech.monspeak.74be21d4d01d265a", "{the_monster_1} says, \"Are you willing to die fighting\? I was!\"", "{the_monster_1}说：“你愿意战死吗？我可是愿意的！”", "the_monster_1:name"},
    {"speech.monspeak.74bf37b391801755", "{the_monster_1} tries to make a funny facial expression.", "{the_monster_1}试着做出一个滑稽的表情。", "the_monster_1:name"},
    {"speech.monspeak.74cfba8dde4c33f9", "loudly", "大声地", ""},
    {"speech.monspeak.750714440e41e7f2", "{channel_1}{the_monster_possessive_1} face changes twice.", "{channel_1}{the_monster_possessive_1}脸变了两次。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.752f59defec29cea", "{the_monster_1} shouts {at_foe_1}, \"Stop bothering me, or I'll kill you!\"", "{the_monster_1}喊道 {at_foe_1}：“别再烦我，不然我就杀了你！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.753a96efb1500f0c", "{the_monster_1} says, \"What's so magical about quicksilver, anyway\?\"", "{the_monster_1}说：“水银到底有什么神奇的？”", "the_monster_1:name"},
    {"speech.monspeak.753ade3b6cc2435b", "{the_monster_1} sobs, \"I don't want it. Make it stop! Make it stop!\"", "{the_monster_1}抽泣道：“我不要它。让它停下！让它停下！”", "the_monster_1:name"},
    {"speech.monspeak.753e1d514bd2ea6a", "{channel_1}{the_monster_1} waves {possessive_1} whip at you.", "{channel_1}{the_monster_1}朝你挥舞{possessive_1}鞭子。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.754193a1aa3a4f7f", "{the_monster_1} {choice_1} about arcanists.", "{the_monster_1}{choice_1}着秘法师。", "the_monster_1:name;choice_1:text"},
    {"speech.monspeak.754193a1aa3a4f7f.choice_1.alt_0", "grouses", "抱怨", ""},
    {"speech.monspeak.754193a1aa3a4f7f.choice_1.alt_1", "grumbles", "嘟囔", ""},
    {"speech.monspeak.75424b7542493c5e", "{the_monster_1} groans, \"My... family...\" and then collapses, dead.", "{the_monster_1}呻吟道：“我的……家人……”随后便倒下，死了。", "the_monster_1:name"},
    {"speech.monspeak.755c70730f7e4ab3", "{the_monster_1} shouts {at_foe_1}, \"Hah! Missed me again!\"", "{the_monster_1}喊道 {at_foe_1}：“哈！又没打中我！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.7562eb5ca118070f", "{the_monster_1} burbles wildly.", "{the_monster_1}狂野地汩汩冒泡。", "the_monster_1:name"},
    {"speech.monspeak.757153133e8326f8", "{the_monster_1} {weeps_1} for your inevitable fate. {player_only_1}", "{the_monster_1}为你无法逃避的命运{weeps_1}。 {player_only_1}", "the_monster_1:name;weeps_1:text;player_only_1:text"},
    {"speech.monspeak.758f6d8ab4d00742", "{the_monster_1} says, \"I thought elves might be good for a party. Nope.\"", "{the_monster_1}说：“我以为精灵能一起开派对。结果不行。”", "the_monster_1:name"},
    {"speech.monspeak.7599d48aaee47f5b", "{the_monster_1} {shouts_1}, \"Die, {foe_name_1}, for besmirching Beogh's name!\"", "{the_monster_1}{shouts_1}：“死吧，{foe_name_1}，因为你玷污了比欧弗的名号！”", "the_monster_1:name;shouts_1:text;foe_name_1:name"},
    {"speech.monspeak.75a494e7aa34bafa", "{the_monster_1} says, \"I offered a draconian some spare armour, but he said it didn't fit.\"", "{the_monster_1}说：“我给了某条龙人一些备用护甲，但他说不合身。”", "the_monster_1:name"},
    {"speech.monspeak.75afd96aea111ab2", "{the_monster_1} says, \"Hawthorn can't hurt me.\"", "{the_monster_1}说：“山楂木伤不了我。”", "the_monster_1:name"},
    {"speech.monspeak.75d53807c226d0aa", "{vashnia_nonnaga_1}", "{vashnia_nonnaga_1}", "vashnia_nonnaga_1:text"},
    {"speech.monspeak.75e1584bb301c483", "{the_monster_1} says, \"If there's anything I hate more than water, it's brackish swamp water.\"", "{the_monster_1}说：“要说有什么比水更让我讨厌，那就是发臭的沼泽水。”", "the_monster_1:name"},
    {"speech.monspeak.761666c465b91037", "{the_monster_1} says {to_foe_1}, \"The wrath of {my_god_1} will be yours.\"", "{the_monster_1}说 {to_foe_1}：“{my_god_1}的怒火将会降临到你身上。”", "the_monster_1:name;to_foe_1:text;my_god_1:name"},
    {"speech.monspeak.762719d35f428685", "{the_monster_1} says {to_foe_1}, \"You will wish to die when I get to you.\"", "{the_monster_1}说 {to_foe_1}：“等落到我手里，你会一心求死。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.76303b3bf6632ba5", "{the_monster_1} says {to_foe_1}, \"Your kind have come here before. I understand now why. You desire death...\"", "{the_monster_1}说 {to_foe_1}：“你的同类以前也来过这里。我现在明白为什么了。你渴望死亡……”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.76433111e3af17ff", "{the_monster_1} looks {at_foe_1} and {grum_verb_1}, \"Time to put down the runt of the litter.\"", "{the_monster_1}看着 {at_foe_1}，{grum_verb_1}：“是时候处理掉这窝里最弱的那只了。”", "the_monster_1:name;at_foe_1:text;grum_verb_1:text"},
    {"speech.monspeak.7653c1780b8ac1e9", "{the_monster_1} gurgles, \"A snack! A snack!\"", "{the_monster_1}咕噜道：“点心！点心！”", "the_monster_1:name"},
    {"speech.monspeak.76918088b6aed8fd", "mobile", "移动", ""},
    {"speech.monspeak.76acbc887bb2415f", "{the_monster_1} howls in fear.", "{the_monster_1}恐惧地嚎叫。", "the_monster_1:name"},
    {"speech.monspeak.76aed6146dac90b8", "{channel_1}{the_monster_1} grinds {possessive_1} teeth.", "{channel_1}{the_monster_1}磨着{possessive_1}牙齿。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.76b84399e967905e", "{weeping_skull_rare_1}", "{weeping_skull_rare_1}", "weeping_skull_rare_1:text"},
    {"speech.monspeak.76d2b8633633708f", "{dowan_duvessa_dies_distance_1}", "{dowan_duvessa_dies_distance_1}", "dowan_duvessa_dies_distance_1:text"},
    {"speech.monspeak.76dbf87a5be3f1b0", "{the_monster_1} sighs and says, \"It wouldn't be so bad were it not for the bird droppings.\"", "{the_monster_1}叹息着说：“要不是有鸟粪，这里倒也不算太糟。”", "the_monster_1:name"},
    {"speech.monspeak.76f1609985825899", "{the_monster_1} says {to_foe_1}, \"Your head on a pike would complement this floor nicely.\"", "{the_monster_1}说 {to_foe_1}：“你的头插在长矛上，会把这片地面点缀得相当不错。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.76f79fe6561c17b8", "{the_monster_1} roars, \"I Iron Bound! You Brass... Trash!\"", "{the_monster_1}吼道：“俺是铁铸的！你是黄铜——是破烂！”", "the_monster_1:name"},
    {"speech.monspeak.77048cca3571e65c", "{the_monster_1} releases a deep croak.", "{the_monster_1}发出一声低沉的呱呱叫。", "the_monster_1:name"},
    {"speech.monspeak.771bdd9e3954df13", "{the_monster_1} mutters, \"I can hear her whispering... but she's dead. She's dead!\"", "{the_monster_1}嘟囔道：“我能听到她在低语……可她已经死了。她死了！”", "the_monster_1:name"},
    {"speech.monspeak.7721fe1a721a1aa6", "{the_monster_1} says, \"I'm really charged up about this fight.\"", "{the_monster_1}说：“我对这场战斗可是蓄满了电。”", "the_monster_1:name"},
    {"speech.monspeak.7726f49f1ddb2e3d", "The air crackles briefly around {the_monster_1}.", "{the_monster_1}周围的空气短暂地噼啪作响。", "the_monster_1:name"},
    {"speech.monspeak.777cf6a4a912370a", "{the_monster_1} says, \"Like I always say, the jar is half empty.\"", "{the_monster_1}说：“就像我常说的，罐子已经空了一半。”", "the_monster_1:name"},
    {"speech.monspeak.77968d2155ea2961", "{the_monster_1} shouts {at_foe_1}, \"I'll hammer you into slag!\"", "{the_monster_1}喊道 {at_foe_1}：“我要把你锤成炉渣！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.779aa5317761800e", "{the_monster_1} says {to_foe_1}, \"If you die in the Dungeon, but nobody's around to see it, does it really matter\?\"", "{the_monster_1}说 {to_foe_1}：“如果你死在地牢里，但周围没人看见，那真的算数吗？”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.77a33d9a2c6baee0", "{the_monster_1} shouts, \"I yield! You are indeed the chosen one!\"", "{the_monster_1}喊道：“我投降！你确实是天选之人！”", "the_monster_1:name"},
    {"speech.monspeak.77b2bef3da1a1122", "{the_monster_1} says, \"Who designed this place\? It's just a bunch of weird little rooms stuck together.\"", "{the_monster_1}说：“这地方是谁设计的？就是一堆古怪的小房间挤在一起。”", "the_monster_1:name"},
    {"speech.monspeak.77b6c5c4b08158be", "{friendly_confused_common_1}", "{friendly_confused_common_1}", "friendly_confused_common_1:text"},
    {"speech.monspeak.77df179a6d2ee176", "{the_monster_1} says, \"Finally, peace and quiet.\"", "{the_monster_1}说：“终于，清静了。”", "the_monster_1:name"},
    {"speech.monspeak.77e5dc6b2d5ea69f", "{the_monster_1} screams {at_foe_1}, \"I hate trespassers!\"", "{the_monster_1}尖叫道 {at_foe_1}：“我恨擅自闯入者！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.7819f7437a7e6f38", "{generic_ranged_1}", "{generic_ranged_1}", "generic_ranged_1:text"},
    {"speech.monspeak.782c2f2ab78076b6", "{the_monster_1} screams {at_foe_1}, \"You must be punished!\"", "{the_monster_1}尖叫 {at_foe_1}：“你必须受到惩罚！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.7830ce34e16a289f", "{the_monster_1} says, \"Oh, this is rather nice.\"", "{the_monster_1}说：“哦，这儿还挺不错。”", "the_monster_1:name"},
    {"speech.monspeak.7833a9c73d61d78d", "{channel_1}You feel troubled. {player_only_1}", "{channel_1}你感到不安。{player_only_1}", "channel_1:key;player_only_1:text"},
    {"speech.monspeak.784ce526d0868e40", "{the_monster_1} honks.", "{the_monster_1}发出喇叭般的鸣响。", "the_monster_1:name"},
    {"speech.monspeak.78614f869541ad2b", "{the_monster_1} says, \"Wow, fire everywhere! I hate that.\"", "{the_monster_1}说：“哇，到处都是火！我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.787bfca574c37f0d", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.788082f1bf32e254", "{the_monster_1} wails.", "{the_monster_1}哀号着。", "the_monster_1:name"},
    {"speech.monspeak.789c7dfc557ed91c", "{the_monster_1} {says_or_shouts_1}, \"I'm proud to serve; I'm ready to die.\"", "{the_monster_1}{says_or_shouts_1}：“我为能效劳而自豪；我已准备好赴死。”", "the_monster_1:name;says_or_shouts_1:text"},
    {"speech.monspeak.78abbb23eab69a62", "{channel_1}{the_monster_1} kicks a rock and scowls.", "{channel_1}{the_monster_1}踢了一脚石头，满脸不悦。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.78d48d2bd8d415a3", "{channel_1}{the_monster_1} pounds {possessive_1} chest with {possessive_2} fists.", "{channel_1}{the_monster_1}用{possessive_1}拳头捶打{possessive_2}胸膛。", "channel_1:key;the_monster_1:name;possessive_1:text;possessive_2:text"},
    {"speech.monspeak.791ac022b64a5d31", "{the_monster_1} says, \"So the shops here weren't enough for you\?\"", "{the_monster_1}说：“所以这儿的商店还不够你用吗？”", "the_monster_1:name"},
    {"speech.monspeak.791e591f3abf5182", "{the_monster_1} shouts {at_foe_1}, \"At last, some action!\"", "{the_monster_1}喊道 {at_foe_1}：“终于有点动静了！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.792dff12cdb5a733", "{channel_1}{the_monster_1} sighs.", "{channel_1}{the_monster_1}叹了口气。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.7931148d0304e45c", "{the_monster_1} screams, \"Help!\"", "{the_monster_1}尖叫道：“救命！”", "the_monster_1:name"},
    {"speech.monspeak.7948f06bafd0abd7", "god-like", "神一般的", ""},
    {"speech.monspeak.795e74343c5281b1", "{the_monster_1} says, \"People will remember me! They'll remember me and die!\"", "{the_monster_1}说：“人们会记住我的！他们会记住我，然后死掉！”", "the_monster_1:name"},
    {"speech.monspeak.79b25d4a1fca5b27", "{roxanne_rare_1}", "{roxanne_rare_1}", "roxanne_rare_1:text"},
    {"speech.monspeak.79c046c4534214b8", "ena", "埃纳", ""},
    {"speech.monspeak.79c8ab6592ae301a", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.79d136dd3067e292", "{the_monster_1} shouts {at_foe_1}, \"The sands of time shall wipe you from history!\"", "{the_monster_1}喊道 {at_foe_1}：“时间之沙将把你从历史中抹去！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.79e7bf8f6639560e", "{the_monster_1} says, \"My goblins will feast on your bones.\"", "{the_monster_1}说：“我的地精们会在你的骨头上美餐一顿。”", "the_monster_1:name"},
    {"speech.monspeak.79f571f81bd1240e", "{the_monster_1} asks {foe_1} \"Do you like me\?\"", "{the_monster_1}问道 {foe_1}“你喜欢我吗？”", "the_monster_1:name;foe_1:text"},
    {"speech.monspeak.79fa67970867847a", "{pikel_rare_1}", "{pikel_rare_1}", "pikel_rare_1:text"},
    {"speech.monspeak.79fc458b6bb9c415", "{the_monster_1} gasps with {possessive_1} dying breath, \"Your fate... be upon your own head...\"", "{the_monster_1}用{possessive_1}最后一口气喘息道：“你的命运……终将由你自己承担……”", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.7a0120553f70ad48", "{the_monster_1} says, \"All wealth is product of labour.\"", "{the_monster_1}说：“所有财富都是劳动的产物。”", "the_monster_1:name"},
    {"speech.monspeak.7a3a45bf29e96fca", "{channel_1}{the_monster_1} puffs mist at {foe_1}.", "{channel_1}{the_monster_1}朝{foe_1}喷出一团雾气。", "channel_1:key;the_monster_1:name;foe_1:text"},
    {"speech.monspeak.7a47bcdca415aa95", "{channel_1}{the_monster_1} unfurls and squashes hidden {choice_1}.", "{channel_1}{the_monster_1}展开又压扁隐藏的{choice_1}。", "channel_1:key;the_monster_1:name;choice_1:text"},
    {"speech.monspeak.7a47bcdca415aa95.choice_1.alt_0", "antennae", "触角", ""},
    {"speech.monspeak.7a47bcdca415aa95.choice_1.alt_1", "spinnerets", "纺器", ""},
    {"speech.monspeak.7a47bcdca415aa95.choice_1.alt_2", "pseudopods", "伪足", ""},
    {"speech.monspeak.7a5f263f6f644854", "{channel_1}{the_monster_1} tugs at {possessive_1} hair.", "{channel_1}{the_monster_1}拽了拽{possessive_1}头发。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.7a6cc667f8c00a77", "{the_monster_1} says, \"Beogh has given me so many different colours to drink.\"", "{the_monster_1}说：“比欧弗给了我那么多种颜色来喝。”", "the_monster_1:name"},
    {"speech.monspeak.7a71da877256d3a7", "{the_monster_1} says, \"{player_name_1}, I'm a little confused!\"", "{the_monster_1}说：“{player_name_1}，我有点糊涂了！”", "the_monster_1:name;player_name_1:name"},
    {"speech.monspeak.7a7abdfbf5d245c7", "{high_priest_1}", "{high_priest_1}", "high_priest_1:text"},
    {"speech.monspeak.7a8c2edbdd43627c", "{the_monster_1} says, \"Don't move a muscle.\"", "{the_monster_1}说：“一根肌肉都别动。”", "the_monster_1:name"},
    {"speech.monspeak.7a92cda6503a3352", "the Joker", "小丑牌", ""},
    {"speech.monspeak.7a9d903aef8fe622", "Blight", "枯萎", ""},
    {"speech.monspeak.7ac1e184a2ba7756", "{the_monster_1} shouts, \"What's happening\?!\"", "{the_monster_1}喊道：“发生什么事了？！”", "the_monster_1:name"},
    {"speech.monspeak.7aca10d9dfc41a78", "{the_monster_1} says, \"Why is it so quiet\?\"", "{the_monster_1}说：“为什么这么安静？”", "the_monster_1:name"},
    {"speech.monspeak.7ae959673008ac79", "{prince_ribbit_common_1}", "{prince_ribbit_common_1}", "prince_ribbit_common_1:text"},
    {"speech.monspeak.7b32565932fa1708", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.7b49af54d1912f64", "{channel_1}{the_monster_1} wildly waves {possessive_1} antennae.", "{channel_1}{the_monster_1}疯狂地摆动着{possessive_1}触角。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.7b58e3c8a03dc160", "{bennu_killed_1}", "{bennu_killed_1}", "bennu_killed_1:text"},
    {"speech.monspeak.7b6742c2f11e0637", "{the_monster_1} says, \"I'll be sure to list you as a co-author when my work is published!\"", "{the_monster_1}说：“等我的著作发表时，我一定会把你列为合著者！”", "the_monster_1:name"},
    {"speech.monspeak.7b71e637deb9c9f9", "{the_monster_1} says {to_foe_1}, \"They'll have to sweep you off the floor after I'm finished with you!\"", "{the_monster_1}说 {to_foe_1}：“等我收拾完你，他们就得拿扫帚把你从地上扫走了！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.7b7ef6155714602e", "{the_monster_1} says, \"Have you got some gold to spare\?\"", "{the_monster_1}说：“你手头有多的金币吗？”", "the_monster_1:name"},
    {"speech.monspeak.7b8c78a910e3d47b", "{channel_1}{the_monster_possessive_1} fingertips begin to glow.", "{channel_1}{the_monster_possessive_1}指尖开始发光。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.7b918c3ca29a73a9", "{the_monster_1} growls.", "{the_monster_1}低吼。", "the_monster_1:name"},
    {"speech.monspeak.7b92fc03082b1f78", "{the_monster_1} says, \"Angels painted black are so last century.\"", "{the_monster_1}说：“天使涂成黑色早就过时了。”", "the_monster_1:name"},
    {"speech.monspeak.7b989ce999fee34d", "{the_monster_1} says {to_foe_1}, \"The expert in battle moves the enemy, and is not moved by them.\"", "{the_monster_1}说 {to_foe_1}：“善战者，致人而不致于人。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.7bcdb8d6b1890457", "{the_monster_1} says, \"Tell me how much this hurts, okay\? I need more data.\"", "{the_monster_1}说：“告诉我这有多疼，好吗？我需要更多数据。”", "the_monster_1:name"},
    {"speech.monspeak.7be32f2e26a398c2", "{channel_1}{the_monster_1} clenches {possessive_1} claws.", "{channel_1}{the_monster_1}攥紧{possessive_1}爪子。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.7c051cb2787d91aa", "{the_monster_1} asks, \"Do you mind if I name my boat the '{player_name_1}'\? Your head will be paying for it, after all.\" {player_only_1}", "{the_monster_1}问：“你介意我把我的船命名为‘{player_name_1}’号吗？毕竟你的脑袋会替我付这笔钱。”{player_only_1}", "the_monster_1:name;player_name_1:name;player_only_1:text"},
    {"speech.monspeak.7c0a212ce56f634d", "{blorkula_rare_1}", "{blorkula_rare_1}", "blorkula_rare_1:text"},
    {"speech.monspeak.7c0fd1a6f425ce28", "{channel_1}{the_monster_possessive_1} eyes start to glow.", "{channel_1}{the_monster_possessive_1}双眼开始发光。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.7c1094a4796b361d", "the importance of the Law.", "法则的重要性。", ""},
    {"speech.monspeak.7c2acff0bb64acca", "{the_monster_1} says {to_foe_1}, \"Die!\"", "{the_monster_1}说 {to_foe_1}：“死！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.7c38d413197cb06c", "{the_monster_1} draws the Swarm. \"Bees, bees everywhere!\"", "{the_monster_1}抽到了蜂群。“蜜蜂，到处都是蜜蜂！”", "the_monster_1:name"},
    {"speech.monspeak.7c43283b6cba5ed6", "{the_monster_1} says, \"Beogh doesn't mind all this killing, you know.\"", "{the_monster_1}说：“你知道，比欧弗并不介意这些杀戮。”", "the_monster_1:name"},
    {"speech.monspeak.7c5e0238663de91b", "{the_monster_1} says, \"I tear you limb from limb!\"", "{the_monster_1}说：“我要把你一块块撕碎！”", "the_monster_1:name"},
    {"speech.monspeak.7c7b7b05f79563b9", "famine", "饥荒", ""},
    {"speech.monspeak.7c7e69d1d1ad475f", "{the_monster_1} says, \"Someone should clean these parts. I hate webs.\"", "{the_monster_1}说：“该有人来打扫打扫这一带了。我讨厌蛛网。”", "the_monster_1:name"},
    {"speech.monspeak.7c89a6321d46722b", "{the_monster_1} groans, \"What are you, a monk\?\"", "{the_monster_1}呻吟道：“你是什么人啊，苦行僧吗？”", "the_monster_1:name"},
    {"speech.monspeak.7c8cd46afc06ffea", "{the_monster_1} says, \"I'm quite good with sums, too.\"", "{the_monster_1}说：“我的算术也相当不错。”", "the_monster_1:name"},
    {"speech.monspeak.7cccfd1f73005ec4", "{channel_1}{the_monster_1} looks to the heavens.", "{channel_1}{the_monster_1}仰望天空。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.7ce1a6bcc8d5e606", "{channel_1}{the_monster_1} {choice_1} {possessive_1} weapon.", "{channel_1}{the_monster_1}{choice_1}{possessive_1}武器。", "channel_1:key;the_monster_1:name;choice_1:text;possessive_1:text"},
    {"speech.monspeak.7ce1a6bcc8d5e606.choice_1.alt_0", "struggles to reload", "费力地装填", ""},
    {"speech.monspeak.7ce1a6bcc8d5e606.choice_1.alt_1", "effortlessly reloads", "毫不费力地装填", ""},
    {"speech.monspeak.7cf3266ca114e9fa", "{the_monster_1} says, \"I keep getting this feeling like someone's watching me. Creepy.\"", "{the_monster_1}说：“我老觉得有人在盯着我。真瘆人。”", "the_monster_1:name"},
    {"speech.monspeak.7cf3d63b7ea244f0", "{boris_rare_1}", "{boris_rare_1}", "boris_rare_1:text"},
    {"speech.monspeak.7cf99cbfd32129de", "{the_monster_1} makes a face at you and exclaims, \"Curses!\"", "{the_monster_1}朝你做了个鬼脸，叫道：“天杀的！”", "the_monster_1:name"},
    {"speech.monspeak.7d0fc83f58686200", "{the_monster_1} says, \"Do you have an apple\? I have a shot I want to try.\"", "{the_monster_1}说：“你有苹果吗？我有一箭想试试。”", "the_monster_1:name"},
    {"speech.monspeak.7d121459b6a86608", "light", "光", ""},
    {"speech.monspeak.7d12f7db465f574f", "{the_monster_1} says, \"People think my brother is the best. I think he's crazy.\"", "{the_monster_1}说：“大家都觉得我哥哥最厉害。我觉得他疯了。”", "the_monster_1:name"},
    {"speech.monspeak.7d16d97ba921f25f", "{channel_1}{the_monster_possessive_1} mouth opens, radula flailing wildly.", "{channel_1}{the_monster_possessive_1}的嘴张开了，齿舌狂乱地摆动。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.7d311298b84e41d5", "{the_monster_1} says, \"I haven't seen any pirates yet. I hate pirates.\"", "{the_monster_1}说：“我还没见到任何海盗。我讨厌海盗。”", "the_monster_1:name"},
    {"speech.monspeak.7d3a3c5bfed983a3", "{channel_1}{the_monster_1} shuffles one of {possessive_1} decks.", "{channel_1}{the_monster_1}洗着{possessive_1}牌组中的一副。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.7d4c152e3902bea4", "{the_monster_1} says, \"I feel rather peculiar.\"", "{the_monster_1}说：“我觉得怪怪的。”", "the_monster_1:name"},
    {"speech.monspeak.7d614128b50a151f", "{the_monster_1} says, \"The people that built this place\? They must be crazy.\"", "{the_monster_1}说：“建造这地方的人？他们肯定是疯了。”", "the_monster_1:name"},
    {"speech.monspeak.7d6e5557756de93c", "{mercenary_guard_1}", "{mercenary_guard_1}", "mercenary_guard_1:text"},
    {"speech.monspeak.7d74c6f3cce803c1", "truckle", "卑躬屈膝", ""},
    {"speech.monspeak.7d94f7e473b980e9", "{says_imp_taunt_1}", "{says_imp_taunt_1}", "says_imp_taunt_1:text"},
    {"speech.monspeak.7d98e7e70fabca8f", "Fire", "火", ""},
    {"speech.monspeak.7ddf3022a273527c", "{the_monster_1} grumbles, \"I\\'ll bet your bee is still using copper gearwork!\"", "{the_monster_1}抱怨道：“我敢打赌你的蜜蜂还在用铜制齿轮！”", "the_monster_1:name"},
    {"speech.monspeak.7dea764ff71b7bb4", "{the_monster_1} screams {at_foe_1}, \"{foe_god_1} is but a nuisance to me, mortal!\"", "{the_monster_1}尖叫 {at_foe_1}：“{foe_god_1}对我来说不过是个麻烦，凡人！”", "the_monster_1:name;at_foe_1:text;foe_god_1:name"},
    {"speech.monspeak.7e09eda1510aaf65", "hand", "手", ""},
    {"speech.monspeak.7e3cecd8d7fb9301", "{the_monster_1} says, \"{player_name_1}, I like you.\"", "{the_monster_1}说：“{player_name_1}，我喜欢你。”", "the_monster_1:name;player_name_1:name"},
    {"speech.monspeak.7e6cefb0f8ec6b30", "{the_monster_1} shouts {at_foe_1}, \"Some dancing partner you are!\"", "{the_monster_1}喊道 {at_foe_1}：“你这舞伴可真够差劲的！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.7eb484067fa6fbb4", "{the_monster_1} says, \"Why is everything spinning\?\"", "{the_monster_1}说：“为什么一切都在旋转？”", "the_monster_1:name"},
    {"speech.monspeak.7ec2c7fe5eabd06b", "{the_monster_1} {choice_1} about occultists.", "{the_monster_1}{choice_1}着神秘学家。", "the_monster_1:name;choice_1:text"},
    {"speech.monspeak.7ec2c7fe5eabd06b.choice_1.alt_0", "grouses", "抱怨", ""},
    {"speech.monspeak.7ec2c7fe5eabd06b.choice_1.alt_1", "grumbles", "嘟囔", ""},
    {"speech.monspeak.7ed5917ea21b59a8", "{maurice_common_1}", "{maurice_common_1}", "maurice_common_1:text"},
    {"speech.monspeak.7ed9dc5054fd39bc", "feline", "猫科的", ""},
    {"speech.monspeak.7ef7b9e1a4504182", "{the_monster_1} says, \"What about an ecumenical tavern\?\"", "{the_monster_1}说：“开一家普世酒馆怎么样？”", "the_monster_1:name"},
    {"speech.monspeak.7f0cd9cc345e6145", "{the_monster_1} {laughs_1} at the inevitable fate of oblivion.", "{the_monster_1}{laughs_1}着，笑那无可避免的湮灭命运。", "the_monster_1:name;laughs_1:text"},
    {"speech.monspeak.7f22ae3a89e392b3", "just saying no to mutations.", "对变异坚决说不。", ""},
    {"speech.monspeak.7f246747004a1cf2", "{the_monster_1} says, \"How do you sleep at night with all those storm clouds\?\"", "{the_monster_1}说：“顶着那些雷雨云，你晚上怎么睡得着？”", "the_monster_1:name"},
    {"speech.monspeak.7f25cfe5df3a810e", "{the_monster_1} says, \"Beogh must be pretty vain, having all those worshippers get remade in Beogh's image.\"", "{the_monster_1}说：“比欧弗一定很虚荣，让所有信徒都照着祂的样子重塑自己。”", "the_monster_1:name"},
    {"speech.monspeak.7f3bce92a39baed8", "{the_monster_1} says, \"I hate mutated serpents.\"", "{the_monster_1}说：“我讨厌变异的蛇。”", "the_monster_1:name"},
    {"speech.monspeak.7f40d8bb1583b9cd", "{the_monster_1} says {to_foe_1}, \"You sneer at my short blade, I will sneer at your cold corpse.\"", "{the_monster_1}说 {to_foe_1}：“你嘲笑我的短刃，我就嘲笑你那冰冷的尸体。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.7f43245a9a9e14c7", "{the_monster_1} threatens, \"Beogh's wrath is as vast as Beogh's mercy. Make your choice!\"", "{the_monster_1}威胁道：“比欧弗的怒火和他的慈悲一样浩大。做出你的选择吧！”", "the_monster_1:name"},
    {"speech.monspeak.7f5f2a8efd6dc2c1", "{channel_1}{the_monster_1} pines for a worthy opponent.", "{channel_1}{the_monster_1}渴望着一个值得一战的对手。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.7f7d90e988740b7c", "house", "宅子", ""},
    {"speech.monspeak.7f801ba950995cd9", "{channel_1}{the_monster_1} blows smoke rings.", "{channel_1}{the_monster_1}吐出一串烟圈。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.7f8956b29ef0e698", "{joseph_rare_1}", "{joseph_rare_1}", "joseph_rare_1:text"},
    {"speech.monspeak.7f935225cab148ba", "{channel_1}Water drips from {the_monster_possessive_1} barrel.", "{channel_1}水从{the_monster_possessive_1}炮管上滴落。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.7fb678c404075bf8", "{the_monster_1} says, \"Are you sure that summoning demons is a good idea\?\"", "{the_monster_1}说：“你确定召唤恶魔是个好主意？”", "the_monster_1:name"},
    {"speech.monspeak.7fd077f3205e5863", "{the_monster_1} says {to_foe_1}, \"Go ahead. Run away.\"", "{the_monster_1}说 {to_foe_1}：“跑吧，尽管跑。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.7fd208217469fd01", "{the_monster_1} says, \"What a chore.\"", "{the_monster_1}说：“真是件苦差事。”", "the_monster_1:name"},
    {"speech.monspeak.7fd4acf6dd70fc5e", "{the_monster_1} screams, \"{player_name_1}! Help me!\"", "{the_monster_1}尖叫道：“{player_name_1}！救救我！”", "the_monster_1:name;player_name_1:name"},
    {"speech.monspeak.7fe1048b1cc2e62a", "{the_monster_1} yells {at_foe_1}, \"I'm a mighty demonic power!\"", "{the_monster_1}大叫道 {at_foe_1}：“我可是强大的恶魔之力！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.7fe26081958f3a7b", "{the_monster_1} utters an oath, \"I will die for my friends!\"", "{the_monster_1}立誓道：“我愿为朋友们而死！”", "the_monster_1:name"},
    {"speech.monspeak.7fe65dc48ba01caf", "{the_monster_1} says, \"I sacrificed my body for ultimate power!\"", "{the_monster_1}说：“我为终极的力量献祭了自己的身体！”", "the_monster_1:name"},
    {"speech.monspeak.7ff27a294ba6a445", "{the_monster_1} says, \"What will you do after everything's destroyed\?\"", "{the_monster_1}说：“等一切都毁灭了，你打算干什么？”", "the_monster_1:name"},
    {"speech.monspeak.7ff5a53f92d7ccfa", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.7ff6f856e1f11b5b", "{the_monster_1} says {to_foe_1}, \"I know your future. Your future is death.\"", "{the_monster_1}说 {to_foe_1}：“我知道你的未来。你的未来就是死亡。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.7ffa118055b3e163", "{channel_1}{the_monster_1} flickers into the darkness.", "{channel_1}{the_monster_1}闪动着隐入黑暗。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.7fff5ceccc5ec225", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.800cf09245e989df", "{the_monster_1} screams {at_foe_1}, \"Stand, coward! You want a fight, show some honour!\"", "{the_monster_1}尖叫道 {at_foe_1}：“站起来，懦夫！想打架，就拿出点荣誉感来！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.803d1985d333e944", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.805b1b96101dcd1b", "Candle", "蜡烛", ""},
    {"speech.monspeak.805ca20d66058872", "{the_monster_1} twaddles, \"I had a jolly good time in life, and I have a jolly good time now!\"", "{the_monster_1}胡言乱语道：“我活着时快活极了，现在也快活极了！”", "the_monster_1:name"},
    {"speech.monspeak.805f00065638b991", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.806f9654343716e0", "{the_monster_1} cackles {at_foe_1}, \"I will rule the world!\"", "{the_monster_1}咯咯怪笑 {at_foe_1}：“我要统治这个世界！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.808414f5eb7b8455", "{the_monster_1} {norris_verb_1} {to_foe_1}, \"Let the waves take you.\"", "{the_monster_1}{norris_verb_1} {to_foe_1}：“让波浪带你走吧。”", "the_monster_1:name;norris_verb_1:text;to_foe_1:text"},
    {"speech.monspeak.808b62b72d81eec8", "{the_monster_1} says, \"You have all forgotten the taste of death.\"", "{the_monster_1}说：“你们都已经忘记了死亡的滋味。”", "the_monster_1:name"},
    {"speech.monspeak.80c545e1f5b9fc2f", "{the_monster_1} says, \"Enter my house and I will deliver you from evil.\" {player_only_1}", "{the_monster_1}说：“进我的宅邸来吧，我会把你从邪恶中解救出来。”{player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.80d108902873f248", "{the_monster_1} screams!", "{the_monster_1}尖叫起来！", "the_monster_1:name"},
    {"speech.monspeak.80ea50bef6a6333b", "{the_monster_1} mutters, \"Now where did you hide it\?\"", "{the_monster_1}嘟囔道：“你到底把它藏到哪儿去了？”", "the_monster_1:name"},
    {"speech.monspeak.80ee0461149aa829", "{channel_1}You feel disoriented. {player_only_1}", "{channel_1}你感到迷失方向。{player_only_1}", "channel_1:key;player_only_1:text"},
    {"speech.monspeak.80eec1055b2d766c", "{the_monster_1} says {to_foe_1}, \"Death will always conquer life.\"", "{the_monster_1}说 {to_foe_1}：“死亡终将征服生命。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.80f8122c02cfe4a7", "cattle farm", "牛场", ""},
    {"speech.monspeak.8102ba0b6e292edc", "{the_monster_1} screams, \"I nearly understand... Get out of my way!\"", "{the_monster_1}尖叫道：“我快要弄明白了……别挡我的路！”", "the_monster_1:name"},
    {"speech.monspeak.81408ea8dc8407c7", "{channel_1}{the_monster_1} blows smoke rings.", "{channel_1}{the_monster_1}吐出一个个烟圈。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.8152a0bd946fe768", "{channel_1}{the_monster_1} grins evilly.", "{channel_1}{the_monster_1}邪恶地咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.816188112bb7f442", "{the_monster_possessive_1} teeth chatter loudly.", "{the_monster_possessive_1}的牙齿咔咔作响。", "the_monster_possessive_1:name"},
    {"speech.monspeak.817c22aaadfee34a", "{the_monster_1} says {to_foe_1}, \"If only old Madame Brzewit could see me now!\"", "{the_monster_1}说 {to_foe_1}：“要是老布热维特夫人现在能看到我就好了！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.817e2a29018b1a3e", "{the_monster_1} says {to_foe_1}, \"I walk in shadow, and soon so shall you.\"", "{the_monster_1}说 {to_foe_1}：“我行走于阴影之中，很快你也会一样。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.81823f3a5474c173", "{the_monster_1} says, \"That colour you're wearing\? I hate that.\"", "{the_monster_1}说：“你穿的那个颜色？我讨厌那个。”", "the_monster_1:name"},
    {"speech.monspeak.818c84d733a6e6d5", "twenty-seven", "二十七", ""},
    {"speech.monspeak.819368569574218d", "mutations, and how to avoid them.", "变异，以及如何避免变异。", ""},
    {"speech.monspeak.81a3cca7908804f2", "{the_monster_1} screams {at_foe_1}, \"I'll haunt your nightmares!\"", "{the_monster_1}尖叫 {at_foe_1}：“我要闯入你的噩梦！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.81c86f12122427dc", "fealty", "效忠", ""},
    {"speech.monspeak.81cb447328309894", "sanguine", "血色", ""},
    {"speech.monspeak.81cbc61878ed6158", "{the_monster_1} says, \"These orcs are so stupid, they must've eaten the rune.\"", "{the_monster_1}说：“这帮兽人蠢得肯定把符文给吃了。”", "the_monster_1:name"},
    {"speech.monspeak.81f321a9a4447f3d", "{channel_1}{the_monster_1} gestures {at_foe_1} frantically.", "{channel_1}{the_monster_1}疯狂地打着手势 {at_foe_1}。", "channel_1:key;the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.81f9cf5e50f084a5", "{the_monster_1} calls out, \"Only Beogh rules here!\"", "{the_monster_1}高声喊道：“这里只有比欧弗说了算！”", "the_monster_1:name"},
    {"speech.monspeak.821825593131d579", "{the_monster_1} shouts, \"This is my domain now; anyone trespasses at their own peril!\"", "{the_monster_1}喊道：“这里如今是我的地盘；谁闯进来，谁就自己承担后果！”", "the_monster_1:name"},
    {"speech.monspeak.8219e6cc8b14ac1f", "{the_monster_1} says, \"I hate purple.\"", "{the_monster_1}说：“我讨厌紫色。”", "the_monster_1:name"},
    {"speech.monspeak.82325bb6ab203338", "{mercenary_guard_rare_1}", "{mercenary_guard_rare_1}", "mercenary_guard_rare_1:text"},
    {"speech.monspeak.823f8ea497afcb19", "The priest snarls, \"I'll spare you only if you run away! Begone!\"", "祭司龇牙道：“你若逃跑，我倒是可以饶你一命！滚吧！”", ""},
    {"speech.monspeak.82439594b6d23bbc", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.824b3eccfdfe51f0", "{demon_taunt_1}", "{demon_taunt_1}", "demon_taunt_1:text"},
    {"speech.monspeak.825290aa6994b96d", "{the_monster_1} says, \"You can't fire me, I quit!\"", "{the_monster_1}说：“你开除不了我，我不干了！”", "the_monster_1:name"},
    {"speech.monspeak.826ee937b72e466c", "{the_monster_1} prays for help.", "{the_monster_1}祈祷求助。", "the_monster_1:name"},
    {"speech.monspeak.8276bdc32495645c", "{hound_1}", "{hound_1}", "hound_1:text"},
    {"speech.monspeak.827961082e118d62", "laughs", "大笑道", ""},
    {"speech.monspeak.828661b5bf96b1f6", "{channel_1}{the_monster_1} shimmers violently.", "{channel_1}{the_monster_1}剧烈地闪烁着微光。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.82a39062a738c2f5", "Buddy", "哥们", ""},
    {"speech.monspeak.82a78dfd2c859f03", "{the_monster_1} hums a lullaby.", "{the_monster_1}哼着摇篮曲。", "the_monster_1:name"},
    {"speech.monspeak.82cf7bd46193bee5", "{the_monster_1} squints and says {to_foe_1}, \"My one eye mightn't be all that good, but I can see you just fine with it, harpy.\"", "{the_monster_1}眯起眼睛说 {to_foe_1}：“我这一只眼也许不太好使，但用它看清你绰绰有余，鸟妖。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.82d5ea741c407a74", "{the_monster_1} shouts {at_foe_1}, \"Wow!\"", "{the_monster_1}喊道 {at_foe_1}：“哇！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.82ddc33fa7de60e3", "{the_monster_1} says, \"I wonder if there's an end to this place.\"", "{the_monster_1}说：“不知道这地方有没有尽头。”", "the_monster_1:name"},
    {"speech.monspeak.82e510d325239f71", "{the_monster_1} laughs at you. \"Don't get delusional, you can't win!\"", "{the_monster_1}嘲笑你。“别痴心妄想了，你赢不了！”", "the_monster_1:name"},
    {"speech.monspeak.82e8dcaad8d3811c", "{the_monster_1} looks down at {possessive_1} mortal wounds and cries, \"But... this was my last day before retirement...\"", "{the_monster_1}低头看着{possessive_1}致命伤，哭喊道：“可是……今天是我退休前的最后一天啊……”", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.82ea6d07993a975a", "{the_monster_1} yells, \"Just try that again; I dare you!\"", "{the_monster_1}喊道：“有种再来一次，我等着！”", "the_monster_1:name"},
    {"speech.monspeak.82f0cc2670d11f4a", "{the_monster_1} says {to_foe_1}, \"You will make a fine sacrifice.\"", "{the_monster_1}说 {to_foe_1}：“你会成为上好的祭品。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.83030a96258f8679", "{the_monster_1} sighs, \"Your wits are somehow even duller than your claws.\"", "{the_monster_1}叹息道：“你的脑子，竟比你的爪子还钝。”", "the_monster_1:name"},
    {"speech.monspeak.8331d73915f014e4", "{the_monster_1} says {to_foe_1}, \"I'm tired of war. But if you want blood, you'll get blood!\"", "{the_monster_1}说 {to_foe_1}：“我厌倦了战争。但如果你想见血，那就让你见血！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.8341ac58e3573aaa", "{the_monster_1} roars, \"Praise to Beogh!\"", "{the_monster_1}吼道：“赞美比欧弗！”", "the_monster_1:name"},
    {"speech.monspeak.83467da6f9fd0d44", "{the_monster_1} gurgles, \"I'll eat you, I will!\"", "{the_monster_1}咕噜道：“我要吃了你，一定会的！”", "the_monster_1:name"},
    {"speech.monspeak.83843b6241bcfb4b", "{the_monster_1} says, \"I'm proud to be an orc.\"", "{the_monster_1}说：“我为身为兽人而自豪。”", "the_monster_1:name"},
    {"speech.monspeak.8396ad42b8935cfe", "{the_monster_1} says {to_foe_1}, \"Come and play with me!\"", "{the_monster_1}说 {to_foe_1}：“来跟我玩呀！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.83a5d371534d0d0e", "{the_monster_1} {orc_says_1}, \"A dead {orc_heathen_1} will not bedevil my soul.\"", "{the_monster_1}{orc_says_1}：“死掉的{orc_heathen_1}缠不住我的灵魂。”", "the_monster_1:name;orc_says_1:text;orc_heathen_1:text"},
    {"speech.monspeak.83b5a36ba4d60f52", "{the_monster_1} {wails_1}, \"Death is your only future!\"", "{the_monster_1} {wails_1}：“死亡是你唯一的未来！”", "the_monster_1:name;wails_1:text"},
    {"speech.monspeak.83be93e2b25c901a", "{the_monster_1} screams {at_foe_1}, \"You are doomed!\"", "{the_monster_1}尖叫 {at_foe_1}：“你注定在劫难逃！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.83cd4ec5de6441d0", "{channel_1}{the_monster_1} looks angrily to the heavens.", "{channel_1}{the_monster_1}愤怒地仰望天空。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.84099b03a9b72bd5", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.8419f468ff29ceaa", "{the_monster_1} says {to_foe_1}, \"Are you sure you're pointing that wand in the right direction\?\"", "{the_monster_1}说 {to_foe_1}：“你确定那根魔杖指的是正确的方向吗？”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.8451493696973ec2", "{the_monster_1} says, \"This is such a pointless quest.\"", "{the_monster_1}说：“这真是个毫无意义的任务。”", "the_monster_1:name"},
    {"speech.monspeak.8460a66a07a17de8", "{channel_1}{the_monster_1} looks at you with fury.", "{channel_1}{the_monster_1}狂怒地看着你。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.84677c4df85c2bf5", "{the_monster_1} asks, \"Where am I\? Why are you fighting me\?\"", "{the_monster_1}问：“我在哪儿？你为什么要和我打？”", "the_monster_1:name"},
    {"speech.monspeak.848280ddda3e4708", "{the_monster_1} says, \"Doesn't healing your enemies sound rather pointless\?\"", "{the_monster_1}说：“治疗你的敌人，听着就毫无意义，不是吗？”", "the_monster_1:name"},
    {"speech.monspeak.84957c33137e138a", "{the_monster_1} says, \"Death is but another step down the path of knowledge.\"", "{the_monster_1}说：“死亡不过是求知之路上的一步。”", "the_monster_1:name"},
    {"speech.monspeak.84a0ac98c015263e", "{the_monster_1} says, \"You'd think there'd be more pits. I haven't seen any.\"", "{the_monster_1}说：“按说这儿的坑应该更多才对。我一个都没见着。”", "the_monster_1:name"},
    {"speech.monspeak.84a0b7f5844450d7", "{the_monster_1} says, \"Let's {cause_or_spread_1} {mayhem_1}!\"", "{the_monster_1}说：“让我们{cause_or_spread_1}{mayhem_1}吧！”", "the_monster_1:name;cause_or_spread_1:text;mayhem_1:text"},
    {"speech.monspeak.84c02abf268e7f58", "{the_monster_1} thanks you for bringing {objective_1} back to life.", "{the_monster_1}感谢你把{objective_1}复活。", "the_monster_1:name;objective_1:text"},
    {"speech.monspeak.84c8a506514a04d5", "{the_monster_1} says, \"Man, I can't wait until I find the rune.\"", "{the_monster_1}说：“天哪，我迫不及待想找到符文了。”", "the_monster_1:name"},
    {"speech.monspeak.84c8dda99fefce4f", "{channel_1}{the_monster_1} begins licking {possessive_1} fur clean.", "{channel_1}{the_monster_1}开始舔舐{possessive_1}皮毛，把自己舔得干干净净。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.84dd8e61209f9d50", "{the_monster_1} {shouts_1}, \"Blood in Beogh's name!\"", "{the_monster_1}{shouts_1}：“为比欧弗之名流血！”", "the_monster_1:name;shouts_1:text"},
    {"speech.monspeak.84e3d010c8ef8f52", "{duvessa_dowan_dies_distance_1}", "{duvessa_dowan_dies_distance_1}", "duvessa_dowan_dies_distance_1:text"},
    {"speech.monspeak.84eb5d0499893acb", "{the_monster_1} says, \"Death will end your pain.\"", "{the_monster_1}说：“死亡将终结你的痛苦。”", "the_monster_1:name"},
    {"speech.monspeak.84f4148737f68a30", "{terence_rare_1}", "{terence_rare_1}", "terence_rare_1:text"},
    {"speech.monspeak.8508689acee1e657", "{the_monster_1} says, \"So much for the uneasy undead.\"", "{the_monster_1}说：“还说什么亡灵不得安息呢。”", "the_monster_1:name"},
    {"speech.monspeak.851f6b628efc173f", "{the_monster_1} draws Torment. \"Half my health gone\? Yikes!\"", "{the_monster_1}抽到了折磨。“一半的生命值没了？哎呀！”", "the_monster_1:name"},
    {"speech.monspeak.8520d1b9d92d0b68", "steel... clashing", "钢铁……碰撞", ""},
    {"speech.monspeak.853119cfb6e7b7c2", "{the_monster_1} {orc_says_1}, \"With Beogh's help we'll overthrow all the false gods!\"", "{the_monster_1}{orc_says_1}：“有比欧弗相助，我们要推翻所有伪神！”", "the_monster_1:name;orc_says_1:text"},
    {"speech.monspeak.85419a7a31a3caac", "{the_monster_1} gasps, \"Did I... did I finally change the future\?\"", "{the_monster_1}喘息道：“我……我终于改变了未来吗？”", "the_monster_1:name"},
    {"speech.monspeak.858c53882e401e45", "{the_monster_1} {wails_1}, \"What do you have that I didn't have\?\"", "{the_monster_1} {wails_1}：“你有什么是我当年没有的？”", "the_monster_1:name;wails_1:text"},
    {"speech.monspeak.85c34bd285120406", "{the_monster_1} says, \"The so-called 'good' gods are just as evil as the rest. I hate hypocrisy.\"", "{the_monster_1}说：“那些所谓的‘善’神，跟别的神一样邪恶。我讨厌伪善。”", "the_monster_1:name"},
    {"speech.monspeak.85d002fd15c67657", "{friendly_silenced_common_1}", "{friendly_silenced_common_1}", "friendly_silenced_common_1:text"},
    {"speech.monspeak.85d4a4d04ceaaab8", "You", "你", ""},
    {"speech.monspeak.85dbf56ce3fd9b4f", "{channel_1}{the_monster_1} looks bored.", "{channel_1}{the_monster_1}看起来很无聊。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.85e30fac6033b894", "foot", "脚", ""},
    {"speech.monspeak.85edef78a3a1fcbd", "{the_monster_1} sings praise to the Shining One, in four-part harmony.", "{the_monster_1}以四部和声歌颂光明神。", "the_monster_1:name"},
    {"speech.monspeak.85f1e9cd65b08348", "{the_monster_1} says {to_foe_1}, \"It doesn't matter if you kill me. You'll still die.\"", "{the_monster_1}说 {to_foe_1}：“你杀不杀我都没关系。你照样得死。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.86179dc2166a1f6e", "{the_monster_1} vanishes in a satisfied sigh of withering leaves.", "{the_monster_1}在一阵枯叶的满足叹息中消失了。", "the_monster_1:name"},
    {"speech.monspeak.863a4c94d1585082", "{channel_1}{the_monster_1} bats away at the thin smoke enveloping {possessive_1} cannon.", "{channel_1}{the_monster_1}挥手驱散缠绕在{possessive_1}火炮周围的淡淡烟雾。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.863e1570d836b82b", "{channel_1}{the_monster_1} looks confused.", "{channel_1}{the_monster_1}一脸困惑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.86a829a349a5273d", "{channel_1}{the_monster_1} is surrounded with an aura of power.", "{channel_1}{the_monster_1}被一圈力量光环环绕。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.86bded77e807a007", "{the_monster_1} sighs {at_foe_1}, \"Enlightenment is such responsibility.\"", "{the_monster_1}叹息着说 {at_foe_1}：“开悟真是一种责任啊。”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.86cc166cf1c92634", "the Genie", "神灯精灵", ""},
    {"speech.monspeak.86ceff7800b29e50", "{the_monster_1} says, \"Someone said I could use acid to solve all my problems. It just made them worse.\"", "{the_monster_1}说：“有人跟我说，用酸能解决我所有的问题。结果只是让问题更糟了。”", "the_monster_1:name"},
    {"speech.monspeak.86e25a136567427b", "{the_monster_1} {mutters_1} to another spectator.", "{the_monster_1}向另一名观众{mutters_1}。", "the_monster_1:name;mutters_1:text"},
    {"speech.monspeak.86e96a0ceffe16fb", "{the_monster_1} says, \"Trust me, I'm a doctor.\"", "{the_monster_1}说：“相信我，我是医生。”", "the_monster_1:name"},
    {"speech.monspeak.86f8015133e50b9d", "{the_monster_1} says, \"How about we settle this with a race\?\"", "{the_monster_1}说：“要不我们用一场赛跑来分个高下？”", "the_monster_1:name"},
    {"speech.monspeak.86fa0d573e351e88", "plague and pestilence", "瘟疫与恶疾", ""},
    {"speech.monspeak.87179a1698aa511e", "{the_monster_1} says, \"My hands hurt, too.\"", "{the_monster_1}说：“我的手也好痛。”", "the_monster_1:name"},
    {"speech.monspeak.872c5d0142a152df", "{zenata_rare_1}", "{zenata_rare_1}", "zenata_rare_1:text"},
    {"speech.monspeak.8735d452980338e2", "{the_monster_1} says, \"See you in Hell!\"", "{the_monster_1}说：“地狱见！”", "the_monster_1:name"},
    {"speech.monspeak.87543217c41e772f", "{jessica_common_1}", "{jessica_common_1}", "jessica_common_1:text"},
    {"speech.monspeak.8780adc97655adac", "{the_monster_1} says, \"I'll bet you have a pretty dark future.\"", "{the_monster_1}说：“我打赌你的前途一片漆黑。”", "the_monster_1:name"},
    {"speech.monspeak.87902ebd95f84e8d", "{wiglaf_common_1}", "{wiglaf_common_1}", "wiglaf_common_1:text"},
    {"speech.monspeak.87acd3f469fc4639", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.87b03b5bb1b9f95a", "{the_monster_1} says {to_foe_1}, \"I'll gie ye a proper bath in magma.\"", "{the_monster_1}说 {to_foe_1}：“俺给你好好洗个岩浆澡。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.87d24ba9daf7ea14", "{the_monster_1} {wails_1}, \"Do you think the gods will protect you\?\"", "{the_monster_1} {wails_1}：“你以为众神会保护你吗？”", "the_monster_1:name;wails_1:text"},
    {"speech.monspeak.8800dbcb232fcc55", "{channel_1}{the_monster_1} tries to blend into {possessive_1} surroundings.", "{channel_1}{the_monster_1}试图融入{possessive_1}周围环境。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.884424e9e1146bbd", "{channel_1}{the_monster_1} blazes with dark energy!", "{channel_1}{the_monster_1}燃起黑暗的能量！", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.884bbf846bc5c656", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.887ee5df6e12da16", "{the_monster_1} {choice_1}, \"Oh dear! Oh dear!\"", "{the_monster_1}{choice_1}道：“天哪！天哪！”", "the_monster_1:name;choice_1:text"},
    {"speech.monspeak.887ee5df6e12da16.choice_1.alt_0", "moans", "呻吟", ""},
    {"speech.monspeak.887ee5df6e12da16.choice_1.alt_1", "wails", "哀号", ""},
    {"speech.monspeak.887ee5df6e12da16.choice_1.alt_2", "cries", "哭喊", ""},
    {"speech.monspeak.887f358ee4344d39", "{channel_1}{the_monster_1} sobs.", "{channel_1}{the_monster_1}抽泣着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.88932d7ae55c6ae2", "{the_monster_1} asks, \"Am I dreaming\? Is this real\?\"", "{the_monster_1}问：“我在做梦吗？这是真的吗？”", "the_monster_1:name"},
    {"speech.monspeak.88b2da28052f2bfe", "{the_monster_1} screams, \"The power of Makhleb!\"", "{the_monster_1}尖叫道：“马科列布的力量！”", "the_monster_1:name"},
    {"speech.monspeak.88b702dd0066155d", "{the_monster_1} says, \"Don't fight so hard! You'll just burn out.\"", "{the_monster_1}说：“别那么拼命！你会把自己烧尽的。”", "the_monster_1:name"},
    {"speech.monspeak.88bc005657a7d40c", "{the_monster_1} says, \"It's the perfect time of year for a holiday!\"", "{the_monster_1}说：“现在正是一年里度假的绝佳时节！”", "the_monster_1:name"},
    {"speech.monspeak.88bd26c69ed69a6c", "{the_monster_1} whispers, \"Trust me. Just give in.\"", "{the_monster_1}低声说：“相信我。放弃抵抗吧。”", "the_monster_1:name"},
    {"speech.monspeak.88c6394230155a7a", "{the_monster_1} snarls {at_foe_1}, \"Go! Away!\"", "{the_monster_1}咆哮道 {at_foe_1}：“走！走开！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.88d316b858dab25a", "{the_monster_1} gurgles, \"Are you a wizard\? Wizards taste nice...\"", "{the_monster_1}咕噜道：“你是巫师吗？巫师尝起来不错……”", "the_monster_1:name"},
    {"speech.monspeak.890837bfdd9d4885", "{the_monster_1} says, \"How do you find enough ash and charcoal to anoint them all\?\"", "{the_monster_1}说：“你上哪儿找那么多草木灰和木炭来给他们涂油？”", "the_monster_1:name"},
    {"speech.monspeak.890ca9e301f03840", "{channel_1}{the_monster_1} adjusts {possessive_1} apparatus.", "{channel_1}{the_monster_1}调整着{possessive_1}装置。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.890d985d4ed8a388", "{the_monster_1} says, \"I will avenge him!\"", "{the_monster_1}说：“我要为他报仇！”", "the_monster_1:name"},
    {"speech.monspeak.892acd3e51d3cfb5", "{channel_1}{the_monster_1} seems enamored of {foe_1}.", "{channel_1}{the_monster_1}似乎迷上了{foe_1}。", "channel_1:key;the_monster_1:name;foe_1:text"},
    {"speech.monspeak.8931816f52c4544a", "{ignacio_common_1}", "{ignacio_common_1}", "ignacio_common_1:text"},
    {"speech.monspeak.894436e956b20bc2", "{the_monster_1} chants and is briefly shrouded in fire.", "{the_monster_1}吟诵咒文，一时被火焰环绕。", "the_monster_1:name"},
    {"speech.monspeak.89495bd99e1441f4", "{the_monster_1} says, \"I hate being shackled.\"", "{the_monster_1}说：“我讨厌被锁链拴着。”", "the_monster_1:name"},
    {"speech.monspeak.895d3ca5d16aa661", "moans", "低声呻吟着", ""},
    {"speech.monspeak.8985ba7907a1ce4a", "{the_monster_1} says, \"You've danced your last steps.\"", "{the_monster_1}说：“你已经跳完了最后几步。”", "the_monster_1:name"},
    {"speech.monspeak.89a5c6d6eb72b7ef", "{the_monster_1} grunts.", "{the_monster_1}哼了一声。", "the_monster_1:name"},
    {"speech.monspeak.89c3c384463b312f", "{yredelemnul_donald_1}", "{yredelemnul_donald_1}", "yredelemnul_donald_1:text"},
    {"speech.monspeak.89d8b74097e46830", "{the_monster_1} says, \"I speak the language of demons!\"", "{the_monster_1}说：“我会说恶魔的语言！”", "the_monster_1:name"},
    {"speech.monspeak.89e48224b622aa34", "{jeremiah_rare_1}", "{jeremiah_rare_1}", "jeremiah_rare_1:text"},
    {"speech.monspeak.89e676538bae1cbb", "Scoff", "嘲笑", ""},
    {"speech.monspeak.89e6a91241633756", "{channel_1}{the_monster_1} does a somersault.", "{channel_1}{the_monster_1}翻了个跟头。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.89eb925716a0a825", "{the_monster_1} says, \"Chitin is about to be a thing of the past!\"", "{the_monster_1}说：“几丁质就要成为历史了！”", "the_monster_1:name"},
