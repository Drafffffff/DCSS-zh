    {"speech.monspeak.579c4bc70fc6f0c1", "{the_monster_1} says, \"I was promised divine protection. So much for that.\"", "{the_monster_1}说：“我曾被许诺神明的护佑。结果就这。”", "the_monster_1:name"},
    {"speech.monspeak.57c466a79262f972", "{related_beogh_orc_1}", "{related_beogh_orc_1}", "related_beogh_orc_1:text"},
    {"speech.monspeak.5856de0ab9708275", "{the_monster_1} moans, \"Good help so hard to find!\"", "{the_monster_1}哀号道：“好帮手真难找啊！”", "the_monster_1:name"},
    {"speech.monspeak.5869dd4f6493dd74", "{the_monster_1} says, \"If I carve 'Go Away' into myself, will Makhleb do that\?\"", "{the_monster_1}说：“如果我在自己身上刻上‘滚开’，马科列布也会这么干吗？”", "the_monster_1:name"},
    {"speech.monspeak.587642bfa4cd5546", "{channel_1}{the_monster_1} engages in an animated conversation with the air beside {objective_1}.", "{channel_1}{the_monster_1}和{objective_1}身旁的空气热烈地交谈着。", "channel_1:key;the_monster_1:name;objective_1:text"},
