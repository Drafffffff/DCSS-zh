    {"speech.monspeak.5e304c78e43a48d1", "{the_monster_1} screams {at_foe_1}, \"Hurry, death AWAITS you!\"", "{the_monster_1}尖叫 {at_foe_1}：“快点，死亡在等着你！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.5e45916e77f50ea2", "{the_monster_1} says, \"Your soul will be trapped in ice for ten thousand years.\"", "{the_monster_1}说：“你的灵魂将在冰中被囚禁一万年。”", "the_monster_1:name"},
    {"speech.monspeak.5e68cc4ef1470a7a", "{the_monster_1} holds {possessive_1} sides and says {to_foe_1}, \"You'll eat dirt beneath my feet.\"", "{the_monster_1}捂着{possessive_1}肚子，说 {to_foe_1}：“你会趴在我脚边吃土。”", "the_monster_1:name;possessive_1:text;to_foe_1:text"},
    {"speech.monspeak.5e76ee127ffce213", "{the_monster_1} says {to_foe_1}, \"I will spin a new home for us all.\"", "{the_monster_1}说 {to_foe_1}：“我要为我们大家织一个新家。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.5e89a6168f158142", "{the_monster_1} says, \"Dancing spiders\? With no cane or a top hat\?\"", "{the_monster_1}说：“会跳舞的蜘蛛？还没有手杖和大礼帽？”", "the_monster_1:name"},
    {"speech.monspeak.5e9bc6990b4c3f0b", "{the_monster_1} gurgles, \"Slow down, so I can eat you.\"", "{the_monster_1}咕噜道：“慢一点，好让我吃了你。”", "the_monster_1:name"},
