    {"speech.monspeak.f3c7860ecad759d2", "{the_monster_1} giggles, \"Dreams, dreams, come out to play!\"", "{the_monster_1}咯咯笑道：“梦啊，梦啊，出来玩吧！”", "the_monster_1:name"},
