    {"monster.target.ally_item", "  {ally}\n", "　{ally}\n", "ally:name"},
    {"monster.targeted_by_many", "{subject} {verb} currently targeted by:{items}", "{subject}{verb}目前被以下盟友选为目标：{items}", "subject:name;verb:text;items:text"},
    {"monster.targeted_by_one", "{subject} {verb} currently targeted by {ally}.", "{subject}{verb}目前被{ally}选为目标。", "subject:name;verb:text;ally:name"},
