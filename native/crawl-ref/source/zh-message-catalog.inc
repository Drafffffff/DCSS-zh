    {"speech.monspeak.b49cad78be32bb0a", "{the_monster_1} wails, \"I didn't mean to kill anyone! I'm not a murderer!\"", "{the_monster_1}号哭道：“我不是有意要杀人的！我不是杀人犯！”", "the_monster_1:name"},
    {"speech.monspeak.b4aa07e2818d67de", "painting", "绘画", ""},
    {"speech.monspeak.b4aae398471be0d8", "{the_monster_1} stares at you in amazement and kneels.", "{the_monster_1}惊讶地盯着你，跪了下来。", "the_monster_1:name"},
    {"speech.monspeak.b4bb8f9b1a6e13ad", "{the_monster_1} shouts, \"Turn back while you still can!\"", "{the_monster_1}喊道：“趁还来得及，回头吧！”", "the_monster_1:name"},
    {"speech.monspeak.b4c0e4c2fb09b6a7", "the sacred texts on", "圣典中关于", ""},
    {"speech.monspeak.b4d1ca9995a4353d", "{the_monster_1} sighs, \"Demons are the only companions you can really rely on.\"", "{the_monster_1}叹道：“只有恶魔才是你真正能依靠的伙伴。”", "the_monster_1:name"},
    {"speech.monspeak.b4e6216da393f2cf", "{the_monster_1} says, \"Everything's been so different since that missionary gave me these suspenders.\"", "{the_monster_1}说：“自从那位传教士给了我这副背带裤，一切都变得大不一样了。”", "the_monster_1:name"},
    {"speech.monspeak.b525f0139f1d7703", "grunts {at_foe_1}", "哼声道 {at_foe_1}", "at_foe_1:text"},
    {"speech.monspeak.b5325842543cc39f", "{the_monster_1} screams {at_foe_1}, \"I have something special for you.\"", "{the_monster_1}尖叫 {at_foe_1}：“我为你准备了点特别的东西。”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.b54a54bd3e507376", "{the_monster_1} says {to_foe_1}, \"You must be punished! Or... I want to punish you!\"", "{the_monster_1}说 {to_foe_1}：“你必须受到惩罚！或者……是我想要惩罚你！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.b54f495b3f4ca6b5", "{channel_1}{the_monster_1} smirks, showing shining fangs.", "{channel_1}{the_monster_1}咧嘴一笑，露出闪亮的尖牙。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.b5509065238b69cf", "senile", "衰老", ""},
    {"speech.monspeak.b571a1b704c53ff8", "{the_monster_1} says, \"It is extremely absurd to expect to be enlightened by reason, and yet to prescribe to it beforehand on which side it must incline.\"", "{the_monster_1}说：“一方面期待被理性启蒙，一方面又预先规定理性必须倾向哪一边，这是极其荒谬的。”", "the_monster_1:name"},
    {"speech.monspeak.b5942ee5c8284827", "{channel_1}{the_monster_1} is calmed by your holy aura.", "{channel_1}{the_monster_1}被你的神圣光环安抚下来。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.b59dd3493169384e", "{the_monster_1} sighs, \"Finally, I can get that {harold_retirement_plan_1} and settle down.\"", "{the_monster_1}叹息道：“终于，我能拿到{harold_retirement_plan_1}，安顿下来了。”", "the_monster_1:name;harold_retirement_plan_1:text"},
    {"speech.monspeak.b59f84693141e1cd", "{channel_1}{the_monster_1} spits at {foe_1}.", "{channel_1}{the_monster_1}朝{foe_1}啐了一口。", "channel_1:key;the_monster_1:name;foe_1:text"},
    {"speech.monspeak.b5a4c1f3a5368a6d", "{the_monster_1} says, \"Must be pretty hard to see through all that dust.\"", "{the_monster_1}说：“在漫天尘土里肯定很难看清东西。”", "the_monster_1:name"},
    {"speech.monspeak.b5b25b7d37b8521e", "{silenced_humanoid_common_1}", "{silenced_humanoid_common_1}", "silenced_humanoid_common_1:text"},
    {"speech.monspeak.b5c9bcc895c3bbed", "{josephina_rare_1}", "{josephina_rare_1}", "josephina_rare_1:text"},
    {"speech.monspeak.b5d242b0068abd38", "{the_monster_1} screams {at_foe_1}, \"Your blood will spurt and your skin will burst!\"", "{the_monster_1}尖叫 {at_foe_1}：“你的血会喷涌，你的皮会爆裂！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.b5d541f588b184b4", "{ignacio_rare_1}", "{ignacio_rare_1}", "ignacio_rare_1:text"},
    {"speech.monspeak.b5dcfa979748d6cf", "{channel_1}{the_monster_1} chortles and stares into space.", "{channel_1}{the_monster_1}咯咯笑着，瞪着虚空发呆。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.b5de8e5cb80e0856", "senseless", "无意义的", ""},
    {"speech.monspeak.b6015427fdd3b9aa", "{grunn_rare_1}", "{grunn_rare_1}", "grunn_rare_1:text"},
    {"speech.monspeak.b611e1efa0abb8c3", "{the_monster_1} shouts {at_foe_1}, \"By thae beards o' ma forefathars, ye wilnae live tae see tha morn'!\"", "{the_monster_1}喊道 {at_foe_1}：“凭俺祖宗的胡子起誓，你活不到明早！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.b6278c82d81f27cb", "{sojobo_advice_1}", "{sojobo_advice_1}", "sojobo_advice_1:text"},
    {"speech.monspeak.b629d7760cd94c33", "{the_monster_1} says {to_foe_1}, \"Bounty hunting has been great, but I can't wait to retire.\"", "{the_monster_1}说 {to_foe_1}：“当赏金猎人一直很不错，但我等不及要退休了。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.b65b21683ff28ae7", "{the_monster_1} says, \"Don't you wish for a portable bookcase\?\"", "{the_monster_1}说：“你不想要一个便携书架吗？”", "the_monster_1:name"},
    {"speech.monspeak.b674e11e09ac9a0b", "{the_monster_1} says, \"Those krakens don't even look real.\"", "{the_monster_1}说：“那些克拉肯看起来根本就不像真的。”", "the_monster_1:name"},
    {"speech.monspeak.b68a03bb35c0bb4f", "purity of body and mind.", "身心的纯洁。", ""},
    {"speech.monspeak.b6ab3e90ba08c00b", "shoe", "鞋", ""},
    {"speech.monspeak.b6bf6ad9187f8692", "{the_monster_1} says, \"I am proof that knowledge is power.\"", "{the_monster_1}说：“我就是知识即力量的证明。”", "the_monster_1:name"},
    {"speech.monspeak.b6d5f3c3cd03852e", "our flesh... melting", "我们的肉……在融化", ""},
    {"speech.monspeak.b6fb52e4c415de3f", "{the_monster_1} says {to_foe_1}, \"First you will suffer, then you will die.\"", "{the_monster_1}说 {to_foe_1}：“你会先受苦，然后再死。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.b705672276d9e8f2", "{the_monster_1} says, \"How much finesse does it take to swing your arms real fast, anyway\?\"", "{the_monster_1}说：“把胳膊抡得快一点，需要多少技巧？”", "the_monster_1:name"},
    {"speech.monspeak.b716fcb170fd1197", "{channel_1}{the_monster_1} stops to {choice_1} {possessive_1} wand.", "{channel_1}{the_monster_1}停下来{choice_1}{possessive_1}魔杖。", "channel_1:key;the_monster_1:name;choice_1:text;possessive_1:text"},
    {"speech.monspeak.b716fcb170fd1197.choice_1.alt_0", "study", "研究", ""},
    {"speech.monspeak.b716fcb170fd1197.choice_1.alt_1", "check on", "查看", ""},
    {"speech.monspeak.b723c174d8ae1010", "the fall of Yredelemnul.", "伊莱德莱姆努尔的堕落。", ""},
    {"speech.monspeak.b73baf5bca8d600f", "{the_monster_1} says, \"I hate Xom.\"", "{the_monster_1}说：“我讨厌佐姆。”", "the_monster_1:name"},
    {"speech.monspeak.b75e427a86fb68f1", "{the_monster_1} points {at_foe_1} and yells, \"Attack!\"", "{the_monster_1}指着 {at_foe_1}喊道：“上！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.b784ac8126a04c1d", "{the_monster_1} asks {foe_1} \"Have you met my wondrous brother\?\"", "{the_monster_1}问{foe_1}：“你见过我那位了不起的哥哥吗？”", "the_monster_1:name;foe_1:text"},
    {"speech.monspeak.b795fc28f331f61d", "{grum_rare_1}", "{grum_rare_1}", "grum_rare_1:text"},
    {"speech.monspeak.b7961917885a15e2", "{channel_1}{the_monster_1} looks friendly.", "{channel_1}{the_monster_1}看起来很友好。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.b7968518eeb91ef2", "{channel_1}{the_monster_1} grins devilishly.", "{channel_1}{the_monster_1}露出恶魔般的笑容。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.b7ba97d3dec56dd9", "{channel_1}{the_monster_1} pats {possessive_1} sizable gut.", "{channel_1}{the_monster_1}拍拍{possessive_1}硕大的肚子。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.b7bea11d3c01ba9c", "{the_monster_1} says, \"Where'd the sea come from\? I thought this place was underground.\"", "{the_monster_1}说：“这片海是打哪来的？我还以为这里在地下。”", "the_monster_1:name"},
    {"speech.monspeak.b7c4c8c207320610", "{channel_1}{the_monster_1} gestures with {possessive_1} weapon {at_foe_1}.", "{channel_1}{the_monster_1}挥舞{possessive_1}武器，指向{at_foe_1}。", "channel_1:key;the_monster_1:name;possessive_1:text;at_foe_1:text"},
    {"speech.monspeak.b810fbcce91293c8", "{the_monster_1} recites {recite_what_1} {recite_subject_1}", "{the_monster_1}背诵{recite_what_1}{recite_subject_1}", "the_monster_1:name;recite_what_1:text;recite_subject_1:text"},
    {"speech.monspeak.b816fffdeaffe169", "{the_monster_1} says, \"Killing you would be a chore, not a joy.\" {player_only_1}", "{the_monster_1}说：“杀你只会是件苦差，而非乐事。”{player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.b81fc28598757fe4", "{the_monster_1} says, \"This is an awful lot of space just to hold some junk.\"", "{the_monster_1}说：“就为了装些破烂，这地方也太空旷了。”", "the_monster_1:name"},
    {"speech.monspeak.b82b1ec393ca4018", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.b843c67fc52c02cc", "{channel_1}{the_monster_1} mockingly mimes being beheaded.", "{channel_1}{the_monster_1}嘲弄地模仿被斩首的样子。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.b889900437fb5705", "infidel", "不信者", ""},
    {"speech.monspeak.b8902e8a9fc64be5", "{channel_1}{the_monster_1} wails in agony.", "{channel_1}{the_monster_1}痛苦地哀号。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.b8c18905656f1043", "{channel_1}{the_monster_1} draws the symbol \"Udjat\" in the dust.", "{channel_1}{the_monster_1}在尘土中画出“乌加特”符号。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.b8df87a3de9bcd6b", "{channel_1}{the_monster_1} gestures rudely at you. {player_only_1}", "{channel_1}{the_monster_1}粗鲁地冲你比划着。{player_only_1}", "channel_1:key;the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.b8e1d94805ff47c0", "{the_monster_1} says, \"Have you seen my glasses\?\"", "{the_monster_1}说：“你们见到我的眼镜了吗？”", "the_monster_1:name"},
    {"speech.monspeak.b8f3b4798bcca7a2", "{the_monster_1} says, \"Ashes to ashes... so for me, and next for you!\"", "{the_monster_1}说：“尘归尘……先是我，接下来就是你！”", "the_monster_1:name"},
    {"speech.monspeak.b8fffa564b3d49a4", "{the_monster_1} says, \"You really are the Messiah.\"", "{the_monster_1}说：“你还真是弥赛亚。”", "the_monster_1:name"},
    {"speech.monspeak.b9089c9c31c4b91e", "{the_monster_1} says, \"Are you going to open a jelly farm when you find the Orb\?\"", "{the_monster_1}说：“等你找到宝珠，是不是要开一家胶冻农场？”", "the_monster_1:name"},
    {"speech.monspeak.b92c1fde473a3b6d", "{the_monster_1} says, \"I hate drums.\"", "{the_monster_1}说：“我讨厌鼓声。”", "the_monster_1:name"},
    {"speech.monspeak.b935a7673f5ed0bf", "{channel_1}{the_monster_1} seems to be having trouble coordinating all eight of {possessive_1} legs.", "{channel_1}{the_monster_1}似乎协调不好{possessive_1}全部八条腿。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.b938e2879f79da83", "{the_monster_1} asks, \"What has happened to me\?\"", "{the_monster_1}问道：“我这是怎么了？”", "the_monster_1:name"},
    {"speech.monspeak.b945ca96783e72a5", "Powder", "火药", ""},
    {"speech.monspeak.b95a10b00a0e9b6b", "{the_monster_1} says to you, \"Forge ahead, servant of Elyvilon!\"", "{the_monster_1}对你说：“向前进吧，艾利维隆的仆从！”", "the_monster_1:name"},
    {"speech.monspeak.b95ac2924a86c6ac", "loudly on", "诗篇中关于", ""},
    {"speech.monspeak.b964dbc8888ed4d0", "{channel_1}{the_monster_1} glowers.", "{channel_1}{the_monster_1}怒目而视。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.b97b249bd3e83091", "{the_monster_1} screams {at_foe_1}, \"Revenge!\"", "{the_monster_1}尖叫道 {at_foe_1}：“复仇！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.b97b4e9d7ade4db7", "{norris_common_1}", "{norris_common_1}", "norris_common_1:text"},
    {"speech.monspeak.b98e51e098b5a7b9", "{the_monster_1} giggles. \"Time to reap what you sow.\"", "{the_monster_1}咯咯笑着：“该是你收获播种之果的时候了。”", "the_monster_1:name"},
    {"speech.monspeak.b9b237b02305e84f", "centipede", "蜈蚣", ""},
    {"speech.monspeak.b9b8593827e122f5", "{the_monster_1} says {to_foe_1}, \"I will eat your liver.\"", "{the_monster_1}说 {to_foe_1}：“我要吃掉你的肝脏。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.b9bd700a7e78ec6f", "{the_monster_1} says, \"Pah! Those who rely on gods for strength get nowhere in life.\"", "{the_monster_1}说：“呸！那些靠神明来获取力量的人，这辈子一事无成。”", "the_monster_1:name"},
    {"speech.monspeak.b9ca290608846654", "{channel_1}{the_monster_1} flexes a bicep menacingly.", "{channel_1}{the_monster_1}威吓地鼓起一块二头肌。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.b9d3fb69f53b518e", "{friendly_hound_1}", "{friendly_hound_1}", "friendly_hound_1:text"},
    {"speech.monspeak.ba3962ebfc0d795b", "{the_monster_1} glances around and shouts, \"{grum_dog_name_1}! Here boy!\"", "{the_monster_1}环顾四周，喊道：“{grum_dog_name_1}！过来，乖狗狗！”", "the_monster_1:name;grum_dog_name_1:name"},
    {"speech.monspeak.ba3fc7173e2a7731", "{the_monster_1} screams in horror.", "{the_monster_1}惊恐地尖叫。", "the_monster_1:name"},
    {"speech.monspeak.ba4f0f5ec39cd77a", "{the_monster_1} {mutters_1}, \"When this is all over, I'm going to start a fungus farm.\"", "{the_monster_1}{mutters_1}：“等这一切结束，我要去开个真菌农场。”", "the_monster_1:name;mutters_1:text"},
    {"speech.monspeak.ba5bc521dfac014d", "{channel_1}{the_monster_possessive_1} bandages flutter.", "{channel_1}{the_monster_possessive_1}的绷带飘动着。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.ba61defd294f02ba", "{the_monster_1} says, \"Feel like your fire's burning out\? I hate that.\"", "{the_monster_1}说：“觉得你的火快烧完了？我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.ba722d71f7a27aba", "{the_monster_1} says, \"Isn't it convenient that your ancestor always knows how to fight\?\"", "{the_monster_1}说：“你的祖先总是知道怎么打架，这不是很方便吗？”", "the_monster_1:name"},
    {"speech.monspeak.ba7c459ac35d3a9c", "{frederick_1}", "{frederick_1}", "frederick_1:text"},
    {"speech.monspeak.ba8fe6b7863423bb", "{channel_1}{the_monster_1} tries to grin evilly.", "{channel_1}{the_monster_1}试着露出邪恶的笑容。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.ba9ace60ab6a625b", "{the_monster_1} marvels to itself over the thinness of mortal minds.", "{the_monster_1}独自惊叹于凡人心智之浅薄。", "the_monster_1:name"},
    {"speech.monspeak.babfc7be203c8f67", "{the_monster_1} shouts {at_foe_1}, \"You dare challenge my right as the Messiah\?\"", "{the_monster_1}喊道 {at_foe_1}：“你竟敢质疑我作为弥赛亚的资格？”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.bac456a79dbcc6b6", "{channel_1}{the_monster_1} shakes {possessive_1} head.", "{channel_1}{the_monster_1}摇了摇{possessive_1}头。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.baccdcd201e4b003", "{the_monster_1} says, \"You'll be just another bloodstain on the stones of this place.\"", "{the_monster_1}说：“你只会成为这地方石头上的又一块血迹。”", "the_monster_1:name"},
    {"speech.monspeak.bad05b769dee9c6c", "{dissolution_speech_1}", "{dissolution_speech_1}", "dissolution_speech_1:text"},
    {"speech.monspeak.baeff4282a3e50da", "{the_monster_1} hisses in an unknowable language.", "{the_monster_1}用一种不可知的语言嘶嘶作声。", "the_monster_1:name"},
    {"speech.monspeak.bafa3a4619813f1a", "{the_monster_1} {says_or_shouts_1}, \"Dying for Beogh gives my life meaning.\"", "{the_monster_1}{says_or_shouts_1}：“为比欧弗而死让我的人生有了意义。”", "the_monster_1:name;says_or_shouts_1:text"},
    {"speech.monspeak.bb003aa4b1e8ac44", "{channel_1}{the_monster_1} shakes in a combination of rage and grief.", "{channel_1}{the_monster_1}在狂怒与悲痛中颤抖着。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.bb04d124dd4ee6fc", "keeping your body clean and pure.", "让身体保持洁净纯粹。", ""},
    {"speech.monspeak.bb116daf1b4c2e31", "{channel_1}{the_monster_1} grins madly.", "{channel_1}{the_monster_1}疯狂地咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.bb42ab6aa1601954", "{the_monster_1} says {to_foe_1}, \"I didn't invite you.\"", "{the_monster_1}说 {to_foe_1}：“我可没邀请你来。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.bb44104f65219b5e", "{the_monster_1} asks {foe_1} \"Who are you\?\"", "{the_monster_1}问{foe_1}：“你是谁？”", "the_monster_1:name;foe_1:text"},
    {"speech.monspeak.bb475ebfbefb630d", "{channel_1}{the_monster_possessive_1} horned helmet rattles.", "{channel_1}{the_monster_possessive_1}带角头盔咔嗒作响。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.bb4f82c84883d6dc", "{channel_1}{the_monster_1} tries to grin evilly.", "{channel_1}{the_monster_1}试着露出邪恶的笑容。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.bb6ce374c75335d2", "{the_monster_1} says, \"Want to see my rocks\?\"", "{the_monster_1}说：“想看看俺的石头吗？”", "the_monster_1:name"},
    {"speech.monspeak.bb78befee7b61d96", "{the_monster_1} whispers {to_foe_1}, \"Come on in, the water's fine.\"", "{the_monster_1}低声说 {to_foe_1}：“来吧，水很舒服。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.bb78f9fae3e08eaa", "{the_monster_1} {loudly_or_repeatedly_1} {shouts_1} encouragement to no one in particular.", "{the_monster_1}{loudly_or_repeatedly_1}{shouts_1}，给不知是谁的人打气。", "the_monster_1:name;loudly_or_repeatedly_1:text;shouts_1:text"},
    {"speech.monspeak.bb867f1ee3603d00", "Proton", "质子", ""},
    {"speech.monspeak.bb8f1341abdb68fd", "{the_monster_1} says {to_foe_1}, \"First you will die, then you will suffer.\"", "{the_monster_1}说 {to_foe_1}：“你会先死去，然后再受苦。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.bbbdf1c7272bfa11", "{the_monster_1} says {to_foe_1}, \"Work for me\? I pay good.\"", "{the_monster_1}说 {to_foe_1}：“给我干活？俺付钱大方。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.bbd6ab57a5735d9e", "The priest shouts, \"Disloyal scoundrel, leave my sight!\"", "祭司喊道：“不忠的恶棍，滚出我的视线！”", ""},
    {"speech.monspeak.bbef74a626beba85", "{the_monster_1} snarls, \"Me hang you on necklace!\"", "{the_monster_1}咆哮道：“我要把你挂在项链上！”", "the_monster_1:name"},
    {"speech.monspeak.bc0300805ce83a19", "{the_monster_1} says, \"You called\?\"", "{the_monster_1}说：“你叫我？”", "the_monster_1:name"},
    {"speech.monspeak.bc0e3c45b9ef783f", "{the_monster_1} gibbers incoherently.", "{the_monster_1}语无伦次地胡言乱语。", "the_monster_1:name"},
    {"speech.monspeak.bc1024bc816504b6", "{the_monster_1} says, \"Perhaps I should have been a lumberjack. The trees might put up more of a fight.\"", "{the_monster_1}说：“也许我该去做个伐木工。树说不定还能反抗得更像样些。”", "the_monster_1:name"},
    {"speech.monspeak.bc181ab459f8eade", "{the_monster_1} says, \"Hey, I thought wands weren't allowed!\"", "{the_monster_1}说：“嘿，我以为魔杖是不允许用的！”", "the_monster_1:name"},
    {"speech.monspeak.bc1ac3d50aa09e3e", "{the_monster_1} says, \"I have seen things no one ever should.\"", "{the_monster_1}说：“我见过不该有人看见的东西。”", "the_monster_1:name"},
    {"speech.monspeak.bc65b1580caf3e4c", "{the_monster_1} growls, \"I'll break a bone for every stich ye rip.\"", "{the_monster_1}低吼道：“你每撕破一个针脚，俺就打断你一根骨头。”", "the_monster_1:name"},
    {"speech.monspeak.bc915c18fc0cd1d5", "{the_monster_1} grumbles {at_foe_1}, \"Just give up already, I want to go home!\"", "{the_monster_1}抱怨道 {at_foe_1}：“快投降吧，我想回家！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.bcb5c74b4c0cceac", "{the_monster_1} says {to_foe_1}, \"Magic and the sword, together, will defeat you.\" {player_only_1}", "{the_monster_1}说 {to_foe_1}：“魔法与剑合璧，必将击败你。”{player_only_1}", "the_monster_1:name;to_foe_1:text;player_only_1:text"},
    {"speech.monspeak.bcdb9e1df26d3d56", "{the_monster_1} says, \"Let it end in hellfire\? Why is there only one hellfire spell\?\"", "{the_monster_1}说：“让一切在地狱火中结束？为什么只有一种地狱火法术？”", "the_monster_1:name"},
    {"speech.monspeak.bce13cd943cd2a6e", "{the_monster_1} says, \"I hate ogres.\"", "{the_monster_1}说：“我讨厌食人魔。”", "the_monster_1:name"},
    {"speech.monspeak.bce9f3346ad8380c", "{the_monster_1} says, \"Do you just use necromancy for everything, then\?\"", "{the_monster_1}说：“所以你是干什么都用死灵术吗？”", "the_monster_1:name"},
    {"speech.monspeak.bcfb6c84c7b48d7c", "{generic_orc_speech_1}", "{generic_orc_speech_1}", "generic_orc_speech_1:text"},
    {"speech.monspeak.bd07394b14ba1d8a", "donkey", "驴", ""},
    {"speech.monspeak.bd1276e592918883", "{the_monster_1} {grum_verb_1} {at_foe_1}, \"My dogs and I will have a feast tonight...\"", "{the_monster_1} {grum_verb_1} {at_foe_1}：“今晚我和我的狗要大快朵颐……”", "the_monster_1:name;grum_verb_1:text;at_foe_1:text"},
    {"speech.monspeak.bd286b66b8a87914", "{asterion_common_1}", "{asterion_common_1}", "asterion_common_1:text"},
    {"speech.monspeak.bd31010fd5a06ef5", "{the_monster_1} says, \"Something's up my trousers! Aieee!\"", "{the_monster_1}说：“有东西钻进我裤子里了！啊啊啊！”", "the_monster_1:name"},
    {"speech.monspeak.bd3eb7d4dee5ffb2", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.bd50c3eea50a9cf3", "Castle", "城堡", ""},
    {"speech.monspeak.bd50e4448576c74b", "{channel_1}{the_monster_1} hisses silently.", "{channel_1}{the_monster_1}无声地嘶嘶作声。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.bd57923d0edb3823", "{the_monster_1} says, \"Replaced! How does it feel to be replaced\?\"", "{the_monster_1}说：“被换掉了！被换掉是什么滋味？”", "the_monster_1:name"},
    {"speech.monspeak.bd57f28f5bde5be8", "{the_monster_1} shouts at you, \"Continue thy quest, mortal!\"", "{the_monster_1}冲你喊道：“继续你的使命吧，凡人！”", "the_monster_1:name"},
    {"speech.monspeak.bd7f077acfdc1d8d", "{channel_1}{the_monster_1} beckons to {foe_1}.", "{channel_1}{the_monster_1}向 {foe_1}招手示意。", "channel_1:key;the_monster_1:name;foe_1:text"},
    {"speech.monspeak.bd8c693a1bfeb24f", "{the_monster_1} inspects {possessive_1} gathered herbal reagents.", "{the_monster_1}检查着{possessive_1}采集来的草药材料。", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.bd903625751533fe", "{the_monster_1} says, \"I'll learn you. I'll learn you yet!\"", "{the_monster_1}说：“我要教训教训你。我还没教训够呢！”", "the_monster_1:name"},
    {"speech.monspeak.bda9485034ff906f", "{channel_1}{the_monster_1} rolls around.", "{channel_1}{the_monster_1}滚来滚去。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.bdb01630ca1ae927", "{the_monster_1} sneers {at_foe_1}, \"Heretic!\"", "{the_monster_1}讥笑道 {at_foe_1}：“异端！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.bdb974de6a3c0fc3", "testudinal", "龟类的", ""},
    {"speech.monspeak.bddcd5b7ed92c282", "{channel_1}{the_monster_1} twirls {possessive_1} moustache.", "{channel_1}{the_monster_1}捻着{possessive_1}小胡子。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.bdf6d8c5db417aad", "Hive", "巢穴", ""},
    {"speech.monspeak.bdf9678dfccf25c2", "{the_monster_1} screams {at_foe_1}, \"No! No! YES! No!\"", "{the_monster_1}尖叫 {at_foe_1}：“不！不！好！不！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.be4aea974c81011c", "{channel_1}{the_monster_1} blinks {at_foe_1}.", "{channel_1}{the_monster_1}身形一闪 {at_foe_1}。", "channel_1:key;the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.be4d0ef0e25dec06", "Elyvilon", "艾利维隆", ""},
    {"speech.monspeak.be601e77312799e3", "{the_monster_1} says, \"You'll rust in Dis!\" {player_only_1}", "{the_monster_1}说：“你会在狄斯铁城里锈成渣！” {player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.be6bf97c6e2558c5", "{the_monster_1} rasps, \"We... will be... remembered!\"", "{the_monster_1}嘶哑地说：“我们……会被……记住的！”", "the_monster_1:name"},
    {"speech.monspeak.be7e39996639c43a", "{the_monster_1} {shouts_1}, \"Attack, my pets! Attack!\"", "{the_monster_1}{shouts_1}：“上啊，我的牲畜们！上！”", "the_monster_1:name;shouts_1:text"},
    {"speech.monspeak.be8d352b7083d97d", "{the_monster_1} says, \"At least {my_god_1} appreciates what I'm doing.\"", "{the_monster_1}说：“至少{my_god_1}还欣赏我在做的事。”", "the_monster_1:name;my_god_1:name"},
    {"speech.monspeak.bea45749e56b818a", "{the_monster_1} says, \"Sorry, didn't catch that. You worship who\? How do you spell it\?\"", "{the_monster_1}说：“抱歉，我没听清。你信的是哪位？怎么拼的？”", "the_monster_1:name"},
    {"speech.monspeak.bebb0fb194a34ad9", "{channel_1}{the_monster_possessive_1} eyes close briefly, then snap open.", "{channel_1}{the_monster_possessive_1}双眼短暂闭上，随即猛然睁开。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.bec62a596aac2b63", "{the_monster_1} says, \"One more harpy dead.\"", "{the_monster_1}说：“又死了一只鸟妖。”", "the_monster_1:name"},
    {"speech.monspeak.bec6df19cdba727a", "{channel_1}Energy condenses in front of {the_monster_1}, but quickly dissipates.", "{channel_1}能量在{the_monster_1}面前凝聚，随即又迅速消散了。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.bed328ba2647ae3f", "{the_monster_1} says, \"Watch and be amazed!\"", "{the_monster_1}说：“看好了，惊叹吧！”", "the_monster_1:name"},
    {"speech.monspeak.bee15288a1627ae3", "{the_monster_1} considers, \"I think I'll use your bounty to get a {harold_retirement_plan_1}...\" {player_only_1}", "{the_monster_1}盘算道：“我想我可以用你的赏金换一处{harold_retirement_plan_1}……”{player_only_1}", "the_monster_1:name;harold_retirement_plan_1:text;player_only_1:text"},
    {"speech.monspeak.bf3ad9d9232eeba5", "{the_monster_1} screams, \"Tenfold be your damnation!\"", "{the_monster_1}尖叫道：“愿你的诅咒十倍降临！”", "the_monster_1:name"},
    {"speech.monspeak.bf67997a26ca1bb9", "{the_monster_1} lets out a whooping war cry.", "{the_monster_1}发出一声高亢的战吼。", "the_monster_1:name"},
    {"speech.monspeak.bf83c99839619539", "arga", "阿尔加", ""},
    {"speech.monspeak.bf9bf9a5a8529d49", "{the_monster_1} says {to_foe_1}, \"Sometimes it's better to sink than to swim.\"", "{the_monster_1}说 {to_foe_1}：“有时沉下去比游起来更好。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.bfa5a5521c70d5d9", "{the_monster_1} {loudly_or_repeatedly_1} {shouts_1} encouragement{orc_modifier_1}", "{the_monster_1}{loudly_or_repeatedly_1}{shouts_1}，为不知是谁的人鼓劲{orc_modifier_1}", "the_monster_1:name;loudly_or_repeatedly_1:text;shouts_1:text;orc_modifier_1:text"},
    {"speech.monspeak.bfe11a50da8d71d7", "pizzabubble", "披萨泡泡", ""},
    {"speech.monspeak.bff0a3780707f6d9", "{subjective_1} says, \"I deserve death, but Beogh is merciful!\"", "{subjective_1}说：“我该死，可比欧弗是慈悲的！”", "subjective_1:text"},
    {"speech.monspeak.bff1eba3071a80c7", "{the_monster_1} speaks about {recite_subject_1}", "{the_monster_1}谈论{recite_subject_1}", "the_monster_1:name;recite_subject_1:text"},
    {"speech.monspeak.bffeb952ba4b35eb", "{the_monster_1} says, \"The adventurer who shines twice as bright burns out twice as fast.\"", "{the_monster_1}说：“光芒亮两倍的冒险者，烧尽也快两倍。”", "the_monster_1:name"},
    {"speech.monspeak.c011b0597efc294b", "Action", "行动", ""},
    {"speech.monspeak.c031cfcf966a2ef4", "{the_monster_1} shouts, \"The Pantheon deserves no one's loyalty. Let us show you the true path!\"", "{the_monster_1}喊道：“万神殿不配得到任何人的忠诚。让我们指给你真正的道路！”", "the_monster_1:name"},
    {"speech.monspeak.c04c2f5b49768735", "susurrates", "喃喃低语道", ""},
    {"speech.monspeak.c04d7140f2bba821", "{the_monster_1} says, \"Something seems a little bit odd about a God who wants to be paid.\"", "{the_monster_1}说：“一个想要人付钱的神，总觉得有点不对劲。”", "the_monster_1:name"},
    {"speech.monspeak.c07cb3222d2f1a9b", "{the_monster_1} says, \"From Slime we come, to Slime we go.\"", "{the_monster_1}说：“源出黏液，归入黏液。”", "the_monster_1:name"},
    {"speech.monspeak.c0827f4cde911b21", "{subjective_1} shouts, \"Surely Beogh must have sent you!\"", "{subjective_1}喊道：“一定是比欧弗派你来的！”", "subjective_1:text"},
    {"speech.monspeak.c0a46c97d600120a", "{the_monster_1} growls a series of guttural syllables.", "{the_monster_1}低吼出一连串喉音浓重的音节。", "the_monster_1:name"},
    {"speech.monspeak.c0d1ebb77db910f2", "{hostile_orc_beogh_believer_speech_rare_1}", "{hostile_orc_beogh_believer_speech_rare_1}", "hostile_orc_beogh_believer_speech_rare_1:text"},
    {"speech.monspeak.c0fd1d7c2d43ef67", "{channel_1}{the_monster_1} stares {at_foe_1}.", "{channel_1}{the_monster_1}凝视着 {at_foe_1}。", "channel_1:key;the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.c0fd34de33ea73f5", "{the_monster_1} says, \"What's the point of being chivalric if nobody's going to be chivalric back\?\"", "{the_monster_1}说：“要是没人对你讲骑士精神，讲骑士精神还有什么用？”", "the_monster_1:name"},
    {"speech.monspeak.c1444542754a9868", "{the_monster_1} says, \"The great annihilating truth is that I hate you.\"", "{the_monster_1}说：“那伟大的湮灭真理就是：我讨厌你。”", "the_monster_1:name"},
    {"speech.monspeak.c15e13bfa581a82f", "forty-two", "四十二", ""},
    {"speech.monspeak.c17320da1b435897", "{the_monster_1} asks, \"What kind of bones do {player_genus_plural_1} have\? My dogs are dying to find out.\" {player_only_1}", "{the_monster_1}问：“{player_genus_plural_1}的骨头是什么样的？我的狗都等不及想知道了。”{player_only_1}", "the_monster_1:name;player_genus_plural_1:name;player_only_1:text"},
    {"speech.monspeak.c17836ae949db8e1", "{the_monster_1} {begs_1} {to_foe_1}, \"Please! I have a lot of children!\"", "{the_monster_1} {begs_1} {to_foe_1}：“求你了！我有一大堆孩子！”", "the_monster_1:name;begs_1:text;to_foe_1:text"},
    {"speech.monspeak.c19d3aef85ee915f", "{the_monster_1} shouts, \"What's happening\?!\"", "{the_monster_1}喊道：“发生什么事了？！”", "the_monster_1:name"},
    {"speech.monspeak.c1d49a0118b830a0", "{channel_1}{the_monster_1} waves excitedly.", "{channel_1}{the_monster_1}兴奋地挥手。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.c1dc1ca3970ef8b5", "{the_monster_1} says, \"The death blow is fun, but the real pleasure is in torturing beforehand.\"", "{the_monster_1}说：“致命一击很有趣，但真正的乐趣在于事先的折磨。”", "the_monster_1:name"},
    {"speech.monspeak.c20e2b1fb4b6097d", "{channel_1}{the_monster_1} runs {possessive_1} fingers through {possessive_2} long green hair.", "{channel_1}{the_monster_1}用{possessive_1}手指梳理着{possessive_2}长长绿发。", "channel_1:key;the_monster_1:name;possessive_1:text;possessive_2:text"},
    {"speech.monspeak.c224d401f5ead6ac", "{the_monster_1} jeers {loudly_or_repeatedly_1} at you.", "{the_monster_1}{loudly_or_repeatedly_1}嘲弄着你。", "the_monster_1:name;loudly_or_repeatedly_1:text"},
    {"speech.monspeak.c257dcd53277f8c7", "{the_monster_1} says, \"I hate voyeurs.\"", "{the_monster_1}说：“我讨厌偷窥狂。”", "the_monster_1:name"},
    {"speech.monspeak.c270810c43cff9fe", "{channel_1}A chill runs down your spine. {player_only_1}", "{channel_1}一阵寒意顺着你的脊背流下。 {player_only_1}", "channel_1:key;player_only_1:text"},
    {"speech.monspeak.c274ade2dae8952f", "{the_monster_1} says, \"I am made of steel!\"", "{the_monster_1}说：“我是钢做的！”", "the_monster_1:name"},
    {"speech.monspeak.c2bf718f6c17da22", "{the_monster_1} says, \"Okawaru always makes me think of chokos.\"", "{the_monster_1}说：“一听到奥卡瓦鲁，我总想到佛手瓜。”", "the_monster_1:name"},
    {"speech.monspeak.c2cacfe235b58d88", "hums", "哼唱", ""},
    {"speech.monspeak.c2d2443b776f8b21", "{channel_1}{the_monster_possessive_1} cannon shakes and flares with a red glow.", "{channel_1}{the_monster_possessive_1}火炮颤抖着，闪出红光。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.c2d30a7d1f7aa432", "{the_monster_1} says, \"A plant spat acid at me. I hate that.\"", "{the_monster_1}说：“一棵植物朝我吐酸液。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.c2f62f9562599e0c", "{the_monster_1} says, \"I'm sure they'll be treated well, anyway.\"", "{the_monster_1}说：“反正我敢肯定他们会被好好对待的。”", "the_monster_1:name"},
    {"speech.monspeak.c2f90d1a354515cd", "{the_monster_1} whispers: \"Through my death, I saw my mistakes, and the mistakes of many more...\"", "{the_monster_1}低语道：“透过我自己的死亡，我看清了我的错误，也看清了更多人的错误……”", "the_monster_1:name"},
    {"speech.monspeak.c2fd40387a59d48c", "Peeping", "窥视", ""},
    {"speech.monspeak.c31e2e9f8384acec", "{channel_1}{the_monster_1} winks at you.", "{channel_1}{the_monster_1}冲你眨眼。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.c332ee0d8bbd5cbd", "{channel_1}{the_monster_1} wildly waves {possessive_1} antennae.", "{channel_1}{the_monster_1}疯狂地摆动着{possessive_1}触角。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.c33a039567832933", "{duvessa_dowan_dies_bytwin_1}", "{duvessa_dowan_dies_bytwin_1}", "duvessa_dowan_dies_bytwin_1:text"},
    {"speech.monspeak.c34abed7b7db4573", "{the_monster_1} makes a sound of rattling chains.", "{the_monster_1}发出锁链哗啦作响的声音。", "the_monster_1:name"},
    {"speech.monspeak.c351cc5e7cfb3a3a", "{the_monster_1} says, \"Skeletons give me the creeps.\"", "{the_monster_1}说：“骷髅让我起鸡皮疙瘩。”", "the_monster_1:name"},
    {"speech.monspeak.c37243e03ecc7c0e", "{the_monster_1} says, \"And that's why I'm the boss.\"", "{the_monster_1}说：“这就是为什么我是头儿。”", "the_monster_1:name"},
    {"speech.monspeak.c37fae091344a1ba", "{the_monster_1} says {to_foe_1}, \"Drop everything you've found here and return home.\"", "{the_monster_1}说 {to_foe_1}：“把你在这里找到的东西全放下，然后回家去。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.c3894266f6279a65", "spread", "散播", ""},
    {"speech.monspeak.c3bc97be4991c2dd", "{the_monster_possessive_1} ankle releases a plume of dust as {subjective_1} confides, \"I'm not really a mummy, you know.\"", "{the_monster_possessive_1}脚踝扬起一缕尘土，{subjective_1}坦言道：“你知道，我其实不是木乃伊。”", "the_monster_possessive_1:name;subjective_1:text"},
    {"speech.monspeak.c3c40ac0537ecc55", "{the_monster_1} says, \"I suppose everything's okay, then\?\"", "{the_monster_1}说：“这么说，一切都没问题喽？”", "the_monster_1:name"},
    {"speech.monspeak.c3cb51e409514751", "{the_monster_1} rasps, \"The flames... keep going out....\"", "{the_monster_1}嘶哑地说：“火焰……不断熄灭……”", "the_monster_1:name"},
    {"speech.monspeak.c423d9aa07b31347", "{the_monster_1} says {to_foe_1}, \"I don't need to breathe anymore, but you do!\"", "{the_monster_1}说 {to_foe_1}：“我已经不需要呼吸了，可你还需要！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.c424a181a71f75f0", "{the_monster_1} screams {at_foe_1}, \"Erolcha angry!\"", "{the_monster_1}尖叫 {at_foe_1}：“厄洛卡很生气！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.c4422aafeb7f82fa", "Ice", "冰", ""},
    {"speech.monspeak.c4541f91e765a8b1", "{the_monster_1} says, \"And stay out!\"", "{the_monster_1}说：“还有，别再回来了！”", "the_monster_1:name"},
    {"speech.monspeak.c4608bb0e09de923", "{the_monster_1} says, \"You didn't bring enough reinforcements. Come back later!\"", "{the_monster_1}说：“你带的援军不够。晚点再来吧！”", "the_monster_1:name"},
    {"speech.monspeak.c463b8b0c367265b", "{channel_1}{the_monster_1} smirks and points a slender finger {at_foe_1}.", "{channel_1}{the_monster_1}得意一笑，用纤细的手指指向 {at_foe_1}。", "channel_1:key;the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.c46f21a3ec7fb8af", "{channel_1}{the_monster_1} takes a fighting stance.", "{channel_1}{the_monster_1}摆出战斗姿势。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.c4a3f7a6bc65f94b", "{the_monster_1} says, \"I open the door for a goblin; he punches me in the face. I hate chivalry.\"", "{the_monster_1}说：“我给一个地精开门，他照我脸上就是一拳。我讨厌骑士精神。”", "the_monster_1:name"},
    {"speech.monspeak.c4b9f7315a98bb7f", "{the_monster_1} says, \"Banished to the Abyss. I hate that.\"", "{the_monster_1}说：“被放逐到深渊了。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.c4bbce5fb0ba5886", "{the_monster_1} screams {at_foe_1}, \"Die!\"", "{the_monster_1}尖叫 {at_foe_1}：“去死吧！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.c4ce5bee9ddfed1c", "{ijyb_common_1}", "{ijyb_common_1}", "ijyb_common_1:text"},
    {"speech.monspeak.c4f2603f40a2d687", "{the_monster_1} says, \"I have spells for any situation.\"", "{the_monster_1}说：“任何情况我都有法术应对。”", "the_monster_1:name"},
    {"speech.monspeak.c4f41331521e458a", "{the_monster_1} says {to_foe_1}, \"We do not look kindly on intruders!\"", "{the_monster_1}说 {to_foe_1}：“我们可不欢迎闯入者！”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.c515e6979a7a30d1", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.c52f393be3e71e6c", "{the_monster_1} says, \"I'm much more flexible now that I'm not limited by flesh.\"", "{the_monster_1}说：“脱离了血肉的束缚，我现在灵活多了。”", "the_monster_1:name"},
    {"speech.monspeak.c5312fb858070f82", "{the_monster_1} says, \"You'll rot in Tartarus!\" {player_only_1}", "{the_monster_1}说：“你会在塔尔塔罗斯里腐烂！” {player_only_1}", "the_monster_1:name;player_only_1:text"},
    {"speech.monspeak.c5428a8677a0d953", "{channel_1}{the_monster_1} forgets how to speak, silenced by the ages.", "{channel_1}{the_monster_1}忘记了如何言语，被岁月夺去了声音。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.c56e88fbb6c06d9a", "{the_monster_1} says, \"Doesn't it hurt to go crashing headfirst through the ceiling\?\"", "{the_monster_1}说：“一头撞穿天花板不疼吗？”", "the_monster_1:name"},
    {"speech.monspeak.c56f8b5dc5615589", "in the mountains", "山中", ""},
    {"speech.monspeak.c5a7896ab98519e2", "{the_monster_1} says, \"I hate you, too.\"", "{the_monster_1}说：“我也讨厌你。”", "the_monster_1:name"},
    {"speech.monspeak.c5b815e6c30fb24c", "{the_monster_1} mutters, \"Next time I\\'m using spur gears. Less buzzing.\"", "{the_monster_1}嘟囔道：“下次我要用正齿轮。嗡嗡声会小些。”", "the_monster_1:name"},
    {"speech.monspeak.c5c96ba4e6ba56c6", "pleads", "乞求道", ""},
    {"speech.monspeak.c5cc21dcc8366eb6", "{the_monster_1} says, \"Nice kit.\"", "{the_monster_1}说：“好装备。”", "the_monster_1:name"},
    {"speech.monspeak.c5cc4356fbf1b714", "{the_monster_1} says, \"It's all about the gold, really.\"", "{the_monster_1}说：“说到底，一切都是为了金子。”", "the_monster_1:name"},
    {"speech.monspeak.c609e565f0a76a68", "{the_monster_1} says, \"I don't get Xom.\"", "{the_monster_1}说：“我搞不懂佐姆。”", "the_monster_1:name"},
    {"speech.monspeak.c63374c2c479ed9d", "{channel_1}{the_monster_1} weaves an illusion.", "{channel_1}{the_monster_1}编织出一个幻象。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.c65e682b97ff8165", "{friendly_beogh_speech_rare_1}", "{friendly_beogh_speech_rare_1}", "friendly_beogh_speech_rare_1:text"},
    {"speech.monspeak.c66b7d640fc37656", "vassalage", "臣服", ""},
    {"speech.monspeak.c68f6102ad3c91a9", "{the_monster_1} claims, \"You mortals are all unique only in the ways you'll break.\"", "{the_monster_1}宣称：“你们这些凡人唯一的独特之处，就是你们崩溃的方式各不相同。”", "the_monster_1:name"},
    {"speech.monspeak.c68f77fc358f7424", "yells", "吼道", ""},
    {"speech.monspeak.c6947b64f3ea9a36", "{the_monster_1} says, \"Whatever happened to, 'First, do no harm'\?\"", "{the_monster_1}说：“‘首先，不可伤害’这话都上哪儿去了？”", "the_monster_1:name"},
    {"speech.monspeak.c6ef79336678f479", "our fingers... freezing", "我们的手指……冻僵了", ""},
    {"speech.monspeak.c74404ed3c1b0882", "{the_monster_1} says {to_foe_1}, \"Killing you is giving me appetite.\"", "{the_monster_1}说 {to_foe_1}：“杀你让我胃口大开。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.c75749715127d2e2", "{the_monster_1} roars at you, \"BIG WORDS FOR SUCH A SMALL MORSEL!\"", "{the_monster_1}冲你吼道：“就你这么一小口肉，口气倒不小！”", "the_monster_1:name"},
    {"speech.monspeak.c75ce008fad7b42c", "{the_monster_1} {orc_says_to_foe_1}, \"The messiah will be a true Orc!\"", "{the_monster_1}{orc_says_to_foe_1}：“弥赛亚必须是一个真正的兽人！”", "the_monster_1:name;orc_says_to_foe_1:text"},
    {"speech.monspeak.c76fad5525c58054", "{the_monster_1} screams {at_foe_1}, \"Me be nice to you! Me promise!\"", "{the_monster_1}尖叫 {at_foe_1}：“俺会对你好的！俺保证！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.c781dae5e377ef7a", "{the_monster_1} says, \"I hate shadows.\"", "{the_monster_1}说：“我讨厌影子。”", "the_monster_1:name"},
    {"speech.monspeak.c783a4bacfd11fd3", "{the_monster_1} says, \"The Orb is all yours.\"", "{the_monster_1}说：“宝珠归你了。”", "the_monster_1:name"},
    {"speech.monspeak.c786fa3abc06fa96", "{the_monster_1} says, \"I've never heard of a star spawning anything.\"", "{the_monster_1}说：“我可从没听说过哪颗星星会生出东西来。”", "the_monster_1:name"},
    {"speech.monspeak.c78a756d6648e9b7", "{the_monster_1} flickers, as though insubstantial.", "{the_monster_1}忽隐忽现，仿佛没有实体。", "the_monster_1:name"},
    {"speech.monspeak.c7a556a38961adf6", "{the_monster_1} begs you to reconsider your quest.", "{the_monster_1}恳求你再考虑一下你的追寻。", "the_monster_1:name"},
    {"speech.monspeak.c7d293dafbe5dc84", "{friendly_silenced_rare_1}", "{friendly_silenced_rare_1}", "friendly_silenced_rare_1:text"},
    {"speech.monspeak.c814a755c19390e0", "{weeping_skull_common_1}", "{weeping_skull_common_1}", "weeping_skull_common_1:text"},
    {"speech.monspeak.c843acd4775986b2", "{deck_of_escape_line_1}", "{deck_of_escape_line_1}", "deck_of_escape_line_1:text"},
    {"speech.monspeak.c84f213ba3f077b0", "{the_monster_1} says {to_foe_1}, \"I'm so much better than you.\"", "{the_monster_1}说 {to_foe_1}：“我比你强太多了。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.c86c12257e705580", "{channel_1}{the_monster_1} grins evilly.", "{channel_1}{the_monster_1}恶狠狠地咧嘴一笑。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.c87676e5b34df14c", "{the_monster_1} laughs {at_foe_1}, \"Think you're sharper than me\?\"", "{the_monster_1}大笑道 {at_foe_1}：“你觉得你比我更锋利吗？”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.c889b2c44960312a", "{the_monster_1} {grum_verb_1}, \"Who's a good boy\? That's right, {grum_dog_name_1}... you are!\"", "{the_monster_1} {grum_verb_1}：“谁是乖狗狗？没错，{grum_dog_name_1}……就是你！”", "the_monster_1:name;grum_verb_1:text;grum_dog_name_1:name"},
    {"speech.monspeak.c8af694fc3cc14b2", "{the_monster_1} screams, \"Wait! Erolcha supposed to do that!\"", "{the_monster_1}尖叫道：“等等！这事应该是厄洛卡干的才对！”", "the_monster_1:name"},
    {"speech.monspeak.c8cb60deba5d8834", "{bennu_death_1}", "{bennu_death_1}", "bennu_death_1:text"},
    {"speech.monspeak.c8d29acf181e37f5", "{the_monster_1} asks {foe_1} \"Could you be a darling and pick up this talisman for me\?\"", "{the_monster_1}问道 {foe_1}“你能行行好，帮我把这个护身符捡起来吗？”", "the_monster_1:name;foe_1:text"},
    {"speech.monspeak.c90db5c5aeb4a03a", "{the_monster_1} frowns {at_foe_1} and says, \"You violating area security.\"", "{the_monster_1}皱起眉头，说 {at_foe_1}：“你在破坏区域安全。”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.c947ca4507082952", "{channel_1}{the_monster_1} sniffs the air and quickly glances around.", "{channel_1}{the_monster_1}嗅了嗅空气，飞快地扫视四周。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.c94b1563fc386336", "{the_monster_1} says {to_foe_1}, \"Still so attached to shiny items\?\"", "{the_monster_1}说 {to_foe_1}：“还这么舍不得那些亮闪闪的东西？”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.c956b48eb2d8d336", "{the_monster_1} shouts, \"Stay back! It could be a {choice_1}!\"", "{the_monster_1}喊道：“退后！这可能是个{choice_1}！”", "the_monster_1:name;choice_1:text"},
    {"speech.monspeak.c956b48eb2d8d336.choice_1.alt_0", "ploy", "诡计", ""},
    {"speech.monspeak.c956b48eb2d8d336.choice_1.alt_1", "trick", "花招", ""},
    {"speech.monspeak.c956b48eb2d8d336.choice_1.alt_2", "gambit", "圈套", ""},
    {"speech.monspeak.c956b48eb2d8d336.choice_1.alt_3", "trap", "陷阱", ""},
    {"speech.monspeak.c960bb556a8921dd", "{the_monster_1} says, \"Such is the fate of all honourless rascals.\"", "{the_monster_1}说：“这就是所有无耻恶棍的下场。”", "the_monster_1:name"},
    {"speech.monspeak.c97b9c288659f233", "{the_monster_1} says, \"Orbs of fire, orbs of destruction, the Orb of Zot... what's with all the orbs\?\"", "{the_monster_1}说：“火焰宝珠、毁灭宝珠、佐特宝珠……怎么这么多宝珠？”", "the_monster_1:name"},
    {"speech.monspeak.c9dd018e90b110f0", "{the_monster_1} says, \"Are you sure you're allowed to read scrolls\?\"", "{the_monster_1}说：“你确定你能读卷轴吗？”", "the_monster_1:name"},
    {"speech.monspeak.c9e6536398086738", "{the_monster_1} emits a sizzling noise.", "{the_monster_1}发出嘶嘶的响声。", "the_monster_1:name"},
    {"speech.monspeak.ca2a4c9ac3004608", "{channel_1}{the_monster_1} checks {possessive_1} coin pouch and frowns.", "{channel_1}{the_monster_1}查看{possessive_1}钱袋，皱起了眉头。", "channel_1:key;the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.ca308d867275cf26", "{the_monster_1} lets out a mighty war cry!", "{the_monster_1}发出雄壮的战争怒吼！", "the_monster_1:name"},
    {"speech.monspeak.ca42cd46f25b2368", "{the_monster_1} says, \"A minor scratch like that one is certainly harmless.\"", "{the_monster_1}说：“像那样的小擦伤当然是无害的。”", "the_monster_1:name"},
    {"speech.monspeak.ca468657ab0dd00a", "{the_monster_1} says, \"And take your demons with you.\"", "{the_monster_1}说：“把你的恶魔也一并带走吧。”", "the_monster_1:name"},
    {"speech.monspeak.ca47746da1d163e3", "{channel_1}{the_monster_1} drools a little bit.", "{channel_1}{the_monster_1}流了点口水。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.ca5d0b981deaab27", "{the_monster_1} {orc_says_to_foe_1}, \"Your {choice_1} cannot {choice_2} me.\"", "{the_monster_1}{orc_says_to_foe_1}：“你的{choice_1}无法{choice_2}我。”", "the_monster_1:name;orc_says_to_foe_1:text;choice_1:text;choice_2:text"},
    {"speech.monspeak.ca5d0b981deaab27.choice_1.alt_0", "costumes", "服装", ""},
    {"speech.monspeak.ca5d0b981deaab27.choice_1.alt_1", "disguise", "伪装", ""},
    {"speech.monspeak.ca5d0b981deaab27.choice_1.alt_2", "tricks", "把戏", ""},
    {"speech.monspeak.ca5d0b981deaab27.choice_2.alt_0", "fool", "蒙骗", ""},
    {"speech.monspeak.ca5d0b981deaab27.choice_2.alt_1", "deceive", "欺骗", ""},
    {"speech.monspeak.ca6e6a59f4b9814b", "{the_monster_1} gasps with {possessive_1} dying breath, \"No one... ever listens...\"", "{the_monster_1}用{possessive_1}最后一口气喘息道：“从来没有人……肯听……”", "the_monster_1:name;possessive_1:text"},
    {"speech.monspeak.ca90462e69c85fd5", "{harold_ret_house_1} {harold_ret_place_1}", "{harold_ret_house_1}的{harold_ret_place_1}", "harold_ret_house_1:text;harold_ret_place_1:text"},
    {"speech.monspeak.ca9767cc50227f76", "{the_monster_1} says, \"Who would want to remember their ancestors\? They're dead.\"", "{the_monster_1}说：“谁会想记住自己的祖先？他们都死了。”", "the_monster_1:name"},
    {"speech.monspeak.ca9c5d26b20cafff", "{the_monster_1} brags, \"I can call spirits from the vasty deep.\"", "{the_monster_1}吹嘘道：“我能从万丈深渊中召唤出幽灵。”", "the_monster_1:name"},
    {"speech.monspeak.caac6300da774eaf", "{generic_donald_1}", "{generic_donald_1}", "generic_donald_1:text"},
    {"speech.monspeak.cab3ab2b8c92f031", "{the_monster_1} shouts {at_foe_1}, \"You are a heretic and must be destroyed!\"", "{the_monster_1}喊道 {at_foe_1}：“你是异端，必须被消灭！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.cae191fbcbaaecc3", "{channel_1}{the_monster_1} twirls on the spot.", "{channel_1}{the_monster_1}原地转圈。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.caf5b144afd8eb23", "{the_monster_1} {grum_verb_1} {at_foe_1}, \"Me and {grum_dog_name_1} will play fetch with your bones!\"", "{the_monster_1} {grum_verb_1} {at_foe_1}：“我和{grum_dog_name_1}会拿你的骨头玩抛接！”", "the_monster_1:name;grum_verb_1:text;at_foe_1:text;grum_dog_name_1:name"},
