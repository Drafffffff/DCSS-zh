    {"speech.monspeak.00f35f12a8b30416", "{the_monster_1} says {to_foe_1}, \"I'll make a rug of your skin.\"", "{the_monster_1}说 {to_foe_1}：“我要用你的皮做一张地毯。”", "the_monster_1:name;to_foe_1:text"},
    {"speech.monspeak.01276350ef4d4bcc", "infinity", "无限", ""},
    {"speech.monspeak.01311ddfeba3c2d6", "{channel_1}{the_monster_1} suddenly looks very angry at the Dungeon.", "{channel_1}{the_monster_1}突然对地牢露出极度愤怒的神情。", "channel_1:key;the_monster_1:name"},
    {"speech.monspeak.01318721f1b9249a", "{the_monster_1} says, \"If you give me all your gold, I promise I'll be your friend too.\"", "{the_monster_1}说：“你把所有的金子都给我，我保证也做你的朋友。”", "the_monster_1:name"},
    {"speech.monspeak.0131edc6a09caec1", "{the_monster_1} says, \"I've never heard of a star cursing anything.\"", "{the_monster_1}说：“我可从没听说过哪颗星星会诅咒东西。”", "the_monster_1:name"},
