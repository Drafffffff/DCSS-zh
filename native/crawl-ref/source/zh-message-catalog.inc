    {"speech.monspeak.f2a8ef8434d21084", "{the_monster_1} howls an indescribable curse.", "{the_monster_1}嚎叫出一句难以形容的诅咒。", "the_monster_1:name"},
    {"speech.monspeak.f2c6e3284ae541eb", "Snoogle", "斯努格", ""},
    {"speech.monspeak.f2dc561b0345ba01", "{the_monster_1} says, \"They don't even play music.\"", "{the_monster_1}说：“他们连音乐都不放。”", "the_monster_1:name"},
