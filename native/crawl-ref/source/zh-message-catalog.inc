    {"speech.monspeak.56edb3b01ad4e7a9", "{the_monster_1} says, \"You're nobody.\"", "{the_monster_1}说：“你什么都不是。”", "the_monster_1:name"},
    {"speech.monspeak.56edd5e98e390851", "{the_monster_1} shouts {at_foe_1}, \"Intruder!\"", "{the_monster_1}喊道 {at_foe_1}：“有入侵者！”", "the_monster_1:name;at_foe_1:text"},
    {"speech.monspeak.572d9e3060c08081", "{the_monster_1} says, \"I forgot what I was going to say. I hate that.\"", "{the_monster_1}说：“我忘了我刚才要说什么了。我讨厌这样。”", "the_monster_1:name"},
    {"speech.monspeak.573ee5acc30e57a6", "{the_monster_1} says, \"But I've got a wife! And kids! Have I\?\"", "{the_monster_1}说：“可我有老婆！还有孩子！我有吗？”", "the_monster_1:name"},
    {"speech.monspeak.573f091324beaa12", "{axioms_of_law_1}", "{axioms_of_law_1}", "axioms_of_law_1:text"},
    {"speech.monspeak.5756c249d4cf6065", "{the_monster_1} says, \"Crazy\? Crazy!\? PORCUPINE!\"", "{the_monster_1}说：“疯？疯！？豪猪！”", "the_monster_1:name"},
