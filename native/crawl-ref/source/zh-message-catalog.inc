    {"speech.monspeak.18bb3e1ee0e6dcb4", "{the_monster_1} says {to_foe_1}, \"How about some decapitation\?\"", "{the_monster_1}说 {to_foe_1}：“来试试砍头怎么样？”", "the_monster_1:name;to_foe_1:text"},
