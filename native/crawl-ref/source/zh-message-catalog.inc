    {"speech.monspeak.18cf097f759f743d.choice_1.alt_1", "effortlessly reloads", "毫不费力地装填", ""},
    {"speech.monspeak.18ef3d96e0d0e6f8", "{the_monster_1} {wails_1}, \"To die, to sleep, no more.\"", "{the_monster_1} {wails_1}：“死去，睡去，再无其他。”", "the_monster_1:name;wails_1:text"},
    {"speech.monspeak.18fe3421a609e9d3", "{the_monster_1} says, \"The Orb of Power is here\? Where are the others, then\?\"", "{the_monster_1}说：“力量宝珠在这里？那其他的呢？”", "the_monster_1:name"},
    {"speech.monspeak.190f47aa2d9fe478", "{channel_1}Strange appendages sprout from {the_monster_possessive_1} back.", "{channel_1}奇怪的附肢从{the_monster_possessive_1}背上长出来。", "channel_1:key;the_monster_possessive_1:name"},
    {"speech.monspeak.191b65b49911f28a", "{boris_return_rare_1}", "{boris_return_rare_1}", "boris_return_rare_1:text"},
