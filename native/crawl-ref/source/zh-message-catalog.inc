    {"speech.monspeak.54538cdad855a075", "{the_monster_1} screams {at_foe_1}, \"You'll have to get past me!\"", "{the_monster_1}尖叫 {at_foe_1}：“你得先过我这一关！”", "the_monster_1:name;at_foe_1:text"},
