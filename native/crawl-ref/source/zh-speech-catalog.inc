    {"_jeremiah_common_", "VISUAL:@The_monster@ looks at @possessive@ weapon with confusion.", "speech.monspeak.9f5d18a84e9776bb"},
    {"_jeremiah_rare_", "@The_monster@ howls, \"Why can't I wake up\?\"", "speech.monspeak.9bb7f9d0eb92a990"},
    {"_jeremiah_rare_", "@The_monster@ wails, \"Just end it! Let me go!\"", "speech.monspeak.e36d669324055be5"},
    {"_jeremiah_rare_", "@The_monster@ sobs, \"I don't want it. Make it stop! Make it stop!\"", "speech.monspeak.753ade3b6cc2435b"},
    {"_jeremiah_rare_", "@The_monster@ says, \"Oh, this must be a dream. This is totally unrealistic.\"", "speech.monspeak.1e0c235960cda2a3"},
    {"_jeremiah_rare_", "@The_monster@ says, \"Oh, what beautiful sparkles and rainbows everywhere!\"", "speech.monspeak.a253a8a64ea4354e"},
    {"_jeremiah_rare_", "@The_monster@ asks @foe@, \"Have you seen the dreamshard\? I... I need it...\"", "speech.monspeak.6a29917f22872a08"},
    {"_jeremiah_rare_", "@The_monster@ whispers, \"Once you die, everything will be fine. It promises.\"", "speech.monspeak.b0de1447937a8dd2"},
