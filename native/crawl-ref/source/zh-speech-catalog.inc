    {"fedhas player ghost", "@The_monster@ says @to_foe@, \"I can no longer spread life, but I can still bring your death!\"", "speech.monspeak.02f963d2eec20650"},
    {"fedhas player ghost", "@The_monster@ says, \"You will make such fine fertiliser.\"", "speech.monspeak.afd2f4766a05144e"},
    {"fedhas player ghost", "@The_monster@ says, \"Life goes in cycles. In a little while, you'll be reborn as a tapeworm.\"", "speech.monspeak.a20fb44d700a9087"},
