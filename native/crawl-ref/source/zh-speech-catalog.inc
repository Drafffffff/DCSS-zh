    {"_sigmund_common_", "@The_monster@ laughs darkly.", "speech.monspeak.0189da6451afa4ea"},
    {"_sigmund_common_", "VISUAL:@The_monster@ looks at you with fury.", "speech.monspeak.8460a66a07a17de8"},
    {"_sigmund_common_", "@The_monster@ flickers, as though insubstantial.", "speech.monspeak.c78a756d6648e9b7"},
    {"_sigmund_common_", "@The_monster@ says @to_foe@, \"Your kind have come here before. I understand now why. You desire death...\"", "speech.monspeak.76303b3bf6632ba5"},
    {"_sigmund_common_", "@The_monster@ says @to_foe@, \"Now you see me, now you don't...\"", "speech.monspeak.197af841f8e399f1"},
    {"_sigmund_common_", "@The_monster@ says @to_foe@, \"Don't worry, I'll kill you fast.\"", "speech.monspeak.ac72dce3dea7f83f"},
    {"_sigmund_common_", "@The_monster@ says @to_foe@, \"You will soon forget everything.\"", "speech.monspeak.f95be3fdae1129c9"},
    {"_sigmund_common_", "@The_monster@ says @to_foe@, \"Look into my eyes.\"", "speech.monspeak.a3ec3dcae5b256a7"},
    {"_sigmund_common_", "@The_monster@ says @to_foe@, \"I'm your fate.\"", "speech.monspeak.dbf684756b930c49"},
    {"_sigmund_common_", "@The_monster@ screams @at_foe@, \"Die, monster!\"", "speech.monspeak.6b6b458b2603d6f0"},
    {"_sigmund_common_", "@The_monster@ screams @at_foe@, \"Don't try to resist!\"", "speech.monspeak.3b4560aa35862519"},
    {"_sigmund_common_", "@The_monster@ giggles. \"Time to reap what you sow.\"", "speech.monspeak.b98e51e098b5a7b9"},
    {"_sigmund_common_", "VISUAL:@The_monster_possessive@ eyes start glowing with a red light.", "speech.monspeak.99be337418fb7b79"},
    {"_sigmund_common_", "@The_monster@ breathes a few words.\nVISUAL:@The_monster_possessive@ hands start flickering wildly.", "speech.monspeak.987506c81db9c077"},
    {"_sigmund_common_", "VISUAL:@The_monster@ is suddenly surrounded by pale @_spell_colour_@ light.", "speech.monspeak.332db442e9f9c13b"},
    {"_sigmund_rare_", "@The_monster@ asks @foe,@ \"Do you like me\?\"", "speech.monspeak.79f571f81bd1240e"},
    {"_sigmund_rare_", "@The_monster@ screams @at_foe@, \"You will never... NEVER!!!\"", "speech.monspeak.d15ec2227d36b49c"},
    {"_sigmund_rare_", "@The_monster@ screams @at_foe@, \"I am the angel of ZOT!!!\"", "speech.monspeak.cafdb472a9762ad4"},
    {"_sigmund_rare_", "@The_monster@ screams @at_foe@, \"Only death can liberate you!\"", "speech.monspeak.8e195c9a2db300f5"},
    {"_sigmund_rare_", "@The_monster@ whispers @to_foe@, \"You'll know eternity soon.\"", "speech.monspeak.b020717a6805cc73"},
    {"_sigmund_rare_", "VISUAL:@The_monster@ smiles chillingly.", "speech.monspeak.f5f3c2f449ed8ecd"},
    {"sigmund triumphant", "VISUAL:@The_monster@ begins carving another notch in @possessive@ scythe.", "speech.monspeak.e27b76beeaf42324"},
