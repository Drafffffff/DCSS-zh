    {"_xak'krixis_monster_thoughts_", "@The_monster@ muses, \"Oh, to shine as brightly as a sun moth...\"", "speech.monspeak.a8b49deec23ca6e3"},
    {"_xak'krixis_monster_thoughts_", "@The_monster@ muses, \"Oh, to be as impervious as an emperor scorpion...\"", "speech.monspeak.af2f98003d579ec9"},
    {"_xak'krixis_monster_thoughts_", "@The_monster@ muses, \"Oh, to inspire such passion as a moth of wrath...\"", "speech.monspeak.eb545e37eb75ebcf"},
