    {"_harold_retirement_plan_", "horse ranch", "speech.monspeak.14b0d1a695021be2"},
    {"_harold_retirement_plan_", "cattle farm", "speech.monspeak.80f8122c02cfe4a7"},
    {"_harold_retirement_plan_", "nice plot of land", "speech.monspeak.933f74d68c8c682a"},
