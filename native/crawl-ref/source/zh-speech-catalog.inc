    {"_chuck_rare_", "@The_monster@ says, \"ME ROCKS!\"", "speech.monspeak.b38ff219606d8a62"},
    {"orb crazy yiuf", "@The_monster@ says, \"Wait for me!\"", "speech.monspeak.fae615200b257b23"},
    {"orb crazy yiuf", "@The_monster@ says, \"You found it!\"", "speech.monspeak.44435b64f7674b79"},
    {"orb crazy yiuf", "@The_monster@ says, \"Get me out of this place.\"", "speech.monspeak.007eadd413041e8c"},
    {"orb crazy yiuf", "@The_monster@ says, \"You came back for me.\"", "speech.monspeak.efb3ecf1f167ab58"},
    {"confused crazy yiuf", "@The_monster@ says, \"This beard itches something crazy!\"", "speech.monspeak.b29f59cec08efef0"},
    {"confused crazy yiuf", "@The_monster@ says, \"I wonder if I left the window open.\"", "speech.monspeak.8fa503cb75501c91"},
    {"confused crazy yiuf", "VISUAL:@The_monster@ scratches @possessive@ head thoughtfully.", "speech.monspeak.f5f8ace21ea62f30"},
    {"confused crazy yiuf", "@The_monster@ says, \"Have you seen my glasses\?\"", "speech.monspeak.b8e1d94805ff47c0"},
    {"confused crazy yiuf", "@The_monster@ says, \"Perhaps I shall have lamb for dinner.\"", "speech.monspeak.6425a0ef9ebd40dd"},
    {"confused crazy yiuf", "@The_monster@ says, \"Oh, this is rather nice.\"", "speech.monspeak.7830ce34e16a289f"},
    {"confused crazy yiuf", "@The_monster@ says, \"Have you seen my cloak\?\"", "speech.monspeak.705efbad8c634bab"},
    {"confused crazy yiuf", "@The_monster@ laughs.", "speech.monspeak.6240bc17c1ec0250"},
    {"confused crazy yiuf", "VISUAL:@The_monster@ counts something out on @possessive@ fingers.", "speech.monspeak.dade69804a79613b"},
    {"confused crazy yiuf", "@The_monster@ says, \"My, my head's in a spin!\"", "speech.monspeak.8d0a9223e7775ed8"},
    {"confused crazy yiuf", "@The_monster@ says, \"I feel rather peculiar.\"", "speech.monspeak.7d4c152e3902bea4"},
