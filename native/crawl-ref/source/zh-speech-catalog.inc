    {"nergalle", "@The_monster@ says, \"You have no idea what it means to truly have nothing. We will teach you.\"", "speech.monspeak.fc57d1c845985892"},
    {"nergalle", "@The_monster@ says, \"I've lived long enough to see a hundred people like you fail.\"", "speech.monspeak.3234169835055d26"},
