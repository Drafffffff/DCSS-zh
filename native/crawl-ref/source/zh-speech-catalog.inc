    {"_rupert_rare_", "@The_monster@ lets out a booming laugh, sending rocks and debris crashing down.", "speech.monspeak.d4469a4e1ea3d208"},
    {"_rupert_rare_", "@The_monster@ flexes and says, \"Free ticket to bow show!\"", "speech.monspeak.4d8b88311bda09c4"},
