    {"_nessos_rare_", "@The_monster@ says, \"Hold still for a moment, will you\? I've got a trick shot I want to try here.\"", "speech.monspeak.03367304d19f2ecd"},
    {"_nessos_rare_", "@The_monster@ says, \"I schooled the Big Guy. You'll be no problem.\"", "speech.monspeak.f500c3092fef424e"},
