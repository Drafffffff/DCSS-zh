    {"_nessos_common_", "@The_monster@ stands on @possessive@ hind legs for a moment.", "speech.monspeak.654b54280933af48"},
    {"_nessos_rare_", "@The_monster@ says, \"Study your classics!\"", "speech.monspeak.28f3c7f6e9216a73"},
    {"_nessos_rare_", "@The_monster@ says, \"I'll learn you. I'll learn you yet!\"", "speech.monspeak.bd903625751533fe"},
    {"_nessos_rare_", "@The_monster@ says, \"Even if you were a mare, I'd kill you!\"", "speech.monspeak.ccdfce2acd8f92b6"},
