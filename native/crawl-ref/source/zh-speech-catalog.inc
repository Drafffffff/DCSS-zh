    {"beogh player ghost", "@The_monster@ says, \"I used to walk on water. Now I just fly over it.\"", "speech.monspeak.11669c334e1e1bf9"},
    {"beogh player ghost", "@The_monster@ says @to_foe@, \"I don't need an army to kill you!\"", "speech.monspeak.932137b4006dcb6f"},
    {"cheibriados player ghost", "@The_monster@ says @to_foe@, \"What's the hurry\? You'll die anyway.\"", "speech.monspeak.0089f554b151c6b5"},
    {"cheibriados player ghost", "@The_monster@ says @to_foe@, \"You can run, but you can't hide!\"", "speech.monspeak.5ba59ad3e8b359e2"},
    {"hepliaklqana player ghost", "@The_monster@ says @to_foe@, \"If I can't kill you now, I'll help my descendant do it later.\"", "speech.monspeak.59fdcd527618245f"},
    {"hepliaklqana player ghost", "@The_monster@ says @to_foe@, \"I'll give you a battle you'll never forget!\"", "speech.monspeak.426feb79011cf721"},
    {"hepliaklqana player ghost", "@The_monster@ says @to_foe@, \"I'm committing your attacks to memory.\"", "speech.monspeak.1d5b7816615f6b1d"},
    {"jiyva player ghost", "@The_monster@ says @to_foe@, \"Still so attached to shiny items\?\"", "speech.monspeak.c94b1563fc386336"},
    {"jiyva player ghost", "@The_monster@ says @to_foe@, \"Foolish people, craving for loot.\"", "speech.monspeak.fea871aba73b0faa"},
    {"jiyva player ghost", "@The_monster@ says @to_foe@, \"I didn't need trinkets in life, I don't need them now.\"", "speech.monspeak.f1d8aaac34e60518"},
    {"lugonu player ghost", "@The_monster@ says regretfully, \"I wish I had corrupted all of this!\"", "speech.monspeak.d1705eb225bb9a22"},
    {"lugonu player ghost", "@The_monster@ says, \"What a barren place. A pity you won't get a chance to visit the Abyss!\"", "speech.monspeak.0682fbb57b03e291"},
    {"lugonu player ghost", "@The_monster@ proudly claims, \"A renegade god deserves renegade ghosts.\"", "speech.monspeak.8c9a56191046a536"},
    {"qazlal player ghost", "@The_monster@ says, \"A storm is coming...\"", "speech.monspeak.4974c9321ec2d389"},
    {"qazlal player ghost", "@The_monster@ says, \"Let nature run its course against you!\"", "speech.monspeak.71d20351d4a22733"},
    {"qazlal player ghost", "@The_monster@ says, \"The earth shall destroy you!\"", "speech.monspeak.9a57cfac498e9482"},
    {"the shining one player ghost", "@The_monster@ says, \"I was promised divine protection. So much for that.\"", "speech.monspeak.579c4bc70fc6f0c1"},
    {"the shining one player ghost", "@The_monster@ says, \"In life I battled great evil. Now I just battle.\"", "speech.monspeak.73135e344427b539"},
    {"the shining one player ghost", "@The_monster@ says, \"They say chivalry is dead. Well, so am I.\"", "speech.monspeak.ae556df3ff0fb5f7"},
    {"the shining one player ghost", "@The_monster@ whispers, \"I have become one of them.\"", "speech.monspeak.73bf283e500e3488"},
    {"the shining one player ghost", "@The_monster@ mumbles, \"We raided the strongholds of evil. Now I walk alone.\"", "speech.monspeak.dd7bed9d8bfca0ff"},
    {"the shining one player ghost", "@The_monster@ utters, \"No lamp to guide me anymore...\"", "speech.monspeak.8b41e692a852106b"},
    {"trog player ghost", "@The_monster@ yells, \"Who would have thought, even in death it is a pleasure to sever!\"", "speech.monspeak.40f83b574e50ee66"},
    {"trog player ghost", "@The_monster@ screams in joy, \"As in life, so in death: Kill! Kill!! Kill!!!\"", "speech.monspeak.a592dfab0ebf8777"},
    {"uskayaw player ghost", "@The_monster@ says @to_foe@, \"It's your last dance!\"", "speech.monspeak.8b56e0f46f1be586"},
    {"uskayaw player ghost", "@The_monster@ says @to_foe@, \"Let me show you true rhythm.\"", "speech.monspeak.913988c91ea26303"},
    {"uskayaw player ghost", "@The_monster@ says, \"You either stomp with the beat or get stomped.\"", "speech.monspeak.a8ee82584515df4d"},
    {"uskayaw player ghost", "@The_monster@ says, \"I used to wander and follow the dancing life. Look where it got me.\"", "speech.monspeak.71e55aa8b8e25f16"},
    {"uskayaw player ghost", "@The_monster@ shouts, \"Finally, a proper audience!\"", "speech.monspeak.26fb6fc67dbb263c"},
    {"xom player ghost", "@The_monster@ @_laughs_@, \"I laugh when killing. So smile when dying. SMILE!\"", "speech.monspeak.2283be93968762b4"},
    {"xom player ghost", "@The_monster@ complains, \"You're an easy kill, but not a fun one.\"", "speech.monspeak.d4689f072b71c5f9"},
    {"xom player ghost", "@The_monster@ reminisces, \"I miss the gifts and the pranks.\"", "speech.monspeak.903c9cb724e782a2"},
    {"xom player ghost", "@The_monster@ twaddles, \"I had a jolly good time in life, and I have a jolly good time now!\"", "speech.monspeak.805ca20d66058872"},
    {"xom player ghost", "@The_monster@ giggles, \"Hey deadhead, what fun to see your head drop dead!\"", "speech.monspeak.f9f1d01185a5288b"},
    {"xom player ghost", "@The_monster@ says, \"I need scissors! I think I chipped a nail somewhere...\"", "speech.monspeak.9d7c59ad92e0c657"},
    {"xom player ghost", "@The_monster@ tries to make a funny facial expression.", "speech.monspeak.74bf37b391801755"},
    {"yredelemnul player ghost", "@The_monster@ says @to_foe@, \"Your soul may be of use to me.\"", "speech.monspeak.02344b08fdd677a6"},
    {"yredelemnul player ghost", "@The_monster@ says @to_foe@, \"First you will die, then you will suffer.\"", "speech.monspeak.bb8f1341abdb68fd"},
    {"_generic_ranged_", "@The_monster@ takes aim @at_foe@.", "speech.monspeak.a213561cfbcb5f89"},
    {"_generic_ranged_", "You feel something passing dangerously close to your head. @player_only@", "speech.monspeak.fd833e7a5819f1e2"},
    {"_form_", "spider", "speech.monspeak.2039613063445a69"},
    {"_form_", "stone statue", "speech.monspeak.6a57d53b9e0c002b"},
    {"_form_", "dragon", "speech.monspeak.024279f1d23ef732"},
    {"_laughs_", "cackles madly", "speech.monspeak.39da5f3d760e4236"},
    {"_laughs_", "chuckles harshly", "speech.monspeak.ce5d1a3a41036d80"},
    {"_laughs_", "gibbers darkly", "speech.monspeak.4dc3beebbb73ec82"},
    {"player ghost", "@_player_ghost_common_@", "speech.monspeak.08186f11795a21e6"},
    {"player ghost", "@_player_ghost_medium_@", "speech.monspeak.64ee5ec618c1ad57"},
    {"player ghost", "@_player_ghost_rare_@", "speech.monspeak.b27ab38e6bff2458"},
    {"_player_ghost_medium_", "@The_monster@ laughs crazily.", "speech.monspeak.448d3b936314fe1d"},
    {"_player_ghost_medium_", "VISUAL:@The_monster@ grins evilly.", "speech.monspeak.ec2a437c0e2468d0"},
    {"_player_ghost_medium_", "@The_monster@ makes a sound of rattling chains.", "speech.monspeak.c34abed7b7db4573"},
    {"_player_ghost_medium_", "@The_monster@ @_wails_@, \"I was like you once.\"", "speech.monspeak.ec2e938ed6df25e7"},
    {"_player_ghost_medium_", "@The_monster@ @_wails_@, \"Very impressive. But it won't help. Nothing will.\"", "speech.monspeak.08eda7573d69ed8f"},
    {"_player_ghost_medium_", "@The_monster@ @_wails_@, \"I have seen your future, and it is all used up.\"", "speech.monspeak.d4c757c36988da09"},
    {"_player_ghost_medium_", "@The_monster@ @_wails_@, \"Do you think the gods will protect you\?\"", "speech.monspeak.87d24ba9daf7ea14"},
    {"_player_ghost_medium_", "@The_monster@ screams, \"I'll kill anyone who wants the ORB!\" @player_only@", "speech.monspeak.90193400f75595c1"},
    {"_player_ghost_medium_", "@The_monster@ screams @at_foe@, \"Don't try to defend! You have no chance!\"", "speech.monspeak.e2c7ddce477100c9"},
    {"_player_ghost_medium_", "@The_monster@ screams, \"Zot is a myth, the ORB is a fable, you'll soon be a tale!\" @player_only@", "speech.monspeak.d5a3a4b1e033d25e"},
    {"_player_ghost_medium_", "@The_monster@ whispers, \"Death is liberation.\"", "speech.monspeak.d6d38c3c5da23eb1"},
    {"_player_ghost_medium_", "@The_monster@ @_wails_@, \"Death is your only future!\"", "speech.monspeak.83b5a36ba4d60f52"},
    {"_player_ghost_medium_", "@The_monster@ whispers, \"Meet the emptiness of death!\"", "speech.monspeak.fca50231f71a5d77"},
    {"_player_ghost_medium_", "@The_monster@ @_wails_@, \"There is no future for me!\"", "speech.monspeak.0b51a71d508d4f90"},
    {"_player_ghost_medium_", "@The_monster@ whispers, \"They're coming for you...\"", "speech.monspeak.d06ecbe0176ede6b"},
    {"_player_ghost_medium_", "@The_monster@ whispers, \"Trust me. Just give in.\"", "speech.monspeak.88bd26c69ed69a6c"},
    {"aizul", "@_Aizul_common_@", "speech.monspeak.3b0fa7bea9a4b0a0"},
    {"aizul", "@_Aizul_rare_@", "speech.monspeak.5604346085ff43f2"},
    {"_aizul_rare_", "@The_monster@ says, \"Sweet dreams!\"", "speech.monspeak.2e774606fcfd34ef"},
    {"_aizul_rare_", "@The_monster@ hums a lullaby.", "speech.monspeak.82a78dfd2c859f03"},
    {"_aizul_rare_", "VISUAL:@The_monster@ coils and then uncoils.", "speech.monspeak.60fe950081cfa44c"},
    {"_aizul_rare_", "@The_monster@ says, \"Everybody has to sleep sometimes.\"", "speech.monspeak.a8957a7e9dd9a105"},
    {"_aizul_rare_", "@The_monster@ says @to_foe@, \"Fancy a snooze\?\"", "speech.monspeak.0c32affd68c7f7a6"},
    {"_aizul_rare_", "@The_monster@ says, \"They said they'd gotten someone better!\"", "speech.monspeak.029d66cd75a3fdf5"},
    {"_aizul_rare_", "@The_monster@ says, \"Replaced! How does it feel to be replaced\?\"", "speech.monspeak.bd57923d0edb3823"},
    {"_aizul_rare_", "@The_monster@ moans, \"No job prospects! Who wants sleepy Aizul to guard their treasure\?\"", "speech.monspeak.ed535dff404fce76"},
    {"_aizul_rare_", "VISUAL:@The_monster@ winks several times @at_foe@.", "speech.monspeak.69578857d89b6ddc"},
    {"agnes", "@_Agnes_common_@", "speech.monspeak.9d25b66743a9495e"},
    {"agnes", "@_Agnes_rare_@", "speech.monspeak.ded2394b98dfb723"},
    {"_agnes_rare_", "@The_monster@ says, \"The ORB is mine by right.\"", "speech.monspeak.d257df5ff61a5d97"},
    {"_agnes_rare_", "@The_monster@ shouts @at_foe@, \"I will kick you around like a rattan ball!\"", "speech.monspeak.f49e55829524a8ea"},
    {"_agnes_rare_", "@The_monster@ asks, \"Have you seen my kris anywhere\?\"", "speech.monspeak.38c547a9e063fce4"},
    {"_agnes_rare_", "@The_monster@ mutters, \"I could really go for a good breadfruit right now.\"", "speech.monspeak.cf93e6edde65dac2"},
    {"antaeus", "@_hell_lord_taunt_@", "speech.monspeak.b30f921f7f2adb15"},
    {"_amaemon_common_", "@The_monster@ hisses.", "speech.monspeak.732a88fb5aedd575"},
    {"_amaemon_common_", "VISUAL:Something foul drips from @the_monster_possessive@ claws.", "speech.monspeak.ec409cb0105566b3"},
    {"_amaemon_common_", "VISUAL:@The_monster_possessive@ eyes glow red.", "speech.monspeak.d7b70167ce9a8d2a"},
    {"_amaemon_common_", "VISUAL:@The_monster_possessive@ tail lashes.", "speech.monspeak.18ccbb0fab8e4a08"},
    {"_amaemon_common_", "@The_monster@ shouts @at_foe@, \"You think you're better than me\?\"", "speech.monspeak.a005e65c3ebffc59"},
    {"_amaemon_common_", "@The_monster@ says @to_foe@, \"Afraid of a little sting\?\"", "speech.monspeak.74b6ffb4ca2a21a4"},
    {"_amaemon_rare_", "@The_monster@ whines, \"They said I was special. Look at me now!\"", "speech.monspeak.3ccc1649e9cb762c"},
    {"_amaemon_rare_", "@The_monster@ sighs, \"Demons are the only companions you can really rely on.\"", "speech.monspeak.b4d1ca9995a4353d"},
    {"_amaemon_rare_", "@The_monster@ says @to_foe@, \"Need some antivenom\? Don't worry, you can trust me.\"", "speech.monspeak.05e9189e3834eb14"},
    {"_amaemon_rare_", "@The_monster@ whispers, \"Once I find the ORB, I'll be cured. I'll be normal again!\"", "speech.monspeak.9956a9e2f70563ae"},
    {"_amaemon_rare_", "@The_monster@ sings, \"Eyes close, heart stop, nighty-night for you...\"", "speech.monspeak.d9d94f45b351762a"},
    {"arachne triumphant", "@The_monster@ shouts, \"This is my domain now; anyone trespasses at their own peril!\"", "speech.monspeak.821825593131d579"},
    {"asterion", "@_Asterion_common_@", "speech.monspeak.bd286b66b8a87914"},
    {"asterion", "@_Asterion_rare_@", "speech.monspeak.9d9682b196523d5a"},
    {"_asterion_common_", "VISUAL:@The_monster@ snorts and paws the ground.", "speech.monspeak.223209b6e6fc49a9"},
    {"_asterion_common_", "VISUAL:@The_monster@ slowly taps @possessive@ weapon in @possessive@ hand.", "speech.monspeak.5b6ff013a2a68462"},
    {"_asterion_common_", "@The_monster@ says, \"Soon your soul will belong to Makhleb.\" @player_only@", "speech.monspeak.2cc4ab594fe038e6"},
    {"_asterion_common_", "@The_monster@ says, \"Makhleb has given me powers of destruction.\"", "speech.monspeak.698e7c36e9a555dd"},
    {"_asterion_common_", "@The_monster@ says, \"Your corpse will decorate my castle walls.\" @player_only@", "speech.monspeak.3d09ec472b8d8b16"},
    {"_asterion_common_", "@The_monster@ says, \"In my kingdom, weaklings like you are put to the sword.\" @player_only@", "speech.monspeak.d5afdbb86b62b4b7"},
    {"_asterion_common_", "@The_monster@ says, \"No maze can contain me.\"", "speech.monspeak.45224513dadfabff"},
    {"_asterion_common_", "@The_monster@ says, \"Enter my house and I will deliver you from evil.\" @player_only@", "speech.monspeak.80c545e1f5b9fc2f"},
    {"_asterion_common_", "@The_monster@ says, \"My mother, she was a queen.\" @player_only@", "speech.monspeak.681cdec84f46c505"},
    {"_asterion_common_", "@The_monster@ screams, \"Stop staring at me!\" @player_only@", "speech.monspeak.2e050681a54bc012"},
    {"_asterion_common_", "@The_monster@ bellows, \"My home has fourteen doors!\"", "speech.monspeak.03699fb1df634cac"},
    {"_asterion_common_", "@The_monster@ chants a prayer to Makhleb.", "speech.monspeak.b440e85b5ebb4b1c"},
    {"_asterion_common_", "@The_monster@ says @to_foe@, \"Your valuables will do nicely in my coffers.\" @player_only@", "speech.monspeak.2e8ac906cba72856"},
    {"_asterion_rare_", "@The_monster@ unleashes a bloodcurdling roar.", "speech.monspeak.39cf415e051a1b89"},
    {"_asterion_rare_", "@The_monster@ chants and is briefly shrouded in fire.", "speech.monspeak.894436e956b20bc2"},
    {"_asterion_rare_", "@The_monster_possessive@ eyes glow.\nYou hear demonic laughter.", "speech.monspeak.e8e3c5e662801d0e"},
    {"_asterion_rare_", "@The_monster@ screams @at_foe@, \"What ORB\?! I have an entire kingdom!\" @player_only@", "speech.monspeak.59eb6bfd1ba1acc5"},
    {"_asterion_rare_", "@The_monster@ screams @at_foe@, \"Bow down before your king! Bow! Bow!!\" @player_only@", "speech.monspeak.eb2adab24877603e"},
    {"asterion triumphant", "@The_monster@ screams, \"The power of Makhleb!\"", "speech.monspeak.88b2da28052f2bfe"},
    {"asterion triumphant", "@The_monster@ bellows, \"I am king! All will kneel!\"", "speech.monspeak.3d6063368b472f6b"},
    {"azrael", "@_Azrael_common_@", "speech.monspeak.e7a919dc65de20d0"},
    {"azrael", "@_Azrael_rare_@", "speech.monspeak.0ddc779e23eddcd2"},
    {"_azrael_rare_", "@The_monster@ grins and asks @foe,@ \"Are you [flammable|inflammable|feeling hot]\?\"", "speech.monspeak.71582262b9bffd6f"},
    {"_azrael_rare_", "@The_monster@ says @to_foe@, \"We're having tasty @foe_genus@ kabobs tonight!\"", "speech.monspeak.61b7337b2cc50b42"},
    {"_azrael_rare_", "@The_monster@ screams @at_foe@, \"No! No! YES! No!\"", "speech.monspeak.bdf9678dfccf25c2"},
    {"_azrael_rare_", "VISUAL:@The_monster@ whirls about in circles.", "speech.monspeak.8de79c804a4150ee"},
    {"_azrael_rare_", "@The_monster@ says @to_foe@, \"May the fleas of a thousand camels infest your armpits.\"", "speech.monspeak.d8f2777ac57a57f7"},
    {"_azrael_rare_", "@The_monster@ wonders @at_foe@, \"Do you still suffer from delusions of adequacy\?\"", "speech.monspeak.1f816941bbc4bbe0"},
    {"_azrael_rare_", "@The_monster@ says @to_foe@, \"May your bottom itch incessantly and may your @_player_arms_@ be too short to scratch it.\"", "speech.monspeak.4462685caeebbf51"},
    {"_azrael_rare_", "@The_monster@ says @to_foe@, \"You child of a motherless goat.\"", "speech.monspeak.0d4336b597419695"},
    {"_azrael_rare_", "@The_monster@ says @to_foe@, \"You child of a rabid dog! Grandchild of a stinking jackal! Great-grandchild of a plucked vulture!\"", "speech.monspeak.4d74f84a6f1f8b80"},
    {"_azrael_rare_", "@The_monster@ says @to_foe@, \"May a porcupine live in your trousers for a thousand days and die there for a thousand and one.\"", "speech.monspeak.6cd42da4cdf49c0c"},
    {"bai suzhen", "@_Bai_Suzhen_common_@", "speech.monspeak.e16317c8cdaf0e32"},
    {"bai suzhen", "@_Bai_Suzhen_rare_@", "speech.monspeak.3b04a6f81cc15939"},
    {"_bai_suzhen_rare_", "@The_monster@ grouses about [the pranks of immortal alchemists|immature sisters].", "speech.monspeak.649caa240c2e8253"},
    {"_bai_suzhen_rare_", "@The_monster@ hisses, \"Days like this make me miss drinking.\"", "speech.monspeak.1d60bafa5545cb92"},
    {"_bai_suzhen_rare_", "@The_monster@ affirms to @reflexive@, \"Our love will make it through this.\"", "speech.monspeak.1989985f405fec2d"},
    {"_bai_suzhen_rare_", "@The_monster@ wonders wistfully, \"Should I have meditated another thousand years\?\"", "speech.monspeak.d417b432e4fd8b3e"},
    {"_bai_suzhen_rare_", "@The_monster@ whispers to @reflexive@, \"Everyone I saved... Everyone I doomed...\"", "speech.monspeak.08dca3dfc6c49549"},
    {"_bai_suzhen_rare_", "VISUAL:@The_monster_possessive@ form shimmers in the rain.", "speech.monspeak.f88da0243aeac40f"},
    {"blorkula the orcula triumphant", "@The_monster@ shouts, \"I believe in me!\"", "speech.monspeak.a2ba6e98b8a68182"},
    {"_blorkula_rare_", "@The_monster@ screams @at_foe@, \"What are you like inside\? I'll break you open and find out!\"", "speech.monspeak.98c24099409f5c5a"},
    {"_blorkula_rare_", "@The_monster@ screams @at_foe@, \"It's all true! You just have to believe!\"", "speech.monspeak.2c030990545d47b7"},
    {"_blorkula_rare_", "@The_monster@ screams @at_foe@, \"Look beyond the surface! Nothing is what it seems!\"", "speech.monspeak.970f32a01010ce88"},
    {"_blorkula_rare_", "@The_monster@ screams @at_foe@, \"I'll make you see things how they really are!\"", "speech.monspeak.5a440e458041037b"},
    {"_blorkula_rare_", "@The_monster@ says @to_foe@, \"There's so much colour in the world. Let me show it to you.\"", "speech.monspeak.da57a2cd8bdb566b"},
    {"_blorkula_rare_", "VISUAL:@The_monster@ contemplates whether Beogh's temples would look better painted @_blorkula_colour_@.", "speech.monspeak.b2025bc1e12e4b77"},
    {"_blorkula_rare_", "@The_monster@ says @to_foe@, \"The problem is, you see everything in terms of black and white.\"", "speech.monspeak.3afc0df42bf09f84"},
    {"_blorkula_rare_", "@The_monster@ mutters, \"Why is everything @_blorkula_colour_@ all of a sudden\?\"", "speech.monspeak.616a17d1fc619f79"},
    {"_blorkula_rare_", "@The_monster@ says, \"Things are no longer grey! Not since my great insight!\"", "speech.monspeak.ae2b8697bb4673ea"},
    {"blorkula the orcula killed", "A faint prismatic mist rises from Blorkula's broken form and then dissipates.", "speech.monspeak.ea9aa7c439547d8e"},
    {"boris", "@_Boris_common_@", "speech.monspeak.12a6239f52a182f4"},
    {"boris", "@_Boris_medium_@", "speech.monspeak.719e5654b6479ff3"},
    {"boris", "@_Boris_rare_@", "speech.monspeak.7cf3d63b7ea244f0"},
    {"_boris_common_", "VISUAL:@The_monster@ stares @at_foe@.", "speech.monspeak.c0fd1d7c2d43ef67"},
    {"_boris_common_", "@_wizard_common_spell_@\n@_fake_spell_effect_@", "speech.monspeak.3de3aeb16698e781"},
    {"_boris_medium_", "@The_monster@ laughs.", "speech.monspeak.91d9791050fef1a9"},
    {"_boris_medium_", "@The_monster@ says @to_foe@, \"You can't imagine my power.\"", "speech.monspeak.a6df17bafaed1574"},
    {"_boris_medium_", "@The_monster@ says, \"You want the ORB\? You'll never get it.\" @player_only@", "speech.monspeak.5217971059eea655"},
    {"_boris_medium_", "@The_monster@ boasts with wailing echoes, \"My power is unlimited.\"", "speech.monspeak.6916b3fc0d5c6947"},
    {"_boris_medium_", "@The_monster@ claims, \"You mortals are all unique only in the ways you'll break.\"", "speech.monspeak.c68f6102ad3c91a9"},
    {"_boris_medium_", "@The_monster@ says @to_foe@, \"You can't kill me in a way that matters.\"", "speech.monspeak.616e7e6de5793635"},
    {"_boris_medium_", "@The_monster@ says @to_foe@, \"I know the secret of eternal life. Do you\?\"", "speech.monspeak.2242e597755435b9"},
    {"_boris_medium_", "@The_monster@ says @to_foe@, \"I know your future. Your future is death.\"", "speech.monspeak.7ff6f856e1f11b5b"},
    {"_boris_medium_", "@The_monster@ says @to_foe@, \"Who wants to live forever\? Me.\"", "speech.monspeak.21afeb32b70308e4"},
    {"_boris_medium_", "@The_monster@ says @to_foe@, \"There's only one solution for all of you. To die.\"", "speech.monspeak.a24fed1180795ffd"},
    {"_boris_medium_", "@The_monster@ says @to_foe@, \"You can never win.\"", "speech.monspeak.9d77663a83c39d3f"},
    {"_boris_return_rare_", "@The_monster@ says @to_foe@, \"Kill me\? I think not!\"", "speech.monspeak.e4733ad015446fcd"},
    {"_boris_return_rare_", "@The_monster@ says @to_foe@, \"You cannot defeat me so easily!\"", "speech.monspeak.61643b5363e10727"},
    {"_boris_return_rare_", "@The_monster@ says @to_foe@, \"We will meet again!\"", "speech.monspeak.6f12fea4397567e9"},
    {"_boris_return_rare_", "@The_monster@ asks, \"Do I look like the kind of man who dies\?\"", "speech.monspeak.cb8ee922d5004a04"},
    {"boris timeout", "@The_monster@ says, \"You can't fire me, I quit!\"", "speech.monspeak.825290aa6994b96d"},
    {"friendly boris timeout", "@Boris timeout@", "speech.monspeak.145b24913db5f093"},
    {"boris triumphant", "@The_monster@ says, \"And that's the last I'll see of you.\"", "speech.monspeak.4fd25d78d0fb5cb6"},
    {"boris triumphant", "@The_monster@ says, \"I'd like to see you come back from this one.\"", "speech.monspeak.7140270ebb816594"},
    {"boris triumphant", "@The_monster@ says, \"I'll treasure this one.\"", "speech.monspeak.28f566d8997a7381"},
    {"boris riddle", "@The_monster@ says, \"You would ask such trivialities of one who has solved death itself\?\"", "speech.monspeak.9f305413353fd803"},
    {"cassandra", "@The_monster@ says, \"A terrible fate awaits all who seek the ORB - and yours worst of all.\" @player_only@", "speech.monspeak.e8f2e6a22e185cf8"},
    {"cassandra", "@The_monster@ beseeches you, \"Abandon your quest, lest a terrible end find us all.\" @player_only@", "speech.monspeak.623bb59e101b3bf6"},
    {"cassandra", "@The_monster@ shouts, \"Turn back while you still can!\"", "speech.monspeak.b4bb8f9b1a6e13ad"},
    {"cassandra", "@The_monster@ says, \"The road you walk has only one end and you would not wish it even upon your enemies.\"", "speech.monspeak.f21ad9670bf2a8ab"},
    {"cassandra", "@The_monster@ cries, \"You know not what is at stake here!\"", "speech.monspeak.52cfb7aaedaceb37"},
    {"cassandra", "@The_monster@ says, \"You never know good fortune from ill. It is because you cannot see into the future.\"", "speech.monspeak.19dd6202c32648d3"},
    {"cassandra", "@The_monster@ says, \"Heed my words or we all shall suffer their consequence.\"", "speech.monspeak.fda21c8ee207d1a3"},
    {"cassandra", "@The_monster@ says, \"I have seen things no one ever should.\"", "speech.monspeak.bc1ac3d50aa09e3e"},
    {"cassandra", "@The_monster@ says, \"Knowledge is its own curse.\"", "speech.monspeak.f52172cd853a569d"},
    {"cassandra", "@The_monster@ says, \"Should we be naught but slaves of fate, I will still speak truth to my dying breath.\"", "speech.monspeak.1f96fc3a53a36360"},
    {"cassandra triumphant", "@The_monster@ gasps, \"Did I... did I finally change the future\?\"", "speech.monspeak.85419a7a31a3caac"},
