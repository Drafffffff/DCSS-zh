    {"_chuck_generic_", "@The_monster@ says, \"Big rocks, small rocks, huge rocks! Magic rocks!\"", "speech.monspeak.42c2f9faf419dfee"},
    {"_chuck_generic_", "VISUAL:@The_monster@ drools a little bit.", "speech.monspeak.ca47746da1d163e3"},
    {"_chuck_rare_", "@The_monster@ says, \"Me has best rocks.\"", "speech.monspeak.49ecce495ce81818"},
    {"_chuck_rare_", "VISUAL:@The_monster@ inspects you suspiciously.", "speech.monspeak.a2597d9cde33ca33"},
    {"_chuck_rare_", "@The_monster@ says, \"No steal rocks!\"", "speech.monspeak.8c11a2712b306186"},
    {"_chuck_rare_", "@The_monster@ screams, \"THIEF!\"", "speech.monspeak.aabb91fa2add238c"},
    {"_chuck_rare_", "@The_monster@ says, \"You took it. Me saw.\"", "speech.monspeak.6cf74f5d000effe3"},
    {"_chuck_rare_", "@The_monster@ says, \"Best rocks! Rocks!\"", "speech.monspeak.8c4b03fd0e70df6b"},
