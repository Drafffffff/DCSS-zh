    {"nergalle", "@The_monster@ says, \"Orcish loyalty transcends such trifles as death.\"", "speech.monspeak.2311ffa3f6898528"},
    {"nergalle", "@The_monster@ says, \"Take it from an old woman: your time is up.\"", "speech.monspeak.669ce8f00725c703"},
    {"nergalle", "@The_monster@ says, \"You'll be just another bloodstain on the stones of this place.\"", "speech.monspeak.baccdcd201e4b003"},
    {"confused nergalle", "@The_monster@ mutters, \"Now, where did I put that quill...\"", "speech.monspeak.e9e0387820d2603e"},
    {"confused nergalle", "@The_monster@ mumbles, \"Leave me be, @orc name@. I told you I'm busy...\"", "speech.monspeak.3eb548708bb136ea"},
    {"confused nergalle", "@The_monster@ mumbles, \"Stop that blasted singing, @orc name@. You were always terrible.\"", "speech.monspeak.489ed7361a2c669e"},
    {"_nessos_common_", "@The_monster@ pounds the earth with @possessive@ hooves.", "speech.monspeak.f40ed2848c4031c8"},
