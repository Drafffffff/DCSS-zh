    {"_gastronok_common_", "VISUAL:@The_monster@ sloshes about.", "speech.monspeak.4a1f030012f91ffc"},
    {"_gastronok_common_", "@The_monster@ gurgles, \"I'll eat you, I will!\"", "speech.monspeak.83467da6f9fd0d44"},
