    {"vehumet player ghost", "@The_monster@ says, \"The agents of utter destruction are not stopped by death.\"", "speech.monspeak.a2300a4d66bf1b47"},
    {"vehumet player ghost", "@The_monster@ boasts, \"After taking care of you, I will research a spell that consumes the world.\"", "speech.monspeak.a1f15494337fb563"},
    {"vehumet player ghost", "@The_monster@ threatens, \"Do not fail me, O fires of Iskenderun!\"", "speech.monspeak.01f78533424e8ff1"},
    {"wu jian player ghost", "@The_monster@ says @to_foe@, \"You lack the discipline to defeat me.\"", "speech.monspeak.f80fdbde13550f78"},
    {"wu jian player ghost", "@The_monster@ says @to_foe@, \"Let's see how well you move.\"", "speech.monspeak.30d85dedfb89f874"},
    {"wu jian player ghost", "@The_monster@ says, \"I'm much more flexible now that I'm not limited by flesh.\"", "speech.monspeak.c52f393be3e71e6c"},
    {"zin player ghost", "@The_monster@ says @to_foe@, \"I died poor and in vain, but not as a freak.\"", "speech.monspeak.38fae8bde8bb7112"},
    {"zin player ghost", "@The_monster@ says @to_foe@, \"For all the tithing, I expected a more glorious afterlife than this.\"", "speech.monspeak.4c83f109a06e1ab7"},
    {"_player_ghost_common_", "VISUAL:@The_monster@ stares at @foe@.", "speech.monspeak.e388e9c81e32060d"},
    {"_player_ghost_common_", "@The_monster@ lets out a mournful wail.", "speech.monspeak.acd4f24a94eaeb32"},
    {"_player_ghost_common_", "@The_monster@ keens inconsolably.", "speech.monspeak.fe89b0f904c768f4"},
    {"_player_ghost_common_", "@The_monster@ wails.", "speech.monspeak.788082f1bf32e254"},
    {"_player_ghost_common_", "VISUAL:@The_monster@ ripples.", "speech.monspeak.545eaa163c4fc8ae"},
    {"_player_ghost_common_", "@The_monster@ @_wails_@, \"What do you have that I didn't have\?\"", "speech.monspeak.858c53882e401e45"},
    {"_player_ghost_common_", "@The_monster@ says very slowly, \"There's no hope.\"", "speech.monspeak.cd737bba775d1521"},
    {"_player_ghost_common_", "@The_monster@ @_wails_@, \"You will never get the ORB!\" @player_only@", "speech.monspeak.aea2e19e07cdb19e"},
    {"_player_ghost_common_", "@The_monster@ whispers, \"The ORB doesn't exist.\" @player_only@", "speech.monspeak.4b18c900a13c6c2f"},
    {"_player_ghost_common_", "@The_monster@ @_wails_@, \"They lied to you. The Dungeon just goes down and down forever.\"", "speech.monspeak.2b1b8023bbcd8117"},
    {"_player_ghost_common_", "@The_monster@ @_wails_@, \"You will join me soon!\"", "speech.monspeak.b394dd5b390961db"},
    {"_player_ghost_common_", "@The_monster@ @_wails_@, \"You must not succeed where I failed!\"", "speech.monspeak.33d5746d59b0bc8f"},
    {"_player_ghost_common_", "@The_monster@ whispers @to_foe@, \"There is no future for you.\"", "speech.monspeak.4729af392164d2ea"},
    {"_player_ghost_rare_", "@The_monster@ @_wails_@, \"To die, to sleep, no more.\"", "speech.monspeak.18ef3d96e0d0e6f8"},
    {"_player_ghost_rare_", "@The_monster@ whispers, \"Everlasting silence awaits you...\"", "speech.monspeak.9dde330523ca13b8"},
    {"_player_ghost_rare_", "@The_monster@ whispers, \"Death doesn't hurt. What you feel is life.\"", "speech.monspeak.33828fcad64ed667"},
    {"_player_ghost_rare_", "@The_monster@ whispers, \"You will understand me better in a moment.\"", "speech.monspeak.b2aa2e244a012c30"},
    {"_player_ghost_rare_", "@The_monster@ whispers, \"It is all a dream - a grotesque and foolish dream.\"", "speech.monspeak.4c3bd0fbfe99d998"},
    {"_player_ghost_rare_", "@The_monster@ whispers, \"Soon you will have time, lots of time...\"", "speech.monspeak.ac99dcb3d29bae46"},
    {"_player_ghost_rare_", "@The_monster@ @_wails_@, \"You must not fail where I succeeded!\"", "speech.monspeak.23b16e212e999f7e"},
    {"_aizul_common_", "VISUAL:@The_monster@ yawns, and then pretends @subjective@ didn't.", "speech.monspeak.e6b786db0679f6f0"},
    {"_aizul_common_", "@The_monster@ says, \"Feeling sleepy\?\"", "speech.monspeak.9180ec451b522da1"},
    {"_aizul_common_", "@The_monster@ says, \"I wasn't actually sleeping!\"", "speech.monspeak.370d76ecca0929a6"},
    {"_aizul_common_", "VISUAL:@The_monster@ hisses menacingly.", "speech.monspeak.37b040e8d044f4a4"},
    {"_aizul_common_", "@The_monster@ screams @at_foe@, \"I'll haunt your nightmares!\"", "speech.monspeak.81a3cca7908804f2"},
    {"_agnes_common_", "VISUAL:@The_monster@ bows.", "speech.monspeak.d51527ac98b8498e"},
    {"_agnes_common_", "@The_monster@ says @to_foe@, \"You dishonour your ancestors.\"", "speech.monspeak.a172f8739e1d4330"},
    {"_agnes_common_", "@The_monster@ says @to_foe@, \"I despise a dishonourable opponent.\"", "speech.monspeak.32fc62864cb53696"},
    {"_agnes_common_", "@The_monster@ says @to_foe@, \"It is my duty to kill you, but also my pleasure.\"", "speech.monspeak.07a77b754e31f960"},
    {"_agnes_common_", "@The_monster@ mutters, \"I never trained for this.\"", "speech.monspeak.61eef10746aa082d"},
    {"_agnes_common_", "@The_monster@ says @to_foe@, \"You will find the Path of Peace easy to follow, in death.\"", "speech.monspeak.3c70d5fc842f6b86"},
    {"agnes triumphant", "@The_monster@ says, \"May you follow the Path of Peace in your next life.\"", "speech.monspeak.677836f4867f3085"},
    {"antaeus triumphant", "@The_monster@ says, \"Your soul will be trapped in ice for ten thousand years.\"", "speech.monspeak.5e45916e77f50ea2"},
    {"amaemon", "@_Amaemon_common_@", "speech.monspeak.3e672f480f79773d"},
    {"amaemon", "@_Amaemon_rare_@", "speech.monspeak.96d38c554aab429c"},
    {"arachne", "@The_monster@ says, \"Follow my lead, little ones.\"", "speech.monspeak.72647330b2b72469"},
    {"arachne", "@The_monster@ says, \"I resented this body once, but could any human make what I've made\?\"", "speech.monspeak.236ad645fa5030b1"},
    {"arachne", "@The_monster@ snarls, \"I will not be driven out again.\"", "speech.monspeak.af8a8230964912ce"},
    {"arachne", "@The_monster@ says @to_foe@, \"Come closer, little fly.\"", "speech.monspeak.943d173197510c81"},
    {"arachne", "@The_monster@ says @to_foe@, \"I'm done suffering for art; you can suffer instead.\"", "speech.monspeak.3e30ba09b6edadb6"},
    {"arachne", "@The_monster@ says @to_foe@, \"My silk is a match for both steel and spell.\"", "speech.monspeak.0381027e94cc2fce"},
    {"arachne", "@The_monster@ says @to_foe@, \"I will spin a new home for us all.\"", "speech.monspeak.5e76ee127ffce213"},
    {"_azrael_common_", "@The_monster@ laughs insanely.", "speech.monspeak.8acd0376b32e29da"},
    {"_azrael_common_", "@The_monster@ howls in rage.", "speech.monspeak.05b233a6f8431add"},
    {"_azrael_common_", "@The_monster@ screams @at_foe@, \"Burn! Burn! All of it must BURN!\"", "speech.monspeak.d829f513e72fa52d"},
    {"_azrael_common_", "VISUAL:@The_monster@ blows smoke rings.", "speech.monspeak.81408ea8dc8407c7"},
    {"_azrael_common_", "VISUAL:@The_monster_possessive@ eyes look fiery.", "speech.monspeak.ddbda2643e54e64e"},
    {"_azrael_common_", "VISUAL:@The_monster@ is momentarily hidden by a cloud of flames.", "speech.monspeak.4ae83f90e453f57f"},
    {"_bai_suzhen_common_", "@The_monster@ grumbles, \"Damn that jealous turtle monk.\"", "speech.monspeak.99a81b2aad8a77de"},
    {"_bai_suzhen_common_", "@The_monster@ pines for @possessive@ lost husband.", "speech.monspeak.04e6e852721360b3"},
    {"_bai_suzhen_common_", "@The_monster@ roars, \"Even the heavens can't separate us forever!\"", "speech.monspeak.711f7822f2d2c999"},
    {"_bai_suzhen_common_", "@The_monster@ inspects @possessive@ gathered herbal reagents.", "speech.monspeak.bd8c693a1bfeb24f"},
    {"_bai_suzhen_common_", "VISUAL:@The_monster@ twists and twirls @possessive@ body through the storm.", "speech.monspeak.fd13615d9de22493"},
    {"blorkula the orcula", "@_Blorkula_common_@", "speech.monspeak.0ef574ad2282cc15"},
    {"blorkula the orcula", "@_Blorkula_rare_@", "speech.monspeak.7c0a212ce56f634d"},
    {"_blorkula_colour_", "@rainbow_colour@", "speech.monspeak.07fe89bfe71221fd"},
    {"_blorkula_colour_", "@misc_colour@", "speech.monspeak.acfbc2572d26aa5f"},
    {"_blorkula_common_", "@_generic_orc_speech_@", "speech.monspeak.d659d70b1d914aa7"},
    {"_blorkula_common_", "VISUAL:@The_monster@ grins serenely.", "speech.monspeak.ef1edb27309d1466"},
    {"_blorkula_common_", "VISUAL:@The_monster@ is briefly surrounded by a halo of @_blorkula_colour_@ light.", "speech.monspeak.30c03ddd4acef8c0"},
    {"_blorkula_common_", "VISUAL:@The_monster_possessive@ eyes glow @_blorkula_colour_@.", "speech.monspeak.1b6d15e3d844cd04"},
    {"_blorkula_common_", "@The_monster@ says @to_foe@, \"You need a new perspective.\"", "speech.monspeak.7485a5fd7a48c630"},
    {"_blorkula_common_", "@The_monster@ screams @at_foe@, \"Let me show you how many colours things can be!\"", "speech.monspeak.ab0733eb89eb3efe"},
    {"_blorkula_common_", "@The_monster@ says, \"Beogh has given me so many different colours to drink.\"", "speech.monspeak.7a6cc667f8c00a77"},
    {"_blorkula_common_", "@The_monster@ says, \"I was weak before I became an orc, but now I'm strong. And I'll get stronger.\"", "speech.monspeak.4db29f83a3d2ca28"},
    {"_blorkula_common_", "@The_monster@ says, \"Everything's been so different since that missionary gave me these suspenders.\"", "speech.monspeak.b4e6216da393f2cf"},
    {"_blorkula_common_", "@The_monster@ mutters, \"Such pretty colours everywhere...\"", "speech.monspeak.9a41e5597f4446ce"},
    {"_blorkula_common_", "@The_monster@ says, \"My favourite colour of blood is @_blorkula_colour_@. Wait, no, @_blorkula_colour_@.\"", "speech.monspeak.50fb7d8297f39b72"},
    {"_blorkula_common_", "@The_monster@ screams, \"What are you staring at, @player_name@\? I'm stylish!\" @player_only@", "speech.monspeak.509ef8e143d38390"},
    {"_boris_rare_", "@The_monster@ says @to_foe@, \"I didn't invite you.\"", "speech.monspeak.bb42ab6aa1601954"},
    {"_boris_rare_", "@The_monster@ says @to_foe@, \"The world, the flesh, and the devil.\"", "speech.monspeak.9e846be37433e009"},
    {"_boris_rare_", "@The_monster@ says, \"There's no good or evil. Just power and will.\"", "speech.monspeak.03361a72fb2009a7"},
    {"_boris_rare_", "@The_monster@ says, \"You have all forgotten the taste of death.\"", "speech.monspeak.808b62b72d81eec8"},
    {"_boris_rare_", "@The_monster@ claims, \"I care not for such insignificant forces as time or death.\"", "speech.monspeak.48d92735f4af4606"},
    {"_boris_rare_", "@The_monster@ says, \"Magic. You know nothing about it.\"", "speech.monspeak.d0e4645cd2593fd1"},
    {"_boris_rare_", "@The_monster@ says @to_foe@, \"Join my legions of the broken and the beaten.\"", "speech.monspeak.20969e9f88428fbc"},
    {"boris killed", "@_Boris_return_common_@", "speech.monspeak.28590af16d94c66a"},
    {"boris killed", "@_Boris_return_rare_@", "speech.monspeak.191b65b49911f28a"},
    {"_boris_return_common_", "@The_monster@ says @to_foe@, \"You haven't seen the last of me!\"", "speech.monspeak.41a09cc7de1911f4"},
    {"_boris_return_common_", "@The_monster@ says @to_foe@, \"I'll get you next time!\"", "speech.monspeak.3684445bbf987e79"},
    {"_boris_return_common_", "@The_monster@ says @to_foe@, \"This isn't over yet!\"", "speech.monspeak.4e17a5b95edf0761"},
    {"_boris_return_common_", "@The_monster@ says, \"I'll be back!\"", "speech.monspeak.371e2318c13384d1"},
    {"_boris_return_common_", "@The_monster@ says, \"This isn't the end, it's only just beginning!\"", "speech.monspeak.1712aa4239d4a7bc"},
    {"cassandra killed", "@The_monster@ gasps with @possessive@ dying breath, \"I... tried to warn you...\"", "speech.monspeak.10491d102f2575b7"},
    {"cassandra killed", "@The_monster@ gasps with @possessive@ dying breath, \"No one... ever listens...\"", "speech.monspeak.ca6e6a59f4b9814b"},
    {"cassandra killed", "@The_monster@ gasps with @possessive@ dying breath, \"Your fate... be upon your own head...\"", "speech.monspeak.79fc458b6bb9c415"},
    {"friendly cassandra", "@The_monster@ begs you to reconsider your quest.", "speech.monspeak.c7a556a38961adf6"},
    {"friendly cassandra", "@The_monster@ pleads, \"Will you not heed even the word of a friend and end this\?\"", "speech.monspeak.f3ebf0e8f76f9299"},
    {"friendly cassandra", "@The_monster@ says, \"Even I cannot save you if you persist in this.\"", "speech.monspeak.27084d57fff910a1"},
    {"crazy yiuf", "@_crazy_yiuf_speech_@", "speech.monspeak.748d608bd81f5476"},
    {"xom crazy yiuf", "@The_monster@ says, \"The life which is unexamined is not worth living.\"", "speech.monspeak.459f918233b41a25"},
    {"xom crazy yiuf", "@The_monster@ says, \"My goal is simple. It is a complete understanding of the universe, why it is as it is and why it exists at all.\"", "speech.monspeak.a444a1954fd27eae"},
    {"xom crazy yiuf", "@The_monster@ says, \"One may say the eternal mystery of the world is its comprehensibility.\"", "speech.monspeak.a2cf7ae2b214e236"},
    {"xom crazy yiuf", "@The_monster@ says, \"Which is more difficult, to awaken one who sleeps or to awaken one who, awake, dreams that he is awake\?\"", "speech.monspeak.e48ad5e77c47fada"},
    {"xom crazy yiuf", "@The_monster@ says, \"Everyone has the same god; only people differ.\"", "speech.monspeak.f6eeb92c1a8ec642"},
    {"xom crazy yiuf", "@The_monster@ says, \"Against boredom even gods struggle in vain.\"", "speech.monspeak.3eaf04b15dff24ab"},
    {"xom crazy yiuf", "@The_monster@ says, \"No facts are to me sacred; none are profane; I simply experiment, an endless seeker, with no past at my back.\"", "speech.monspeak.991a2b63a30cfcbe"},
    {"xom crazy yiuf", "@The_monster@ says, \"The present is the child, and the necessary child, of all the past, and the mother of all the future.\"", "speech.monspeak.db173d5b6d84140c"},
    {"xom crazy yiuf", "@The_monster@ says, \"Reason is nothing but a wonderful and unintelligible instinct in our souls.\"", "speech.monspeak.da71b7342ba7b159"},
    {"xom crazy yiuf", "@The_monster@ says, \"It is extremely absurd to expect to be enlightened by reason, and yet to prescribe to it beforehand on which side it must incline.\"", "speech.monspeak.b571a1b704c53ff8"},
    {"xom crazy yiuf", "@The_monster@ says, \"The real reality is there, but everything you KNOW about 'it' is in your mind and yours to do with as you like.\"", "speech.monspeak.5ba94ef6ef688c68"},
    {"xom crazy yiuf", "VISUAL:@The_monster@ considers dialectic materialism.", "speech.monspeak.e5be346b1da95cb0"},
    {"xom crazy yiuf", "VISUAL:@The_monster@ ponders an existential dilemma.", "speech.monspeak.cb313e89cab8a0ba"},
    {"xom crazy yiuf", "VISUAL:@The_monster@ shuffles @possessive@ notes under @possessive@ cloak.", "speech.monspeak.d673b83d0df1e4a4"},
    {"xom crazy yiuf", "VISUAL:@The_monster@ heaves a sigh in contemplation.", "speech.monspeak.71c38ba137f041e3"},
    {"_crazy_yiuf_speech_", "@The_monster@ @_crazy_yiuf_speech_verbs_@, \"@_crazy_yiuf_sentence_@\"", "speech.monspeak.ff3cd063ca48ed27"},
    {"_crazy_yiuf_speech_", "VISUAL:@The_monster@ waves @possessive@ quarterstaff at you. @player_only@", "speech.monspeak.2bbc68034c8d1f48"},
    {"_crazy_yiuf_speech_", "@The_monster@ cries, \"You leg down broken song, no\?\"", "speech.monspeak.60684cc4e919f36a"},
    {"_crazy_yiuf_speech_", "VISUAL:@The_monster@ glowers.", "speech.monspeak.b964dbc8888ed4d0"},
    {"_crazy_yiuf_speech_", "VISUAL:@The_monster@ twirls on the spot.", "speech.monspeak.cae191fbcbaaecc3"},
    {"_crazy_yiuf_speech_", "VISUAL:@The_monster@ flaps @possessive@ cloak.", "speech.monspeak.48fd83a0849f4fe7"},
    {"_crazy_yiuf_speech_", "@The_monster@ says, \"Crazy\? Crazy!\? PORCUPINE!\"", "speech.monspeak.5756c249d4cf6065"},
    {"_crazy_yiuf_speech_", "@The_monster@ sings, \"Trees, trees, trees, circus!\"", "speech.monspeak.4e0c3101177c1707"},
    {"_crazy_yiuf_speech_", "@The_monster@ says, \"I'm not crazy!\"", "speech.monspeak.df08e6ca327de4a6"},
    {"_crazy_yiuf_speech_", "@The_monster@ says, \"What sane person could live in this world and not be crazy\?\"", "speech.monspeak.e4516ba0cb5dfe19"},
