    {"edmund", "@_Edmund_common_@", "speech.monspeak.d05f1ad875844a93"},
    {"edmund", "@_Edmund_rare_@", "speech.monspeak.d68a6128492e5f33"},
    {"_edmund_rare_", "VISUAL:@The_monster@ grinds @possessive@ teeth, and then sighs.", "speech.monspeak.7144881ac888cc62"},
    {"_edmund_rare_", "VISUAL:@The_monster@ looks rather jealous.", "speech.monspeak.3232cae5819bab44"},
    {"_edmund_rare_", "@The_monster@ says, \"A flail is better than a scythe, any day of the week!\"", "speech.monspeak.981ea51d6f633e7e"},
    {"_edmund_rare_", "@The_monster@ says, \"What use are spells, anyway\?\"", "speech.monspeak.d70c379a01519b2e"},
    {"_edmund_rare_", "@The_monster@ mutters, \"Who needs spells, anyway\?\"", "speech.monspeak.94650db4fec986a0"},
    {"_edmund_rare_", "@The_monster@ says, \"Everyone always remembers my brother. 'Who's Edmund\?' they ask!\"", "speech.monspeak.a23b0fac1ee51220"},
    {"_edmund_rare_", "@The_monster@ says, \"People will remember me! They'll remember me and die!\"", "speech.monspeak.795e74343c5281b1"},
    {"_edmund_rare_", "@The_monster@ says, \"Maybe I'll buy a title. How does Count Edmund sound\?\"", "speech.monspeak.0a4b5aab393876cc"},
    {"_edmund_rare_", "@The_monster@ whines, \"My parents never had time for me!\"", "speech.monspeak.e7964dc1ec8cb0d0"},
    {"edmund triumphant", "@The_monster@ says, \"That'll show my brother!\"", "speech.monspeak.682af1c2b534712d"},
    {"edmund triumphant", "@The_monster@ says, \"I'd like to see a scythe do that!\"", "speech.monspeak.94d8131846f16326"},
    {"edmund triumphant", "@The_monster@ whines, \"They better pay attention to me now!\"", "speech.monspeak.594b0d553958a6f2"},
    {"_erica_rare_", "@The_monster@ screams @at_foe@, \"Hurry, death AWAITS you!\"", "speech.monspeak.5e304c78e43a48d1"},
    {"_erica_rare_", "@The_monster@ screams @at_foe@, \"I'll never tell where it is!\"", "speech.monspeak.cdf1a896960c161c"},
    {"_erica_rare_", "@The_monster@ screams @at_foe@, \"You'll never get it!\"", "speech.monspeak.2f0435dc0b460f19"},
    {"_erica_rare_", "@The_monster@ says @to_foe@, \"The claw is nothing compared to the sucker!\"", "speech.monspeak.684f78b8312b1f6e"},
    {"_erica_rare_", "@The_monster@ boasts @to_foe@, \"If terror be the object, I am a masterpiece!\"", "speech.monspeak.4fb3d97ee66e7f3d"},
    {"_erica_rare_", "@The_monster@ boasts @to_foe@, \"Reason would be justified, if not for me!\"", "speech.monspeak.3e49dbaa37ad92a6"},
    {"erica triumphant", "@The_monster@ begins burbling mirthfully and uncontrollably.", "speech.monspeak.fcf6cc0ba21974d1"},
    {"_erolcha_common_", "@The_monster@ roars.", "speech.monspeak.73bdb3ba0d7008bf"},
    {"_erolcha_common_", "@The_monster@ growls.", "speech.monspeak.7b918c3ca29a73a9"},
    {"_erolcha_common_", "VISUAL:@The_monster@ tries to grin evilly.", "speech.monspeak.ba8fe6b7863423bb"},
    {"_erolcha_common_", "@The_monster@ screams @at_foe@, \"DIE!\"", "speech.monspeak.5d9906cd19fdb21c"},
    {"_erolcha_common_", "@The_monster@ screams @at_foe@, \"Lunch!\"", "speech.monspeak.91645976815fa024"},
    {"_erolcha_common_", "@The_monster@ screams @at_foe@, \"Erolcha kill you!\"", "speech.monspeak.2de8ac5af6f2cb40"},
    {"eustachio", "@_Eustachio_common_@", "speech.monspeak.6dd13533817721e1"},
    {"eustachio", "@_Eustachio_rare_@", "speech.monspeak.9580833f2abe7fe2"},
    {"_eustachio_common_", "@The_monster@ screams @at_foe@, \"At last I'll have my revenge!\"", "speech.monspeak.485d32d80a113790"},
    {"_eustachio_common_", "@The_monster@ screams @at_foe@, \"Hey, you killed my favourite bat!\"", "speech.monspeak.f2759121e666418d"},
    {"_eustachio_common_", "@The_monster@ says @to_foe@, \"Summoning is fun!\"", "speech.monspeak.22a7f710a66f9ef2"},
    {"_eustachio_common_", "@The_monster@ says @to_foe@, \"My allies will avenge me.\"", "speech.monspeak.e9176197d69a2490"},
    {"_eustachio_common_", "@The_monster@ screams, \"This atrocity can only be purified with blood!\"", "speech.monspeak.e06513b6ffe837b3"},
    {"_eustachio_common_", "@The_monster@ utters an oath, \"I will die for my friends!\"", "speech.monspeak.7fe26081958f3a7b"},
    {"_eustachio_common_", "@The_monster@ growls, \"To hell with you, honourless miscreant!\"", "speech.monspeak.e632a09c678f55ce"},
    {"_eustachio_common_", "@The_monster@ asks, \"How can you live without manners, virtues and honour\?\"", "speech.monspeak.2376626d110f3b9b"},
    {"_eustachio_rare_", "@The_monster@ yells @at_foe@, \"Perjured traitor, DIE!\"", "speech.monspeak.0dc28b1ca1cb9dfc"},
    {"_eustachio_rare_", "VISUAL:@The_monster@ twirls @possessive@ moustache.", "speech.monspeak.918a1beee929f086"},
    {"_eustachio_rare_", "@The_monster@ calls on the powers of shadow!", "speech.monspeak.0846a2fe59c15923"},
    {"_eustachio_rare_", "@The_monster@ brags, \"I can call spirits from the vasty deep.\"", "speech.monspeak.ca9c5d26b20cafff"},
    {"eustachio triumphant", "VISUAL:@The_monster@ twirls @possessive@ moustache.", "speech.monspeak.bddcd5b7ed92c282"},
    {"eustachio triumphant", "@The_monster@ says, \"Such is the fate of all honourless rascals.\"", "speech.monspeak.c960bb556a8921dd"},
    {"frances", "@_Frances_common_@", "speech.monspeak.1be32f25c979e64b"},
    {"frances", "@_Frances_rare_@", "speech.monspeak.041a4c578ebf99e0"},
    {"_frances_rare_", "VISUAL:@The_monster@ takes a defensive stance.", "speech.monspeak.629b354d0bcdfa2b"},
    {"_frances_rare_", "@The_monster@ growls a series of guttural syllables.", "speech.monspeak.c0a46c97d600120a"},
    {"_frances_rare_", "@The_monster@ says, \"There is a strange beauty in the demonic, don't you think\?\"", "speech.monspeak.2dacec61b78b2dc1"},
    {"_frances_rare_", "@The_monster@ says, \"Would you challenge me, knowing my power\?\"", "speech.monspeak.3971a89822916e1a"},
    {"_frances_rare_", "@The_monster@ says, \"I am undefeated in single-handed combat.\"", "speech.monspeak.ed4a4a90bdcb0a2e"},
    {"_frances_rare_", "@The_monster@ says, \"Warriors are made for war and combat. Do you call yourself a warrior\?\"", "speech.monspeak.ab47abffd374d3db"},
    {"_frances_rare_", "@The_monster@ says, \"Even the Halls of Hell could not contain me.\"", "speech.monspeak.eb865508f3d6da6c"},
    {"_frances_rare_", "@The_monster@ says, \"I will defeat you, of this I have no doubt!\" @player_only@", "speech.monspeak.5659ac360b1c2965"},
    {"beogh frederick", "@The_monster@ says, \"You didn't bring enough reinforcements. Come back later!\"", "speech.monspeak.c4608bb0e09de923"},
    {"beogh frederick", "@Frederick@", "speech.monspeak.9082cda599b44c46"},
    {"_frederick_common_", "VISUAL:@The_monster@ pines for a worthy opponent.", "speech.monspeak.7f5f2a8efd6dc2c1"},
    {"_frederick_common_", "VISUAL:@The_monster@ yawns in an exaggerated manner.", "speech.monspeak.9655dfa6c9f17c26"},
    {"_frederick_common_", "@The_monster@ offers a few words of tactical advice.", "speech.monspeak.65cc5665fa0e21d2"},
    {"_frederick_common_", "@The_monster@ says, \"Adventurers these days do not know how to walk, let alone fight.\"", "speech.monspeak.0009e18568a82f2e"},
    {"_frederick_common_", "@The_monster@ says, \"In my day, to be a hero meant something. Now, it just means you die quicker.\"", "speech.monspeak.472d13209851059b"},
    {"_frederick_common_", "@The_monster@ says, \"You call yourself an adventurer\? Hah!\"", "speech.monspeak.2d3e11f7e0982e8d"},
    {"_frederick_common_", "@The_monster@ says, \"I've killed five 'adventurers' today. Will you be the sixth\?\"", "speech.monspeak.4d29234e55f072f5"},
    {"_frederick_common_", "@The_monster@ says, \"Challenge me\? You, and whose army\?\" @player_only@", "speech.monspeak.1a8a99b27eb9dd2b"},
    {"_frederick_common_", "@The_monster@ says @to_foe@, \"Why should I even bother fighting the likes of you\?\"", "speech.monspeak.da95a3326a336671"},
    {"ashenzari frederick triumphant", "@The_monster@ shakes @possessive@ head sadly, \"Willingly donning a god's shackles... pitiful.\"", "speech.monspeak.acbcb51bf1340235"},
    {"ashenzari frederick triumphant", "@Frederick@", "speech.monspeak.30bf637bc5250556"},
    {"beogh frederick triumphant", "@The_monster@ sighs, \"Your brethren were only holding you back, @player_genus@.\"", "speech.monspeak.99afa9fcd6dc1d81"},
    {"beogh frederick triumphant", "@Frederick@", "speech.monspeak.f4be35feccf96b52"},
    {"gozag frederick triumphant", "@The_monster@ says, \"Your greed held you back.\"", "speech.monspeak.6de432b924b410bd"},
    {"gozag frederick triumphant", "@Frederick@", "speech.monspeak.50a74c1bb2e1e2d5"},
    {"hepliaklqana frederick triumphant", "@The_monster@ says, \"Relying on the deeds of your ancestors brought you no glory.\"", "speech.monspeak.8bfc0d9c74c2e2c4"},
    {"hepliaklqana frederick triumphant", "@Frederick@", "speech.monspeak.805f00065638b991"},
    {"kikubaaqudgha frederick triumphant", "@The_monster@ sighs, \"Join the corpses you idolise, mortal.\"", "speech.monspeak.a86c896c4dc0fd58"},
    {"kikubaaqudgha frederick triumphant", "@Frederick@", "speech.monspeak.6e75cb994f888f1a"},
    {"lugonu frederick triumphant", "@The_monster@ says, \"A more permanent form of banishment for you, mortal.\"", "speech.monspeak.d777f315d7845117"},
    {"lugonu frederick triumphant", "@Frederick@", "speech.monspeak.1c7e1e5748405857"},
    {"makhleb frederick triumphant", "@The_monster@ says, \"And take your demons with you.\"", "speech.monspeak.ca468657ab0dd00a"},
