    {"forgecraft player ghost", "@The_monster@ says @to_foe@, \"Look on my works and despair!\"", "speech.monspeak.cf548338b7069e2f"},
    {"forgecraft player ghost", "@The_monster@ says @to_foe@, \"My constructs will outlast you.\"", "speech.monspeak.a8567727092a42f1"},
