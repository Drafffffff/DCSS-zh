    {"_mara_rare_", "@The_monster@ screams, \"Tenfold be your damnation!\"", "speech.monspeak.bf3ad9d9232eeba5"},
    {"_mara_rare_", "@The_monster_possessive@ features momentarily become yours. \"Wouldst slay thyself\?\"", "speech.monspeak.2679b6937c1919f0"},
    {"_mara_rare_", "@The_monster@ says, \"I stand as high above you as a star above the ocean's bottom.\"", "speech.monspeak.e10f50e4c5bda32b"},
    {"_mara_rare_", "@The_monster@ smirks. \"I am one who seeks the Path and the Right.\"", "speech.monspeak.b2889cc7f77cffde"},
    {"_mara_rare_", "@The_monster@ says, \"Thou art lean, ill-favoured, death is in thy neighbourhood!\"", "speech.monspeak.aa5cce6b2c6e73a6"},
    {"_mara_rare_", "@The_monster@ says, \"Difficult is the way of exertion, difficult to pass, difficult to enter upon.\"", "speech.monspeak.5bf8e6338ce937ee"},
    {"_mara_rare_", "@The_monster@ calls, \"Stop! In seven days from now the wheel of empire will appear!\"", "speech.monspeak.185e30ff82cd111b"},
