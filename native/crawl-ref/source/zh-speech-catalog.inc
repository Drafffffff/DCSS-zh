    {"_ignacio_rare_", "@The_monster@ says, \"I enjoy death. I like the smell. I like the greasy feel of cooling blood.\"", "speech.monspeak.92f66b9ec127eebe"},
    {"_ignacio_rare_", "@The_monster@ says, \"I have to say that I admire beauty and perfection. I like to watch it die. The contrast as it decays is exquisite.\"", "speech.monspeak.23a0ca7d2434999e"},
    {"_ignacio_rare_", "@The_monster@ says in a calm gravelly voice, \"173 down. One million more to go.\"", "speech.monspeak.5d1e52575601b34b"},
    {"_ignacio_rare_", "@The_monster@ says, \"The death blow is fun, but the real pleasure is in torturing beforehand.\"", "speech.monspeak.c1dc1ca3970ef8b5"},
    {"_ignacio_rare_", "@The_monster@ says @to_foe@, \"No gallows around, so decapitation it is.\"", "speech.monspeak.f7fda4a6b6b27914"},
