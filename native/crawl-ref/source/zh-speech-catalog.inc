    {"grunn", "@_Grunn_common_@", "speech.monspeak.4109d1f8a9c5e69c"},
    {"grunn", "@_Grunn_rare_@", "speech.monspeak.b6015427fdd3b9aa"},
    {"_grunn_rare_", "VISUAL:One of @the_monster_possessive@ claws falls out.", "speech.monspeak.d8d3d4c41a6a79fb"},
    {"_grunn_rare_", "VISUAL:@The_monster@ pats at a spot of missing fur and sighs.", "speech.monspeak.3bd640538021319c"},
    {"_grunn_rare_", "@The_monster@ @_Grum_verb_@ @at_foe@, \"My dogs and I will have a feast tonight...\"", "speech.monspeak.8c2ff0942d4c408d"},
    {"_grunn_rare_", "@The_monster@ @_Grum_verb_@ @at_foe@, \"I don't need to eat anymore, but I'll make an exception for you.\"", "speech.monspeak.94f206ede80a4702"},
    {"_grunn_rare_", "@The_monster@ asks, \"What kind of bones do @player_genus_plural@ have\? My dogs are dying to find out.\" @player_only@", "speech.monspeak.c17320da1b435897"},
    {"_grunn_rare_", "@The_monster@ looks @at_foe@ and @_Grum_verb_@, \"Time to put down the runt of the litter.\"", "speech.monspeak.e90a8ec062c8dd80"},
    {"_grunn_rare_", "@The_monster@ @_Grum_verb_@ @at_foe@, \"Me and @_Grum_dog_name_@ will play fetch with your bones!\"", "speech.monspeak.489adbcb874af91f"},
    {"_grunn_rare_", "@The_monster@ shouts, \"Faster, @_Grum_dog_name_@! Kill! Kill!\"", "speech.monspeak.1d53ede7da10bb86"},
    {"_grunn_rare_", "@The_monster@ lets out a long, sad whine.", "speech.monspeak.1220478de17cc2b1"},
    {"_grunn_rare_", "@The_monster@ says, \"Selling your soul isn't that bad. What the hell, right\?\"", "speech.monspeak.aea1d93efe81c51e"},
    {"_grunn_rare_", "@The_monster@ moans, \"It's cold... so cold.\"", "speech.monspeak.27cb4dd16ca62609"},
    {"_harold_common_", "VISUAL:@The_monster@ looks eager to get this over with.", "speech.monspeak.42a93dbf29cd601e"},
    {"_harold_common_", "@The_monster@ yells @at_foe@, \"I don't have all day!\"", "speech.monspeak.297e27e5d6b319a0"},
    {"_harold_common_", "@The_monster@ grumbles @at_foe@, \"Just give up already, I want to go home!\"", "speech.monspeak.bc915c18fc0cd1d5"},
    {"_harold_common_", "@The_monster@ says @to_foe@, \"I was hoping my final job would be more of a challenge, but money is money.\"", "speech.monspeak.63416233f4b5a267"},
    {"_harold_common_", "@The_monster@ shouts @at_foe@, \"Can you die now\? I had plans for the rest of the day!\"", "speech.monspeak.4846647b704259d2"},
    {"_harold_common_", "@The_monster@ says, \"Do you have any idea what people are willing to pay to have you killed, @player_name@\?\" @player_only@", "speech.monspeak.24421eca7d95fbc9"},
    {"_harold_common_", "@The_monster@ says @to_foe@, \"Let's make it quick, okay\? I've got mouths to feed.\"", "speech.monspeak.9282ec06feff0a6c"},
    {"_harold_common_", "@The_monster@ says @to_foe@, \"Listen, it's nothing personal. It's just a job.\"", "speech.monspeak.150ecb15d8f6aac0"},
    {"_harold_common_", "@The_monster@ says @to_foe@, \"This is so exciting! What a great way to end my career!\"", "speech.monspeak.90c90f72349ff0c7"},
    {"_harold_common_", "@The_monster@ says @to_foe@, \"Ah, this is what I got into this business for!\"", "speech.monspeak.24c081c05779402b"},
    {"_harold_rare_", "VISUAL:@The_monster@ pauses a moment, imagining something with a smile on @possessive@ face.", "speech.monspeak.73b94367654b5ff2"},
    {"_harold_rare_", "@The_monster@ considers, \"I think I'll use your bounty to get a @_Harold_retirement_plan_@...\" @player_only@", "speech.monspeak.bee15288a1627ae3"},
    {"_harold_rare_", "@The_monster@ asks, \"Do you mind if I name my boat the '@player_name@'\? Your head will be paying for it, after all.\" @player_only@", "speech.monspeak.7c051cb2787d91aa"},
    {"_harold_rare_", "@The_monster@ says happily, \"The price on your head will fill my nest egg nicely!\" @player_only@", "speech.monspeak.dd93c0f1f42dd397"},
    {"_harold_rare_", "@The_monster@ thinks, and says @to_foe@, \"Perhaps I'll take up @_Harold_ret_hobby_@ after I'm done here...\"", "speech.monspeak.086816cbd25aba0f"},
    {"_harold_rare_", "@The_monster@ says, \"Try to look on the bright side. Your death will help put my children through school.\" @player_only@", "speech.monspeak.8bc1ae16722019a9"},
    {"_harold_rare_", "@The_monster@ says @to_foe@, \"Bounty hunting has been great, but I can't wait to retire.\"", "speech.monspeak.b629d7760cd94c33"},
    {"_harold_rare_", "@The_monster@ says @to_foe@, \"My wife will appreciate not having to wash blood out of my clothes anymore.\"", "speech.monspeak.27e56bed35474b3e"},
    {"harold triumphant", "@The_monster@ says, \"Can't wait to tell my little ones about this.\"", "speech.monspeak.dee8015d3f3c5675"},
    {"harold triumphant", "@The_monster@ says, \"Time to retire.\"", "speech.monspeak.9c41271f0fe04d77"},
    {"harold triumphant", "@The_monster@ sighs, \"Finally, I can get that @_Harold_retirement_plan_@ and settle down.\"", "speech.monspeak.b59dd3493169384e"},
    {"harold triumphant", "@The_monster@ sighs, \"Nothing for old @the_monster@ but @_Harold_ret_hobby_@ after this.\"", "speech.monspeak.4024d65e9fb12980"},
    {"_harold_retirement_plan_", "@_Harold_ret_house_@ @_Harold_ret_place_@", "speech.monspeak.ca90462e69c85fd5"},
