    {"dissolution", "@_dissolution_speech_@", "speech.monspeak.bad05b769dee9c6c"},
    {"_dissolution_common_", "@The_monster@ gurgles.", "speech.monspeak.ec15b97b3beae156"},
    {"_dissolution_common_", "@The_monster@ gurgles loudly.", "speech.monspeak.1a0208786acef812"},
    {"_dissolution_common_", "@The_monster@ emits a sizzling noise.", "speech.monspeak.c9e6536398086738"},
    {"_dissolution_common_", "VISUAL:@The_monster@ jiggles.", "speech.monspeak.0c21788f2d5b5f67"},
    {"_dissolution_common_", "VISUAL:@The_monster@ wobbles.", "speech.monspeak.34d1d924f2e0f6d9"},
    {"_dissolution_speech_", "@The_monster@ says, \"Join with me for eternity!\"", "speech.monspeak.a1621b14d93957f3"},
    {"_dissolution_speech_", "@The_monster@ says, \"Become one with my sorrow!\"", "speech.monspeak.a03983175edfbb69"},
    {"_dissolution_speech_", "@The_monster@ says, \"Slime for the Slime God!\"", "speech.monspeak.61a23b52dce1621b"},
    {"_dissolution_speech_", "@The_monster@ says, \"Acid is thicker than water.\"", "speech.monspeak.3630140ea2fcfbb4"},
    {"_dissolution_speech_", "@The_monster@ says, \"Acid to acid, slime to slime.\"", "speech.monspeak.673c24d6ffe52cd2"},
    {"_dissolution_speech_", "@_dissolution_rare_@", "speech.monspeak.d15d3efa5c39cb05"},
    {"_dissolution_rare_", "@The_monster@ says, \"We come from slime, we turn to slime.\"", "speech.monspeak.e56d5ec7c2528513"},
    {"_dissolution_rare_", "@The_monster@ says, \"From Slime we come, to Slime we go.\"", "speech.monspeak.c07cb3222d2f1a9b"},
    {"_dissolution_rare_", "@The_monster@ says, \"Resolve to dissolve!\"", "speech.monspeak.1d3e181c1ad20eab"},
    {"_dissolution_rare_", "@The_monster@ presages, \"An acid flood will etch off all the scum!\"", "speech.monspeak.a013b482469ad73e"},
    {"_dissolution_rare_", "@The_monster@ says, \"There is a problem solver and @possessive@ name is Dissolver!\"", "speech.monspeak.2e10ca8e153fdf7b"},
    {"temple donald", "@_generic_Donald_@", "speech.monspeak.5a0867f8201dc93c"},
    {"temple donald", "@The_monster@ says, \"I can never find the altar I want in here.\"", "speech.monspeak.38f5644f0ca7ef06"},
    {"temple donald", "@The_monster@ says, \"There are too many gods demanding my worship. I hate that.\"", "speech.monspeak.13e92cc19c720c47"},
    {"temple donald", "@The_monster@ says, \"Why did you bring me all the way here just to see the Temple\?\"", "speech.monspeak.f3203eb572bee8c2"},
    {"temple donald", "@The_monster@ says, \"There's not enough treasure in here.\"", "speech.monspeak.a01d8cb5aae94c66"},
    {"temple donald", "@The_monster@ says, \"You've already taken the rune from here, haven't you\?\"", "speech.monspeak.f463dda4daeb797c"},
    {"temple donald", "@The_monster@ says, \"The so-called 'good' gods are just as evil as the rest. I hate hypocrisy.\"", "speech.monspeak.85c34bd285120406"},
    {"temple donald", "@The_monster@ says, \"I hate temples.\"", "speech.monspeak.2469057fc206fca5"},
    {"temple donald", "@The_monster@ says, \"What about an ecumenical tavern\?\"", "speech.monspeak.7ef7b9e1a4504182"},
    {"orc donald", "@_generic_Donald_@", "speech.monspeak.f627e17914a535e8"},
    {"orc donald", "@The_monster@ says, \"Orcs complain a lot, don't they\? I hate it.\"", "speech.monspeak.713fdcb356098958"},
    {"orc donald", "@The_monster@ says, \"Orcs smell really bad. Yuck.\"", "speech.monspeak.e14bb1f44f4a91e2"},
    {"orc donald", "@The_monster@ says, \"At least there's gold. That doesn't make up for it.\"", "speech.monspeak.4a6b36dfd932b0bc"},
    {"orc donald", "@The_monster@ says, \"I'll never be able to carry all this gold! I hate that.\"", "speech.monspeak.d7d0b7e1fd2642aa"},
    {"orc donald", "@The_monster@ says, \"What do they mine anyway\? I've never seen them mine anything.\"", "speech.monspeak.4820de2ff93294ec"},
    {"orc donald", "@The_monster@ says, \"Have you ever seen an orcish miner\? Me neither.\"", "speech.monspeak.df0c0460763154b6"},
    {"orc donald", "VISUAL:@The_monster@ kicks a rock and scowls.", "speech.monspeak.78abbb23eab69a62"},
    {"orc donald", "@The_monster@ says, \"Why is it so dark\? Have they never heard of torches\?\"", "speech.monspeak.3ff9f0aecb3c84e3"},
    {"orc donald", "@The_monster@ ponders, \"They're ugly as hell, too!\"", "speech.monspeak.48cf96ef68f8012c"},
    {"orc donald", "@The_monster@ says, \"I ran into an orc. He called himself a warlord, and I asked what war\?\"", "speech.monspeak.6cecea7d3b2ab3a6"},
    {"orc donald", "@The_monster@ says, \"These orcs are so stupid, they must've eaten the rune.\"", "speech.monspeak.81cbc61878ed6158"},
    {"orc donald", "@The_monster@ says, \"I asked for directions to the rune, but they belched at me.\"", "speech.monspeak.506b5c86dc1a0daf"},
    {"orc donald", "@The_monster@ says, \"I prefer the Lair of the Beasts, to be honest. At least animals don't complain.\"", "speech.monspeak.1dcf984300010a24"},
    {"orc donald", "@The_monster@ says, \"I hate complainers so much.\"", "speech.monspeak.4d3afef7eccefd59"},
    {"elf donald", "@_generic_Donald_@", "speech.monspeak.6a948af01ebf4d7e"},
    {"elf donald", "@The_monster@ says, \"Why would you have your front door in a mine\? Stupid.\"", "speech.monspeak.992fb1b43a866b00"},
    {"elf donald", "@The_monster@ says, \"I hope this rune is worth it!\"", "speech.monspeak.f9678a9045112946"},
    {"elf donald", "@The_monster@ says, \"I thought elves might be good for a party. Nope.\"", "speech.monspeak.758f6d8ab4d00742"},
    {"elf donald", "@The_monster@ says, \"Really pretty, but really, really boring. I hate that.\"", "speech.monspeak.233f9e48021979cc"},
    {"elf donald", "@The_monster@ says, \"What's with all the gesturing\? I hate that.\"", "speech.monspeak.ebfa1f90db0396ba"},
    {"elf donald", "@The_monster@ says, \"None of these elves know how to fight. I hate that.\"", "speech.monspeak.4c42b86e95d96f60"},
    {"elf donald", "@The_monster@ says, \"What's the point of a Hall of Blades anyway\?\"", "speech.monspeak.a7e9fe4899cd66c1"},
    {"spider donald", "@_generic_Donald_@", "speech.monspeak.a63534949194e59f"},
    {"spider donald", "@The_monster@ says, \"There's a spider on your neck!\"", "speech.monspeak.d7f368c037f2f473"},
    {"spider donald", "@The_monster@ says, \"I hate crawling things.\"", "speech.monspeak.1fef757e22342fc3"},
    {"spider donald", "@The_monster@ says, \"Someone should clean these parts. I hate webs.\"", "speech.monspeak.7c7e69d1d1ad475f"},
    {"spider donald", "@The_monster@ says, \"My uncle had bigger webs in his attic. I hated that.\"", "speech.monspeak.a04882ed53f2aa32"},
    {"spider donald", "@The_monster@ says, \"I hate getting stuck.\"", "speech.monspeak.54d6c5e4b5d21a28"},
    {"spider donald", "@The_monster@ says, \"Dancing spiders\? With no cane or a top hat\?\"", "speech.monspeak.5e89a6168f158142"},
    {"spider donald", "@The_monster@ says, \"Something's up my trousers! Aieee!\"", "speech.monspeak.bd31010fd5a06ef5"},
    {"spider donald", "@The_monster@ says, \"I hate venom. I hate getting bitten.\"", "speech.monspeak.40d807c442989fd6"},
    {"spider donald", "@The_monster@ says, \"Arachnophobia is no disease, it's common sense.\"", "speech.monspeak.20ab9a59c91a616a"},
    {"spider donald", "@The_monster@ says, \"There, on the ceiling! And on that wall!\"", "speech.monspeak.e9295e1cda258672"},
    {"vaults donald", "@_generic_Donald_@", "speech.monspeak.164b06563f81d537"},
    {"vaults donald", "@The_monster@ says, \"The Vaults\? They should've called it the Dumps.\"", "speech.monspeak.0d736f9970aa3e79"},
    {"vaults donald", "@The_monster@ says, \"Don't bother, there's only junk at the bottom.\"", "speech.monspeak.3c6dd3b9bf827d0d"},
    {"vaults donald", "@The_monster@ says, \"I asked the warden where the rune was. She slammed the door in my face.\"", "speech.monspeak.3ed9ce06a84a36de"},
    {"vaults donald", "@The_monster@ says, \"I don't remember getting an invitation to a convocation.\"", "speech.monspeak.24e05d8e0935e913"},
    {"vaults donald", "@The_monster@ says, \"Who designed this place\? It's just a bunch of weird little rooms stuck together.\"", "speech.monspeak.77b2bef3da1a1122"},
    {"vaults donald", "@The_monster@ says, \"This is an awful lot of space just to hold some junk.\"", "speech.monspeak.b81fc28598757fe4"},
    {"vaults donald", "@The_monster@ says, \"I saw some yaktaurs earlier, but I bolted.\"", "speech.monspeak.104fab3bf32d8b13"},
    {"vaults donald", "@The_monster@ says, \"I saw a dragon earlier, but I didn't get too close - it seemed pretty mercurial.\"", "speech.monspeak.94817dae7d464e04"},
    {"vaults donald", "@The_monster@ says, \"Why are there poltergeists guarding this place, but not the Crypt\?\"", "speech.monspeak.61d6c2afbe22c731"},
    {"crypt donald", "@_generic_Donald_@", "speech.monspeak.79c8ab6592ae301a"},
    {"crypt donald", "@The_monster@ says, \"Zombies are pretty boring.\"", "speech.monspeak.a7a7145ecd7bffc3"},
    {"crypt donald", "@The_monster@ says, \"Man, I can't wait until I find the rune.\"", "speech.monspeak.84c8a506514a04d5"},
    {"crypt donald", "@The_monster@ says, \"They must've been making zombies for centuries to fill this place.\"", "speech.monspeak.a908a886668e36aa"},
    {"crypt donald", "@The_monster@ says, \"My neck hurts.\"", "speech.monspeak.35e16ba06dd94586"},
    {"crypt donald", "@The_monster@ says, \"Is it cursed, or does it curse\? I can never tell.\"", "speech.monspeak.4fbf508e252fad7f"},
    {"crypt donald", "@The_monster@ says, \"Curse skulls, curse toes... What next\?\"", "speech.monspeak.367874f1f30c7aca"},
    {"crypt donald", "@The_monster@ says, \"This isn't even all that spooky.\"", "speech.monspeak.ebbd29aee1cc780f"},
    {"crypt donald", "@The_monster@ says, \"This place is pretty cryptic.\"", "speech.monspeak.09e95a3768da7993"},
    {"crypt donald", "@The_monster@ says, \"Skeletons give me the creeps.\"", "speech.monspeak.c351cc5e7cfb3a3a"},
    {"crypt donald", "@The_monster@ says, \"I hate skeletons.\"", "speech.monspeak.068ba8186f1142d6"},
    {"crypt donald", "@The_monster@ says, \"I hate draugr.\"", "speech.monspeak.8b3c4d7bcc8dc6c2"},
    {"crypt donald", "@The_monster@ says, \"I hate zombies.\"", "speech.monspeak.5e18930fa0695d3c"},
    {"crypt donald", "@The_monster@ says, \"I hate vampires.\"", "speech.monspeak.4bfcbfea3b406a6d"},
    {"crypt donald", "@The_monster@ says, \"That ghoul gave me heartburn.\"", "speech.monspeak.4f0f5889e3ae9a6b"},
    {"crypt donald", "@The_monster@ says, \"What sort of name is 'necrophage', anyway\?\"", "speech.monspeak.0e0e74d11253248e"},
    {"crypt donald", "@The_monster@ says, \"Where are all the doors\?\"", "speech.monspeak.f1f52c3fe1eff142"},
    {"crypt donald", "@The_monster@ says, \"You know, I thought there'd be more coffins in a crypt...\"", "speech.monspeak.23c9be5e8e11264e"},
    {"crypt donald", "@The_monster@ says, \"Have you seen a sarcophagus full of treasure around\? Me neither.\"", "speech.monspeak.180b8d81a243b10a"},
    {"crypt donald", "@The_monster@ says, \"I just hope the loot isn't guarded by liches. I hate liches.\"", "speech.monspeak.507d5f3c3eba9415"},
    {"crypt donald", "@The_monster@ says, \"That mummy wasn't so great.\"", "speech.monspeak.ff078204415ed9f7"},
    {"crypt donald", "@The_monster@ says, \"This place has the same junk as everywhere else. I hate that.\"", "speech.monspeak.ac4bd91fc813b543"},
    {"crypt donald", "@The_monster@ says, \"Why is it so quiet\?\"", "speech.monspeak.7aca10d9dfc41a78"},
    {"crypt donald", "@The_monster@ says, \"So much for the uneasy undead.\"", "speech.monspeak.8508689acee1e657"},
    {"crypt donald", "@The_monster@ says, \"They don't shamble much, do they\? I hate that.\"", "speech.monspeak.ea407a1457658f3b"},
    {"crypt donald", "@The_monster@ says, \"They don't even play music.\"", "speech.monspeak.f2dc561b0345ba01"},
    {"crypt donald", "@The_monster@ says, \"Some mausoleum.\"", "speech.monspeak.b230994f2b57e2a6"},
    {"crypt donald", "@The_monster@ says, \"I saw a sphinx earlier. I hate that.\"", "speech.monspeak.df14c42695c641cd"},
    {"crypt donald", "@The_monster@ says, \"The Crypt, the Tomb, what's next\? The Coffin\?\"", "speech.monspeak.ad5462bb101bc0f2"},
    {"crypt donald", "@The_monster@ says, \"All these vampires have me hopping mad!\"", "speech.monspeak.5cf821686f58afd0"},
    {"crypt donald", "@The_monster@ says, \"I hate revenants, but I forget why! And I hate that, too!\"", "speech.monspeak.6ecf177191da02c4"},
    {"crypt donald", "@The_monster@ says, \"I got a splinter from a draugr. I hate that.\"", "speech.monspeak.6c5969c6ec5f6e7e"},
    {"orb donald", "@_generic_Donald_@", "speech.monspeak.089c627295253220"},
    {"orb donald", "@The_monster@ says, \"Thanks for carrying the Orb of Power for me.\"", "speech.monspeak.fd4fc9acd97b98a0"},
    {"orb donald", "@The_monster@ says, \"Isn't that thing heavy\? I could take a turn.\"", "speech.monspeak.ee6a4bd3e66c17f4"},
    {"orb donald", "@The_monster@ says, \"Aren't you worried about radiation\? You should put that down.\"", "speech.monspeak.6caf82ba59b63bd6"},
    {"orb donald", "@The_monster@ says, \"What are you going to do with that Orb\?\"", "speech.monspeak.a53aa72a6a21c291"},
    {"orb donald", "@The_monster@ says, \"Don't you think the Orb of Power was down there for a reason\?\"", "speech.monspeak.2f2fb4627cd34560"},
    {"orb donald", "@The_monster@ says, \"I heard that the world ends if you bring it to the surface.\"", "speech.monspeak.16610f90db80f21e"},
    {"orb donald", "@The_monster@ says, \"Someone is going to come looking for that Orb.\"", "speech.monspeak.e259dc6307d54747"},
    {"orb donald", "@The_monster@ says, \"Are you sure that's the real Orb, and not some cheap imitation\?\"", "speech.monspeak.416b17671f21d4d5"},
    {"orb donald", "@The_monster@ says, \"You have the Orb. Was it worth it\?\"", "speech.monspeak.d2f33ff8dfe0245a"},
    {"the shining one donald", "@_generic_Donald_@", "speech.monspeak.a064b8697bc81f64"},
    {"the shining one donald", "@The_monster@ says, \"What's the point of being chivalric if nobody's going to be chivalric back\?\"", "speech.monspeak.c0fd34de33ea73f5"},
    {"the shining one donald", "@The_monster@ says, \"I open the door for a goblin; he punches me in the face. I hate chivalry.\"", "speech.monspeak.c4a3f7a6bc65f94b"},
    {"the shining one donald", "@The_monster@ says, \"Hah! I saw you coming a mile away.\"", "speech.monspeak.df944bf41ead7590"},
    {"the shining one donald", "@The_monster@ says, \"You stick out like a sore thumb. Or at least, a shining one.\"", "speech.monspeak.49e36dbe87dae03c"},
    {"the shining one donald", "@The_monster@ says, \"Won't need this ring of positive energy, then, will I\?\"", "speech.monspeak.437812c285a96290"},
    {"the shining one donald", "@The_monster@ says, \"Can you turn the glow down a bit\? I can't see you to hit you.\"", "speech.monspeak.b2d2e4e4d1a62469"},
    {"the shining one donald", "@The_monster@ says, \"Cleansing flame\? What's it supposed to be cleansing\? The floor\?\"", "speech.monspeak.d625d1de5554212d"},
    {"the shining one donald", "@The_monster@ says, \"I hate haloes.\"", "speech.monspeak.a37447e518bdbf60"},
    {"kikubaaqudgha donald", "@_generic_Donald_@", "speech.monspeak.556e090733677519"},
    {"kikubaaqudgha donald", "@The_monster@ says, \"Kikubaa-what\? How do you even say that\?\"", "speech.monspeak.0627077cf19b0731"},
    {"kikubaaqudgha donald", "@The_monster@ says, \"Sorry, didn't catch that. You worship who\? How do you spell it\?\"", "speech.monspeak.bea45749e56b818a"},
    {"kikubaaqudgha donald", "@The_monster@ says, \"Can you spell it for me - slowly\?\"", "speech.monspeak.d721b3f696fc65ee"},
    {"kikubaaqudgha donald", "@The_monster@ says, \"How do you pronounce that\?\"", "speech.monspeak.44815fb3e55f4134"},
    {"kikubaaqudgha donald", "@The_monster@ says, \"I hate zombies.\"", "speech.monspeak.2c6a3c99a6b36d90"},
    {"kikubaaqudgha donald", "@The_monster@ says, \"Yuck, you smell of miasma!\"", "speech.monspeak.5626f99adc00e77e"},
    {"kikubaaqudgha donald", "@The_monster@ says, \"I hate wretches.\"", "speech.monspeak.a201dcee743fb98f"},
    {"kikubaaqudgha donald", "@The_monster@ says, \"How deep do you have to dig to get a never-ending supply of wretches\?\"", "speech.monspeak.3033603f44431f48"},
    {"kikubaaqudgha donald", "@The_monster@ says, \"You must really love pain. I hate it.\"", "speech.monspeak.6768179321b65dd2"},
    {"kikubaaqudgha donald", "@The_monster@ says, \"Do you just use necromancy for everything, then\?\"", "speech.monspeak.bce9f3346ad8380c"},
    {"kikubaaqudgha donald", "@The_monster@ says, \"Why a 'Demon-God'\? Wouldn't a 'Zombie-God' be more appropriate\?\"", "speech.monspeak.ab3adf0ba824f725"},
    {"kikubaaqudgha donald", "@The_monster@ says, \"I hate ruin.\"", "speech.monspeak.e4e4a78ed5660bc7"},
    {"kikubaaqudgha donald", "@The_monster@ says, \"I hate despair.\"", "speech.monspeak.a1e3b8c7218b22b1"},
    {"yredelemnul donald", "@_generic_Donald_@", "speech.monspeak.82439594b6d23bbc"},
    {"yredelemnul donald", "@_yredelemnul_Donald_@", "speech.monspeak.09082ae4a73550b1"},
    {"okawaru donald", "@_generic_Donald_@", "speech.monspeak.4298a7a0495a72db"},
    {"okawaru donald", "@The_monster@ says, \"Okawaru always makes me think of chokos.\"", "speech.monspeak.c2bf718f6c17da22"},
    {"okawaru donald", "@The_monster@ says, \"Oh, hey! I could use a new shield. Have you got any spares\?\"", "speech.monspeak.a1ae6eab9c277709"},
    {"okawaru donald", "@The_monster@ says, \"Nice kit.\"", "speech.monspeak.c5cc21dcc8366eb6"},
    {"okawaru donald", "@The_monster@ asks, \"How many innocent creatures did you kill for those shoes\?\"", "speech.monspeak.1f3d1b3a0a927f33"},
    {"okawaru donald", "@The_monster@ says, \"Okawaru's gifts are murder.\"", "speech.monspeak.622a2960f1c83ed6"},
    {"okawaru donald", "@The_monster@ says, \"You can only wear one cloak at a time, you know\?\"", "speech.monspeak.95688a3e56ec893c"},
    {"okawaru donald", "@The_monster@ says, \"Do you think you're a hero\? I hate that.\"", "speech.monspeak.4b3312c058f0bc34"},
    {"okawaru donald", "@The_monster@ says, \"How much finesse does it take to swing your arms real fast, anyway\?\"", "speech.monspeak.b705672276d9e8f2"},
    {"okawaru donald", "@The_monster@ says, \"I could take you in a fair duel. No cheating!\"", "speech.monspeak.0ac8c1f8d6685a14"},
    {"trog donald", "@_generic_Donald_@", "speech.monspeak.9692c511cf7c3e5b"},
    {"trog donald", "@The_monster@ says, \"So, are you allowed to read books\?\"", "speech.monspeak.34d9a6ab14538970"},
    {"trog donald", "@The_monster@ says, \"You troglodyte!\"", "speech.monspeak.73d6fa4e1d538939"},
    {"trog donald", "@The_monster@ says, \"I heard Trog has abandonment issues.\"", "speech.monspeak.ea3f52e34546f072"},
    {"trog donald", "@The_monster@ says, \"I bet Trog's next axe will take you to the Abyss.\"", "speech.monspeak.249e20e933d8f0c7"},
    {"trog donald", "@The_monster@ says, \"I considered Trog, but the aftereffects of berserk scare me.\"", "speech.monspeak.9f42ae6ad2b167fb"},
    {"trog donald", "@The_monster@ says, \"I bet you wish you could cast spells now, right\?\"", "speech.monspeak.69e126129ae8430a"},
    {"trog donald", "@The_monster@ says, \"Are you sure you're allowed to read scrolls\?\"", "speech.monspeak.c9dd018e90b110f0"},
    {"trog donald", "@The_monster@ says, \"Hey, I thought wands weren't allowed!\"", "speech.monspeak.bc181ab459f8eade"},
    {"trog donald", "@The_monster@ says, \"If I tell you I hate magic, will you worship me\?\"", "speech.monspeak.60d0a393c4e4e916"},
    {"trog donald", "@The_monster@ says, \"I hate ogres.\"", "speech.monspeak.bce13cd943cd2a6e"},
    {"nemelex xobeh donald", "@_generic_Donald_@", "speech.monspeak.50830806ba0eecd2"},
    {"nemelex xobeh donald", "@The_monster@ says, \"What's all in the cards\? Your future\?\"", "speech.monspeak.9a451bda0196b130"},
    {"nemelex xobeh donald", "@The_monster@ says, \"I bet you're feeling stupid now, huh\?\"", "speech.monspeak.a29ad196fdefc11a"},
    {"nemelex xobeh donald", "@The_monster@ says, \"If I draw a card, can you tell me which one it is\?\"", "speech.monspeak.693e12e70a663496"},
    {"nemelex xobeh donald", "@The_monster@ says, \"Where do you keep all those decks\?\"", "speech.monspeak.1d3049ddfdb80de5"},
    {"nemelex xobeh donald", "@The_monster@ says, \"I'm sure I saw a card fall out of that deck.\"", "speech.monspeak.33146c31aece3181"},
    {"nemelex xobeh donald", "@The_monster@ says, \"I've seen this trick before. You've got the ace up your sleeve, right\?\"", "speech.monspeak.d886336e20ddc8cd"},
    {"nemelex xobeh donald", "@The_monster@ says, \"You need to come to terms with your gambling problem.\"", "speech.monspeak.e449515f956fb42a"},
    {"nemelex xobeh donald", "@The_monster@ says, \"How about a game of 52 card pickup\?\"", "speech.monspeak.366764f86ebbdea7"},
    {"nemelex xobeh donald", "@The_monster@ laughs, \"An explosive gambit... I hate that.\"", "speech.monspeak.f0d2a046cb4de226"},
    {"jiyva donald", "@_generic_Donald_@", "speech.monspeak.c515e6979a7a30d1"},
    {"jiyva donald", "@The_monster@ says, \"Come slime with me!\"", "speech.monspeak.2a2610d6192216b8"},
    {"jiyva donald", "@The_monster@ says, \"You look a bit slimy.\"", "speech.monspeak.cd66cb88a2dbb53b"},
    {"jiyva donald", "@The_monster@ says, \"Ah. That explains where all the items went.\"", "speech.monspeak.d0646229d3753565"},
    {"jiyva donald", "@The_monster@ says, \"Are you going to open a jelly farm when you find the Orb\?\"", "speech.monspeak.b9089c9c31c4b91e"},
    {"jiyva donald", "@The_monster@ says, \"I hate it when jellies take over a level.\"", "speech.monspeak.8aaea63ffd109455"},
    {"jiyva donald", "@The_monster@ says, \"Your jellies ate my lunch. I hate that.\"", "speech.monspeak.a09b4ee0a4f4f2dc"},
    {"jiyva donald", "@The_monster@ says, \"I hate slime.\"", "speech.monspeak.40934156b6a0ad7e"},
    {"jiyva donald", "@The_monster@ says, \"You must hate doors a lot.\"", "speech.monspeak.ff4d8247fccf8d8c"},
    {"jiyva donald", "@The_monster@ says, \"If I pretend to be a jelly, can I have your stuff\?\"", "speech.monspeak.d427c508d149797f"},
    {"fedhas donald", "@_generic_Donald_@", "speech.monspeak.108e4844e7fc0e9c"},
    {"fedhas donald", "@The_monster@ says, \"What's with all that fungus\?\"", "speech.monspeak.475cca8855ddce32"},
    {"fedhas donald", "@The_monster@ says, \"I hate [trees|plants|fungi].\"", "speech.monspeak.f1bc19dbfa7d8074"},
    {"fedhas donald", "@The_monster@ says, \"Do you like gardening\? I hate gardening.\"", "speech.monspeak.0dd00c7269586fbf"},
    {"fedhas donald", "@The_monster@ says, \"So, how do you deal with the weeds\?\"", "speech.monspeak.662cfe87cc96cf81"},
    {"fedhas donald", "@The_monster@ says, \"A plant spat acid at me. I hate that.\"", "speech.monspeak.c2d30a7d1f7aa432"},
    {"fedhas donald", "@The_monster@ says, \"Better hope you don't develop allergies.\"", "speech.monspeak.5c7711be1de68d9f"},
    {"vehumet donald", "@_generic_Donald_@", "speech.monspeak.5eac0758e91930d4"},
    {"vehumet donald", "@The_monster@ says, \"What kind of god gives you spells but not spellbooks\?\"", "speech.monspeak.65c746833b28d34d"},
    {"vehumet donald", "@The_monster@ says, \"Let it end in hellfire\? Why is there only one hellfire spell\?\"", "speech.monspeak.bcdb9e1df26d3d56"},
    {"vehumet donald", "@The_monster@ says, \"I hate Vehumet.\"", "speech.monspeak.1d93340e45982b2b"},
    {"vehumet donald", "@The_monster@ says, \"I hate hellfire.\"", "speech.monspeak.503741fb05e64bce"},
    {"vehumet donald", "@The_monster@ says, \"What's the point of conjuring, anyway\?\"", "speech.monspeak.0885f7e32b66815e"},
    {"vehumet donald", "@The_monster@ says, \"Do you find it easier to cast spells, now\?\"", "speech.monspeak.aca74a5cd127333b"},
    {"vehumet donald", "@The_monster@ says, \"I hate explosions.\"", "speech.monspeak.8fed4c6f16520045"},
    {"vehumet donald", "@The_monster@ says, \"You're supposed to blow everything up for a god who barely gives you powers\?\"", "speech.monspeak.e72a167514c93522"},
    {"gozag donald", "@_generic_Donald_@", "speech.monspeak.8bba566775fcf6ea"},
    {"gozag donald", "@The_monster@ says, \"Spare some coin\?\"", "speech.monspeak.93199a3dd3292f82"},
    {"gozag donald", "@The_monster@ says, \"I hate the rich.\"", "speech.monspeak.e156132b1df4d01f"},
    {"gozag donald", "@The_monster@ says, \"I bet you have to pay people to get friends.\"", "speech.monspeak.dc9bb34bf9c401b5"},
    {"gozag donald", "@The_monster@ says, \"Couldn't find enough potions\?\"", "speech.monspeak.6750cfc388bec6c5"},
    {"gozag donald", "@The_monster@ says, \"So the shops here weren't enough for you\?\"", "speech.monspeak.791ac022b64a5d31"},
    {"gozag donald", "@The_monster@ says, \"I saw some gold over there. Quick, better go get it!\"", "speech.monspeak.0a3f45a00b6e541a"},
    {"gozag donald", "@The_monster@ says, \"What do potions have to do with a god of gold, anyway\?\"", "speech.monspeak.4acf09e251c967fa"},
    {"gozag donald", "@The_monster@ says, \"If you give me all your gold, I promise I'll be your friend too.\"", "speech.monspeak.01318721f1b9249a"},
    {"qazlal donald", "@_generic_Donald_@", "speech.monspeak.26e8caeaebf122d0"},
    {"qazlal donald", "@The_monster@ says, \"How do you sleep at night with all those storm clouds\?\"", "speech.monspeak.7f246747004a1cf2"},
    {"qazlal donald", "@The_monster@ says, \"Must be pretty hard to see through all that dust.\"", "speech.monspeak.b5a4c1f3a5368a6d"},
    {"qazlal donald", "@The_monster@ says, \"I hate storms.\"", "speech.monspeak.e004c634e08b72dc"},
    {"qazlal donald", "@The_monster@ says, \"I hate disasters.\"", "speech.monspeak.faf50ae6c75575a2"},
    {"qazlal donald", "@The_monster@ says, \"I hate elementals.\"", "speech.monspeak.1ab09f660754bebc"},
    {"qazlal donald", "@The_monster@ says, \"What was that\? Sorry, I couldn't hear you over all this noise.\"", "speech.monspeak.9d006bdc42f945b4"},
    {"qazlal donald", "@The_monster@ says, \"Well, at least you're never short of company.\"", "speech.monspeak.ad8fd15a3e4ac766"},
    {"qazlal donald", "@The_monster@ says, \"Great. Now my shield is all dirty.\"", "speech.monspeak.336bbd01d65d5c30"},
    {"hepliaklqana donald", "@_generic_Donald_@", "speech.monspeak.e5cdfb5b4f49ebe9"},
    {"hepliaklqana donald", "@The_monster@ says, \"I went to a family reunion once. I hated it.\"", "speech.monspeak.8bb542db75b9e483"},
    {"hepliaklqana donald", "@The_monster@ says, \"Who would want to remember their ancestors\? They're dead.\"", "speech.monspeak.ca9767cc50227f76"},
    {"hepliaklqana donald", "@The_monster@ says, \"If your ancestor was so tough and powerful, how come they're dead\?\"", "speech.monspeak.adf490023c40c3e3"},
    {"hepliaklqana donald", "@The_monster@ says, \"Would you happen to remember where the Orb is\?\"", "speech.monspeak.29dc543ac95c724c"},
    {"hepliaklqana donald", "@The_monster@ says, \"Ghost stories\? Ooh, I'm so scared!\"", "speech.monspeak.fb1a83e5cba55c24"},
    {"hepliaklqana donald", "@The_monster@ says, \"Isn't it convenient that your ancestor always knows how to fight\?\"", "speech.monspeak.ba722d71f7a27aba"},
    {"hepliaklqana donald", "@The_monster@ says, \"I forgot what I was going to say. I hate that.\"", "speech.monspeak.572d9e3060c08081"},
    {"wu jian donald", "@_generic_Donald_@", "speech.monspeak.2af99e7cc5c4e464"},
    {"wu jian donald", "@The_monster@ says, \"Path\? I don't see a path anywhere.\"", "speech.monspeak.afbd39d153813c1e"},
    {"wu jian donald", "@The_monster@ says, \"You're jumping off the walls\? I hate that.\"", "speech.monspeak.d4ca6aa6cf52b474"},
    {"wu jian donald", "@The_monster@ says, \"Watching you spin around is making me dizzy. I hate that.\"", "speech.monspeak.0af0ff4dcb3888bf"},
    {"wu jian donald", "@The_monster@ says, \"Why not just HIT them without all this spinning and flipping nonsense\?\"", "speech.monspeak.491a05b19197a35e"},
    {"wu jian donald", "@The_monster@ says, \"Don't you get tired of all these old geezers telling you what to do\?\"", "speech.monspeak.9e4a742ada1118ef"},
    {"wu jian donald", "@The_monster@ says, \"No way as a way\? Sounds like nonsense.\"", "speech.monspeak.160d0402ce141d09"},
    {"_generic_donald_", "@The_monster@ says, \"You're really ugly. Did you know that\?\"", "speech.monspeak.17312578a368eb8b"},
    {"_generic_donald_", "@The_monster@ says, \"This is such a pointless quest.\"", "speech.monspeak.8451493696973ec2"},
    {"_generic_donald_", "@The_monster@ says, \"They wouldn't let me join their adventuring club without the Orb.\"", "speech.monspeak.e8c0223c07541394"},
    {"_generic_donald_", "@The_monster@ says, \"I hate this place.\"", "speech.monspeak.928a4dfb97e1175a"},
    {"_generic_donald_", "@The_monster@ says, \"I hate you, too.\"", "speech.monspeak.c5a7896ab98519e2"},
    {"_generic_donald_", "@The_monster@ says, \"My feet hurt.\"", "speech.monspeak.28920fade10b14bc"},
    {"_generic_donald_", "@The_monster@ says, \"My hands hurt, too.\"", "speech.monspeak.87179a1698aa511e"},
    {"_generic_donald_", "@The_monster@ says, \"I think I'm starting to get a cough. I hate that.\"", "speech.monspeak.9299df84dfb8bc98"},
    {"_generic_donald_", "@The_monster@ says, \"I've got a headache. I hate that.\"", "speech.monspeak.fa9333a72e816116"},
    {"_generic_donald_", "@The_monster@ says, \"That colour you're wearing\? I hate that.\"", "speech.monspeak.81823f3a5474c173"},
    {"_generic_donald_", "@The_monster@ says, \"Like I always say, the jar is half empty.\"", "speech.monspeak.777cf6a4a912370a"},
    {"_generic_donald_", "@The_monster@ says, \"And you think you've got it bad...\"", "speech.monspeak.f4155e7cef3335da"},
    {"_generic_donald_", "@The_monster@ says, \"I wonder if there's an end to this place.\"", "speech.monspeak.82ddc33fa7de60e3"},
    {"_generic_donald_", "@The_monster@ says, \"Is it turtles all the way down\?\"", "speech.monspeak.cdacf832b4e98025"},
    {"_generic_donald_", "@The_monster@ says, \"The people that built this place\? They must be crazy.\"", "speech.monspeak.7d614128b50a151f"},
    {"_generic_donald_", "@The_monster@ says, \"The air in here stinks. I hate that.\"", "speech.monspeak.154e9a0766e6606f"},
    {"_generic_donald_", "@The_monster@ says, \"I bet the Orb isn't even all that great.\"", "speech.monspeak.1490acc7e7f35848"},
    {"_generic_donald_", "@The_monster@ says, \"So, what is this Orb thing, anyway\?\"", "speech.monspeak.9e2c97f065c72db2"},
    {"_generic_donald_", "@The_monster@ says, \"I hope I haven't come all this way for a glorified paperweight.\"", "speech.monspeak.6a5458aabc47c606"},
    {"_generic_donald_", "@The_monster@ says, \"I don't get what's so special about the number twenty-seven.\"", "speech.monspeak.74a7f6721d509ad4"},
    {"_generic_donald_", "@The_monster@ says, \"The other people here are really rude.\"", "speech.monspeak.6731173bcd50fa72"},
    {"_generic_donald_", "@The_monster@ says, \"Maybe I'll visit Hell next.\"", "speech.monspeak.4358ecdc10ca2649"},
    {"_generic_donald_", "@The_monster@ says, \"The Vaults look kind of boring.\"", "speech.monspeak.a289b333c56fa098"},
    {"_generic_donald_", "@The_monster@ says, \"I can never work out what any of these scrolls mean.\"", "speech.monspeak.4f9c7677454d6123"},
    {"_generic_donald_", "@The_monster@ sighs.", "speech.monspeak.a6e7fa359381b43d"},
    {"_generic_donald_", "VISUAL:@The_monster@ winces.", "speech.monspeak.0ed1028f8ceb47c9"},
    {"_generic_donald_", "VISUAL:@The_monster@ makes a rude gesture at you.", "speech.monspeak.efe75daa686d5f4e"},
    {"_generic_donald_", "VISUAL:@The_monster@ shakes @possessive@ head.", "speech.monspeak.bac456a79dbcc6b6"},
    {"_generic_donald_", "@The_monster@ says, \"What lunatic would build a room out of doors\?\"", "speech.monspeak.4341182139ec5159"},
    {"_generic_donald_", "@The_monster@ says, \"Why would someone put a sword in a little box\?\"", "speech.monspeak.00b8d862f30e0969"},
    {"_generic_donald_", "@The_monster@ says, \"I think I hate rivers, but I can't remember why.\"", "speech.monspeak.70c70f2241404a7b"},
    {"_generic_donald_", "@The_monster@ says, \"That guy with the scythe is really mean.\"", "speech.monspeak.e4e908689916f5a0"},
    {"_generic_donald_", "@The_monster@ says, \"What kind of a name is Fauntleroy\?\"", "speech.monspeak.e29937885c201a29"},
    {"_generic_donald_", "@The_monster@ says, \"What's the big idea\?!\"", "speech.monspeak.0de4c79491c421c7"},
    {"friendly donald", "@_generic_Donald_@", "speech.monspeak.a2aa99eac509bb35"},
    {"friendly donald", "@The_monster@ sings, \"Roses are red / violets are blue / I hate many things / But most of all you!\"", "speech.monspeak.8ce81220cecd8234"},
    {"default hostile confused donald", "@The_monster@ says, \"I suppose everything's okay, then\?\"", "speech.monspeak.c3c40ac0537ecc55"},
    {"default hostile confused donald", "@The_monster@ says, \"Actually, I like you.\"", "speech.monspeak.45017f32ccd950bb"},
    {"default hostile confused donald", "@The_monster@ says, \"Oh boy, oh boy, oh boy!\"", "speech.monspeak.2b842844a741af3e"},
    {"default hostile confused donald", "@The_monster@ says, \"Aw, phooey!\"", "speech.monspeak.f41817a325db4a7b"},
    {"default hostile confused donald", "@The_monster@ says, \"But I've got a wife! And kids! Have I\?\"", "speech.monspeak.573ee5acc30e57a6"},
    {"default hostile confused donald", "@The_monster@ screams.", "speech.monspeak.f8f2147e96552408"},
    {"default hostile confused donald", "@The_monster@ makes quacking noises.", "speech.monspeak.5eaa14d4f151864e"},
    {"default hostile confused donald", "@The_monster@ says, \"My legs! My legs! What happened to my legs\?\"", "speech.monspeak.0f8b9abdbc5f7ad8"},
    {"default hostile confused donald", "@The_monster@ sings badly, off-key.", "speech.monspeak.fb2ec99eca644ce8"},
    {"default hostile confused donald", "VISUAL:@The_monster@ does a happy little dance.", "speech.monspeak.64c94894e8b0ee07"},
    {"default hostile confused donald", "VISUAL:@The_monster@ sticks a finger up @possessive@ nose.", "speech.monspeak.13929a5cf8adb4ea"},
    {"default hostile confused donald", "VISUAL:@The_monster@ tugs at @possessive@ hair.", "speech.monspeak.7a5f263f6f644854"},
    {"default hostile confused donald", "VISUAL:@The_monster@ twirls gently on the spot.", "speech.monspeak.99fe82040d70828b"},
    {"donald marionette", "@The_monster@ says, \"Don't use me like a cheap sock puppet. I hate that.\"", "speech.monspeak.1fabdfdc0c1eaa9a"},
    {"donald banished", "@The_monster@ says, \"Banished to the Abyss. I hate that.\"", "speech.monspeak.c4b9f7315a98bb7f"},
    {"twin_died dowan", "VISUAL:@The_monster@ shakes with grief.", "speech.monspeak.b25981f8a989f176"},
    {"twin_died dowan", "@The_monster@ says, \"Magic will overcome all!\"", "speech.monspeak.15dc1dca633465a6"},
    {"twin_died dowan", "@The_monster@ says, \"Her death will not be in vain!\"", "speech.monspeak.1473b8e95338867c"},
    {"twin_died dowan", "@The_monster@ says, \"How can I live without her\?\"", "speech.monspeak.283ecca72c526831"},
    {"twin_died dowan", "@The_monster@ breathes, \"And she was my only...\"", "speech.monspeak.b0543bace3ebd9fe"},
    {"_dowan_rare_", "VISUAL:@The_monster@ throws and catches a handful of magical flame, then smirks.", "speech.monspeak.8e60fbaccd88d87a"},
    {"_dowan_rare_", "VISUAL:@The_monster_possessive@ robes are whipped around by a magical breeze.", "speech.monspeak.49a5f09b8b3c63e8"},
    {"_dowan_rare_", "VISUAL:@The_monster_possessive@ feet meld with the ground, briefly.", "speech.monspeak.424cf5663155b172"},
    {"_dowan_rare_", "VISUAL:@The_monster@ generates a fountain of clear water, and laughs cruelly.", "speech.monspeak.e5e186adc7a7f2e2"},
    {"_dowan_rare_", "@The_monster@ whispers @to_foe@, \"It won't be long now.\"", "speech.monspeak.1f9e5b131f15d703"},
    {"_dowan_rare_", "@The_monster@ hisses @to_foe@, \"Insulting my beauty only makes me fight harder!\"", "speech.monspeak.d54913f6b1b4ca5a"},
    {"_dowan_rare_", "@The_monster@ says @to_foe@, \"Where the sword fails, magic succeeds!\"", "speech.monspeak.0066ef208dbf39b5"},
    {"_dowan_rare_", "@The_monster@ says @to_foe@, \"There's a certain beauty in death, don't you think\?\"", "speech.monspeak.b05bed8ce7d4921d"},
    {"_dowan_rare_", "@The_monster@ laughs at you. \"Don't get delusional, you can't win!\"", "speech.monspeak.82e510d325239f71"},
    {"dowan_duvessa_dies_invisible", "@The_monster@ screams, \"No! No! NO!\"", "speech.monspeak.d9e90937276abb57"},
    {"dowan_duvessa_dies_invisible_bytwin", "@Dowan_Duvessa_dies_bytwin@", "speech.monspeak.a6ff960bf411b29e"},
    {"dowan_duvessa_dies_distance_bytwin", "@Dowan_Duvessa_dies_distance@", "speech.monspeak.76d2b8633633708f"},
    {"twin_died duvessa", "VISUAL:@The_monster@ shakes in a combination of rage and grief.", "speech.monspeak.05a2c9c456266072"},
    {"twin_died duvessa", "VISUAL:@The_monster@ grits @possessive@ teeth and focuses.", "speech.monspeak.48b603754563204a"},
    {"twin_died duvessa", "@The_monster@ says, \"The sword shall overcome grief!\"", "speech.monspeak.50c1ebb1f08a7aed"},
    {"twin_died duvessa", "@The_monster@ says, \"His death shall not be in vain!\"", "speech.monspeak.a485f701602a05e0"},
    {"twin_died duvessa", "@The_monster@ says, \"I will avenge him!\"", "speech.monspeak.890d985d4ed8a388"},
    {"twin_died duvessa", "@The_monster@ says, \"I will journey to Hell to retrieve him!\"", "speech.monspeak.73d8235c3d850a08"},
    {"twin_died duvessa", "VISUAL:@The_monster@ weeps.", "speech.monspeak.fe223da4f0910345"},
    {"twin_ikilled duvessa", "VISUAL:@The_monster@ shakes in grief and horror.", "speech.monspeak.154ba6f7a36558a6"},
    {"twin_ikilled duvessa", "@The_monster@ says, \"What have I done\? What have I done\?\"", "speech.monspeak.ed717c6ba004059a"},
    {"twin_ikilled duvessa", "@The_monster@ says, \"How can I live after this\?\"", "speech.monspeak.140a74ee33df711b"},
    {"twin_ikilled duvessa", "@The_monster@ screams.", "speech.monspeak.8ad30a624785f748"},
    {"duvessa_dowan_dies", "@The_monster@ screams in rage.", "speech.monspeak.460ec32c311177c5"},
    {"duvessa_dowan_dies", "@The_monster@ screams, \"No! How DARE you!\"", "speech.monspeak.00470576bb8c0b86"},
    {"duvessa_dowan_dies", "VISUAL:@The_monster@ weeps, and shakes @possessive@ weapon @at_foe@.", "speech.monspeak.1f50639358433846"},
    {"duvessa_dowan_dies_invisible", "@The_monster@ screams in rage.", "speech.monspeak.1e81e600426af5a7"},
    {"duvessa_dowan_dies_invisible", "@The_monster@ screams in a voice full of rage, \"No, no!\"", "speech.monspeak.4e1d2779074ade89"},
    {"duvessa_dowan_dies_invisible", "@The_monster@ shouts wrathfully, \"No!\"", "speech.monspeak.10a419a5f8f0c64e"},
