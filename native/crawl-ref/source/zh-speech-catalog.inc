    {"_urug_common_", "@The_monster@ squints and screams @at_foe@, \"A harpy\? Time to die, you blasted buzzard!\"", "speech.monspeak.1ea64d667e4642d7"},
    {"_urug_common_", "@The_monster@ squints and screams @at_foe@, \"I know a harpy when I see one!\"", "speech.monspeak.5cef3fe3a49f00c4"},
    {"_urug_common_", "@The_monster@ squints, then shrugs and mutters, \"Close enough.\"", "speech.monspeak.222a14756be58fe3"},
    {"_urug_common_", "@The_monster@ grins and says, \"Time to carve some turkeys.\"", "speech.monspeak.e1e5a1d7cb63fd75"},
    {"_urug_common_", "@The_monster@ screams @at_foe@, \"Bird-brain!\"", "speech.monspeak.310c9b4017986985"},
    {"_urug_common_", "@The_monster@ screams @at_foe@, \"Prepare for a defeathering!\"", "speech.monspeak.8d8a8463a349ee3e"},
    {"_urug_common_", "@The_monster@ screams @at_foe@, \"Revenge!\"", "speech.monspeak.b97b249bd3e83091"},
    {"_urug_common_", "@The_monster@ screams @at_foe@, \"Die, harpy!\"", "speech.monspeak.42fe89c916672043"},
    {"_urug_common_", "@The_monster@ screams @at_foe@, \"All you harpies will die!\"", "speech.monspeak.3957708404feb65f"},
    {"_urug_common_", "@The_monster@ screams @at_foe@, \"Payback for my eye!\"", "speech.monspeak.35fa72fece978862"},
    {"_urug_common_", "@The_monster@ screams @at_foe@, \"Damn your eyes!\"", "speech.monspeak.70bfaa517d453f9e"},
    {"_urug_common_", "@The_monster@ screams @at_foe@, \"I'm goin' to kill you! Now!\"", "speech.monspeak.9729dd6834d88784"},
    {"_urug_rare_", "VISUAL:@The_monster@ winks @at_foe@... or blinks.", "speech.monspeak.45a4781e72a460db"},
    {"_urug_rare_", "@The_monster@ screams @at_foe@, \"Your bloody kin took my one good eye. Now you die, harpy!\"", "speech.monspeak.e28448a02ed5808e"},
    {"_urug_rare_", "@The_monster@ says @to_foe@, \"They call me one-eyed Urug. When I'm done with you they'll have to call you no-head @player_name@.\" @player_only@", "speech.monspeak.3911f43ff3783355"},
    {"_urug_rare_", "@The_monster@ screams @at_foe@, \"You are already dead.\"", "speech.monspeak.0e1815850d2bbea4"},
    {"_urug_rare_", "@The_monster@ mutters, \"Sometimes I wonder if they all really are harpies.\"", "speech.monspeak.23d257f495774b72"},
