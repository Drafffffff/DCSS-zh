    {"fighting player ghost", "@The_monster@ sneers, \"Do you call that fighting\?\"", "speech.monspeak.7165c739e8572734"},
    {"fighting player ghost", "@The_monster@ laughs, \"And you think you're capable of finding the ORB\? I had it, you know. Then I gave it away so I could steal it AGAIN.\"", "speech.monspeak.e2786630f48191e8"},
