    {"_grum_common_", "@The_monster@ stares @at_foe@ intently and @_Grum_verb_@.", "speech.monspeak.9795984cb9a476c5"},
    {"_grum_common_", "@The_monster@ lets out an intimidating howl.", "speech.monspeak.2bc891fcb8807199"},
    {"_grum_common_", "VISUAL:@The_monster@ sniffs the air and quickly glances around.", "speech.monspeak.c947ca4507082952"},
    {"_grum_common_", "@The_monster@ points @possessive@ finger @at_foe@ and @_Grum_verb_@, \"Attack!\"", "speech.monspeak.1c8fea93043db401"},
    {"_grum_common_", "@The_monster@ points @possessive@ finger @at_foe@ and shouts, \"@_Grum_dog_name_@! Sic 'em!\"", "speech.monspeak.a1d4114a8a1a30b2"},
    {"_grum_common_", "@The_monster@ glances around and shouts, \"@_Grum_dog_name_@! Here boy!\"", "speech.monspeak.ba3962ebfc0d795b"},
    {"_grum_common_", "@The_monster@ shouts, \"@_Grum_dog_name_@! Good boy!\"", "speech.monspeak.ef3f583f34e2ab26"},
    {"_grum_rare_", "VISUAL:@The_monster@ is momentarily distracted by a flea in @possessive@ coat.", "speech.monspeak.4bb51209056dbc01"},
    {"_grum_rare_", "@The_monster@ @_Grum_verb_@ @at_foe@, \"I'll hound you night and day!\"", "speech.monspeak.9c5552ac6d879fd2"},
    {"_grum_rare_", "@The_monster@ @_Grum_verb_@ @at_foe@, \"My dogs and I will have a feast tonight...\"", "speech.monspeak.bd1276e592918883"},
    {"_grum_rare_", "@The_monster@ @_Grum_verb_@ @at_foe@, \"You look like good eating.\"", "speech.monspeak.6d6a821e52f902d1"},
    {"_grum_rare_", "@The_monster@ @_Grum_verb_@ @at_foe@, \"I'll squash you like a puppy.\"", "speech.monspeak.0dad423e18b8fd76"},
    {"_grum_rare_", "@The_monster@ looks @at_foe@ in disgust and @_Grum_verb_@, \"You ain't no friend of mine.\"", "speech.monspeak.0d0ebbe0445ae2d6"},
    {"_grum_rare_", "@The_monster@ cheerfully says, \"No dog meat for Grum tonight!\"", "speech.monspeak.10b027508817a05c"},
    {"_grum_rare_", "@The_monster@ @_Grum_verb_@, \"You're dog chow, @player_name@!\"", "speech.monspeak.404875d305339626"},
    {"_grum_rare_", "@The_monster@ asks, \"What kind of bones do @player_genus_plural@ have\? My dogs are dying to find out.\" @player_only@", "speech.monspeak.330fc1f8dafc76a3"},
    {"_grum_rare_", "@The_monster@ says @to_foe@, \"What's my secret\? I feed my dogs @player_genus_plural@. It makes their fur nice and shiny.\" @player_only@", "speech.monspeak.ec332cf3c54eebed"},
    {"_grum_rare_", "@The_monster@ looks @at_foe@ and @_Grum_verb_@, \"Time to put down the runt of the litter.\"", "speech.monspeak.76433111e3af17ff"},
    {"_grum_rare_", "@The_monster@ @_Grum_verb_@ @at_foe@, \"Me and @_Grum_dog_name_@ will play fetch with your bones!\"", "speech.monspeak.caf5b144afd8eb23"},
    {"_grum_rare_", "@The_monster@ @_Grum_verb_@, \"Who's a good boy\? That's right, @_Grum_dog_name_@... you are!\"", "speech.monspeak.c889b2c44960312a"},
    {"_grum_rare_", "@The_monster@ @_Grum_verb_@ @at_foe@, \"You will fight me\? This will be... rough!\"", "speech.monspeak.552943df45d9863f"},
    {"_grum_rare_", "@The_monster@ shouts, \"Release the hounds!\"", "speech.monspeak.3b6822c50adc1c6f"},
    {"_grum_rare_", "@The_monster@ says @to_foe@, \"I'm selling these fine leather pelts.\"", "speech.monspeak.714a6a74445cb279"},
    {"_grum_rare_", "@The_monster@ shouts, \"Faster, @_Grum_dog_name_@! Kill! Kill!\"", "speech.monspeak.db6407716573b314"},
