    {"_jessica_rare_", "@The_monster@ shouts @at_foe@, \"I don't like beings like you!\"", "speech.monspeak.186ecffb1c8073c0"},
    {"_jessica_rare_", "@The_monster@ shouts @at_foe@, \"Stop bothering me, or I'll kill you!\"", "speech.monspeak.752f59defec29cea"},
