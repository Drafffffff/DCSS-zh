    {"_fannar_common_", "VISUAL:@The_monster@ brushes some snowflakes from @possessive@ robe.", "speech.monspeak.4d98bb5e0840bf4a"},
    {"_fannar_common_", "@The_monster@ murmurs some mystic words to @reflexive@.", "speech.monspeak.f4bdaab2cd8c705d"},
    {"_fannar_rare_", "@The_monster@ says @to_foe@, \"Freeze!\"", "speech.monspeak.cf47679b3a742274"},
    {"_fannar_rare_", "@The_monster@ says @to_foe@, \"I shall freeze you to your soul!\"", "speech.monspeak.47c3ae997a236e91"},
    {"_fannar_rare_", "@The_monster@ says @to_foe@, \"An icy embrace awaits you...\"", "speech.monspeak.4523ea5b88f752ea"},
    {"_fannar_rare_", "@The_monster@ says @to_foe@, \"You will make a fine ice sculpture.\"", "speech.monspeak.4fb400184c74518e"},
    {"_fannar_rare_", "@The_monster@ says @to_foe@, \"Does this not give you the chills\?\"", "speech.monspeak.eb51b34a4d262ed1"},
