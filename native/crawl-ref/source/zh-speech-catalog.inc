    {"swamp donald", "@_generic_Donald_@", "speech.monspeak.e1cea3d1ad73a4e3"},
    {"swamp donald", "@The_monster@ says, \"What's that horrible smell\? It's like... yuck.\"", "speech.monspeak.037aec712c9bb408"},
    {"swamp donald", "@The_monster@ says, \"If there's anything I hate more than water, it's brackish swamp water.\"", "speech.monspeak.75e1584bb301c483"},
    {"swamp donald", "@The_monster@ says, \"I hate trees. I hate swamp water. I hate this place.\"", "speech.monspeak.0edc465a75a0cfa5"},
    {"swamp donald", "@The_monster@ says, \"That buzzing noise\? I hate that the most.\"", "speech.monspeak.2ce997e1bafd0b11"},
    {"swamp donald", "@The_monster@ says, \"What could mosquitoes possibly want with my blood\?\"", "speech.monspeak.37cc7a255793df4a"},
    {"swamp donald", "@The_monster@ says, \"I hope these swamp worms drown.\"", "speech.monspeak.dae54ffb105389dd"},
    {"swamp donald", "@The_monster@ says, \"Damn it, I left my flaming sword at home.\"", "speech.monspeak.a399cde50ddce950"},
    {"swamp donald", "@The_monster@ says, \"Don't you hate leeches\? I know I do.\"", "speech.monspeak.66e53eb7cc85de27"},
    {"swamp donald", "@The_monster@ says, \"I hate mosquitoes. Almost as much as I hate swamp water.\"", "speech.monspeak.afdeaff0260c108e"},
    {"swamp donald", "@The_monster@ says, \"At least there's some dry land. I hate getting wet.\"", "speech.monspeak.3f14045180a74c3a"},
    {"swamp donald", "@The_monster@ says, \"Is there a plague of frogs happening, or something\? At least it's not locusts.\"", "speech.monspeak.224a4b7c864a37be"},
    {"swamp donald", "@The_monster@ says, \"The more heads they grow, the more I hate hydras.\"", "speech.monspeak.11a9c2a730f5dfaf"},
    {"shoals donald", "@_generic_Donald_@", "speech.monspeak.7b32565932fa1708"},
    {"shoals donald", "@The_monster@ says, \"Tides\? I despise tides. No, wait, I hate tides!\"", "speech.monspeak.e5777657f74db2ec"},
    {"shoals donald", "@The_monster@ says, \"I like turtle soup. I hate turtles.\"", "speech.monspeak.aab0376a70dc385b"},
    {"shoals donald", "@The_monster@ says, \"I haven't seen any pirates yet. I hate pirates.\"", "speech.monspeak.7d311298b84e41d5"},
    {"shoals donald", "@The_monster@ says, \"At least this place doesn't smell as bad as the Swamp.\"", "speech.monspeak.939a026dbabcce78"},
    {"shoals donald", "@The_monster@ says, \"The sirens are starting to hurt my ears.\"", "speech.monspeak.56aa0d8435c3c0fb"},
    {"shoals donald", "@The_monster@ says, \"Are sirens supposed to sound like that\? I can sing better than that!\"", "speech.monspeak.25aadce30f86bbba"},
    {"shoals donald", "@The_monster@ says, \"Where'd the sea come from\? I thought this place was underground.\"", "speech.monspeak.b7bea11d3c01ba9c"},
    {"shoals donald", "@The_monster@ says, \"I like the beach, but I hate the sea.\"", "speech.monspeak.901f9cb70ff79a0e"},
    {"shoals donald", "@The_monster@ says, \"These tides are fast. That can't be natural!\"", "speech.monspeak.6a2848a0f61cd457"},
    {"shoals donald", "@The_monster@ says, \"At least there aren't any ducks around. I hate ducks.\"", "speech.monspeak.b0adb0c6e8efc5c7"},
    {"shoals donald", "@The_monster@ says, \"I'm soaked through. I hate being wet!\"", "speech.monspeak.5fa12d45351337ee"},
    {"shoals donald", "@The_monster@ says, \"Those krakens don't even look real.\"", "speech.monspeak.b674e11e09ac9a0b"},
    {"shoals donald", "@The_monster@ says, \"I'm looking for Ms. Medusa. Have you seen her\?\"", "speech.monspeak.33b36fca1f4129e9"},
    {"shoals donald", "@The_monster@ says, \"I don't understand half of what these people say. It's all Greek to me.\"", "speech.monspeak.ab50c99d6849cb76"},
    {"shoals donald", "@The_monster@ says, \"And I thought they were famous for their poetry.\"", "speech.monspeak.535b422584240290"},
    {"shoals donald", "@The_monster@ says, \"I slipped earlier. I hate that.\"", "speech.monspeak.67d7ef83973ed8c1"},
    {"shoals donald", "@The_monster@ says, \"I wish these tides would just make up their mind. In and out, in and out...\"", "speech.monspeak.2cf1c0836d62b5eb"},
    {"shoals donald", "@The_monster@ says, \"A turtle bit me. I hate turtles.\"", "speech.monspeak.9c811a40e9cbeba9"},
    {"shoals donald", "@The_monster@ says, \"This tentacle just came out of nowhere and touched me. I hate tentacles!\"", "speech.monspeak.d47edbf9fe811b5e"},
    {"slime donald", "@_generic_Donald_@", "speech.monspeak.e4feb307052288f0"},
    {"slime donald", "@The_monster@ says, \"Where's all the loot\?\"", "speech.monspeak.2d0ab37a35218b3d"},
    {"slime donald", "@The_monster@ says, \"I feel like a jelly sandwich, now.\"", "speech.monspeak.5d2550f37b3a75ee"},
    {"slime donald", "@The_monster@ says, \"This place is the Pits.\"", "speech.monspeak.9874b8c67d76dd45"},
    {"slime donald", "@The_monster@ says, \"I hate the colour green.\"", "speech.monspeak.fbb39d15429d2678"},
    {"slime donald", "@The_monster@ says, \"I can't smell anything here. I hate that.\"", "speech.monspeak.308d232cc9e21f3d"},
    {"slime donald", "@The_monster@ says, \"I can't get this icky slime off my feet.\"", "speech.monspeak.af1998a6c926e0c6"},
    {"slime donald", "@The_monster@ says, \"I keep getting this feeling like someone's watching me. Creepy.\"", "speech.monspeak.7cf3266ca114e9fa"},
    {"slime donald", "@The_monster@ says, \"I always freeze up when I think I'm being watched.\"", "speech.monspeak.1aa6906fda76b74d"},
    {"slime donald", "@The_monster@ says, \"Acid blobs make me think of reflux. I hate reflux.\"", "speech.monspeak.27e7f18fd95e1472"},
    {"slime donald", "@The_monster@ says, \"What's up with all this goo\? It's like a world of goo. I hate goo.\"", "speech.monspeak.0e70a4e73f97d375"},
    {"slime donald", "@The_monster@ says, \"Someone said I could use acid to solve all my problems. It just made them worse.\"", "speech.monspeak.86ceff7800b29e50"},
    {"slime donald", "@The_monster@ says, \"I hope the rune isn't sticky.\"", "speech.monspeak.dfd75ac4768f4d23"},
    {"slime donald", "@The_monster@ says, \"A rock stubbed itself on my toe. I hate that.\"", "speech.monspeak.3710cc632d0e0ad8"},
    {"slime donald", "@The_monster@ says, \"What's so magical about quicksilver, anyway\?\"", "speech.monspeak.753a96efb1500f0c"},
    {"snake donald", "@_generic_Donald_@", "speech.monspeak.b82b1ec393ca4018"},
    {"snake donald", "@The_monster@ says, \"You know that hissing noise\? I hate that.\"", "speech.monspeak.3153dbba6b0dda57"},
    {"snake donald", "@The_monster@ says, \"You know that slithering noise\? I hate that.\"", "speech.monspeak.9fb32bc9b2440009"},
    {"snake donald", "@The_monster@ says, \"I'd like to make these snakes into gloves, but I hate gloves.\"", "speech.monspeak.9a295ccd52990047"},
    {"snake donald", "@The_monster@ says, \"This place is the Pits.\"", "speech.monspeak.ac0ff4a9783bd4aa"},
    {"snake donald", "@The_monster@ says, \"What do naga need barding for\?\"", "speech.monspeak.971b5e6f1b175405"},
    {"snake donald", "@The_monster@ says, \"What's a barding, anyway\? Does it sing for its supper\?\"", "speech.monspeak.4eb94e27339ebb5e"},
    {"snake donald", "@The_monster@ says, \"Robes are for wimps. Real warriors wear heavy armour!\"", "speech.monspeak.43ef295cbd915932"},
    {"snake donald", "@The_monster@ says, \"Nagas are pretty ugly. I hate nagas.\"", "speech.monspeak.472de3394adaeaaa"},
    {"snake donald", "@The_monster@ says, \"Did all the warriors here go to shield school or something\?\"", "speech.monspeak.20d6620f676f235e"},
    {"snake donald", "@The_monster@ says, \"So, why is that serpent talking\?\"", "speech.monspeak.56cb084157602148"},
    {"snake donald", "@The_monster@ says, \"What sort of name is 'naga' anyway\? They're not even good at nagging.\"", "speech.monspeak.6b7c9d5993c8c41b"},
    {"snake donald", "@The_monster@ says, \"At least there aren't any garudas. I hate garudas.\"", "speech.monspeak.138b3db0c88499a5"},
    {"snake donald", "@The_monster@ says, \"You'd think there'd be more pits. I haven't seen any.\"", "speech.monspeak.84a0ac98c015263e"},
    {"snake donald", "@The_monster@ says, \"I'm sick of this place. Or maybe that's poison...\"", "speech.monspeak.2669d57fffefa781"},
    {"snake donald", "@The_monster@ says, \"I hate mutated serpents.\"", "speech.monspeak.7f3bce92a39baed8"},
    {"snake donald", "@The_monster@ says, \"So, nagas are stealthy\? Don't make me laugh.\"", "speech.monspeak.246bbb5f1d04399e"},
    {"snake donald", "@The_monster@ says, \"I wish they'd hurry up and stop blocking the corridors.\"", "speech.monspeak.1662d6c7e9c40c8c"},
    {"snake donald", "@The_monster@ says, \"Man, snails must be faster than these guys.\"", "speech.monspeak.6da60beeab039d72"},
    {"snake donald", "@The_monster@ says, \"How does a snake shoot lightning, anyway\?\"", "speech.monspeak.2ae504bda7459def"},
    {"snake donald", "@The_monster@ says, \"First nagas, now salamanders. What's next, crocodiles with mirrors on their heads\?\"", "speech.monspeak.e3863718ad5e3e71"},
    {"abyss donald", "@_generic_Donald_@", "speech.monspeak.0167b92d4278aa9d"},
    {"abyss donald", "@The_monster@ says, \"But I don't want to have to go deeper!\"", "speech.monspeak.398602c1d80083e7"},
    {"abyss donald", "@The_monster@ says, \"What does 'eldritch' mean, anyway\?\"", "speech.monspeak.0ba3a810e04d90ba"},
    {"abyss donald", "@The_monster@ says, \"I keep hearing this weird shrieking in my head. I hate that.\"", "speech.monspeak.d2d6fe98710eb3b8"},
    {"abyss donald", "@The_monster@ says, \"I've never heard of a star cursing anything.\"", "speech.monspeak.0131edc6a09caec1"},
    {"abyss donald", "@The_monster@ says, \"I've never heard of a star spawning anything.\"", "speech.monspeak.c786fa3abc06fa96"},
    {"abyss donald", "@The_monster@ throws up @possessive@ hands and says, \"Alright, I admit it, I'm lost!\"", "speech.monspeak.9f3a86843fe1b7d0"},
    {"abyss donald", "@The_monster@ says, \"I hate wrenching sensations.\"", "speech.monspeak.fd5f55bebed65b04"},
    {"abyss donald", "@The_monster@ says, \"What's so abyssal about tentacles and stars\?\"", "speech.monspeak.90863cb9907176ea"},
    {"abyss donald", "@The_monster@ says, \"Screaming refractions\? What's next, yodelling boulders\?\"", "speech.monspeak.6f3de96811bc89c5"},
    {"zot donald", "@_generic_Donald_@", "speech.monspeak.71f8b138020f8a79"},
    {"zot donald", "@The_monster@ says, \"I saw a draconian who kept changing colours. Some people are so indecisive.\"", "speech.monspeak.3454b0fbbd251b7f"},
    {"zot donald", "@The_monster@ says, \"How come everyone is wearing a cloak down here\?\"", "speech.monspeak.10fabdb64a4802b5"},
    {"zot donald", "@The_monster@ says, \"I offered a draconian some spare armour, but he said it didn't fit.\"", "speech.monspeak.75a494e7aa34bafa"},
    {"zot donald", "@The_monster@ says, \"I keep feeling something staring at me. Is it you\?\"", "speech.monspeak.680e805a9ca4e726"},
    {"zot donald", "@The_monster@ says, \"How do you make a golem out of electricity\?\"", "speech.monspeak.cc96c0f6119eaef6"},
    {"zot donald", "@The_monster@ says, \"What's an 'Orb Guardian', anyway\?\"", "speech.monspeak.53cb94bc922932fa"},
    {"zot donald", "@The_monster@ says, \"Orbs of fire, orbs of destruction, the Orb of Zot... what's with all the orbs\?\"", "speech.monspeak.c97b9c288659f233"},
    {"zot donald", "@The_monster@ says, \"I hate orbs.\"", "speech.monspeak.6ce479a86b28d94e"},
    {"zot donald", "@The_monster@ says, \"I hate clowns.\"", "speech.monspeak.4975ecd001fc8103"},
    {"zot donald", "@The_monster@ says, \"I hate draconians.\"", "speech.monspeak.74351da11a3e61dd"},
    {"zot donald", "@The_monster@ says, \"I hate purple.\"", "speech.monspeak.8219e6cc8b14ac1f"},
    {"zot donald", "@The_monster@ says, \"Are they setting up a circus down here\?\"", "speech.monspeak.08b492f1b8e1785d"},
    {"zot donald", "@The_monster@ says, \"This place probably doesn't see many tourists.\"", "speech.monspeak.60bd566ae2c41d46"},
    {"zot donald", "@The_monster@ says, \"Oh, so that's what those runes are for!\"", "speech.monspeak.3c7b426e254df285"},
    {"zot donald", "@The_monster@ says, \"Why do the walls change colour every floor\? Did they keep running out of paint\?\"", "speech.monspeak.a771ffa1d536ac75"},
    {"zot donald", "@The_monster@ says, \"What's stopping the guards from just stealing the Orb themselves\?\"", "speech.monspeak.358416e587911fa5"},
    {"zot donald", "@The_monster@ says, \"I hope I don't run into any orbs of ice down here!\"", "speech.monspeak.4657126d77633eb5"},
    {"zot donald", "@The_monster@ says, \"Did you bring your rings of ice\?\"", "speech.monspeak.2878f62aada0bd21"},
    {"zot donald", "@The_monster@ says, \"The Orb of Power is here\? Where are the others, then\?\"", "speech.monspeak.18fe3421a609e9d3"},
    {"zot donald", "@The_monster@ says, \"I saw some tasty-looking maize earlier, but it tried to eat me. I hate that.\"", "speech.monspeak.a2b4337ee7899d4c"},
    {"zin donald", "@_generic_Donald_@", "speech.monspeak.b3f4b077ac474285"},
    {"zin donald", "@The_monster@ says, \"So much for spreading the word; you get punched in the face instead.\"", "speech.monspeak.a6b8de4bc6de64c3"},
    {"zin donald", "@The_monster@ says, \"This pamphlet doesn't say what the point to Recitation is.\"", "speech.monspeak.2d0c555276a8d5b3"},
    {"zin donald", "@The_monster@ says, \"I wanna be an adventurer, not a preacher!\"", "speech.monspeak.93d64bb6019512d2"},
    {"zin donald", "@The_monster@ says, \"What does Zin need our gold for, anyway\?\"", "speech.monspeak.1ed45d367cc93a15"},
    {"zin donald", "@The_monster@ says, \"Something seems a little bit odd about a God who wants to be paid.\"", "speech.monspeak.c04d7140f2bba821"},
    {"zin donald", "@The_monster@ says, \"I've got two hundred gold pieces. Is that enough to cure these mutations\?\"", "speech.monspeak.f809004d3b8f69af"},
    {"zin donald", "@The_monster@ says, \"Didn't you like your horns\?\"", "speech.monspeak.7401cfb11e7bd959"},
    {"zin donald", "@The_monster@ says, \"If I give you twenty gold pieces, can you get rid of this nasty case of scales I've got\?\"", "speech.monspeak.07eed0f421476994"},
    {"zin donald", "@The_monster@ covers @possessive@ ears. \"Shut up!\"", "speech.monspeak.1d442af364771894"},
    {"zin donald", "@The_monster@ says, \"Wouldn't you get more for your money with Gozag\?\"", "speech.monspeak.59051bddc04c006d"},
    {"friendly yredelemnul donald", "@_yredelemnul_Donald_@", "speech.monspeak.89c3c384463b312f"},
    {"_yredelemnul_donald_", "@The_monster@ says, \"How does a bone dragon fly, anyway\?\"", "speech.monspeak.ebbad3a4e6ffe4c9"},
    {"_yredelemnul_donald_", "@The_monster@ says, \"How do you flay a ghost, anyway\?\"", "speech.monspeak.fd35223bf4db1c7d"},
    {"_yredelemnul_donald_", "@The_monster@ says, \"Pah! You're not even a real necromancer.\"", "speech.monspeak.ce47c0931247e4dc"},
    {"_yredelemnul_donald_", "@The_monster@ says, \"Did you drop out of Necromancy School\?\"", "speech.monspeak.48a59876eeb33523"},
    {"_yredelemnul_donald_", "@The_monster@ says, \"Ah. You're responsible for all those zombies.\"", "speech.monspeak.a0c9d1aa99c8090d"},
    {"_yredelemnul_donald_", "@The_monster@ says, \"I hate zombies.\"", "speech.monspeak.1ec02996dce69e8f"},
    {"_yredelemnul_donald_", "@The_monster@ says, \"Zombies\? Spectres\? Don't you get bored without any real company\?\"", "speech.monspeak.2981301c5cb820d0"},
    {"_yredelemnul_donald_", "@The_monster@ says, \"Angels painted black are so last century.\"", "speech.monspeak.7b92fc03082b1f78"},
    {"_yredelemnul_donald_", "@The_monster@ says, \"If you wanted the light to be dimmer, you could have said so.\"", "speech.monspeak.169495a19e7cbdca"},
    {"_yredelemnul_donald_", "@The_monster@ says, \"What kind of torch can only be lit once per level\?\"", "speech.monspeak.6fbd6931d8955bd4"},
    {"_yredelemnul_donald_", "@The_monster@ says, \"How does that torch stay lit when you throw its fire all over\?\"", "speech.monspeak.0b7a2e538abce2ff"},
    {"_yredelemnul_donald_", "@The_monster@ says, \"I hate being shackled.\"", "speech.monspeak.89495bd99e1441f4"},
    {"makhleb donald", "@_generic_Donald_@", "speech.monspeak.bd3eb7d4dee5ffb2"},
    {"makhleb donald", "@The_monster@ says, \"At least you've got demons for company.\"", "speech.monspeak.458f3bac4ecdc120"},
    {"makhleb donald", "@The_monster@ says, \"Are you sure that summoning demons is a good idea\?\"", "speech.monspeak.7fb678c404075bf8"},
    {"makhleb donald", "@The_monster@ says, \"Hey, watch where you throw those bolts!\"", "speech.monspeak.2cebbd18628762d7"},
    {"makhleb donald", "@The_monster@ says, \"What will you do after everything's destroyed\?\"", "speech.monspeak.7ff27a294ba6a445"},
    {"makhleb donald", "@The_monster@ says, \"I hate demons.\"", "speech.monspeak.0a7ca4948a761fc0"},
    {"makhleb donald", "@The_monster@ says, \"I hate blood.\"", "speech.monspeak.043ca34287132121"},
    {"makhleb donald", "@The_monster@ says, \"I hate suffering.\"", "speech.monspeak.1e16e24d2dcf5855"},
    {"makhleb donald", "@The_monster@ says, \"I hate branding.\"", "speech.monspeak.62093c46b7a55e73"},
    {"makhleb donald", "@The_monster@ says, \"I hate pacts.\"", "speech.monspeak.711aea0f629833e4"},
    {"makhleb donald", "@The_monster@ says, \"I hate the Hells.\"", "speech.monspeak.2d5c0d3d786da0c9"},
    {"makhleb donald", "@The_monster@ says, \"I just stubbed my toe. Does that mean I'm cleansed\?\"", "speech.monspeak.909c76f7653452cc"},
    {"makhleb donald", "@The_monster@ says, \"If I carve 'Go Away' into myself, will Makhleb do that\?\"", "speech.monspeak.5869dd4f6493dd74"},
    {"makhleb donald", "@The_monster@ says, \"What's the Crucible of Flesh\? Some kind of fancy barbecue place\?\"", "speech.monspeak.a49bb7760448f6b7"},
    {"sif muna donald", "@_generic_Donald_@", "speech.monspeak.1c76296de3f0fd8b"},
    {"sif muna donald", "@The_monster@ says, \"Don't you wish for a portable bookcase\?\"", "speech.monspeak.b65b21683ff28ae7"},
    {"sif muna donald", "@The_monster@ says, \"Imagine how many trees were cut down to fuel your hobby.\"", "speech.monspeak.17eb4d8ff21e8962"},
    {"sif muna donald", "@The_monster@ says, \"Man, that must be some big library.\"", "speech.monspeak.6973f05de8b50ccd"},
    {"sif muna donald", "@The_monster@ says, \"Found the spell you wanted yet\?\"", "speech.monspeak.fa30062cd9dddb2c"},
    {"sif muna donald", "@The_monster@ says, \"If you wanted to read so much, why didn't you become a librarian\?\"", "speech.monspeak.287200ec8f3eb837"},
    {"sif muna donald", "@The_monster@ says, \"Did you remember that thing that you forgot\? I hate that.\"", "speech.monspeak.13eb74cafe6d4a26"},
    {"sif muna donald", "@The_monster@ says, \"It's like an all you can read... something.\"", "speech.monspeak.9db959a1d5463e70"},
    {"sif muna donald", "@The_monster@ says, \"I hate books.\"", "speech.monspeak.1be843683f7bd34f"},
    {"sif muna donald", "@The_monster@ says, \"Surely there's a limit to the number of books you can carry. Right\?\"", "speech.monspeak.a55b30363a58a350"},
    {"sif muna donald", "@The_monster@ says, \"It's good how you can learn magic as if by magic.\"", "speech.monspeak.0692ff6b8a304ea0"},
    {"sif muna donald", "@The_monster@ says, \"I hate spells.\"", "speech.monspeak.a2403b117a68842a"},
    {"sif muna donald", "@The_monster@ says, \"Don't you just hate miscasts\?\"", "speech.monspeak.71136680dd235d3f"},
    {"elyvilon donald", "@_generic_Donald_@", "speech.monspeak.884bbf846bc5c656"},
    {"elyvilon donald", "@The_monster@ says, \"Whatever happened to, 'First, do no harm'\?\"", "speech.monspeak.c6947b64f3ea9a36"},
    {"elyvilon donald", "@The_monster@ says, \"Doesn't healing your enemies sound rather pointless\?\"", "speech.monspeak.848280ddda3e4708"},
    {"elyvilon donald", "@The_monster@ says, \"Maybe you should start praying.\"", "speech.monspeak.a720402a4a147673"},
    {"elyvilon donald", "@The_monster@ says, \"If I give you my weapon, will you leave me alone\?\"", "speech.monspeak.8a907f357f3dead8"},
    {"elyvilon donald", "@The_monster@ says, \"Come on. Make me an offer of peace that I can't refuse!\"", "speech.monspeak.1d473bb0354a75f9"},
    {"elyvilon donald", "@The_monster@ says, \"For every monster you don't kill, I'll kill three.\"", "speech.monspeak.051356610a10eb24"},
    {"lugonu donald", "@_generic_Donald_@", "speech.monspeak.3a1dbe3be340171c"},
    {"lugonu donald", "@The_monster@ says, \"Why would you want to visit the Abyss\? For a holiday\?\"", "speech.monspeak.f049da60a6d27f39"},
    {"lugonu donald", "@The_monster@ says, \"Nothing ever attacks me when I'm in the Abyss.\"", "speech.monspeak.d2b2d0a665c3070f"},
    {"lugonu donald", "@The_monster@ says, \"Are you going to banish me, too\?\"", "speech.monspeak.2bfc9022d6f6f84a"},
    {"lugonu donald", "@The_monster@ says, \"The world's bad enough without you corrupting it.\"", "speech.monspeak.2651fcb4f8c3ba20"},
    {"lugonu donald", "@The_monster@ says, \"You must really love eldritch horrors. I hate them.\"", "speech.monspeak.cf4c382f8a037755"},
    {"lugonu donald", "@The_monster@ says, \"How can a god be banished to the Abyss\?\"", "speech.monspeak.acc2140f9cdaaab6"},
    {"beogh donald", "@_generic_Donald_@", "speech.monspeak.0b05499a86c82d86"},
    {"beogh donald", "@The_monster@ says, \"Beogh must be pretty vain, having all those worshippers get remade in Beogh's image.\"", "speech.monspeak.7f25cfe5df3a810e"},
    {"beogh donald", "@The_monster@ says, \"One of the priests looked like she was going to ask me to join... I guess she changed her mind.\"", "speech.monspeak.9796dd14b8aad27e"},
    {"beogh donald", "@The_monster@ says, \"You think walking on water is cool\? I can swim.\"", "speech.monspeak.110d81ec7ebfd772"},
    {"beogh donald", "@The_monster@ says, \"Isn't it annoying when people just start challenging you, and you can't get away from them\?\"", "speech.monspeak.f50d4b3a2bb537fd"},
    {"beogh donald", "@The_monster@ says, \"I'd get sick of only having three followers at most.\"", "speech.monspeak.e1d27c09265da445"},
    {"beogh donald", "@The_monster@ says, \"How do you find enough ash and charcoal to anoint them all\?\"", "speech.monspeak.890837bfdd9d4885"},
    {"beogh donald", "@The_monster@ says, \"You'll need more than orcs to take me on.\"", "speech.monspeak.d0c383c119b2201f"},
    {"beogh donald", "@The_monster@ says, \"Do you like preaching on mountaintops\?\"", "speech.monspeak.d4da15422d50e10f"},
    {"beogh donald", "@The_monster@ says, \"What is divine providence, anyway\? I hate that.\"", "speech.monspeak.02fe687558cb1b5f"},
    {"beogh donald", "@The_monster@ says, \"You'd better watch out. The one on the left looks like he gets lost easily.\"", "speech.monspeak.f25479f51e65b7e5"},
    {"beogh donald", "@The_monster@ says, \"You think you're the Messiah\? I met another orc who thought that, too.\"", "speech.monspeak.f961d13a8a3d7869"},
    {"beogh donald", "@The_monster@ says, \"Messiah\? I hate messiahs.\"", "speech.monspeak.9c29b706928fa3b6"},
    {"beogh donald", "@The_monster@ bows and submits to you. \"Nah, just kidding.\"", "speech.monspeak.d572c22e2f1871c7"},
    {"ignis donald", "@_generic_Donald_@", "speech.monspeak.ec1ae87fbc60a790"},
    {"ignis donald", "@The_monster@ says, \"Don't fight so hard! You'll just burn out.\"", "speech.monspeak.88b702dd0066155d"},
    {"ignis donald", "@The_monster@ says, \"Huh, so Ignis will die when you do... how's that make you feel\?\"", "speech.monspeak.ac900d3d48614d1c"},
    {"ignis donald", "@The_monster@ says, \"You'd think a god of fire would be a bit brighter.\"", "speech.monspeak.eb84bc647202830d"},
    {"ignis donald", "@The_monster@ says, \"Feel like your fire's burning out\? I hate that.\"", "speech.monspeak.ba61defd294f02ba"},
    {"ignis donald", "@The_monster@ says, \"You know a god's a real winner when you're their only follower, right\?\"", "speech.monspeak.f8d546afeb72b4eb"},
    {"ignis donald", "@The_monster@ says, \"Oh, I wondered where that burning smell was coming from.\"", "speech.monspeak.602c280ef27ddfe1"},
    {"ignis donald", "@The_monster@ says, \"Why not join one of those new, up-and-coming flame gods instead\?\"", "speech.monspeak.1564e2734fda03fd"},
    {"ignis donald", "@The_monster@ says, \"Doesn't it hurt to go crashing headfirst through the ceiling\?\"", "speech.monspeak.c56e88fbb6c06d9a"},
    {"ignis donald", "@The_monster@ says, \"Wow, you can rise to a higher floor... isn't that called 'climbing stairs'\?\"", "speech.monspeak.a1c7d8dc87d53104"},
    {"ignis donald", "@The_monster@ says, \"Wow, fire everywhere! I hate that.\"", "speech.monspeak.78614f869541ad2b"},
    {"cheibriados donald", "@_generic_Donald_@", "speech.monspeak.1cbf7e96a698336b"},
    {"cheibriados donald", "@The_monster@ says, \"Slow down!\"", "speech.monspeak.4cb72b0446d56911"},
    {"cheibriados donald", "@The_monster@ says, \"You're not very quick on the uptake, are you\?\"", "speech.monspeak.2018061cbaa8ecf9"},
    {"cheibriados donald", "@The_monster@ says, \"You know, if you want, I know a very good posture trainer.\"", "speech.monspeak.da3556052704b6f8"},
    {"cheibriados donald", "@The_monster@ says, \"Am I talking too fast for you\?\"", "speech.monspeak.0b034abda455def8"},
    {"cheibriados donald", "@The_monster@ says, \"Look at me! I'm running, I'm running!\"", "speech.monspeak.20443f668c33223a"},
    {"cheibriados donald", "@The_monster@ says, \"Quick, run away!\"", "speech.monspeak.3a964065b682117e"},
    {"cheibriados donald", "@The_monster@ says, \"How about we settle this with a race\?\"", "speech.monspeak.86f8015133e50b9d"},
    {"xom donald", "@_generic_Donald_@", "speech.monspeak.803d1985d333e944"},
    {"xom donald", "@The_monster@ says, \"Xom\? Are you insane\?\"", "speech.monspeak.26dc98de29a5166c"},
    {"xom donald", "@The_monster@ says, \"I don't get Xom.\"", "speech.monspeak.c609e565f0a76a68"},
    {"xom donald", "@The_monster@ says, \"I hate Xom.\"", "speech.monspeak.b73baf5bca8d600f"},
    {"xom donald", "@The_monster@ says, \"I hate maniacal laughter.\"", "speech.monspeak.dbb0779002c30ba9"},
    {"xom donald", "@The_monster@ says, \"I hate divine lightning.\"", "speech.monspeak.27412adcefe71caf"},
    {"xom donald", "@The_monster@ says, \"If it's mutations you're wanting, wouldn't Jiyva be a better deal\?\"", "speech.monspeak.df77f89a7ed13b2c"},
    {"xom donald", "@The_monster@ says, \"I hope you love dancing weapons. I hate them.\"", "speech.monspeak.f798c009e2f56496"},
    {"xom donald", "@The_monster@ says, \"Been surrounded by packs of demons recently\? I hate that.\"", "speech.monspeak.3aa629523196bdfc"},
    {"xom donald", "@The_monster@ says, \"Xom just doesn't make any sense. I hate that.\"", "speech.monspeak.e4010e78a33244da"},
    {"xom donald", "@The_monster@ says, \"What kind of name is 'Xom', anyway\?\"", "speech.monspeak.959be2a571864b3a"},
    {"xom donald", "@The_monster@ says, \"What is a 'random number god' anyway\?\"", "speech.monspeak.160fef45896ecf83"},
    {"xom donald", "@The_monster@ says, \"I had a teddy bear once. I hated it.\"", "speech.monspeak.8f1524b095cc5b6c"},
    {"ashenzari donald", "@_generic_Donald_@", "speech.monspeak.787bfca574c37f0d"},
    {"ashenzari donald", "@The_monster@ says, \"You seem like a real know-it-all. I hate that.\"", "speech.monspeak.2e59acfec640b59f"},
    {"ashenzari donald", "@The_monster@ says, \"What's the point of being all-knowing if you can't do anything\?\"", "speech.monspeak.7293b88900067d5e"},
    {"ashenzari donald", "@The_monster@ makes a face at you and exclaims, \"Curses!\"", "speech.monspeak.7cf99cbfd32129de"},
    {"ashenzari donald", "@The_monster@ says, \"I got nailed to the sky once. No big deal, really.\"", "speech.monspeak.d6aa3b1cebf0adef"},
    {"ashenzari donald", "@The_monster@ says, \"I hate voyeurs.\"", "speech.monspeak.c257dcd53277f8c7"},
    {"ashenzari donald", "@The_monster@ says, \"What does a god have to do to get cursed, anyway\?\"", "speech.monspeak.39893546672911de"},
    {"dithmenos donald", "@_generic_Donald_@", "speech.monspeak.caac6300da774eaf"},
    {"dithmenos donald", "@The_monster@ says, \"Sounds like you're dealing with a pretty shady god there.\"", "speech.monspeak.cc0806c677ebba7d"},
    {"dithmenos donald", "@The_monster@ says, \"I'll bet you have a pretty dark future.\"", "speech.monspeak.8780adc97655adac"},
    {"dithmenos donald", "@The_monster@ squints around. \"I can't see a thing. I hate that.\"", "speech.monspeak.22f4a1e0881fbae6"},
    {"dithmenos donald", "@The_monster@ says, \"I hate shadows.\"", "speech.monspeak.c781dae5e377ef7a"},
    {"dithmenos donald", "@The_monster@ says, \"I hate starless nights.\"", "speech.monspeak.ae8accf488f76d4d"},
    {"dithmenos donald", "@The_monster@ says, \"Are you still afraid of the dark\?\"", "speech.monspeak.d7585e7f562963ba"},
    {"dithmenos donald", "@The_monster@ says, \"Careful; you might trip over your own shadow.\"", "speech.monspeak.93168952186112b1"},
    {"ru donald", "@_generic_Donald_@", "speech.monspeak.237ab56b10b7b346"},
    {"ru donald", "@The_monster@ says, \"Missing something\?\"", "speech.monspeak.2d75741ccfe7e37f"},
    {"ru donald", "@The_monster@ says, \"I hate sacrifices.\"", "speech.monspeak.cd8b28ce4682e75d"},
    {"ru donald", "@The_monster@ says, \"I hate sacrificants.\"", "speech.monspeak.6e0d316007a63cb6"},
    {"ru donald", "@The_monster@ says, \"Once, I gave up eating meat for a week. I hated that.\"", "speech.monspeak.a942c57199b0dae7"},
    {"ru donald", "@The_monster@ says, \"Once, I gave up drinking for a week. I hated that.\"", "speech.monspeak.6c1304d2fe909753"},
    {"ru donald", "@The_monster@ says, \"I hate hidden layers of reality.\"", "speech.monspeak.1156f13d3d427fe9"},
    {"ru donald", "@The_monster@ says, \"I hate existential doubt.\"", "speech.monspeak.3e4048fd77eef122"},
    {"ru donald", "@The_monster@ says, \"The great annihilating truth is that I hate you.\"", "speech.monspeak.c1444542754a9868"},
    {"pakellas donald", "@_generic_Donald_@", "speech.monspeak.1c0e893cb34d341a"},
    {"pakellas donald", "@The_monster@ says, \"I hate inventors.\"", "speech.monspeak.ad23a44a15b59a0a"},
    {"pakellas donald", "@The_monster@ says, \"What are you with all those gadgets, some kind of pawn shop\?\"", "speech.monspeak.2db7c2a76b6a7070"},
    {"pakellas donald", "@The_monster@ says, \"What would you do with the Orb, anyway\? Experiment on it\?\"", "speech.monspeak.25ad26d2044373ea"},
    {"pakellas donald", "@The_monster@ says, \"Bet you can't [analyse|invent] your way out of this one.\"", "speech.monspeak.a8de429d4379e4ae"},
    {"pakellas donald", "@The_monster@ says, \"Can I borrow that [wand|lamp|fan] for a second\? You must have some to spare.\"", "speech.monspeak.113c24cc2f41b38d"},
    {"uskayaw donald", "@_generic_Donald_@", "speech.monspeak.1815fdb3d0af13de"},
    {"uskayaw donald", "@The_monster@ says, \"Dance\? No thanks, I don't dance.\"", "speech.monspeak.5a8657d4c8950933"},
    {"uskayaw donald", "@The_monster@ says, \"I hate drums.\"", "speech.monspeak.b92c1fde473a3b6d"},
    {"uskayaw donald", "@The_monster@ says, \"I hate chants.\"", "speech.monspeak.6a0fbcfc435067d6"},
    {"uskayaw donald", "@The_monster@ says, \"Poetry of the foot\? All you're doing is stomping around.\"", "speech.monspeak.106507ab2ef9bd56"},
    {"uskayaw donald", "@The_monster@ says, \"You look ridiculous with all that flailing around.\"", "speech.monspeak.d050c6f189757610"},
    {"uskayaw donald", "@The_monster@ says, \"That's not dancing; that's just a fancy way of killing things.\"", "speech.monspeak.45027d0d0c90d1e9"},
    {"uskayaw donald", "@The_monster@ says, \"What kind of dance blows up spectators\?\"", "speech.monspeak.ed4d4feaaceb8c7a"},
    {"no god donald", "@_generic_Donald_@", "speech.monspeak.84099b03a9b72bd5"},
    {"no god donald", "@The_monster@ says, \"Don't you get lonely without a god\?\"", "speech.monspeak.1c9d2ca894b50b05"},
    {"no god donald", "@The_monster@ says, \"I hate the gods.\"", "speech.monspeak.b22a6bb5b473ab06"},
    {"no god donald", "@The_monster@ says, \"I hate atheists.\"", "speech.monspeak.9d664d18ace3bef1"},
    {"no god donald", "@The_monster@ says, \"I hate the gods, and the gods hate me.\"", "speech.monspeak.fe65889991bc3c52"},
    {"no god donald", "@The_monster@ says, \"You must run out of gods to curse by.\"", "speech.monspeak.23794199bc91ffa9"},
    {"no god donald", "@The_monster@ says, \"Did you miss the Ecumenical Temple\?\"", "speech.monspeak.f2e1bf9e70ede7b7"},
    {"donald riddle", "@The_monster@ says, \"Everybody knows that one already. Try something more original.\"", "speech.monspeak.457a4e0b21b68bc0"},
    {"donald killed", "@The_monster@ says, \"I'm dying. I hate that.\"", "speech.monspeak.6df3133ca1c29113"},
    {"donald triumphant", "@The_monster@ says, \"I won. I... don't hate that.\"", "speech.monspeak.52e3daf158e96a37"},
    {"donald triumphant", "@The_monster@ says, \"Well, maybe you weren't so bad after all.\"", "speech.monspeak.6efe8ae866fd3193"},
    {"twin_banished dowan", "VISUAL:@The_monster@ shakes with grief.", "speech.monspeak.2c26b2cfd364a357"},
    {"twin_banished dowan", "@The_monster@ says, \"I will find her! I will get her back!\"", "speech.monspeak.f45a23f4fa9bdf09"},
    {"twin_banished dowan", "@The_monster@ says, \"She won't be lost forever!\"", "speech.monspeak.d06cf589ad493652"},
    {"twin_slimified dowan", "VISUAL:@The_monster@ shakes with grief.", "speech.monspeak.25c3c85ba454c943"},
    {"twin_slimified dowan", "@The_monster@ says, \"I will find a way to undo this!\"", "speech.monspeak.09eec075e7f5dc63"},
    {"twin_slimified dowan", "@The_monster@ says, \"Turn her back! At once!\"", "speech.monspeak.d2a112c5572a29a2"},
    {"dowan", "@_Dowan_common_@", "speech.monspeak.0b880a5caec83fab"},
    {"dowan", "@_Dowan_rare_@", "speech.monspeak.651017af113b7845"},
    {"fleeing dowan", "VISUAL:@The_monster@ cries in horror.", "speech.monspeak.91e23a3473c9a196"},
    {"_dowan_common_", "VISUAL:@The_monster@ smirks and points a slender finger @at_foe@.", "speech.monspeak.c463b8b0c367265b"},
    {"_dowan_common_", "@The_monster@ says @to_foe@, \"My weaknesses are her strengths!\"", "speech.monspeak.391cb07781fafb19"},
    {"_dowan_common_", "@The_monster@ says @to_foe@, \"Stay away from my face!\"", "speech.monspeak.3461f6945a07f873"},
    {"_dowan_common_", "@The_monster@ says @to_foe@, \"Magic and the sword, together, will defeat you.\" @player_only@", "speech.monspeak.bcb5c74b4c0cceac"},
    {"dowan_duvessa_dies", "@The_monster@ screams, \"No! No!\"", "speech.monspeak.8ae303a0353f1797"},
    {"dowan_duvessa_dies", "VISUAL:@The_monster@ seems overcome with grief.", "speech.monspeak.09922432da92d4c6"},
    {"dowan_duvessa_dies", "@The_monster@ screams, \"No! Oh no!\"", "speech.monspeak.187045a4f7ee2a4c"},
    {"dowan_duvessa_dies", "@The_monster_possessive@ eyes darken. \"You have made a grave mistake.\"", "speech.monspeak.ebf718ec66ac195a"},
    {"dowan_duvessa_dies_distance", "You hear a distant wail of despair.", "speech.monspeak.d682698ac64dc862"},
    {"dowan_duvessa_dies_bytwin", "@Duvessa_Dowan_dies_bytwin@", "speech.monspeak.9f6f320210312aae"},
    {"twin_banished duvessa", "VISUAL:@The_monster@ shakes in a combination of rage and grief.", "speech.monspeak.bb003aa4b1e8ac44"},
    {"twin_banished duvessa", "VISUAL:@The_monster@ grits @possessive@ teeth and focuses.", "speech.monspeak.362dc147ef461173"},
    {"twin_banished duvessa", "@The_monster@ says, \"I will get him back!\"", "speech.monspeak.90ff2d8c54c0f222"},
    {"twin_ikilled dowan", "VISUAL:@The_monster@ is wide-eyed with horror.", "speech.monspeak.2a7e662ff119413d"},
    {"twin_ikilled dowan", "@The_monster@ screams.", "speech.monspeak.dd6e6d81a4e50b65"},
    {"twin_ikilled dowan", "@The_monster@ shakes @possessive@ head, saying, \"No, no, no!\"", "speech.monspeak.a13d4809f43dd296"},
    {"twin_ikilled dowan", "@The_monster@ screams, \"No! What have I done\?\"", "speech.monspeak.64df213eee84add5"},
    {"duvessa", "@_Duvessa_common_@", "speech.monspeak.dcdd555084c01e20"},
    {"duvessa", "@_Duvessa_rare_@", "speech.monspeak.8ad305a57dd2b014"},
    {"_duvessa_common_", "VISUAL:@The_monster@ gestures with @possessive@ weapon @at_foe@.", "speech.monspeak.b7c4c8c207320610"},
    {"_duvessa_common_", "@The_monster@ says @to_foe@, \"My weaknesses are his strengths!\"", "speech.monspeak.986dec40da58d931"},
    {"_duvessa_common_", "@The_monster@ says @to_foe@, \"Where magic fails, the sword succeeds!\"", "speech.monspeak.6d4b63a18f2e127a"},
    {"_duvessa_common_", "@The_monster@ says @to_foe@, \"When magic and the sword combine, nothing stands against them.\"", "speech.monspeak.b0248ce26fa9ac91"},
    {"_duvessa_rare_", "@The_monster@ @_shouts_@ @to_foe@, \"You can run, but you cannot escape us forever!\" @player_only@", "speech.monspeak.0afef56a9999c045"},
    {"_duvessa_rare_", "@The_monster@ says @to_foe@, \"I don't care about looks, I care about technique!\"", "speech.monspeak.d10a121f8a06df5c"},
    {"_duvessa_rare_", "@The_monster@ says @to_foe@, \"Did you see that move\? Perfect!\"", "speech.monspeak.fffbcf1b09373b19"},
    {"_duvessa_rare_", "@The_monster@ says @to_foe@, \"Beauty is only skin deep, and my weapons penetrate much further than that.\"", "speech.monspeak.ec16cb255e397883"},
    {"_duvessa_rare_", "@The_monster@ says @to_foe@, \"Practise, practise, practise! One day you'll be as good as me.\" @player_only@", "speech.monspeak.417ff6556fa229aa"},
    {"duvessa_dowan_dies_distance", "You hear a distant scream of rage.", "speech.monspeak.96a925badbae00d9"},
    {"duvessa_dowan_dies_bytwin", "@The_monster@ screams in horror.", "speech.monspeak.ba3fc7173e2a7731"},
    {"duvessa_dowan_dies_bytwin", "@The_monster@ screams, \"NO! What have I done\?\"", "speech.monspeak.fd82a39ba51d4152"},
    {"duvessa_dowan_dies_invisible_bytwin", "@Duvessa_Dowan_dies_bytwin@", "speech.monspeak.c33a039567832933"},
    {"_edmund_common_", "VISUAL:@The_monster@ gestures @at_foe@ with @possessive@ flail.", "speech.monspeak.e52501c12a60b88e"},
    {"_edmund_common_", "@The_monster@ clears @possessive@ throat.", "speech.monspeak.2a0de4369bda10e3"},
    {"_edmund_common_", "@The_monster@ says, \"You wouldn't believe how much I paid for this flail.\"", "speech.monspeak.eb096baa5bfeac65"},
    {"_edmund_common_", "@The_monster@ asks @foe,@ \"Have you met my wondrous brother\?\"", "speech.monspeak.b784ac8126a04c1d"},
    {"_edmund_common_", "@The_monster@ says @to_foe@, \"I might not be good at magic, but I can still kill you!\"", "speech.monspeak.d60b2b6addb419e1"},
    {"_edmund_common_", "@The_monster@ says, \"People think my brother is the best. I think he's crazy.\"", "speech.monspeak.7d12f7db465f574f"},
    {"_edmund_common_", "@The_monster@ says, \"I'm quite good with sums, too.\"", "speech.monspeak.7c8cd46afc06ffea"},
    {"_edmund_common_", "@The_monster@ says, \"People accused me of being a cutpurse!\"", "speech.monspeak.1110600d60aa4351"},
    {"erica", "@_Erica_common_@", "speech.monspeak.e414178645f8686c"},
    {"erica", "@_Erica_rare_@", "speech.monspeak.974e0ac99501784d"},
    {"_erica_common_", "VISUAL:@The_monster@ writhes her tentacles angrily.", "speech.monspeak.007e9b71a382d74e"},
    {"_erica_common_", "@The_monster@ burbles wildly.", "speech.monspeak.7562eb5ca118070f"},
    {"_erica_common_", "@The_monster@ says @to_foe@, \"I'm so much better than you.\"", "speech.monspeak.c84f213ba3f077b0"},
    {"_erica_common_", "@The_monster@ says @to_foe@, \"I love to horrify, but killing's even better.\"", "speech.monspeak.e0b183b34dd2c2b2"},
    {"_erica_common_", "@The_monster@ says @to_foe@, \"Fast and perfect. Such is my way of killing.\"", "speech.monspeak.e73fc528d6344162"},
    {"_erica_common_", "@The_monster@ screams @at_foe@, \"Your blood will spurt and your skin will burst!\"", "speech.monspeak.b5d242b0068abd38"},
    {"erolcha", "@_Erolcha_common_@", "speech.monspeak.8ff43d3035ce67c4"},
    {"erolcha", "@_Erolcha_rare_@", "speech.monspeak.7032770bd0104f3d"},
    {"_erolcha_rare_", "@The_monster@ screams @at_foe@, \"Eat!\"", "speech.monspeak.65a6bfb922c4f7a8"},
    {"_erolcha_rare_", "@The_monster@ screams @at_foe@, \"Stand! Erolcha hit you!\"", "speech.monspeak.2cb7c7f97bd253d7"},
    {"_erolcha_rare_", "@The_monster@ screams @at_foe@, \"Blood!\"", "speech.monspeak.61749ae038a39353"},
    {"_erolcha_rare_", "@The_monster@ screams @at_foe@, \"Erolcha crush your head!\"", "speech.monspeak.ef540cc23ac3ac09"},
    {"_erolcha_rare_", "@The_monster@ screams @at_foe@, \"Erolcha happy to kill you!\"", "speech.monspeak.ea26a24b4dc3e37d"},
    {"_erolcha_rare_", "@The_monster@ screams @at_foe@, \"Erolcha angry!\"", "speech.monspeak.c424a181a71f75f0"},
    {"erolcha banished", "@The_monster@ screams, \"Wait! Erolcha supposed to do that!\"", "speech.monspeak.c8af694fc3cc14b2"},
    {"_frances_common_", "VISUAL:@The_monster@ sneers @at_foe@.", "speech.monspeak.3a5b8448e598dacb"},
    {"_frances_common_", "VISUAL:@The_monster@ runs a finger over @possessive@ scar.", "speech.monspeak.9c4d67d7c171cff3"},
    {"_frances_common_", "@The_monster@ speaks in an indecipherable language.", "speech.monspeak.adb6fea1f9930d6a"},
    {"_frances_common_", "@The_monster@ mutters a nigh-unspeakable word.", "speech.monspeak.1570cd204311da1b"},
    {"_frances_common_", "@The_monster@ says, \"Show me proof of your conquests, and I will call you a great adventurer.\" @player_only@", "speech.monspeak.99b0d7743f021009"},
    {"_frances_common_", "@The_monster@ says, \"I command an army of devils. What do you command\?\" @player_only@", "speech.monspeak.26c435f4aec625f8"},
    {"_frances_common_", "@The_monster@ says, \"I value strength and power. I see none of this in you.\" @player_only@", "speech.monspeak.908c51603f045ee6"},
    {"_frances_common_", "@The_monster@ says, \"I speak the language of demons!\"", "speech.monspeak.89d8b74097e46830"},
    {"_frances_common_", "@The_monster@ howls an indescribable curse.", "speech.monspeak.f2a8ef8434d21084"},
    {"_frances_common_", "@The_monster@ says, \"I have seen worlds and universes beyond all imagining.\"", "speech.monspeak.b34e23281d617dbf"},
    {"frederick", "@_Frederick_common_@", "speech.monspeak.cec06b32d3d19edc"},
    {"frederick", "@_Frederick_rare_@", "speech.monspeak.8f78acb08c343dfd"},
    {"okawaru frederick", "@The_monster@ says, \"Pah! Those who rely on gods for strength get nowhere in life.\"", "speech.monspeak.b9bd700a7e78ec6f"},
    {"okawaru frederick", "@Frederick@", "speech.monspeak.2eddc7db9593ec44"},
    {"_frederick_rare_", "VISUAL:@The_monster@ polishes @possessive@ monocle.", "speech.monspeak.ef52470878aa18d0"},
    {"_frederick_rare_", "VISUAL:@The_monster@ looks bored.", "speech.monspeak.85dbf56ce3fd9b4f"},
    {"_frederick_rare_", "VISUAL:@The_monster@ sighs.", "speech.monspeak.792dff12cdb5a733"},
    {"_frederick_rare_", "@The_monster@ rants about the fall of honour.", "speech.monspeak.08dd3c1ea733fc57"},
    {"_frederick_rare_", "@The_monster@ says, \"All of you adventurers look the same to me! Bumbling weaklings, the lot!\" @player_only@", "speech.monspeak.d0bd4521724c68a1"},
    {"_frederick_rare_", "@The_monster@ says, \"For you, today is the most challenging fight of your life. For me... well, I will have lunch shortly.\" @player_only@", "speech.monspeak.239c0db827ecf0e2"},
    {"_frederick_rare_", "@The_monster@ says, \"Perhaps I should have been a lumberjack. The trees might put up more of a fight.\"", "speech.monspeak.bc1024bc816504b6"},
    {"_frederick_rare_", "@The_monster@ says, \"Killing you would be a chore, not a joy.\" @player_only@", "speech.monspeak.b816fffdeaffe169"},
    {"_frederick_rare_", "@The_monster@ eyes @foe@ carefully. \"They told me only worthy opponents would get this far.\"", "speech.monspeak.3278078fc57ccb18"},
    {"frederick triumphant", "@The_monster@ scoffs, \"You didn't have a chance.\"", "speech.monspeak.6c57d4c1a9afc155"},
    {"frederick triumphant", "@The_monster@ sighs, \"Someday I'll have a real challenge.\"", "speech.monspeak.52f3f6d4de005e39"},
    {"frederick triumphant", "@The_monster@ says, \"What a chore.\"", "speech.monspeak.7fd208217469fd01"},
    {"frederick triumphant", "@The_monster@ says, \"You don't even know how to die right.\"", "speech.monspeak.fd0b9b3497b0d5a4"},
    {"frederick triumphant", "@The_monster@ sighs, \"Killing weak @player_genus_plural@ does nothing to prove my superiority.\"", "speech.monspeak.ef2f32f22504274a"},
    {"frederick triumphant", "@The_monster@ sighs, \"Another waste of time.\"", "speech.monspeak.ee4a7d329f7db748"},
    {"frederick riddle", "@The_monster@ sighs, \"Your wits are somehow even duller than your claws.\"", "speech.monspeak.83030a96258f8679"},
    {"cheibriados frederick triumphant", "@The_monster@ says, \"Be happy - you can't get any slower than dead.\"", "speech.monspeak.b3047c424153740d"},
    {"cheibriados frederick triumphant", "@Frederick@", "speech.monspeak.7ff5a53f92d7ccfa"},
    {"dithmenos frederick triumphant", "@The_monster@ says, \"Time for you to vanish into the darkness.\"", "speech.monspeak.dc1b90b70a061502"},
    {"dithmenos frederick triumphant", "@Frederick@", "speech.monspeak.4d012c9aded518ac"},
    {"elyvilon frederick triumphant", "@The_monster@ says, \"Healer, heal thyself.\"", "speech.monspeak.3e907b2abb70204e"},
    {"elyvilon frederick triumphant", "@Frederick@", "speech.monspeak.87acd3f469fc4639"},
    {"fedhas frederick triumphant", "@The_monster@ says, \"You're grass, mortal.\"", "speech.monspeak.d3a12d0e038c3c71"},
    {"fedhas frederick triumphant", "@Frederick@", "speech.monspeak.3380981d7d43099d"},
    {"ignis frederick triumphant", "@The_monster@ says, \"Foolish to worship a god whose flame is even dimmer than you.\"", "speech.monspeak.3621aad597dd3d79"},
    {"ignis frederick triumphant", "@Frederick@", "speech.monspeak.9bb56a60cd16a7a6"},
    {"jivya frederick triumphant", "@The_monster@ says, \"Our battle was as dull and shapeless as your god.\"", "speech.monspeak.471a11ae9c06f1a6"},
    {"jivya frederick triumphant", "@Frederick@", "speech.monspeak.516d4fe7c9fa12e0"},
    {"nemelex xobeh frederick triumphant", "@The_monster@ says, \"Looks like you fold, gambler.\"", "speech.monspeak.8e43c39320cbff96"},
    {"nemelex xobeh frederick triumphant", "@Frederick@", "speech.monspeak.a11717e983961c28"},
    {"sif muna frederick triumphant", "@The_monster@ sighs, \"Relying on the knowledge of others got you nowhere, mortal.\"", "speech.monspeak.292fb44203728f86"},
    {"sif muna frederick triumphant", "@Frederick@", "speech.monspeak.cafbf9d6ef498382"},
    {"uskayaw frederick triumphant", "@The_monster@ says, \"You've danced your last steps.\"", "speech.monspeak.8985ba7907a1ce4a"},
    {"uskayaw frederick triumphant", "@Frederick@", "speech.monspeak.373c7ad723260de9"},
    {"the shining one frederick triumphant", "@The_monster@ says, \"The adventurer who shines twice as bright burns out twice as fast.\"", "speech.monspeak.bffeb952ba4b35eb"},
    {"the shining one frederick triumphant", "@Frederick@", "speech.monspeak.df98b6e3c7a347fc"},
    {"_fannar_common_", "VISUAL:@The_monster@ glares icily @at_foe@.", "speech.monspeak.736db5b547dd8248"},
