    {"_gastronok_rare_", "VISUAL:@The_monster_possessive@ mouth opens, radula flailing wildly.", "speech.monspeak.7d16d97ba921f25f"},
    {"_gastronok_rare_", "VISUAL:@The_monster@ is buffeted by a sudden breeze.", "speech.monspeak.e5863c6ae302ee6b"},
    {"_gastronok_rare_", "VISUAL:@The_monster_possessive@ eyestalks wobble, almost dislodging @possessive@ wizard hat.", "speech.monspeak.e68d91e608a1e69b"},
    {"_gastronok_rare_", "@The_monster@ gurgles, \"You're how I like my food. Fast!\"", "speech.monspeak.73fd55b30b6f202e"},
    {"_gastronok_rare_", "@The_monster@ gurgles, \"Slow down, so I can eat you.\"", "speech.monspeak.5e9bc6990b4c3f0b"},
    {"_gastronok_rare_", "@The_monster@ gurgles, \"Are you a wizard\? Wizards taste nice...\"", "speech.monspeak.88d316b858dab25a"},
    {"_gastronok_rare_", "@The_monster@ gurgles, \"Huuuuuuuuuuungry!\"", "speech.monspeak.4b1b51a939fc8a07"},
    {"_gastronok_rare_", "@The_monster@ gurgles, \"It's true, you are what you eat.\"", "speech.monspeak.33b90420b8f4f959"},
    {"_gastronok_rare_", "@The_monster@ gurgles, \"I bet you'll be tasty.\"", "speech.monspeak.44b967fabdc3d68d"},
    {"gastronok triumphant", "@The_monster@ gurgles, \"Time to dig in!\"", "speech.monspeak.651e9076b8af503d"},
    {"gastronok triumphant", "@The_monster@ gurgles, \"About time. I'm starving!\"", "speech.monspeak.4e383982c6acbfbc"},
    {"gastronok triumphant", "@The_monster@ gurgles, \"Let's see if you taste as good as that wizard did.\"", "speech.monspeak.4dc58bc953b29cc2"},
    {"grinder", "@_Grinder_common_@", "speech.monspeak.9f2e231d05031ab0"},
    {"grinder", "@_Grinder_rare_@", "speech.monspeak.5fc2c83db4fd7412"},
    {"_grinder_common_", "VISUAL:@The_monster@ grins, showing sharp teeth.", "speech.monspeak.9a93ef5eac65f6f6"},
    {"_grinder_common_", "@The_monster@ says, \"You look like you could use a good racking.\"", "speech.monspeak.29ff1d705926fa58"},
    {"_grinder_common_", "@The_monster@ says, \"I used to sell toenails on the black market.\"", "speech.monspeak.d494e86ad4c0fae0"},
    {"_grinder_common_", "@The_monster@ says, \"There's only one good use for a tongue: cutting it out.\"", "speech.monspeak.d875509ddcdffb9a"},
    {"_grinder_common_", "@The_monster@ says, \"Mostly I couldn't keep them alive.\"", "speech.monspeak.9b5a7b23ba674c7e"},
    {"_grinder_common_", "@The_monster@ says, \"DUCK!\"", "speech.monspeak.0a8ed62a7d59e8ee"},
    {"_grinder_common_", "@The_monster@ sighs, \"No one appreciates my work.\"", "speech.monspeak.55d6576bef81aadd"},
    {"_grinder_common_", "@The_monster@ says, \"Wait up.\"", "speech.monspeak.5b57095a887e6819"},
    {"_grinder_common_", "@The_monster@ says, \"Just stop there for a second...\"", "speech.monspeak.d722899dc1c0e92c"},
    {"_grinder_common_", "@The_monster@ says, \"Don't move a muscle.\"", "speech.monspeak.7a8c2edbdd43627c"},
    {"_grinder_common_", "@The_monster@ says, \"Tell me all your secrets, or I'll kill you.\"", "speech.monspeak.06f88a91b0119f58"},
    {"_grinder_rare_", "@The_monster@ says, \"Are you a fish\?\"", "speech.monspeak.48385e25fc8ed3c7"},
    {"_grinder_rare_", "@The_monster@ says, \"What is the universe for\?\"", "speech.monspeak.71d725f2c0228dd9"},
    {"_grinder_rare_", "@The_monster@ says, \"My boss said I was rubbish. His entrails said otherwise.\"", "speech.monspeak.b337d3892326369b"},
    {"_grinder_rare_", "@The_monster@ says, \"At least @my_God@ appreciates what I'm doing.\"", "speech.monspeak.be8d352b7083d97d"},
    {"_grinder_rare_", "@The_monster@ says, \"Make like a tree!\"", "speech.monspeak.30bfe63c1fde43dd"},
    {"_grinder_rare_", "VISUAL:@The_monster@ rolls @possessive@ eyes.", "speech.monspeak.d31b0e10822e4106"},
    {"grinder triumphant", "@The_monster@ says, \"Now the real fun starts!\"", "speech.monspeak.4fe449a147f88d4d"},
    {"grinder triumphant", "@The_monster@ says, \"Hey, I wasn't done torturing you yet!\"", "speech.monspeak.7042961a7b6330c2"},
    {"grinder triumphant", "@The_monster@ sighs, \"Dead already\? I want a refund.\"", "speech.monspeak.8a947fa5a3b7f04e"},
